}
{
  "name": "manage_mentor_note",
  "description": "Create, update, or delete a mentor note. Action 'upsert' opens (or retrieves existing) a note for the caller as mentor for a given mentee/project/term/domain/week. Action 'set_vibe' sets the weekly vibe rating. Action 'delete' removes the note. The note body is collab-owned — write it in the DocEditor, not via this tool.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "upsert",
          "set_vibe",
          "delete"
        ],
        "description": "What to do."
      },
      "menteeId": {
        "type": "string",
        "description": "Mentee user id. Required for action=upsert."
      },
      "projectId": {
        "type": "string",
        "description": "Project id. Required for action=upsert."
      },
      "termId": {
        "type": "string",
        "description": "Term id. Required for action=upsert."
      },
      "domainId": {
        "type": "string",
        "description": "Domain id. Required for action=upsert."
      },
      "weekOf": {
        "type": "string",
        "description": "Week date (yyyy-mm-dd). Collapsed to Monday-UTC. Required for action=upsert."
      },
      "id": {
        "type": "string",
        "description": "MentorNote id. Required for action=set_vibe and action=delete."
      },
      "vibe": {
        "enum": [
          "Good",
          "Ok",
          "Bad",
          null
        ],
        "description": "Vibe rating. Required for action=set_vibe (pass null to clear)."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_mentorship_pair",
  "description": "Create or delete a mentorship pair. Both actions are Core-only. Action 'create' links a mentor to a mentee for a project/term/domain (dupe-safe). Action 'delete' removes an existing pair by id.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "delete"
        ],
        "description": "What to do."
      },
      "menteeUserId": {
        "type": "string",
        "description": "Mentee user id. Required for action=create."
      },
      "mentorUserId": {
        "type": "string",
        "description": "Mentor user id. Required for action=create."
      },
      "projectId": {
        "type": "string",
        "description": "Project id. Required for action=create."
      },
      "termId": {
        "type": "string",
        "description": "Term id. Required for action=create."
      },
      "domainId": {
        "type": "string",
        "description": "Domain id. Required for action=create."
      },
      "id": {
        "type": "string",
        "description": "MentorshipPair id. Required for action=delete."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_mentor_note_template",
  "description": "Create, update, or delete a mentor note template. Core-only. Action 'create' makes a new template (optionally setting it as default). Action 'update' changes name and/or isDefault. Both create and update accept optional 'content' (Markdown) to author the template body. Action 'delete' removes a template.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "delete"
        ],
        "description": "What to do."
      },
      "name": {
        "type": "string",
        "description": "Template name. Required for action=create; optional for action=update."
      },
      "isDefault": {
        "type": "boolean",
        "description": "When true, this template becomes the default seed for new notes (clears the flag on any other template). Optional for create/update."
      },
      "content": {
        "type": "string",
        "maxLength": 300000,
        "description": "Optional template body as Markdown (same dialect as create_page). Authors the collaborative body for create and update."
      },
      "id": {
        "type": "string",
        "description": "MentorNoteTemplate id. Required for action=update and action=delete."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_documents_to_sign",
  "description": "List the lab agreements the caller still needs to sign. Returns outstanding bindings (documentId, documentName, versionId) the caller is in the audience for but hasn't signed yet.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_signed_document",
  "description": "Retrieve the caller's own signed copy of an agreement binding. Returns the document metadata, version number, typed name, and a flag indicating if the archived body is legacy ProseMirror format.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "bindingId": {
        "type": "string",
        "description": "The binding ID to look up the caller's signature for."
      }
    },
    "required": [
      "bindingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_binding_to_sign",
  "description": "Return the agreement body, field definitions, and resolved merge variables for a binding the caller must sign — lets a caller inspect the document before calling sign_document. Returns 403 if the caller is not in the audience and has not yet signed; 404 if the binding doesn't exist.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "bindingId": {
        "type": "string",
        "description": "The binding id returned by list_documents_to_sign."
      }
    },
    "required": [
      "bindingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_my_signed_documents",
  "description": "Return the caller's personal archive of signed lab agreements (member role only — not hiring confidentiality), newest first. Each item includes the signatureId (link into get_signed_document), bindingId, documentName, context (term code / cycle name / 'Lab-wide'), and signedAt ISO timestamp.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_agreement_signatures",
  "description": "List member signatures on a signing document, newest first. Core-only. Optionally filter by a specific binding. Returns signerId, name, signedAt, and binding context. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "documentId": {
        "type": "string",
        "description": "The signing document ID to list signatures for."
      },
      "bindingId": {
        "type": "string",
        "description": "Optional. Filter to a specific binding (context/term)."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "documentId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_agreements",
  "description": "Core-only. Return the agreements console overview for a term: every non-archived agreement with its binding status, signatory roster (signed / outstanding), needs-activation flag, and a recent-signatures activity feed of the latest 15 (activityMayBeTruncated is true when there may be more; use list_agreement_signatures for a full list). Bindings are limited to the current term by default, with pastBindingCount giving how many were left out; pass includePastBindings to return them all. Pass termId to focus on a specific term (e.g. an upcoming term); defaults to the current term.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "termId": {
        "type": "string",
        "description": "Optional term id to focus the console on. Defaults to the current term. Accepts upcoming terms so Core can manage agreements before a term starts."
      },
      "includePastBindings": {
        "type": "boolean",
        "description": "Return bindings for past terms too. Default false."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "get_signed_document_admin",
  "description": "Core-only. Read another member's full signed copy of an agreement: frozen archival body (with field values baked in), signing metadata (IP, user agent, typed name, role, version number), and whether the body was pre-migration legacy ProseMirror JSON. The existing get_signed_document only returns the caller's own copy; this tool is for Core reviewers auditing compliance.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "signatureId": {
        "type": "string",
        "description": "The signature id (from list_agreement_signatures or list_agreements activity feed)."
      }
    },
    "required": [
      "signatureId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "sign_document",
  "description": "Sign a lab agreement binding as the current user. Validates audience eligibility and required fields before recording the signature.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "bindingId": {
        "type": "string",
        "description": "The binding ID to sign."
      },
      "fieldValues": {
        "type": "object",
        "description": "Key-value map of field IDs to values (signature text, checkbox booleans, etc.). Required fields for the member role must be filled.",
        "additionalProperties": true
      }
    },
    "required": [
      "bindingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_agreement",
  "description": "Core-only. Create, rename, publish, activate, update, delete_version, archive, or remind on a signing document/agreement. Actions: create · rename · publish · activate · update · delete_version · archive · remind. Putting a version in force (activate) records the pre-signed admin-signature counter-signatures placed in the body. Update edits the config facets (gate scope / audience / cadence). delete_version removes an unpublished/unsigned draft version. archive toggles the archivedAt timestamp on the document. remind nudges outstanding signers for a binding (throttled to once per 24h; pass force:true to override).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "rename",
          "publish",
          "activate",
          "update",
          "delete_version",
          "archive",
          "remind"
        ]
      },
      "documentId": {
        "type": "string",
        "description": "Required for rename, publish, activate, update."
      },
      "versionId": {
        "type": "string",
        "description": "Required for publish, activate."
      },
      "name": {
        "type": "string",
        "description": "Document name. Required for create; used by rename."
      },
      "gateScope": {
        "type": "string",
        "enum": [
          "None",
          "App",
          "HiringCycle"
        ],
        "description": "Gate scope. Set on create (defaults to None) or update."
      },
      "audience": {
        "type": "string",
        "enum": [
          "Manual",
          "NewMembers",
          "Members",
          "Mentors",
          "HiringParticipants",
          "Group"
        ],
        "description": "Target audience. NewMembers = this cycle's General/Fellowship hires; Members = returning active members (not new); Mentors = all mentors; Group = a user group (see audienceGroupId). Set on create (defaults to Manual) or update."
      },
      "audienceGroupId": {
        "type": "string",
        "description": "Only for audience=Group. A GroupDefinition id to target a fixed group; omit (or pass empty) to target the binding's term group — everyone active/staffed that term, so a per-term agreement auto-rolls each term. Ignored for other audiences (cleared)."
      },
      "cadence": {
        "type": "string",
        "enum": [
          "Once",
          "PerTerm",
          "PerCycle"
        ],
        "description": "Signing cadence. Set on create (defaults to Once) or update."
      },
      "bindingId": {
        "type": "string",
        "description": "Required for remind."
      },
      "force": {
        "type": "boolean",
        "description": "For remind: bypass the 24-hour throttle and nudge all outstanding signers immediately. Defaults to false."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "issue_term_agreements",
  "description": "Core-only. Put the latest published version of each selected agreement in force for a term and send sign requests to the audience. Pass preview:true to see who would be notified without committing (the staffing board's confirm step). termId defaults to the current term; pass an upcoming term id to issue early. documentIds is required when preview is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "preview": {
        "type": "boolean",
        "description": "When true, return the issuable agreements + recipient lists without activating anything. Defaults to false."
      },
      "documentIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Agreement document ids to issue. Required when preview is false. Ignored when preview is true (all PerTerm App-gated agreements are shown)."
      },
      "termId": {
        "type": "string",
        "description": "Target term id. Defaults to the current term. Accepts upcoming terms so agreements can be issued before a term starts."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_forms",
  "description": "List every form: id, name, folderPageId (the Drive Page folder it lives in, null = top level), version count, publish state, and publicToken (for get_form and submit_form), for the forms you can view. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_form",
  "description": "Read a form's definition. Pass exactly one of formId or token. formId needs edit access and returns everything an editor sees: settings, the window, audience, the draft, and every version with its questions, for example before a save_version, which replaces the whole question list. token is audience-gated like submit_form and returns the latest published version as a respondent sees it: versionId, questions with their keys, and live options for reference questions. Use that to build a submit_form call.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "formId": {
        "type": "string",
        "description": "The form ID, for the editor's view."
      },
      "token": {
        "type": "string",
        "description": "The form's public token (publicToken in list_forms), for the respondent's view."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_form_responses",
  "description": "Return form submissions, newest first, as a response grid (columns + per-submission answer rows). Needs edit access on the form. Pass page.nextCursor as cursor to read the next page until page.hasMore is false; page.total is the full submission count, or the matching count when q, slot or answers narrow it. q searches name, email and answer text; q and answers need versionNumber.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "formId": {
        "type": "string",
        "description": "The form ID to load responses for."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      },
      "versionNumber": {
        "type": "number",
        "description": "If provided, filter to submissions for this version only. Required with q or answers."
      },
      "q": {
        "type": "string",
        "description": "Only submissions where every word appears in the respondent's name, email or an answer. Needs versionNumber."
      },
      "slot": {
        "type": "string",
        "description": "Only submissions filled for this slot."
      },
      "answers": {
        "type": "array",
        "description": "Filter by answers; every filter must match. One per question, using the question's key from get_form. kind is: is (values: option strings, or \\"__other__\\" for an answer outside the options; a checkbox matches when it includes any), contains (text, case-insensitive; text, textarea, email and URL questions), range (min and/or max, inclusive; number or YYYY-MM-DD date questions), answered or blank (any filterable question; blank also covers a question a rule hid). File and skills rating questions can't be filtered.",
        "items": {
          "type": "object",
          "properties": {
            "questionKey": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "is",
                "contains",
                "range",
                "answered",
                "blank"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "text": {
              "type": "string"
            },
            "min": {
              "type": [
                "string",
                "number"
              ]
            },
            "max": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [
            "questionKey",
            "kind"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "formId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_form_summary",
  "description": "Return the results Summary for one form version: the response total and per-question counts and percentages, across every response rather than one page. Pass answers to count only responses with matching answers. Needs edit access on the form.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "formId": {
        "type": "string",
        "description": "The form ID."
      },
      "versionNumber": {
        "type": "number",
        "description": "The version to summarize. Defaults to the latest."
      },
      "slot": {
        "type": "string",
        "description": "If provided, count only responses filled for this slot. slotOptions in the result lists them."
      },
      "answers": {
        "type": "array",
        "description": "Filter by answers; every filter must match. One per question, using the question's key from get_form. kind is: is (values: option strings, or \\"__other__\\" for an answer outside the options; a checkbox matches when it includes any), contains (text, case-insensitive; text, textarea, email and URL questions), range (min and/or max, inclusive; number or YYYY-MM-DD date questions), answered or blank (any filterable question; blank also covers a question a rule hid). File and skills rating questions can't be filtered.",
        "items": {
          "type": "object",
          "properties": {
            "questionKey": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "is",
                "contains",
                "range",
                "answered",
                "blank"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "text": {
              "type": "string"
            },
            "min": {
              "type": [
                "string",
                "number"
              ]
            },
            "max": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [
            "questionKey",
            "kind"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "formId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_form_tracker",
  "description": "Return the response tracker for a form: how many people are expected, how many responded, and who hasn't, with dismissed people last. tracker is null when nobody is expected to respond. Needs edit access on the form.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "formId": {
        "type": "string",
        "description": "The form ID."
      }
    },
    "required": [
      "formId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "submit_form",
  "description": "Submit a response to a published form addressed by its public token. Access is audience-gated (Members / SignedIn / Groups / Public). Always submits as the authenticated caller — no anonymous path.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "token": {
        "type": "string",
        "description": "The form's public token (from the fill URL)."
      },
      "versionId": {
        "type": "string",
        "description": "The form version ID to submit against (versionId from get_form with token)."
      },
      "answers": {
        "type": "object",
        "description": "Answer map: question key → answer value. Checkbox answers are an array of strings.",
        "additionalProperties": true
      }
    },
    "required": [
      "token",
      "versionId",
      "answers"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_form",
  "description": "Create, version, publish, configure, or delete a form, delete a response, or remind people who haven't responded. Actions: create · save_version · save_draft · publish · unpublish · set_window · set_audience · set_settings · rename · move · duplicate · delete · delete_response · send_reminder. Needs edit access on the form (create: on the folder). set_audience sets the form page's general access. set_settings changes only the settings you pass. delete_response is permanent and lets the person fill the form again. send_reminder is limited to one per form every 24 hours.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "save_version",
          "save_draft",
          "publish",
          "unpublish",
          "set_window",
          "set_audience",
          "set_settings",
          "rename",
          "move",
          "duplicate",
          "delete",
          "delete_response",
          "send_reminder"
        ],
        "description": "The management action to perform."
      },
      "formId": {
        "type": "string",
        "description": "Required for all actions except create."
      },
      "name": {
        "type": "string",
        "description": "Form name (create / rename)."
      },
      "folderPageId": {
        "type": "string",
        "description": "Target Drive folder Page ID (create / move) — a Page of kind=Folder. Empty string = top level."
      },
      "questions": {
        "type": "string",
        "description": "JSON-encoded Question[] (save_version / save_draft). Each question is {key, type, required, data: {label, description?, options?, ...}}. Types: text, textarea, select, radio, checkbox, scale, date, number, email, github_url, figma_url, drive_url, file, skills_rating, reference, info, pageBreak. radio is single choice and needs data.options with at least two entries. radio and checkbox accept data.allowOther: true, which adds an Other write-in (up to 200 characters). scale is a fixed 1 to 5 rating with optional data.scaleLow and data.scaleHigh end labels. number accepts optional numeric data.min and data.max. date answers are YYYY-MM-DD. file accepts optional data.accept (comma-separated types) and data.maxFiles (1 to 10, default 1); data.exactFiles: true makes an answer need exactly maxFiles files instead of up to that many. email answers are stored lowercased. Any question can carry data.showIf: {match: 'all' | 'any', conditions: [{questionKey, op, values}]}, which shows it only when earlier answers match; on a pageBreak it shows or hides that whole page. Each condition's source must come earlier. Ops by source type: select, radio, reference: is, isNot (values: any of the options, or row ids for reference); scale: is, isNot (values '1' to '5'), atLeast, atMost (one value); checkbox: includes, excludes (any of the options); number and date: atLeast, atMost (one number, or one YYYY-MM-DD date); text, textarea, email and link types: contains (one text); every source above plus file: answered, blank (values []). For radio and checkbox with allowOther, '__other__' matches a write-in. skills_rating can't be a source. The older single-condition form {questionKey, op, value} is still read. A question that staffing reads through a column mapping can't be conditional, and neither can the page it sits on. Hidden questions are never required and store no answer."
      },
      "description": {
        "type": "string",
        "description": "JSON-encoded rich-text description (save_version / save_draft)."
      },
      "opensAt": {
        "type": "string",
        "description": "ISO datetime window opens (set_window). Empty string clears."
      },
      "closesAt": {
        "type": "string",
        "description": "ISO datetime window closes (set_window). Empty string clears."
      },
      "audience": {
        "type": "string",
        "enum": [
          "Members",
          "SignedIn",
          "Groups",
          "Public"
        ],
        "description": "Audience setting (set_audience)."
      },
      "groupIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Group IDs when audience=Groups (set_audience)."
      },
      "oneResponsePerMember": {
        "type": "boolean",
        "description": "One-response gate (set_settings)."
      },
      "notifyOnSubmission": {
        "type": "boolean",
        "description": "Email Core on each submission (set_settings)."
      },
      "listed": {
        "type": "boolean",
        "description": "Show on 'Forms for you' member home (set_settings)."
      },
      "allowResponseEdit": {
        "type": "boolean",
        "description": "Let respondents change their own answers while the form is open (set_settings). Needs oneResponsePerMember."
      },
      "remindBeforeClose": {
        "type": "boolean",
        "description": "Remind people who haven't responded a day before the form closes (set_settings). Needs a close time."
      },
      "sendReceipt": {
        "type": "boolean",
        "description": "Email respondents a copy of their answers on submit (set_settings)."
      },
      "confirmationMessage": {
        "type": "string",
        "description": "JSON-encoded rich-text blocks shown after submitting, in place of the default copy (set_settings). Empty string clears."
      },
      "submissionId": {
        "type": "string",
        "description": "The response to delete, an id from get_form_responses (delete_response)."
      },
      "message": {
        "type": "string",
        "description": "The reminder text (send_reminder)."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "create_payroll_csv_upload",
  "description": "Start uploading a payroll CSV for Admin → Payroll reconciliation: the TimesheetX timesheet export (kind \\"timesheet\\") or the optional notes CSV (kind \\"notes\\"). Returns a presigned S3 POST and a ready curl command for a POSIX shell: run it with the local file path, expect a final line of HTTP 204, then call import_payroll_csvs with the key(s). Max 10 MB; the link expires after 15 minutes. Admin-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "timesheet",
          "notes"
        ],
        "description": "Which file this is. Import needs a timesheet; notes are optional."
      },
      "fileName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "The CSV's file name, e.g. 'TimesheetX 09-13-2026.csv'. Must end in .csv."
      }
    },
    "required": [
      "kind",
      "fileName"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "import_payroll_csvs",
  "description": "Import payroll CSVs uploaded with create_payroll_csv_upload into Admin → Payroll — the same import as the page's Upload button. The timesheet is required; notes are optional and attach to the pay periods the timesheet imports. Re-importing a pay period replaces its rows. Both uploaded files are deleted afterwards, whether or not the import succeeds. Returns the import summary: per-period rows created, duplicates skipped, prior rows replaced, invalid periods, and per-row errors. Admin-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "timesheetKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "description": "Key returned by create_payroll_csv_upload for the timesheet."
      },
      "notesKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "description": "Key returned by create_payroll_csv_upload for the notes CSV (optional)."
      }
    },
    "required": [
      "timesheetKey"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_domains",
  "description": "List all lab domains with their lead assignments and activity counts (application cycles, lead assignments, reviewers, interviewers, deliberation sessions). Lead assignments are for the current term unless termId or allTerms is given; the counts always cover all terms. Accessible to Core leads, domain leads, and admins.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "termId": {
        "type": "string",
        "description": "Show lead assignments for this term instead of the current one."
      },
      "allTerms": {
        "type": "boolean",
        "description": "Show lead assignments from every term. Ignored when termId is set."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "send_announcement",
  "description": "Send (or schedule) a lab-wide announcement. Pick at least one audience source: allMembers, groupIds, or userIds. Supply sendAt (ISO datetime) to schedule for a future time instead of sending immediately. Use cancel_scheduled to cancel a pending scheduled announcement. Requires Core.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "send",
          "cancel_scheduled"
        ],
        "description": "send — send or schedule an announcement (default); cancel_scheduled — cancel a pending scheduled announcement by id."
      },
      "scheduledAnnouncementId": {
        "type": "string",
        "description": "Required for cancel_scheduled: the id of the pending scheduled announcement to cancel."
      },
      "title": {
        "type": "string",
        "maxLength": 200,
        "description": "Announcement title (required for send)."
      },
      "body": {
        "type": "string",
        "maxLength": 2000,
        "description": "Optional body text."
      },
      "link": {
        "type": "string",
        "maxLength": 500,
        "description": "Optional URL the notification links to."
      },
      "kind": {
        "type": "string",
        "enum": [
          "General",
          "MeetingInvite",
          "MeetingReminder",
          "SystemAnnouncement"
        ],
        "description": "Notification kind (default General)."
      },
      "isTodo": {
        "type": "boolean",
        "description": "If true, surfaces as a todo item in the recipient's task sidebar."
      },
      "dueAt": {
        "type": "string",
        "description": "ISO 8601 datetime deadline for the todo (only meaningful when isTodo=true)."
      },
      "formId": {
        "type": "string",
        "description": "ID of a published form to attach."
      },
      "sendAt": {
        "type": "string",
        "description": "ISO 8601 datetime. When in the future the announcement is scheduled rather than sent immediately."
      },
      "allMembers": {
        "type": "boolean",
        "description": "Include all current lab members in the recipient set."
      },
      "groupIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Lab group IDs whose members are included in the recipient set."
      },
      "userIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Individual user IDs to include in the recipient set."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_group",
  "description": "Create, update, or delete a Static lab group. Only admins may call this tool. System-managed groups (systemKey set) cannot be edited or deleted. Dynamic groups cannot have their member list overridden — those update automatically.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "delete"
        ],
        "description": "The operation to perform."
      },
      "groupId": {
        "type": "string",
        "description": "Required for update and delete — the id of the group to modify."
      },
      "name": {
        "type": "string",
        "description": "Display name of the group (1–100 chars). Required for create; optional for update."
      },
      "staticMemberIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Full replacement list of member userIds. Required for create (min 1); optional for update (Static groups only)."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_domain_lead",
  "description": "Add or remove a domain lead assignment. Add always targets the current active term. Only admins may call this tool.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "remove"
        ],
        "description": "The operation to perform."
      },
      "domainId": {
        "type": "string",
        "description": "Required for add — the id of the domain."
      },
      "userId": {
        "type": "string",
        "description": "Required for add — the userId to assign as lead."
      },
      "assignmentId": {
        "type": "string",
        "description": "Required for remove — the id of the DomainLeadAssignment row."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_audit_logs",
  "description": "Return audit log entries, newest first. Filterable by action, actor userId, target id, person name/email or IP, and date range. Pass page.nextCursor as cursor to read the next page until page.hasMore is false; page.total is the count for the filters. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Filter by audit action"
      },
      "area": {
        "type": "string",
        "description": "Filter by area (the action's first segment, e.g. staffing, mcp, auth, hiring, page). Ignored when action is set."
      },
      "userId": {
        "type": "string",
        "description": "Filter by actor user ID"
      },
      "targetId": {
        "type": "string",
        "description": "Filter by target ID"
      },
      "person": {
        "type": "string",
        "description": "Search by name/email (searches both actor and target), or by request IP: a full address matches exactly, a partial one like 129.170 matches the range"
      },
      "from": {
        "type": "string",
        "description": "Start date (ISO)"
      },
      "to": {
        "type": "string",
        "description": "End date (ISO)"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_job",
  "description": "Enable/disable/configure or immediately trigger a background job. Actions: list · set_config · run. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "set_config",
          "run"
        ],
        "description": "list — enumerate all jobs with their current state; set_config — patch enabled/interval/settings; run — trigger immediately."
      },
      "name": {
        "type": "string",
        "description": "Job name (stable registry key)."
      },
      "enabled": {
        "type": "boolean",
        "description": "set_config: enable or disable the job."
      },
      "intervalMinutes": {
        "type": "number",
        "description": "set_config: cadence override (1–10080 minutes)."
      },
      "settings": {
        "type": "object",
        "description": "set_config: numeric setting overrides keyed by setting key."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_feature_flag",
  "description": "List or configure feature flags (gradual rollout). A flag is on for a user when it's enabled and any target matches: everyone, a listed role, or a named user. Actions: list · set_config. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "set_config"
        ],
        "description": "list — return all flags and their current targeting; set_config — patch one flag."
      },
      "key": {
        "type": "string",
        "description": "set_config: the flag's registry key (e.g. \\"desktop-app\\")."
      },
      "enabled": {
        "type": "boolean",
        "description": "set_config: master switch. False turns the flag off for everyone."
      },
      "everyone": {
        "type": "boolean",
        "description": "set_config: when enabled, turn the flag on for all users."
      },
      "roles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "isCore",
            "isAdmin",
            "isDomainLead",
            "isInstructor",
            "isInterviewer",
            "isStaff",
            "isAlumni"
          ]
        },
        "description": "set_config: role targets. Any of: isCore, isAdmin, isDomainLead, isInstructor, isInterviewer, isStaff, isAlumni."
      },
      "userIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "set_config: explicit User.id allowlist."
      },
      "variant": {
        "type": "string",
        "description": "set_config: for multi-value flags (e.g. \\"home-surface\\"), which option targeted users get. Use list to see each flag's options."
      },
      "note": {
        "type": "string",
        "description": "set_config: optional operator note (empty string clears it)."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_email_senders",
  "description": "List all configured email sender integrations, one entry per email purpose. Shows which Gmail account is linked for each purpose, when it was last used, any sync errors, and the fallback address for purposes without a dedicated sender. Only accessible to Core leads.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_email_templates",
  "description": "List every operator-editable email: its key, area, what sends it, which {{variables}} it may use, the sender identity it goes out as, whether copy has been written, and what happens when it hasn't (skip = nothing sends, error = the action is blocked, default = built-in copy is used). Pass includeVersions together with key to also get that email's edit history. Only accessible to Core leads.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "description": "Limit to one email key, e.g. \\"hiring:decision:Accepted\\"."
      },
      "includeVersions": {
        "type": "boolean",
        "description": "Include the append-only edit history. Requires key. Defaults to false."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_email_template",
  "description": "Edit one operator-editable email, identified by its registry key (see list_email_templates). action=save: set the subject and body. action=clear: delete the copy, which turns the email off where the registry allows that. action=rollback: restore a previous version as a new one. action=send_test: render with sample values and send to the caller's own DALI address. Emails cannot be created or renamed here — the set is fixed in code. Only accessible to Core leads.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "save",
          "clear",
          "rollback",
          "send_test"
        ],
        "description": "The operation to perform."
      },
      "key": {
        "type": "string",
        "description": "The email's registry key, e.g. \\"hiring:decision:Accepted\\". Always required."
      },
      "subject": {
        "type": "string",
        "description": "Subject line. Required for save."
      },
      "body": {
        "type": "string",
        "description": "Body text. Required for save."
      },
      "versionNumber": {
        "type": "number",
        "description": "Required for rollback — the version to restore."
      }
    },
    "required": [
      "action",
      "key"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_announcements",
  "description": "List scheduled (pending) and sent announcements. \`pending\` holds the next 20 scheduled sends, soonest first, and \`pendingTotal\` is how many are scheduled in all. \`recentlySent\` is paged, newest first: pass page.nextCursor as cursor to read the next page until page.hasMore is false. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Page size (default 20, max 100)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_email_sender",
  "description": "Disable a Gmail sender integration or set/clear its daily email cap. action=disable: soft-disables the send-as identity. action=save_cap: sets (or clears) the daily email cap for this sender. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "disable",
          "save_cap"
        ],
        "description": "disable — soft-disable the sender; save_cap — set/clear daily cap."
      },
      "integrationId": {
        "type": "string",
        "description": "GmailIntegration id (from list_email_senders)."
      },
      "dailyCap": {
        "type": "number",
        "description": "save_cap: positive integer sets the cap; 0 or omit to clear (uncapped)."
      }
    },
    "required": [
      "action",
      "integrationId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_outbound_messages",
  "description": "List outbound messages from the transactional outbox, newest first. Pass page.nextCursor as cursor to read the next page until page.hasMore is false. Optionally filter by status or search recipient/subject/event. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "Pending",
          "Sending",
          "Sent",
          "Dead",
          "Canceled"
        ],
        "description": "Filter by message status."
      },
      "q": {
        "type": "string",
        "description": "Text search across target, recipientUserId, eventType, subject."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 100, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_outbound_message",
  "description": "Retry a Dead outbound message (resets it to Pending for re-delivery) or cancel a Pending one. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "retry",
          "cancel"
        ],
        "description": "retry — reset a Dead message to Pending; cancel — stop a Pending message from sending."
      },
      "messageId": {
        "type": "string",
        "description": "OutboundMessage id."
      }
    },
    "required": [
      "action",
      "messageId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_activity",
  "description": "Manage time-boxed Activities (onboarding hunts and site modes). action=list: list activities, newest start first; pass page.nextCursor as cursor to read the next page until page.hasMore is false. action=create: create a new Draft activity (name + kind required). action=update: update name/window/audience/termId. action=set_status: transition status to Published/Draft/Archived. action=delete: delete a Draft activity with no events. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "create",
          "update",
          "set_status",
          "delete"
        ],
        "description": "Operation to perform."
      },
      "activityId": {
        "type": "string",
        "description": "Activity id (required for update/set_status/delete)."
      },
      "name": {
        "type": "string",
        "description": "Activity name (required for create; optional for update)."
      },
      "kind": {
        "type": "string",
        "enum": [
          "scavenger_hunt"
        ],
        "description": "Activity mechanic (required for create)."
      },
      "termId": {
        "type": "string",
        "description": "Term id to associate (optional)."
      },
      "startsAt": {
        "type": "string",
        "description": "ISO 8601 datetime for window start."
      },
      "endsAt": {
        "type": "string",
        "description": "ISO 8601 datetime for window end."
      },
      "audienceEveryone": {
        "type": "boolean",
        "description": "update: whether audience is all lab members."
      },
      "status": {
        "type": "string",
        "enum": [
          "Draft",
          "Published",
          "Archived"
        ],
        "description": "set_status: target status."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_ai_usage",
  "description": "AI doc-writing usage summary per member over the last 7, 30, or 90 days. Returns per-user request counts and token totals plus lab-wide totals. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "rangeDays": {
        "type": "number",
        "enum": [
          7,
          30,
          90
        ],
        "description": "Look-back window in days (default: 30)."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "get_attendance_overview",
  "description": "Admin view of self check-in attendance across all meetings, with optional term filter. Returns meetings newest first (undated meetings last) with per-meeting invited/checkedIn counts and, by default, attendee lists. Pass includeAttendees false for counts only. Pass page.nextCursor as cursor to read the next page until page.hasMore is false; page.total is the number of matching meetings. Core leads only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "termId": {
        "type": "string",
        "description": "Filter to a specific term. Omit for all terms."
      },
      "includeAttendees": {
        "type": "boolean",
        "description": "Include each meeting's attendee rows. Default true. False returns only the invited and checkedIn counts."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 100, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_infrastructure",
  "description": "Read-only view of the Fly.io + Neon fleet for all projects. Returns per-project app/machine counts, Neon project/endpoint states, and the Neon plan with estimated month-to-date and last-month dollars (from published rates; the invoice is authoritative). Requires the infra-dashboard feature flag and Core access.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "create_member",
  "description": "Create a lab member, or promote the existing User to a member when any given identity (email or NetID) already belongs to one. An existing User only has blank fields filled; values already set are never overwritten. The email is routed by suffix: @dali.dartmouth.edu to daliEmail, @dartmouth.edu to dartmouthEmail, anything else to personalEmail; explicit identity fields override that routing. With a NetID and no email, the email and class year come from the Dartmouth directory; a NetID the directory doesn't know creates the member with no email. Sends no email or notification. Intended for admin backfill. Core members only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "firstName": {
        "type": "string",
        "minLength": 1
      },
      "lastName": {
        "type": "string",
        "minLength": 1
      },
      "email": {
        "type": "string",
        "minLength": 1,
        "description": "Primary email, routed to a column by suffix. At least one of email, daliEmail, dartmouthEmail, personalEmail is required unless netId is given."
      },
      "daliEmail": {
        "type": "string",
        "description": "An @dali.dartmouth.edu address."
      },
      "dartmouthEmail": {
        "type": "string",
        "description": "An @dartmouth.edu address so the member's Dartmouth login resolves to this account."
      },
      "personalEmail": {
        "type": "string"
      },
      "netId": {
        "type": "string"
      },
      "githubUsername": {
        "type": "string"
      },
      "phoneNumber": {
        "type": "string"
      },
      "birthday": {
        "type": "string",
        "description": "YYYY-MM-DD"
      },
      "dietaryRestrictions": {
        "type": "string"
      },
      "classYear": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2100
      },
      "pronouns": {
        "type": "string"
      },
      "major": {
        "type": "string"
      },
      "hometown": {
        "type": "string"
      },
      "linkedinUrl": {
        "type": "string"
      },
      "personalSite": {
        "type": "string"
      }
    },
    "required": [
      "firstName",
      "lastName"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "backfill_hiring_cycle",
  "description": "Import ONE finished historical hiring cycle: the cycle (Completed, stamped with the dates you pass), its application form, per-domain rubrics and challenge forms, applications, reviews, Released decisions and completed interviews. Rows are written directly with the historical timestamps; nothing is released, so no emails, notifications, Slack messages, members, or domain eligibility are created. Applicants without an account get a plain User with no membership. A waitlisted applicant needs a final outcome: pass outcome.waitlistedAt with Rejected (came off the waitlist) or Accepted (hired from it), so nobody lands on the live waitlist. Omit the outcome for undecided applicants. Pass cycleId to append more applications to a cycle created by an earlier call; reruns skip rows that already exist. Max 200 applications per call. Admins only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "cycle": {
        "type": "object",
        "description": "name, createdAt (ISO, required), applicants (Students|Interns|LabMembers, default Students), termId, startTermIds[], openDate, closeDate, hasChallenges, hasInterviews."
      },
      "cycleId": {
        "type": "string",
        "description": "Append to this existing cycle instead of creating one."
      },
      "applicationForm": {
        "type": "object",
        "description": "{ name, questions: Question[] }. Created only when the cycle has no application form."
      },
      "domains": {
        "type": "array",
        "description": "[{ domainId, rubric?: { name, criteria: RubricCriterion[] }, challengeForm?: { name, questions } }]",
        "items": {
          "type": "object"
        }
      },
      "applications": {
        "type": "array",
        "maxItems": 200,
        "description": "[{ applicant: { userId?, email?, netId?, firstName?, lastName? }, createdAt, answers?, domainApplications: [{ domainId, submittedAt, answers?, withdrawn?, outcome?: { type: Accepted|Rejected, decidedAt, notes?, invitedToInterviewAt?, waitlistedAt? }, reviews?: [{ reviewerUserId, submittedAt, scores, feedback?, rejectionRationale?, overallRecommendation? }], interview?: { startTime, endTime, interviewerUserIds?, notes? } }] }]",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [
      "cycle",
      "applications"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "get_backfill_state",
  "description": "Read what a backfill needs to reconcile against: the users holding the given NetIDs, and the project and Core assignments in the given terms. Read-only. Admins only. Assignments are paged one kind at a time: \`assignments\` picks project (default) or core, and that kind comes back in its own key with the other key null. Pass page.nextCursor as cursor, with the same \`assignments\` and \`termIds\`, until page.hasMore is false, then repeat with the other kind. \`members\` is returned on the first page only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "netIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 200,
        "description": "NetIDs to resolve. Unknown ones are simply absent from \`members\`."
      },
      "termIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 60,
        "description": "Terms to read assignments for."
      },
      "assignments": {
        "type": "string",
        "enum": [
          "project",
          "core"
        ],
        "description": "Which assignments to page: project (default) or core."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "list_project_chart_strings",
  "description": "Read a project's payroll chart strings for one term or all terms, including superseded history. Returns both the project's own entries and the effective string per term — what payroll charges — which may be inherited from the lab-wide default, or be the lab's built-in projects GL when no default is recorded. Core-only; chart strings are deliberately absent from \`get_project_settings\`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Project.id, as returned by \`list_projects\` or \`list_my_projects\`."
      },
      "termCode": {
        "type": "string",
        "description": "Limit to one term, e.g. '26F'. Omit for every term on record."
      },
      "includeSuperseded": {
        "type": "boolean",
        "description": "Include rows replaced by a later one. Default false (current rows only)."
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "set_project_chart_string",
  "description": "Record a payroll chart string for a project and term. Appends a new row and marks any existing current row for that project/term superseded — nothing is edited in place, so the history is the audit trail. Validates the string's format (GL or PTAEO) and rejects malformed values. Core-only, and requires the \`mcp:admin\` scope.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Project.id. Required and explicit: resolving a project from an award title is the caller's job, not this tool's — a payroll identifier should not be written off a fuzzy name match."
      },
      "termCode": {
        "type": "string",
        "minLength": 1,
        "description": "Term this string applies to, e.g. '26F'. One row per term."
      },
      "chartString": {
        "type": "string",
        "minLength": 1,
        "description": "The chart string as received. GL is entity.org.funding.activity.subactivity; PTAEO is project.task.award.expenditureType.org, where XXXXX in the expenditure type is expected and correct."
      },
      "fundingType": {
        "type": "string",
        "enum": [
          "DALI_GL",
          "TRANSFER_GL",
          "DALI_PTAEO",
          "OTHER_PTAEO"
        ],
        "description": "How the work is paid for — the lab's four project types. DALI_GL (lab money on the GL), TRANSFER_GL (DALI fronts it and invoices, revenue transfers back), DALI_PTAEO (our own sponsored award), OTHER_PTAEO (someone else's award). Omit if not known."
      },
      "fpNumber": {
        "type": "string",
        "description": "RAPPORT FP, e.g. FP00014787."
      },
      "awardId": {
        "type": "string",
        "description": "RAPPORT award, e.g. AWD00013615."
      },
      "rapportName": {
        "type": "string",
        "description": "The award's title in RAPPORT, which is rarely identical to the DALI OS project name. Stored as provenance."
      },
      "awardStart": {
        "type": "string",
        "description": "Award start date (ISO)."
      },
      "awardEnd": {
        "type": "string",
        "description": "Award end date (ISO)."
      },
      "supersedeReason": {
        "type": "string",
        "description": "Why this replaces the previous row, e.g. 'advance -> funded award'."
      },
      "note": {
        "type": "string",
        "description": "Free-text note."
      }
    },
    "required": [
      "projectId",
      "termCode",
      "chartString"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "update_project",
  "description": "Edit a project's settings. Writable fields: name, status (Active/Paused/Archived), iconEmoji, description, imageUrl, isPrivate, calendarEmail, repoUrls, deploymentUrl, termCount, githubTeamSlug, slackChannelName. Requires Core or project-member access; status and isPrivate are Core only. Pairs with \`get_project_settings\` which reads these same fields.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Project.id to update."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Display name."
      },
      "status": {
        "type": "string",
        "enum": [
          "Active",
          "Paused",
          "Archived"
        ],
        "description": "Project lifecycle status."
      },
      "iconEmoji": {
        "type": "string",
        "description": "Single emoji icon. Pass an empty string to clear."
      },
      "description": {
        "type": "string",
        "description": "Short plain-text description. Pass an empty string to clear."
      },
      "imageUrl": {
        "type": "string",
        "description": "Banner image URL. Pass an empty string to clear."
      },
      "isPrivate": {
        "type": "boolean",
        "description": "When true the project is hidden from non-members."
      },
      "calendarEmail": {
        "type": "string",
        "description": "Google Calendar email for the project. Pass an empty string to clear."
      },
      "repoUrls": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "GitHub repo URLs / slugs (one per entry). Replaces the full list."
      },
      "deploymentUrl": {
        "type": "string",
        "description": "Live deployment URL. Pass an empty string to clear."
      },
      "termCount": {
        "type": "integer",
        "minimum": 1,
        "description": "Planned number of terms for this project."
      },
      "githubTeamSlug": {
        "type": "string",
        "description": "GitHub team slug (will be normalised to lowercase-hyphenated). Pass an empty string to clear."
      },
      "slackChannelName": {
        "type": "string",
        "description": "Slack channel name (will be normalised to Slack rules). Pass an empty string to clear."
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_task_files",
  "description": "Link or unlink a project file artifact on a task. action: 'link' attaches the file (idempotent); 'unlink' removes the link without deleting the file.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "link",
          "unlink"
        ],
        "description": "'link' or 'unlink'."
      },
      "taskId": {
        "type": "string",
        "minLength": 1,
        "description": "Task.id."
      },
      "fileId": {
        "type": "string",
        "minLength": 1,
        "description": "ProjectFile.id. Must belong to the same project as the task and be live (not archived)."
      }
    },
    "required": [
      "action",
      "taskId",
      "fileId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "set_file_partner_visibility",
  "description": "Set whether a project file is visible in the partner portal. The file must be live (not archived).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "fileId": {
        "type": "string",
        "minLength": 1,
        "description": "ProjectFile.id."
      },
      "partnerVisible": {
        "type": "boolean",
        "description": "true to share with the partner portal, false to hide."
      }
    },
    "required": [
      "fileId",
      "partnerVisible"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_staffing",
  "description": "Manage staffing-board metadata. Actions: set_mentor_role (mark a user as mentor/non-mentor), add_external_mentor / remove_external_mentor (external mentor entries on a project), add_board_member / remove_board_member (who appears on the board). Staffing managers only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "set_mentor_role",
          "add_external_mentor",
          "remove_external_mentor",
          "add_board_member",
          "remove_board_member"
        ]
      },
      "cycleId": {
        "type": "string",
        "minLength": 1,
        "description": "StaffingCycle.id."
      },
      "userId": {
        "type": "string",
        "minLength": 1,
        "description": "User.id (for set_mentor_role, add/remove_board_member)."
      },
      "isMentor": {
        "type": "boolean",
        "description": "For set_mentor_role: true to mark as mentor, false to override as non-mentor."
      },
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Project.id (for add/remove_external_mentor)."
      },
      "domainId": {
        "type": "string",
        "minLength": 1,
        "description": "Domain.id (for add_external_mentor)."
      },
      "externalMentorId": {
        "type": "string",
        "minLength": 1,
        "description": "ExternalMentor.id (for remove_external_mentor)."
      }
    },
    "required": [
      "action",
      "cycleId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "finalize_staffing",
  "description": "HIGH-BLAST: Confirm proposed staffing assignments for one project and optionally provision their Slack channel, GitHub team, and Google Group. Each automation step reports its own outcome. Idempotent — safe to re-run. Staffing managers only (mcp:admin). automations: any subset of ['assignments','slack','gmail','github']. Pass saveFieldsOnly: true to persist channel/slug fields without running any automations.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "cycleId": {
        "type": "string",
        "minLength": 1,
        "description": "StaffingCycle.id."
      },
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Project.id to finalize."
      },
      "automations": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "assignments",
            "slack",
            "gmail",
            "github"
          ]
        },
        "description": "Subset of automations to run."
      },
      "slackChannel": {
        "type": "string",
        "description": "Optional Slack channel name override. Persisted and used if provided."
      },
      "githubTeamSlug": {
        "type": "string",
        "description": "Optional GitHub team slug override. Persisted and used if provided."
      },
      "saveFieldsOnly": {
        "type": "boolean",
        "description": "When true, persist slackChannel/githubTeamSlug without running automations."
      },
      "promoteMentors": {
        "type": "boolean",
        "description": "When true, promote override-mentors below P3 to P3 during assignments step."
      }
    },
    "required": [
      "cycleId",
      "projectId",
      "automations"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "correct_assignment_level",
  "description": "Core-only post-finalize correction for a ProjectAssignment.level. Guards: target level must be within DomainEligibility ceiling; demotion is blocked while the member is mentoring active mentees on the same (project, term, domain). Use the eligibility editor for promotions, this for fixing mistakes. Core only (mcp:admin).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "assignmentId": {
        "type": "string",
        "minLength": 1,
        "description": "ProjectAssignment.id to correct."
      },
      "level": {
        "type": "string",
        "enum": [
          "P1",
          "P2",
          "P3"
        ],
        "description": "Target level: P1, P2, or P3."
      }
    },
    "required": [
      "assignmentId",
      "level"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "archive_done_tasks",
  "description": "Immediately archive every live Done/Cancelled task on a project (no idle-age threshold). Mirrors the board's 'Archive done tasks' button. Returns the count of tasks archived. Requires Core or project-member access.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_archived_tasks",
  "description": "List archived (Done/Cancelled) tasks on a project, newest-archived first. These tasks no longer appear on the active board. Use \`archive_done_tasks\` to move live Done/Cancelled tasks to the archive. Pass page.nextCursor as cursor to read older archived tasks until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_project_file",
  "description": "Rename a project file or append a new version. action must be:\\n- \`rename\`: update the file's display name. Requires: fileId, title.\\n- \`add_version\`: append a new uploaded version. Obtain s3Key via upload_project_file, or via create_project_file_upload for a file over ~9 MB (after its POST succeeds; do not also finalize it). Requires: fileId, s3Key, fileName, contentType, sizeBytes.\\n\\nRequires Core or project-member access. Only project-workspace files are in scope.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "rename",
          "add_version"
        ],
        "description": "'rename' or 'add_version'."
      },
      "fileId": {
        "type": "string",
        "minLength": 1,
        "description": "ProjectFile.id."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "New display name (rename only)."
      },
      "s3Key": {
        "type": "string",
        "minLength": 1,
        "description": "S3 key returned by upload_project_file or create_project_file_upload (add_version only)."
      },
      "fileName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Original file name including extension (add_version only)."
      },
      "contentType": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "MIME type of the file (add_version only)."
      },
      "sizeBytes": {
        "type": "number",
        "minimum": 0,
        "description": "File size in bytes (add_version only)."
      }
    },
    "required": [
      "action",
      "fileId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "get_project_file",
  "description": "Return metadata and signed download URLs for all versions of a project file (newest first). URLs expire in 1 hour. Use list_project_files to discover file ids.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "fileId": {
        "type": "string",
        "minLength": 1,
        "description": "ProjectFile.id."
      }
    },
    "required": [
      "fileId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "create_project_file_upload",
  "description": "Start uploading a file of up to 100 MB to a project, without base64. Returns a presigned S3 POST (uploadUrl + fields) and a ready curl command for a POSIX shell: run it with the local file path, expect HTTP 204, then call finalize_project_file_upload with the returned key to add the file to the project's Files list. To add the upload as a new version of an existing file instead, pass the key to manage_project_file add_version and skip finalize. The link expires after 15 minutes. If you send the POST yourself, send every field before the file part — S3 ignores fields after it. Requires Core or being staffed on the project.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "fileName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "File name including extension, e.g. 'final-deck.pdf'."
      },
      "contentType": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "MIME type. It is signed into the upload: the Content-Type form field must match it exactly (the curl command sends it)."
      },
      "sizeBytes": {
        "type": "number",
        "description": "Optional file size in bytes; a file over 100 MB is refused here instead of after the upload."
      }
    },
    "required": [
      "projectId",
      "fileName",
      "contentType"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "finalize_project_file_upload",
  "description": "Add a file uploaded through create_project_file_upload to the project's Files list. Call it after the POST returned HTTP 204. Size and type are read from storage, not taken from the caller. Calling it again with the same key returns the file already created. Requires Core or being staffed on the project.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "description": "The key returned by create_project_file_upload."
      },
      "fileName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Original file name shown on download. Defaults to the sanitized name in the key."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Display name in the Files list. Defaults to fileName."
      }
    },
    "required": [
      "projectId",
      "key"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "provision_epic_description_doc",
  "description": "Provision (or return) the collab-doc room ID for an epic's rich description. Call this before opening the collab editor for an epic. If the epic has a plain-text description and the doc room is empty, seeds the doc from that text. Returns { descriptionDocId }. Requires Core or project-member access.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "epicId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "epicId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_epic",
  "description": "Manage project epics. Pass \`action\` to select the operation:\\n- \`create\`: create an epic. Requires: projectId, title.\\n- \`update\`: edit an epic's fields (title, description, status, dates, target term). Requires: epicId.\\n- \`delete\`: delete an epic; sprints and tasks have their epicId nulled. Requires: epicId.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "delete"
        ],
        "description": "Operation to perform."
      },
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "maxLength": 5000
      },
      "status": {
        "type": "string",
        "enum": [
          "Backlog",
          "Open",
          "InProgress",
          "Done",
          "Cancelled"
        ]
      },
      "startsAt": {
        "type": "string",
        "description": "Empty string clears."
      },
      "endsAt": {
        "type": "string",
        "description": "Empty string clears."
      },
      "epicId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_story",
  "description": "Manage user stories under epics. Pass \`action\` to select the operation:\\n- \`create\`: create a user story. Requires: epicId, title.\\n- \`update\`: edit a story's title, notes, or status. Requires: storyId.\\n- \`delete\`: delete a user story. Requires: storyId.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "delete"
        ],
        "description": "Operation to perform."
      },
      "epicId": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "notes": {
        "type": "string",
        "maxLength": 5000
      },
      "status": {
        "type": "string",
        "enum": [
          "Todo",
          "InProgress",
          "Done"
        ]
      },
      "storyId": {
        "type": "string",
        "minLength": 1
      },
      "startsAt": {
        "type": "string",
        "description": "Date-only string (YYYY-MM-DD) or empty string to clear. Stored as UTC midnight."
      },
      "endsAt": {
        "type": "string",
        "description": "Date-only string (YYYY-MM-DD) or empty string to clear."
      },
      "priority": {
        "type": "string",
        "enum": [
          "Must",
          "Should",
          "Could",
          "Wont",
          ""
        ],
        "description": "Story priority (Must/Should/Could/Wont). Empty string clears."
      },
      "successMetric": {
        "type": "string",
        "description": "Success metric text. Empty string clears."
      },
      "acceptanceCriteria": {
        "type": "string",
        "description": "Acceptance criteria text. Empty string clears."
      },
      "category": {
        "type": "string",
        "description": "Category label. Empty string clears."
      },
      "dependsOn": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Full replacement set of story ids this story depends on (waits for). Omit to leave unchanged; empty array clears all dependencies."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_time_entry",
  "description": "Manage the authenticated member's time entries (Manual and Meeting). Pass \`action\` to select the operation:\\n- \`add\`: log a manual time entry. Requires: date, hours, assignmentType, roleRefId, startTime, endTime (ISO with offset). Two-step: call without \`confirmed\` first to see a preview, then re-call with \`confirmed: true\`.\\n- \`update\`: change an entry's date, hours, role, note, or time range, including a Meeting entry's role and note. Requires: id. Same two-step confirmation as add.\\n- \`delete\`: delete a time entry. Requires: id. No confirmation gate.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "update",
          "delete"
        ],
        "description": "Operation to perform."
      },
      "date": {
        "type": "string",
        "description": "New date (YYYY-MM-DD)."
      },
      "hours": {
        "type": "number",
        "description": "New hours, > 0 and ≤ 24."
      },
      "assignmentType": {
        "type": "string",
        "enum": [
          "Project",
          "Core",
          "Instructor",
          "DomainLead",
          "Admin",
          "Custom"
        ]
      },
      "roleRefId": {
        "type": "string"
      },
      "note": {
        "type": "string",
        "description": "New note. Pass an empty string to clear it."
      },
      "startTime": {
        "type": "string"
      },
      "endTime": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean",
        "description": "Must be true to write. Call once without it to get a preview, show the user exactly what will be logged (date, hours, role, note), and only pass true once they have agreed or amended it. Never set true on the first call."
      },
      "id": {
        "type": "string",
        "description": "TimeEntry.id from \`list_my_time_entries\`."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_document_sharing",
  "description": "Manage document and file audience/curation. Pass \`action\` to select the operation:\\n- \`set_document_sharing\`: change a document's audience (partner visibility, public write-up, pinned). Requires: pageId.\\n- \`delete_document\`: archive or permanently delete a project document. Requires: pageId.\\n- \`set_file_sharing\`: share a project file with the partner org, or stop sharing it. Requires: fileId, partnerVisible.\\n- \`delete_file\`: archive a project file so it drops out of the Files list. Requires: fileId.\\n- \`share_file\`: share a project file with a member or group. Requires: fileId, principalType, principalId.\\n- \`unshare_file\`: remove a share (ids from list_file_shares). Requires: fileId, shareId.\\n- \`set_file_link_access\`: set who can open the file by link. Requires: fileId, linkAccess.\\n- \`share_page\`: share a document or folder you manage (lab, project or personal) with a member or group. Requires: pageId, principalType, principalId.\\n- \`unshare_page\`: remove a document share (ids from list_page_shares). Requires: pageId, shareId.\\n- \`set_page_general_access\`: set whether everyone in the lab or only people you add can open a document. Requires: pageId, linkAccess.\\n- \`set_folder_access\`: set who can open a folder and everything in it. Private and Group also switch every document inside to only people you add. Requires: pageId, scopeKind (plus scopeGroupId for Group).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "set_document_sharing",
          "delete_document",
          "set_file_sharing",
          "delete_file",
          "share_file",
          "unshare_file",
          "set_file_link_access",
          "share_page",
          "unshare_page",
          "set_page_general_access",
          "set_folder_access"
        ],
        "description": "Operation to perform."
      },
      "pageId": {
        "type": "string",
        "minLength": 1
      },
      "partnerVisible": {
        "type": "boolean"
      },
      "publicVisible": {
        "type": "boolean",
        "description": "Use as the public write-up rendered under the showcase card on dali.website."
      },
      "pinned": {
        "type": "boolean",
        "description": "Pin to the top of the project's Documents block."
      },
      "permanent": {
        "type": "boolean",
        "description": "Delete rather than archive. Irreversible. Defaults to false."
      },
      "fileId": {
        "type": "string",
        "minLength": 1
      },
      "principalType": {
        "type": "string",
        "enum": [
          "User",
          "Group"
        ],
        "description": "share_file / share_page: who the grant is for."
      },
      "principalId": {
        "type": "string",
        "minLength": 1,
        "description": "share_file / share_page: User.id or Group id."
      },
      "permission": {
        "type": "string",
        "enum": [
          "View",
          "Comment",
          "Edit",
          "FullAccess"
        ],
        "description": "share_file / share_page: access level. Defaults to View. FullAccess lets them re-share."
      },
      "shareId": {
        "type": "string",
        "minLength": 1,
        "description": "unshare_file / unshare_page: the share id from list_file_shares or list_page_shares."
      },
      "linkAccess": {
        "type": "string",
        "enum": [
          "Restricted",
          "LabMembers"
        ],
        "description": "set_file_link_access / set_page_general_access: Restricted = only people you add; LabMembers = everyone in the lab."
      },
      "linkPermission": {
        "type": "string",
        "enum": [
          "View",
          "Comment",
          "Edit"
        ],
        "description": "set_file_link_access / set_page_general_access: level for lab members. Defaults to View."
      },
      "scopeKind": {
        "type": "string",
        "enum": [
          "Private",
          "Lab",
          "Group",
          "Inherit"
        ],
        "description": "set_folder_access: Private = only the owner and people named on each document; Lab = every lab member; Group = members of scopeGroupId; Inherit = clear it and follow the parent folder. Private and Group switch every document inside to only people you add."
      },
      "scopeGroupId": {
        "type": "string",
        "minLength": 1,
        "description": "set_folder_access: the group id when scopeKind is Group."
      },
      "scopePermission": {
        "type": "string",
        "enum": [
          "View",
          "Comment",
          "Edit"
        ],
        "description": "set_folder_access: what people in the scope can do. Defaults to View for Lab, Edit otherwise."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_project_template",
  "description": "Manage project templates (Core only). Pass \`action\`:\\n- \`capture\`: save an existing project's structure (epics, user stories, sprints, tasks, checklists) as a reusable template. Requires: projectId, name.\\n- \`list\`: list available project templates.\\n- \`instantiate\`: create a new project pre-populated from a template. Requires: templateId, name.\\n- \`delete\`: delete a project template. Requires: templateId.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "capture",
          "list",
          "instantiate",
          "delete"
        ],
        "description": "Operation to perform."
      },
      "projectId": {
        "type": "string",
        "description": "capture: the source project."
      },
      "templateId": {
        "type": "string",
        "description": "instantiate/delete: the template."
      },
      "name": {
        "type": "string",
        "maxLength": 200,
        "description": "capture: the template name. instantiate: the new project's name."
      },
      "description": {
        "type": "string",
        "maxLength": 2000,
        "description": "capture: optional template description."
      },
      "includeOverviewPage": {
        "type": "boolean",
        "description": "capture: also carry the project's Overview page as a starting doc (default false)."
      },
      "initialTermId": {
        "type": "string",
        "description": "instantiate: optional first term for the new project."
      },
      "partnerOrgId": {
        "type": "string",
        "description": "instantiate: optional partner org to link."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "manage_task",
  "description": "Create and edit project or Core tasks. Pass \`action\`:\\n- \`create\`: file a task at the end of its column. Requires title, plus projectId unless core is true. With no status and no dueAt it goes to Backlog. Optional mirrorToGithubRepo (one of the project's repoUrls) mirrors it to a GitHub issue.\\n- \`update\`: edit title, description, priority, startsAt, dueAt, epicId, storyId, domainId, assigneeUserIds. Requires taskId. Omit a field to keep it; empty string clears it. A task's sprint follows its dates. A story pins its epic.\\n- \`set_status\`: move a task to another column, e.g. Done. Requires taskId, status. Assignees can do this too.\\n- \`set_checklist\`: replace the whole checklist. Requires taskId, items (empty array clears). Assignees can do this too.\\n- \`delete\`: hard-delete a task with its assignees and comments. Requires taskId. Prefer status Cancelled to keep history.\\n- \`link_github\`: mirror a task to a new GitHub issue. Requires taskId, repo (one of the project's repoUrls).\\n- \`unlink_github\`: stop mirroring; the GitHub issue stays. Requires taskId.\\nEverything except set_status and set_checklist needs Core or project-member access.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "set_status",
          "set_checklist",
          "delete",
          "link_github",
          "unlink_github"
        ],
        "description": "Operation to perform."
      },
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Required unless \`core\` is true."
      },
      "core": {
        "type": "boolean",
        "description": "Set true to file the task on the Core taskboard instead of a project. Core members only; projectId is ignored."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": {
        "type": "string",
        "description": "Plain-text / Markdown description. Empty string clears."
      },
      "status": {
        "type": "string",
        "enum": [
          "Backlog",
          "Todo",
          "InProgress",
          "InReview",
          "Done",
          "Cancelled"
        ],
        "description": "set_status: the target column. create: defaults to Todo when dueAt is set, otherwise Backlog."
      },
      "priority": {
        "type": "string",
        "enum": [
          "Low",
          "Normal",
          "High",
          "Urgent"
        ]
      },
      "epicId": {
        "type": "string",
        "description": "Epic link. Empty string = unlinked."
      },
      "storyId": {
        "type": "string",
        "description": "Parent user story. Pins the epic to the story's epic (overrides epicId). Empty string unlinks. A bare epicId change drops a now-orphaned story."
      },
      "domainId": {
        "type": "string",
        "description": "Domain chip. Empty string = no domain."
      },
      "startsAt": {
        "type": "string",
        "description": "Timeline start (ISO timestamp, planning only). Empty string clears."
      },
      "dueAt": {
        "type": "string",
        "description": "ISO timestamp. Empty string clears."
      },
      "assigneeUserIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Full replacement set. Empty array unassigns everyone."
      },
      "mirrorToGithubRepo": {
        "type": "string",
        "description": "If set, mirror this task to a GitHub issue in the given repo (must appear in the project's repoUrls). Empty string disables."
      },
      "taskId": {
        "type": "string",
        "minLength": 1
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "done": {
              "type": "boolean"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "description": "set_checklist: the whole checklist."
      },
      "repo": {
        "type": "string",
        "minLength": 1,
        "description": "owner/repo (or a github.com URL). Must appear in the project's repoUrls."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_members",
  "description": "Browse the DALI member directory. Returns current-term-active members by default. Optionally filter by domain name/code, tier, or a name/email substring. Use \`includeInactive\` to also include alumni and members inactive this term. Pass page.nextCursor as cursor to read the next page until page.hasMore is false; page.total is the full match count.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "q": {
        "type": "string",
        "maxLength": 100,
        "description": "Optional substring to match against name or daliEmail (case-insensitive)."
      },
      "domain": {
        "type": "string",
        "description": "Filter to members with a domain eligibility matching this domain name or code."
      },
      "tier": {
        "type": "string",
        "enum": [
          "admin",
          "core",
          "domain-lead",
          "member"
        ],
        "description": "Filter by role tier."
      },
      "includeInactive": {
        "type": "boolean",
        "description": "If true, also include alumni and members with no current-term assignment. Default false."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Page size (default 50, max 100)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "complete_onboarding_tour",
  "description": "Mark the authenticated member's onboarding tour as completed. Safe to call even if the tour is already complete — it is a no-op in that case.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "set_activity_visibility",
  "description": "Control whether your activity (online presence) is visible to other lab members. Pass \`hideActivity: true\` to go invisible; \`false\` to show your status again.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "hideActivity": {
        "type": "boolean",
        "description": "True to hide your activity from others; false to show it."
      }
    },
    "required": [
      "hideActivity"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_journeys",
  "description": "List onboarding journeys (self-paced learning paths per domain) the caller can see: published ones, plus drafts they can edit. Shows each journey's domain, the caller's role (owner, editor or none), whether it has unpublished changes, and the caller's own progress. Filter with \`domain\` (a domain code such as fullstack).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "description": "Domain code, e.g. fullstack or uiux."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_journey",
  "description": "Read one onboarding journey. \`version\` draft (editors only, the default for them) or published. \`detail\` outline (module graph, page titles, counts) or full (page bodies and slide bodies as Markdown, lab files and steps, whiteboard and document labs with their checks, quiz questions with answers; full is editors only). With full, pass \`moduleId\` to expand only that module and keep the others as outline, which keeps a large journey readable one module at a time. Also returns what still blocks publishing.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "journeyId": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "enum": [
          "draft",
          "published"
        ]
      },
      "detail": {
        "type": "string",
        "enum": [
          "outline",
          "full"
        ],
        "description": "Default outline."
      },
      "moduleId": {
        "type": "string",
        "minLength": 1,
        "description": "With detail full: expand only this module. Other modules stay outline."
      }
    },
    "required": [
      "journeyId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_journey",
  "description": "Create and manage onboarding journeys. Actions: create (domain code, optional title/description; starts as a private draft you own, with one Welcome module), update (title, description, recommended), publish (makes the current draft live for learners; fails while publishIssues remain), discard (drops unpublished changes; a never-published journey is deleted, owners only), delete (owners only; removes learner progress too). Core can create in any domain, domain leads in the domains they lead. Edit modules with manage_journey_module, pages with manage_journey_page, slides with manage_journey_slides, labs and quizzes with set_journey_activity, and access with manage_journey_access.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "publish",
          "discard",
          "delete"
        ]
      },
      "journeyId": {
        "type": "string",
        "description": "Required except for create."
      },
      "domain": {
        "type": "string",
        "description": "create: domain code, e.g. fullstack."
      },
      "title": {
        "type": "string",
        "maxLength": 300
      },
      "description": {
        "type": "string",
        "maxLength": 20000
      },
      "recommended": {
        "type": "boolean",
        "description": "Feature it at the top of the domain for new members."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_journey_module",
  "description": "Add, update or delete modules on an onboarding journey's map (saved to the draft). A module unlocks once every module in its dependsOn is finished; modules with no prerequisites are starting points. Actions: add (title, summary, duration like \\"20 min\\"; afterModuleId places it after that module and makes it the prerequisite, or pass dependsOn), update (any of title, summary, duration, position {x,y}), delete (also removes it from other modules' prerequisites), set_prerequisites (moduleId + the full dependsOn list; loops are refused). New modules start with one empty page.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "update",
          "delete",
          "set_prerequisites"
        ]
      },
      "journeyId": {
        "type": "string",
        "minLength": 1
      },
      "moduleId": {
        "type": "string",
        "description": "Required except for add."
      },
      "title": {
        "type": "string",
        "maxLength": 300
      },
      "summary": {
        "type": "string",
        "maxLength": 20000
      },
      "duration": {
        "type": "string",
        "maxLength": 40
      },
      "afterModuleId": {
        "type": "string"
      },
      "dependsOn": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "position": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "action",
      "journeyId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_journey_page",
  "description": "Edit a journey module's lesson pages, which learners read in order. Bodies are Markdown (headings, lists, code blocks, quotes, tables, images, links). Actions: add (title, markdown, optional index), update (pageId + title and/or markdown; markdown replaces the whole body), delete, move (pageId + toIndex). Saved to the draft.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "update",
          "delete",
          "move"
        ]
      },
      "journeyId": {
        "type": "string",
        "minLength": 1
      },
      "moduleId": {
        "type": "string",
        "minLength": 1
      },
      "pageId": {
        "type": "string",
        "description": "Required except for add."
      },
      "title": {
        "type": "string",
        "maxLength": 300
      },
      "markdown": {
        "type": "string",
        "maxLength": 300000
      },
      "index": {
        "type": "number",
        "minimum": 0,
        "description": "add: position, default last."
      },
      "toIndex": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "action",
      "journeyId",
      "moduleId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_journey_slides",
  "description": "Edit a journey module's slide deck, a short click-through shown beside the lesson. Actions: set (replace the whole deck with \`slides\`; an empty list removes it), add (\`slide\`, optional index), update (slideId + \`slide\` fields to change), delete, move (slideId + toIndex). Saved to the draft.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "update",
          "delete",
          "move",
          "set"
        ]
      },
      "journeyId": {
        "type": "string",
        "minLength": 1
      },
      "moduleId": {
        "type": "string",
        "minLength": 1
      },
      "slideId": {
        "type": "string"
      },
      "slide": {
        "type": "object",
        "properties": {
          "layout": {
            "type": "string",
            "enum": [
              "title",
              "content",
              "split",
              "image"
            ],
            "description": "title: big heading + subtitle. content: heading + body. split: heading + body + image. image: full-bleed image with an optional caption (the title)."
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "description": "Heading, or the caption on image slides."
          },
          "subtitle": {
            "type": "string",
            "maxLength": 300,
            "description": "Title layout only."
          },
          "bodyMarkdown": {
            "type": "string",
            "maxLength": 20000,
            "description": "Content and split layouts. Keep it to a few short points."
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 2000,
            "description": "Split and image layouts."
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 300
          },
          "notes": {
            "type": "string",
            "maxLength": 20000,
            "description": "Speaker notes shown under the slide."
          }
        },
        "additionalProperties": false
      },
      "slides": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "layout": {
              "type": "string",
              "enum": [
                "title",
                "content",
                "split",
                "image"
              ],
              "description": "title: big heading + subtitle. content: heading + body. split: heading + body + image. image: full-bleed image with an optional caption (the title)."
            },
            "title": {
              "type": "string",
              "maxLength": 300,
              "description": "Heading, or the caption on image slides."
            },
            "subtitle": {
              "type": "string",
              "maxLength": 300,
              "description": "Title layout only."
            },
            "bodyMarkdown": {
              "type": "string",
              "maxLength": 20000,
              "description": "Content and split layouts. Keep it to a few short points."
            },
            "imageUrl": {
              "type": "string",
              "maxLength": 2000,
              "description": "Split and image layouts."
            },
            "imageAlt": {
              "type": "string",
              "maxLength": 300
            },
            "notes": {
              "type": "string",
              "maxLength": 20000,
              "description": "Speaker notes shown under the slide."
            }
          },
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "index": {
        "type": "number",
        "minimum": 0
      },
      "toIndex": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "action",
      "journeyId",
      "moduleId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "set_journey_activity",
  "description": "Set or remove a journey module's coding lab, whiteboard or document lab, or quiz. Pick it with activity, pass its content in the matching field, or pass remove: true to delete it. Each call replaces that whole activity and saves to the draft. A module has at most one lab, code or studio. code_lab (codeLab): a small web project learners edit in the browser while guided steps check their work. files maps paths to contents and must include index.html (local stylesheets and scripts are inlined; <script type=\\"module\\"> files can import each other, and bare imports load from esm.sh). Each step's check is a JavaScript expression evaluated in the learner's page that is true once the step is done, e.g. document.querySelector('h1')?.textContent.includes('Hello'). studio_lab (studioLab): a whiteboard (kind canvas) or document (kind document) lab for non-code work like critiques, affinity maps and ticket writing. Each criterion is checked automatically (mode auto, with a rule), ticked by the learner (self), or approved by a journey owner or editor after the learner submits (mentor). Automatic rules: item-count {itemType: sticky|text|shape|image|pin|any, color?, min} counts the learner's own board items; hotspots {min} counts hidden problem areas the learner pinned; contains-text {text}; word-count {min}; section {heading, minWords} counts words between a heading containing that text and the next heading; list-items {heading, min} counts list items in that section. Canvas labs take a starter board: items {type: sticky|text|shape|image|pin, x, y, width?, height?, text?, color: yellow|pink|green|blue|purple, src?, alt?, locked?} and hidden hotspots {label, x, y, width, height} learners should pin. Document labs take a starter template in Markdown (use ### headings for the sections rules look for). quiz (quiz): learners must reach passingScore (percent correct) to finish the module, and can retry. multiple-choice questions take options (strings) and correctOption (0-based index); short-answer questions take acceptedAnswers, matched ignoring case, extra spaces and trailing punctuation (leave it empty to accept any response, for reflection questions).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "activity": {
        "type": "string",
        "enum": [
          "code_lab",
          "studio_lab",
          "quiz"
        ]
      },
      "journeyId": {
        "type": "string",
        "minLength": 1
      },
      "moduleId": {
        "type": "string",
        "minLength": 1
      },
      "remove": {
        "type": "boolean"
      },
      "codeLab": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "intro": {
            "type": "string",
            "maxLength": 20000,
            "description": "Wrap text in backticks for inline code."
          },
          "files": {
            "type": "object",
            "description": "Path to file contents."
          },
          "defaultFile": {
            "type": "string",
            "description": "The file learners start in."
          },
          "steps": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "instructions": {
                  "type": "string"
                },
                "hint": {
                  "type": "string"
                },
                "check": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "check"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "files",
          "steps"
        ],
        "additionalProperties": false
      },
      "studioLab": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "canvas",
              "document"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "brief": {
            "type": "string",
            "maxLength": 20000,
            "description": "Plain text. Blank lines separate paragraphs."
          },
          "criteria": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object"
            }
          },
          "canvas": {
            "type": "object",
            "description": "{ items: [...], hotspots: [...] }"
          },
          "documentTemplateMarkdown": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "kind",
          "title",
          "criteria"
        ]
      },
      "quiz": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "intro": {
            "type": "string",
            "maxLength": 20000
          },
          "passingScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Default 80."
          },
          "questions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "multiple-choice",
                    "short-answer"
                  ]
                },
                "prompt": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "correctOption": {
                  "type": "number"
                },
                "acceptedAnswers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "explanation": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "prompt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "questions"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "activity",
      "journeyId",
      "moduleId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_journey_reviews",
  "description": "List learners' whiteboard and document lab submissions on onboarding journeys you own or edit, newest first. status is waiting (the default) or reviewed. Page with page.nextCursor as cursor until page.hasMore is false. Read one with get_journey_review.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "waiting",
          "reviewed"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_journey_review",
  "description": "Read one learner's whiteboard or document lab submission on a journey you own or edit: the work as text, every check's result, and which hidden problem areas they found.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "submissionId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "submissionId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "review_journey_submission",
  "description": "Approve a learner's whiteboard or document lab submission, or send it back. decision is approved or changes-requested. mentorChecks ticks mentor criteria by id ({criterionId: true}); approving needs every mentor criterion ticked, requesting changes needs a note. The learner is notified.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "submissionId": {
        "type": "string",
        "minLength": 1
      },
      "decision": {
        "type": "string",
        "enum": [
          "approved",
          "changes-requested"
        ]
      },
      "note": {
        "type": "string",
        "maxLength": 10000
      },
      "mentorChecks": {
        "type": "object"
      }
    },
    "required": [
      "submissionId",
      "decision"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_journey_access",
  "description": "List who can edit an onboarding journey and their role: owner (edits, publishes, deletes, manages access) or editor (edits and publishes). Also returns your own role.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "journeyId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "journeyId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_journey_access",
  "description": "Change who can edit an onboarding journey. Roles: owner (edits, publishes, deletes, manages access) and editor (edits and publishes). Everyone else can take the journey once it's published. Actions: add (userId or email + role), set_role, remove. Only owners and Core can change access, and the last owner can't be demoted or removed. Returns the updated list; read it without changes with list_journey_access.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "set_role",
          "remove"
        ]
      },
      "journeyId": {
        "type": "string",
        "minLength": 1
      },
      "userId": {
        "type": "string"
      },
      "email": {
        "type": "string",
        "description": "Instead of userId."
      },
      "role": {
        "type": "string",
        "enum": [
          "owner",
          "editor"
        ]
      }
    },
    "required": [
      "action",
      "journeyId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_gallery_posts",
  "description": "Page through the Community gallery feed as the web feed shows it, most recently taken first (takenAt, else when posted): 40 posts a page with a nextCursor for the next one. Filter to your own posts (show 'mine'), to one person's (byUserId), or by words in the caption or the poster's name (query). imageUrl is the feed-sized copy; use get_gallery_post for the full-size image, the original and comments.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "show": {
        "type": "string",
        "enum": [
          "all",
          "mine"
        ]
      },
      "byUserId": {
        "type": "string",
        "minLength": 1
      },
      "query": {
        "type": "string",
        "maxLength": 100
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "description": "nextCursor from the previous page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_gallery_post",
  "description": "One Community gallery post: caption, poster, reactions and comments. imageUrl is the copy the post page shows (at most 2048px); originalUrl downloads the untouched original. Links expire within the hour.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "postId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "postId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "create_gallery_upload",
  "description": "Start posting one photo to the Community gallery. Returns a presigned S3 POST and a curl command for each file you name: the original (PNG, JPEG, WebP or GIF, up to 50 MB, kept untouched for download and print) and, as the web composer makes them, an optional display copy at most 2048px on its long side for the post page and an optional tile 640px wide for the feed. Make the copies yourself (e.g. \`sips -Z 2048\` and \`sips --resampleWidth 640\` on macOS) when the original is larger; without them the feed and post page load the original. Run each curl (expect HTTP 204), then call manage_gallery_post action 'create' with the returned keys and the original's pixel width and height. Links expire after 15 minutes.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "original": {
        "type": "object",
        "description": "The photo as taken.",
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          }
        },
        "required": [
          "fileName",
          "contentType"
        ],
        "additionalProperties": false
      },
      "display": {
        "type": "object",
        "description": "A copy at most 2048px on its long side.",
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          }
        },
        "required": [
          "fileName",
          "contentType"
        ],
        "additionalProperties": false
      },
      "thumb": {
        "type": "object",
        "description": "A copy 640px wide.",
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          }
        },
        "required": [
          "fileName",
          "contentType"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "original"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_gallery_post",
  "description": "Write to the Community gallery, as the web does. Actions: 'create' (posts: up to 10, one per photo, with the keys create_gallery_upload returned); 'delete' (your own post); 'react' (toggle one of ❤️ 🔥 😂 👏 😮 🎉, notifies the poster); 'comment' (body, @handles mention people); 'delete_comment' (yours, or any as Core); 'report' (someone else's post; two reports hide it); 'hide' and 'restore' (Core only; restoring clears its reports).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "delete",
          "react",
          "comment",
          "delete_comment",
          "report",
          "hide",
          "restore"
        ]
      },
      "postId": {
        "type": "string",
        "minLength": 1
      },
      "posts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "imageKey": {
              "type": "string",
              "minLength": 1,
              "description": "The original's key."
            },
            "displayKey": {
              "type": "string",
              "minLength": 1
            },
            "thumbKey": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "description": "The original's width in pixels."
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "description": "The original's height in pixels."
            },
            "color": {
              "type": "string",
              "description": "The photo's average colour as #rrggbb, painted while it loads. Defaults to grey."
            },
            "caption": {
              "type": "string",
              "maxLength": 500
            },
            "takenAt": {
              "type": "string",
              "description": "When the photo was taken, as ISO 8601. Read it from the file's EXIF DateTimeOriginal (e.g. \`mdls -name kMDItemContentCreationDate\` or \`exiftool -DateTimeOriginal\`). The feed sorts by it; without it the post sorts by when it was posted."
            }
          },
          "required": [
            "imageKey",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "emoji": {
        "type": "string",
        "enum": [
          "❤️",
          "🔥",
          "😂",
          "👏",
          "😮",
          "🎉"
        ]
      },
      "body": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "commentId": {
        "type": "string",
        "minLength": 1
      },
      "reason": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "read_help",
  "description": "Read the DALI OS help: how the platform works and how to do things in it (booking rooms, staffing, hiring, Drive, settings and so on). Without a slug, lists the articles you can see (slug, title, summary). With a slug, returns that article in Markdown. Read-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "description": "An article's slug from the list. Omit to list articles."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_core_milestones",
  "description": "List Core's term plan: for each week 0 to 10 of a term, its milestones (lab-wide goals) and plan items (things to do), in order, with owners and notes. Core only. termCode like '26F' defaults to the current term. kind filters to Milestone or Plan.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "termCode": {
        "type": "string",
        "description": "Term code such as 26F. Defaults to the current term."
      },
      "kind": {
        "type": "string",
        "enum": [
          "Milestone",
          "Plan"
        ]
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_core_milestone",
  "description": "Create and manage Core milestones and plan items. Core only. Actions: create (termId, week 0-10, title; optional kind, notes, ownerIds), update (id; optional title, notes, ownerIds, kind; an empty title deletes), move (id, toWeek; optional toPosition), delete (id), fill_from_last_year (termId; copies last year's same-season term into weeks that have no items). Owners must be Core members for that term; no owners means the whole lab.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "move",
          "delete",
          "fill_from_last_year"
        ]
      },
      "id": {
        "type": "string"
      },
      "termId": {
        "type": "string"
      },
      "week": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "toWeek": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "toPosition": {
        "type": "integer",
        "minimum": 0
      },
      "kind": {
        "type": "string",
        "enum": [
          "Milestone",
          "Plan"
        ]
      },
      "title": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "ownerIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}"
`;
