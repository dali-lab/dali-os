// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MCP registered tool definitions > keeps every tool name, description, scope and input schema stable 1`] = `
"{
  "name": "whoami",
  "description": "Return the authenticated DALI OS member's identity and role tier.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_my_notifications",
  "description": "Return the authenticated DALI OS member's in-app notifications. By default returns the live inbox (newest 30, with staleness hides). The inbox has no cursor: page.hasMore says older items exist, and history mode reaches them. Pass any of status/kind/q/cursor to switch to history mode: full history, newest first, with open/cleared counts and a \`state\` annotation on each item. In history mode pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "Page size (default 30, max 50)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      },
      "onlyUnread": {
        "type": "boolean",
        "description": "Inbox mode only: if true, only return notifications that have not been read."
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "cleared",
          "all"
        ],
        "description": "History mode: filter by open (unread) or cleared (read). Default \\"all\\"."
      },
      "kind": {
        "type": "string",
        "description": "History mode: filter by NotificationKind (e.g. \\"MeetingInvite\\", \\"SystemAnnouncement\\")."
      },
      "q": {
        "type": "string",
        "description": "History mode: case-insensitive substring match against title and body."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_my_upcoming_meetings",
  "description": "Return meetings the authenticated DALI OS member is invited to or attending in a forward window. Includes scheduled meetings and assigned interviews.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "daysAhead": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "description": "How many days into the future to scan (default 7, max 30)."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "find_mutual_freebusy",
  "description": "Find time slots where all listed participants are mutually free. The authenticated caller is implicitly included.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "participantUserIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 8,
        "description": "User IDs of other participants. Caller is added if not already present. Max 8 total."
      },
      "windowStart": {
        "type": "string",
        "description": "ISO 8601 window start (e.g. 2026-05-14T13:00:00Z)."
      },
      "windowEnd": {
        "type": "string",
        "description": "ISO 8601 window end. Span must be ≤ 7 days."
      },
      "slotMinutes": {
        "type": "integer",
        "enum": [
          15,
          30,
          45,
          60
        ],
        "description": "Minimum slot length in minutes (default 30)."
      }
    },
    "required": [
      "participantUserIds",
      "windowStart",
      "windowEnd"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "search_directory",
  "description": "Search the DALI member directory. Matches against name fragments, daliEmail, netId, domain names, and role titles. Returns current-term-active members by default (set includeInactive to also match alumni / members inactive this term). Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "description": "Search query (≤ 100 chars). Case-insensitive substring match."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "Page size (default 20, max 50)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      },
      "includeInactive": {
        "type": "boolean",
        "description": "If true, also match members with no current-term assignment (alumni / inactive). Defaults to false — mirrors the web directory's current-term filter."
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_member_profile",
  "description": "Get a single member's profile. Publicly visible fields (name, email, domains, roles, projects, achievements) are returned for any member. Private fields (personalEmail, netId, phone, birthday, dietary, timezone, bioDocId) are returned only when looking up your own profile. Education profile (attended courses, taught, CE credits) is returned for self or Core/Admin callers.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "memberId": {
        "type": "string",
        "minLength": 1,
        "description": "The User.id of the member to look up."
      }
    },
    "required": [
      "memberId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "schedule_meeting",
  "description": "Create a meeting. Supports inviting a DALI Group or an explicit user list. Optionally schedule it for a specific start time; otherwise the meeting is created in 'Searching' state. Sends in-app MeetingInvite notifications to participants, and pushes to Google Calendar when the organizer has a linked calendar.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Meeting title (1–200 chars)."
      },
      "durationMinutes": {
        "type": "integer",
        "minimum": 5,
        "maximum": 480,
        "description": "Duration in minutes (5–480)."
      },
      "scopeType": {
        "type": "string",
        "enum": [
          "UserList",
          "Group",
          "None"
        ],
        "description": "How to resolve participants. 'UserList' (default) uses participantUserIds; 'Group' resolves a GroupDefinition; 'None' creates the meeting with no participants (org-wide)."
      },
      "participantUserIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "description": "DALI member User IDs to invite — required when scopeType is 'UserList'. Use \`search_directory\` to look up IDs by name."
      },
      "groupId": {
        "type": "string",
        "minLength": 1,
        "description": "GroupDefinition.id — required when scopeType is 'Group'. Use \`list_groups\` to find available groups."
      },
      "startTime": {
        "type": "string",
        "format": "date-time",
        "description": "Optional ISO 8601 start time. If omitted, the meeting is created in 'Searching' state with no confirmed time."
      },
      "recurrenceRule": {
        "type": "string",
        "maxLength": 500,
        "description": "Optional RFC 5545 RRULE for recurring meetings."
      },
      "roomIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 10,
        "description": "DALI rooms the meeting occupies, from \`list_rooms\`. Requires startTime. Every room must be free for every occurrence, or the meeting isn't created."
      },
      "organizerCalendarLinkId": {
        "type": "string",
        "minLength": 1,
        "description": "Optional UserCalendarLink ID. When provided (and enabled), the meeting is pushed to that external calendar and Gmail invites are sent. Use \`list_my_calendar_links\` to discover available IDs."
      },
      "organizerCalendarId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320,
        "description": "Optional calendar ID within the linked account. Omitted = the account's primary calendar."
      },
      "meetingType": {
        "type": "string",
        "enum": [
          "Team",
          "Partner",
          "Other"
        ],
        "description": "'Team' or 'Partner' require projectId and create a meeting note in that project. 'Other' creates a general meeting note (no project). Omit for meetings without notes."
      },
      "meetingTypeLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Display label for the meeting type — required when meetingType is 'Other'."
      },
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Project.id — required for 'Team' and 'Partner' meeting types."
      },
      "notebook": {
        "type": "object",
        "description": "The notebook the meeting's note files into: { existingId } for a notebook you can edit, or { title, templatePageId? } to create one at the meeting's space. Omit for the default.",
        "properties": {
          "existingId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "templatePageId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "attendanceMode": {
        "type": "string",
        "enum": [
          "Roster",
          "SelfCheckIn"
        ],
        "description": "'Roster' (default): organizer/Core mark attendees. 'SelfCheckIn': attendees self-check-in via QR — Core/Instructor only."
      },
      "isCoreMeeting": {
        "type": "boolean",
        "description": "Legacy. Core is decided by where the meeting's notebook is filed; this only files a project-less note in Core's Meetings folder. Only takes effect when the caller is Core. Defaults to false."
      },
      "addMeet": {
        "type": "boolean",
        "description": "Attach a Google Meet link. Requires an organizerCalendarLinkId (the link is minted on that calendar); ignored otherwise."
      },
      "guestEmails": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "People with no DALI profile, invited by address (e.g. an outside partner). They reach the meeting only through the Google event invite, which requires organizerCalendarLinkId and a startTime."
      }
    },
    "required": [
      "title",
      "durationMinutes"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_my_calendar_links",
  "description": "List the authenticated user's linked external calendars. Use the returned \`id\` as \`organizerCalendarLinkId\` on \`schedule_meeting\` to push the meeting to that calendar (and send Gmail invites). Includes disabled / errored links so the agent can surface broken connections.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "mark_notification_read",
  "description": "Mark one or all of the authenticated member's notifications as read. Pass \`all: true\` to bulk-clear the entire inbox (same as the web \\"mark all read\\" button). For a single notification, \`notificationId\` is required. Meeting invites are not cleared — use \`rsvp_to_notification\` for those. Form todos only clear when their form is submitted, unless you pass \`intent: \\"dismiss\\"\` to force-clear. Pass \`intent: \\"unread\\"\` to re-open a previously cleared notification.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "notificationId": {
        "type": "string",
        "minLength": 1,
        "description": "Notification.id, as returned by \`list_my_notifications\`. Required unless \`all\` is true."
      },
      "all": {
        "type": "boolean",
        "description": "If true, mark ALL eligible notifications read (bulk clear). Ignores \`notificationId\` and \`intent\`."
      },
      "intent": {
        "type": "string",
        "enum": [
          "read",
          "unread",
          "dismiss"
        ],
        "description": "\\"read\\" (default) marks it cleared; \\"unread\\" re-opens a cleared notification; \\"dismiss\\" force-clears a form todo."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "rsvp_to_notification",
  "description": "Respond to a meeting-invite notification (accepted/declined/tentative). Records the RSVP, marks the notification read, and best-effort pushes the response to Google Calendar when the meeting was pushed there.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "notificationId": {
        "type": "string",
        "minLength": 1,
        "description": "Notification.id of a MeetingInvite, from \`list_my_notifications\`."
      },
      "response": {
        "type": "string",
        "enum": [
          "accepted",
          "declined",
          "tentative"
        ],
        "description": "The RSVP response to record."
      }
    },
    "required": [
      "notificationId",
      "response"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_notification_preferences",
  "description": "Return the authenticated member's notification settings for every event type — in-app, desktop banner, Slack DM, and email (Instant/Daily/Weekly/Off) — resolving registry defaults where no explicit preference is saved.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "set_notification_preference",
  "description": "Set the authenticated member's notification channels for one event type. Omitted fields keep their current effective value. Locked in-app events can't be muted; externally-emailed events accept no email setting.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "eventType": {
        "type": "string",
        "enum": [
          "meeting.invite",
          "meeting.reminder",
          "meeting.cancelled",
          "meeting.time_proposed",
          "meeting.record_prompt",
          "meeting.transcript_ready",
          "room.booking_bumped",
          "class.schedule_changed",
          "mentorship.note_reminder",
          "task.due_reminder",
          "task.assigned",
          "task.comment",
          "task.status_changed",
          "task.github_update",
          "project.sprint_closed",
          "collab.comment_reply",
          "file.comment",
          "file.new_version",
          "pagedoc.mention",
          "pagedoc.maintainer_assigned",
          "document.shared_with_you",
          "document.sign_request",
          "document.countersign_request",
          "staffing.assigned",
          "timesheet.due_reminder",
          "hiring.interview_assigned",
          "hiring.interview_cancelled",
          "hiring.fellowship_invite",
          "hiring.core_invite",
          "hiring.core_decision",
          "partner.inquiry_received",
          "partner.meeting_requested",
          "partner.stale",
          "partner.next_step_due",
          "partner.renewal_due",
          "partner.contract_signed",
          "partner.survey_received",
          "partner.referral_received",
          "announcement",
          "listserv",
          "release.published",
          "member.onboarding",
          "member.onboarding.reminder",
          "journey.lab_submitted",
          "journey.lab_reviewed",
          "form.submission",
          "form.reminder",
          "education.announcement",
          "education.decision",
          "education.assignment",
          "education.discussion",
          "education.feedback_request",
          "education.certificate",
          "education.session_reminder",
          "education.grade",
          "education.ce_reminder",
          "member.promotion",
          "blog.submitted",
          "blog.approved",
          "blog.comment",
          "blog.reaction",
          "coffee_chat.invite",
          "coffee_chat.accepted",
          "resume_review.invite",
          "resume_review.accepted",
          "gallery.comment",
          "gallery.reaction",
          "community.event_nearby"
        ],
        "description": "Event type key, as returned by \`list_notification_preferences\`."
      },
      "inApp": {
        "type": "boolean",
        "description": "Show in the in-app notification bell."
      },
      "desktop": {
        "type": "boolean",
        "description": "Raise a native banner in the DALI OS desktop app (applies when in-app is on)."
      },
      "slackDm": {
        "type": "boolean",
        "description": "Send a Slack DM."
      },
      "email": {
        "type": "string",
        "enum": [
          "Instant",
          "Daily",
          "Weekly",
          "Off"
        ],
        "description": "Instant email, Daily/Weekly digest, or Off."
      }
    },
    "required": [
      "eventType"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "cancel_meeting",
  "description": "Cancel a meeting the authenticated member organizes. Only the organizer may cancel. Idempotent — cancelling an already-cancelled meeting returns alreadyCancelled=true.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "ScheduledMeeting.id, as returned by \`list_my_upcoming_meetings\` or \`schedule_meeting\`."
      }
    },
    "required": [
      "meetingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_groups",
  "description": "List all lab groups (Static and Dynamic). Returns each group's id, name, type, and memberCount, plus memberIds when includeMemberIds is true. Pass page.nextCursor as cursor to read the next page until page.hasMore is false. Pair with the free-busy / schedule tools to schedule a meeting with a group's members.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "includeArchived": {
        "type": "boolean",
        "description": "If true, also return groups whose bound terms have ended or that were manually archived (default false)."
      },
      "includeMemberIds": {
        "type": "boolean",
        "description": "If true, each group also carries memberIds (default false). Use a small limit with it, since rosters can be long."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_my_projects",
  "description": "List projects the authenticated DALI OS member is staffed on. Past-term assignments stay visible (matches in-app access). Each row includes the current-term role/domain (if assigned this term), the current sprint, and open task count.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "currentTermOnly": {
        "type": "boolean",
        "description": "If true, only return projects the member is staffed on for the current term (default false — past assignments included, matching project workspace access)."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_projects",
  "description": "List every project in the lab (id, name, status, terms, partner orgs): the full directory, not just the caller's assignments. Use list_my_projects for staffed-on detail; get_project_overview to drill into one. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "description": "Restrict to these statuses. Default: all (Active, Paused, Archived).",
        "type": "array",
        "items": {
          "enum": [
            "Active",
            "Paused",
            "Archived"
          ],
          "type": "string"
        },
        "maxItems": 3
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_terms",
  "description": "List all lab terms chronologically (id, code like '26X', year, season, start/end dates). isCurrent marks the active term (rolls forward to the next term during inter-term gaps). Read-only.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_project_overview",
  "description": "Get a Project's overview: status, current-term roster, active sprint, current epic, task counts by status. Read-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Project.id, as returned by \`list_my_projects\`."
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_my_tasks",
  "description": "List project tasks the authenticated DALI OS member is assigned to. Defaults to open work (excludes Done and Cancelled). Filter by status or projectId. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Backlog",
            "Todo",
            "InProgress",
            "InReview",
            "Done",
            "Cancelled"
          ]
        },
        "maxItems": 6,
        "description": "Restrict to these task statuses. Default ['Todo','InProgress','InReview'] — pass explicit list to include Done/Cancelled."
      },
      "projectId": {
        "type": "string",
        "minLength": 1,
        "description": "Restrict to a single project."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Page size (default 50, max 100)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_task",
  "description": "Get a task's full detail: description, checklist, comments, assignees, GitHub link, linked files. Read-only. Comments are the newest page, shown oldest first, with commentCount as the total. When commentsPage.hasMore is true, pass commentsPage.nextCursor as cursor (with the same limit) to read the next older comments.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "minLength": 1,
        "description": "Task.id, as returned by \`list_my_tasks\` or the board/backlog resources."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "taskId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "create_project",
  "description": "Create a project. Requires Core or Admin access. Optionally seeds the planned term set, declared domains, per-(domain, term) challenges, and a partner org. Term and domain ids come from list_terms and the domains reference (use list_projects on an existing project to see the shape). Returns the new project's id.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "description": "Short plain-text blurb. Omit or empty string for none."
      },
      "iconEmoji": {
        "type": "string",
        "description": "Single emoji shown before the project name."
      },
      "status": {
        "type": "string",
        "enum": [
          "Active",
          "Paused",
          "Archived"
        ],
        "description": "Defaults to 'Active'."
      },
      "termIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Terms this project runs. The start term is derived as the earliest of these."
      },
      "domainIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Declared domains. Must be active domains."
      },
      "challenges": {
        "type": "array",
        "description": "Per-(domain, term) challenge text. Each domainId must be in domainIds and each termId in termIds.",
        "items": {
          "type": "object",
          "properties": {
            "domainId": {
              "type": "string",
              "minLength": 1
            },
            "termId": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "domainId",
            "termId",
            "scope"
          ],
          "additionalProperties": false
        }
      },
      "partnerOrgId": {
        "type": "string",
        "description": "Optional partner org to link up front."
      },
      "termCount": {
        "type": "integer",
        "minimum": 1,
        "description": "Expected span in terms. Defaults to the number of termIds given (min 1)."
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "add_task_comment",
  "description": "Append a comment to a project task. Allowed for anyone with project edit access (Core or staffed on the project — the same gate the web comment box uses) and, as self-service, the task's own assignees.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "minLength": 1
      },
      "body": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "required": [
      "taskId",
      "body"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_sprints",
  "description": "List a project's sprints. Sprints are fixed one-week bands anchored to each term the project runs (Sprint 1..N per term); a task belongs to a sprint by its dates rather than an assignment. Read-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_epics",
  "description": "List a project's epics with their user stories. Ordered by position. Pass page.nextCursor as cursor to read the next page of epics until page.hasMore is false. Each epic carries all of its stories.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Backlog",
            "Open",
            "InProgress",
            "Done",
            "Cancelled"
          ]
        },
        "maxItems": 5
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_project_pages",
  "description": "List the page tree for a project's workspace (overview, PRD, retros, free-form docs). Excludes archived pages. Each top-level page carries its whole subtree. Pass page.nextCursor as cursor to read the next page of top-level pages until page.hasMore is false; page.total counts top-level pages. Includes the project's Overview and PRD page ids on the project itself.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "includeArchived": {
        "type": "boolean"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "read_page",
  "description": "Read a workspace page's content as Markdown (headings, lists, check lists, quotes, code, tables, images). Lossy for editor-only blocks (callouts/toggles flatten). Member mentions read as [@handle](/members/<userId>), page mentions as [Title](/documents/<pageId>) and task mentions as [Title](/projects/<projectId>?tab=progress&task=<taskId>); all three round-trip through set_page_content. To change part of a page, use outline_content and edit_content (when available) rather than rewriting it. Long pages come back in chunks of limit characters (default 50000, max 200000): pass page.nextCursor as cursor until page.hasMore is false. page.total is the full Markdown length.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200000,
        "description": "Page size (default 50000, max 200000)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "pageId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "create_page",
  "description": "Create a page in a project's workspace: a FreeForm document (optionally with Markdown content) or a Folder. Documents can nest under a top-level Folder; folders can't nest. Requires Core or being staffed on the project.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "kind": {
        "type": "string",
        "enum": [
          "FreeForm",
          "Folder"
        ],
        "description": "Default 'FreeForm' (a document). 'Folder' creates a container page."
      },
      "parentPageId": {
        "type": "string",
        "description": "Optional. Nest under this top-level Folder page (FreeForm only)."
      },
      "content": {
        "type": "string",
        "maxLength": 300000,
        "description": "Optional initial body as Markdown (FreeForm only), same dialect as set_page_content: mention a member as [@handle](/members/<userId>), not @Name. Unknown ids are written as plain text and listed in warnings."
      },
      "fromTemplatePageId": {
        "type": "string",
        "description": "Optional. Create the document by duplicating this template page's content (a Lab page marked as a template). Mutually exclusive with 'content'; FreeForm only."
      },
      "iconEmoji": {
        "type": "string",
        "maxLength": 8
      }
    },
    "required": [
      "projectId",
      "title"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "set_page_content",
  "description": "Replace a page's body with content rendered from Markdown (headings, lists, quotes, code blocks, links, bold/italic/strike, and images via ![alt](src) — use upload_project_file with purpose 'pageImage' to get a src). ![title](youtube url) adds a video player. Works for Project, Lab, and personal-note (Member) workspace pages. OVERWRITES the existing body. To change part of an existing page, use edit_content instead (when available); otherwise read_page first to preserve content. Mention a member as [@handle](/members/<userId>) (not @Name), a page as [Title](/documents/<pageId>) and a task as [Title](/projects/<projectId>?tab=progress&task=<taskId>); an id that is unknown (or not a lab member, or a task outside the named project) is written as plain text and listed in warnings. The old body remains restorable from the page's version history. Requires edit access on the page (Core, staffed on the project, or page owner).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "minLength": 1
      },
      "markdown": {
        "type": "string",
        "maxLength": 300000,
        "description": "New page body as Markdown. Empty string clears the page."
      }
    },
    "required": [
      "pageId",
      "markdown"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_project_files",
  "description": "List files uploaded to a project (current version metadata). Excludes archived files unless includeArchived is true. Most recently updated first. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "includeArchived": {
        "type": "boolean"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "projectId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "upload_project_file",
  "description": "Upload a file to a project from base64 content (max ~9 MB decoded). purpose \\"file\\" (default) adds it to the project's Files list; \\"pageImage\\" uploads an image for embedding in page bodies via set_page_content — use the returned src in ![alt](src). For a larger file, or one on disk you can reach with a shell, use create_project_file_upload instead (up to 100 MB, no base64). Requires Core or being staffed on the project.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1
      },
      "fileName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "contentType": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "base64": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000000
      },
      "purpose": {
        "type": "string",
        "enum": [
          "file",
          "pageImage"
        ],
        "description": "Default 'file'. 'pageImage' requires an image/* contentType."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Display name in the Files list (purpose 'file' only). Defaults to fileName."
      }
    },
    "required": [
      "projectId",
      "fileName",
      "contentType",
      "base64"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_my_roles",
  "description": "List the authenticated member's paid roles for the current term, each with the assignmentType and roleRefId needed to attribute a time entry or a work block. Call this before adding time.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "allTerms": {
        "type": "boolean",
        "description": "Include roles from every term rather than just the current one. Defaults to false."
