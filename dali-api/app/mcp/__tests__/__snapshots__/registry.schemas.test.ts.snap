      "color": {
        "type": "string",
        "maxLength": 32,
        "description": "Optional color string for create."
      },
      "tagId": {
        "type": "string",
        "description": "Required for archive."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:admin"
}
{
  "name": "apply_doc_tag",
  "description": "Add or remove a tag on a document (Page) or project file. Core only. op 'add' is idempotent; 'remove' is a no-op if the tag isn't applied.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "targetType": {
        "type": "string",
        "enum": [
          "doc",
          "file"
        ]
      },
      "targetId": {
        "type": "string",
        "minLength": 1
      },
      "tagId": {
        "type": "string",
        "minLength": 1
      },
      "op": {
        "type": "string",
        "enum": [
          "add",
          "remove"
        ]
      }
    },
    "required": [
      "targetType",
      "targetId",
      "tagId",
      "op"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_collab_versions",
  "description": "List version history snapshots for a collaborative document. Access is gated by the doc's own permission model. Returns versions newest-first with a short plain-text preview. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "docName": {
        "type": "string",
        "minLength": 1,
        "description": "The collab room name (e.g. 'doc:{pageId}:body', 'task:{taskId}:description'). Use read_page to find a page's doc name."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "docName"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_collab_version",
  "description": "Get the plain-text content of a specific collab document version snapshot. Long versions come back in chunks of limit characters (default 50000, max 200000): pass page.nextCursor as cursor until page.hasMore is false. page.total is the full length.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "versionId": {
        "type": "string",
        "minLength": 1,
        "description": "Version ID from list_collab_versions."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200000,
        "description": "Page size (default 50000, max 200000)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "versionId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "restore_collab_version",
  "description": "Restore a collaborative document to a previous version snapshot. Reuses the server-side collab pipeline (restoreVersion) so the Y.Doc clone rule is respected and open editors receive the change via websocket. Requires edit access on the document.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "versionId": {
        "type": "string",
        "minLength": 1,
        "description": "Version ID to restore."
      }
    },
    "required": [
      "versionId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "name_collab_version",
  "description": "Set or clear a human-readable label on a collab document version snapshot (e.g. 'Before Q3 review'). An empty string clears the label. Requires at least view access on the document.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "versionId": {
        "type": "string",
        "minLength": 1,
        "description": "Version ID to label."
      },
      "label": {
        "type": "string",
        "maxLength": 200,
        "description": "Label text. Empty string clears the label."
      }
    },
    "required": [
      "versionId",
      "label"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_comment",
  "description": "Create, edit, react, unreact, or delete a comment on a document (Page), project file, or page-doc. Permissions mirror the web: creating/reacting requires comment access; editing is author-only; deleting a file comment requires Core.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "edit",
          "react",
          "unreact",
          "delete"
        ]
      },
      "targetType": {
        "type": "string",
        "enum": [
          "doc",
          "file",
          "pagedoc"
        ],
        "description": "Required for 'create'."
      },
      "targetId": {
        "type": "string",
        "description": "Required for 'create'."
      },
      "body": {
        "type": "string",
        "maxLength": 5000,
        "description": "Required for 'create' and 'edit'."
      },
      "parentId": {
        "type": "string",
        "description": "For 'create': reply to an existing comment."
      },
      "anchor": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "slide",
              "blocknote"
            ]
          },
          "slideId": {
            "type": "string"
          },
          "elementId": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "description": "For 'create' on doc targets: an inline marker ({kind: 'blocknote'}), or on a slide deck a pin ({kind: 'slide', slideId, elementId?, x?, y?} with x and y as 0-1 fractions of the slide)."
      },
      "versionId": {
        "type": "string",
        "description": "For 'create' on file targets: pin to a file version."
      },
      "commentId": {
        "type": "string",
        "description": "Required for all actions except 'create'."
      },
      "emoji": {
        "type": "string",
        "maxLength": 64,
        "description": "Required for 'react'/'unreact'."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_page",
  "description": "Manage a page: update (rename, set icon, archive or restore a project page), set_visibility (share a project page with the partner portal, or make it the public write-up), pin/unpin, move/reorder, duplicate, favorite/unfavorite, toggle template status, or update typography display settings. Permissions mirror the web (update and set_visibility require Core or being staffed on the project; pin requires project-edit or lab-member; move requires manage access; duplicate/set_template requires edit access; favorite requires view access; typography requires edit access on a FreeForm page).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "update",
          "set_visibility",
          "pin",
          "move",
          "duplicate",
          "favorite",
          "set_template",
          "typography"
        ]
      },
      "pageId": {
        "type": "string",
        "minLength": 1,
        "description": "Required for all actions."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "For 'update': new title."
      },
      "iconEmoji": {
        "type": "string",
        "maxLength": 8,
        "description": "For 'update': empty string clears the icon."
      },
      "archived": {
        "type": "boolean",
        "description": "For 'update': true archives (soft-deletes) the page, false restores it."
      },
      "audience": {
        "type": "string",
        "enum": [
          "partner",
          "public"
        ],
        "description": "For 'set_visibility': 'partner' shares the page with the partner portal; 'public' makes it the public write-up."
      },
      "visible": {
        "type": "boolean",
        "description": "For 'set_visibility': true to show, false to hide."
      },
      "pinned": {
        "type": "boolean",
        "description": "For 'pin': true to pin, false to unpin."
      },
      "parentPageId": {
        "type": [
          "string",
          "null"
        ],
        "description": "For 'move': target parent folder id, or null for top-level."
      },
      "beforeId": {
        "type": "string",
        "description": "For 'move': place before this sibling's id."
      },
      "workspaceType": {
        "type": "string",
        "enum": [
          "Lab",
          "Project"
        ],
        "description": "For 'move' cross-workspace: destination workspace type."
      },
      "workspaceId": {
        "type": "string",
        "description": "For 'move' to a project: the project id."
      },
      "favorited": {
        "type": "boolean",
        "description": "For 'favorite': true to add, false to remove."
      },
      "isTemplate": {
        "type": "boolean",
        "description": "For 'set_template'."
      },
      "font": {
        "type": "string",
        "enum": [
          "default",
          "serif",
          "mono"
        ],
        "description": "For 'typography': page font family."
      },
      "smallText": {
        "type": "boolean",
        "description": "For 'typography': reduce text size."
      },
      "fullWidth": {
        "type": "boolean",
        "description": "For 'typography': expand to full container width."
      },
      "nestingGuides": {
        "type": "boolean",
        "description": "For 'typography': show nesting indentation guides."
      }
    },
    "required": [
      "action",
      "pageId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "create_slide_deck",
  "description": "Create a lab slide deck from an outline in one step. Each slide has a layoutId, its text by box name in slots (Markdown), speaker notes, and free elements (text, image by URL, shape, chart with data, icon, video, poll, custom HTML) as in manage_slide_elements add_element. A slide can instead be one custom HTML page: give it html (a Blank-layout slide filled by your HTML). Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture. Returns the deck's pageId and every slide with its element ids; edit it afterwards with manage_slide_deck and manage_slide_elements. Needs the live deck editor to be on for you.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "themeId": {
        "type": "string",
        "enum": [
          "dali-dark",
          "dali-light"
        ],
        "description": "Defaults to the standard dark theme."
      },
      "parentPageId": {
        "type": "string",
        "description": "Put the deck inside an existing top-level Lab folder. Omit for the top level."
      },
      "slides": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "layoutId": {
              "type": "string",
              "enum": [
                "title",
                "content",
                "split",
                "image",
                "section",
                "bignumber",
                "blank"
              ],
              "description": "Defaults to 'content'."
            },
            "slots": {
              "type": "object",
              "description": "Text for the layout's boxes, by slot name (title, subtitle, body and so on). Text is Markdown. An image box takes an object { src, alt } instead of text.",
              "additionalProperties": true
            },
            "html": {
              "type": "string",
              "maxLength": 200000,
              "description": "A custom slide: this HTML fills a Blank-layout slide. layoutId and slots are not used with it. Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture."
            },
            "notes": {
              "type": "string",
              "maxLength": 20000,
              "description": "Speaker notes."
            },
            "elements": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "shape",
                      "chart",
                      "icon",
                      "video",
                      "poll",
                      "html"
                    ],
                    "description": "add_element only. Tables and code go in a text element's markdown (a pipe table or a fenced block)."
                  },
                  "shape": {
                    "type": "string",
                    "enum": [
                      "rect",
                      "rounded",
                      "ellipse",
                      "line",
                      "arrow"
                    ],
                    "description": "Shapes: required when adding one."
                  },
                  "fill": {
                    "type": "string",
                    "enum": [
                      "accent",
                      "fg",
                      "muted",
                      "surface",
                      "rule"
                    ],
                    "description": "Shapes: a theme color."
                  },
                  "markdown": {
                    "type": "string",
                    "maxLength": 20000,
                    "description": "Text: the whole text, replacing what is there."
                  },
                  "textStyle": {
                    "type": "string",
                    "enum": [
                      "title",
                      "heading",
                      "body",
                      "kicker",
                      "default"
                    ],
                    "description": "Text: a theme text style. 'default' goes back to the layout's style."
                  },
                  "src": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Images: an http(s) URL or a path on this site. Required when adding one."
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "chart": {
                    "type": "object",
                    "description": "Charts: required when adding one; on update it replaces the chart. Every series needs one value per label.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "bar",
                          "line",
                          "pie"
                        ]
                      },
                      "labels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 60
                        },
                        "minItems": 1,
                        "maxItems": 24
                      },
                      "series": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "maxLength": 60
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "maxItems": 24
                            }
                          },
                          "required": [
                            "name",
                            "values"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "labels",
                      "series"
                    ],
                    "additionalProperties": false
                  },
                  "icon": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "Icons: a lucide icon name such as 'rocket' or 'bar-chart-3'. Required when adding one."
                  },
                  "videoUrl": {
                    "type": "string",
                    "maxLength": 2048,
                    "description": "Videos: a YouTube link. Required when adding one."
                  },
                  "poll": {
                    "type": "object",
                    "description": "Polls: required when adding one. Followers vote while you present.",
                    "properties": {
                      "question": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 80
                        },
                        "minItems": 2,
                        "maxItems": 6
                      },
                      "multi": {
                        "type": "boolean",
                        "description": "Allow several answers."
                      }
                    },
                    "required": [
                      "question",
                      "options"
                    ],
                    "additionalProperties": false
                  },
                  "html": {
                    "type": "string",
                    "maxLength": 200000,
                    "description": "Custom HTML: the source, replacing what is there. Required when adding one. Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture."
                  },
                  "htmlFill": {
                    "type": "boolean",
                    "description": "Custom HTML: cover the whole slide."
                  },
                  "x": {
                    "type": "number",
                    "description": "Left edge on the 1920 by 1080 stage."
                  },
                  "y": {
                    "type": "number",
                    "description": "Top edge on the stage."
                  },
                  "w": {
                    "type": "number",
                    "description": "Width on the stage."
                  },
                  "h": {
                    "type": "number",
                    "description": "Height on the stage."
                  },
                  "rot": {
                    "type": "number",
                    "description": "Rotation in degrees."
                  },
                  "build": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50,
                    "description": "The presenting step it appears at. 0 shows it from the start."
                  },
                  "buildBullets": {
                    "type": "boolean",
                    "description": "Text: show its top-level blocks one per step, the first together with the box."
                  },
                  "buildEffect": {
                    "type": "string",
                    "enum": [
                      "appear",
                      "fade",
                      "rise",
                      "scale"
                    ],
                    "description": "How it enters while presenting. Fade when left out."
                  },
                  "buildAfter": {
                    "type": "boolean",
                    "description": "Its step plays by itself after the previous step instead of waiting for a key press."
                  },
                  "buildDelay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5000,
                    "description": "Milliseconds to wait before an automatic step."
                  }
                },
                "additionalProperties": false
              },
              "description": "Free elements to add to the slide, each as in manage_slide_elements add_element."
            }
          },
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 60,
        "description": "The slides, in order."
      }
    },
    "required": [
      "title",
      "slides"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "get_slide_deck",
  "description": "Read a Drive slide deck. Returns slides in pages of limit: pass page.nextCursor as cursor until page.hasMore is false (page.total is the slide count). Pass elements: true to also get the theme, each slide's layoutId and its elements (text boxes, images, shapes, charts, icons, videos, polls, custom HTML and layout boxes, whose id is their slot name). Pass exportLinks: true to get PDF and PowerPoint download links instead. Edit slides with manage_slide_deck and elements with manage_slide_elements. Version history is list_collab_versions with docName 'slides:{pageId}:deck'.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "minLength": 1,
        "description": "The deck's page id."
      },
      "elements": {
        "type": "boolean",
        "description": "Also return the theme, each slide's layoutId and its elements. A custom HTML element comes back with htmlLength and a short htmlPreview."
      },
      "includeHtml": {
        "type": "boolean",
        "description": "With elements: return each custom HTML element's full source as html instead of the preview."
      },
      "exportLinks": {
        "type": "boolean",
        "description": "Return PDF and PowerPoint download links instead of the slides."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "pageId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_slide_deck",
  "description": "Edit the slides of a Drive slide deck. Actions: set_slides (replace every slide) · add_slide (optional index, else at the end; layoutId for any layout) · add_slides (draft several slides at once from an outline: each has a layoutId, text per box in slots, notes and free elements) · update_slide (fields left out are kept) · delete_slide · move_slide (to toIndex) · duplicate_slide · set_layout · set_theme. Bodies are Markdown, including pipe tables and fenced code blocks. An outline slide with html makes a slide whose content is your own HTML, CSS and script. Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture. Read the deck with get_slide_deck; edit what's on a slide with manage_slide_elements. Create a new deck from an outline with create_slide_deck. set_slides, add_slide, update_slide, delete_slide and move_slide return the whole deck; the others return what they changed.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "set_slides",
          "add_slide",
          "add_slides",
          "update_slide",
          "delete_slide",
          "move_slide",
          "duplicate_slide",
          "set_layout",
          "set_theme"
        ]
      },
      "pageId": {
        "type": "string",
        "minLength": 1,
        "description": "The deck's page id."
      },
      "slides": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "layout": {
              "type": "string",
              "enum": [
                "title",
                "content",
                "split",
                "image"
              ],
              "description": "title: big heading + subtitle. content: heading + body. split: heading + body + image. image: full-bleed image with an optional caption (the title)."
            },
            "title": {
              "type": "string",
              "maxLength": 300,
              "description": "Heading, or the caption on image slides."
            },
            "subtitle": {
              "type": "string",
              "maxLength": 300,
              "description": "Title layout only."
            },
            "bodyMarkdown": {
              "type": "string",
              "maxLength": 20000,
              "description": "Content and split layouts. Keep it to a few short points."
            },
            "imageUrl": {
              "type": "string",
              "maxLength": 2000,
              "description": "Split and image layouts."
            },
            "imageAlt": {
              "type": "string",
              "maxLength": 300
            },
            "notes": {
              "type": "string",
              "maxLength": 20000,
              "description": "Speaker notes shown under the slide."
            }
          },
          "additionalProperties": false
        },
        "maxItems": 300,
        "description": "set_slides: the whole deck, in order."
      },
      "slide": {
        "type": "object",
        "properties": {
          "layout": {
            "type": "string",
            "enum": [
              "title",
              "content",
              "split",
              "image"
            ],
            "description": "title: big heading + subtitle. content: heading + body. split: heading + body + image. image: full-bleed image with an optional caption (the title)."
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "description": "Heading, or the caption on image slides."
          },
          "subtitle": {
            "type": "string",
            "maxLength": 300,
            "description": "Title layout only."
          },
          "bodyMarkdown": {
            "type": "string",
            "maxLength": 20000,
            "description": "Content and split layouts. Keep it to a few short points."
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 2000,
            "description": "Split and image layouts."
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 300
          },
          "notes": {
            "type": "string",
            "maxLength": 20000,
            "description": "Speaker notes shown under the slide."
          }
        },
        "additionalProperties": false,
        "description": "add_slide and update_slide: the slide's fields."
      },
      "slideId": {
        "type": "string",
        "description": "update_slide, delete_slide, move_slide, duplicate_slide and set_layout."
      },
      "index": {
        "type": "number",
        "minimum": 0,
        "description": "add_slide and add_slides: where to insert, 0-based."
      },
      "toIndex": {
        "type": "number",
        "minimum": 0,
        "description": "move_slide: the new 0-based position."
      },
      "outline": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "layoutId": {
              "type": "string",
              "enum": [
                "title",
                "content",
                "split",
                "image",
                "section",
                "bignumber",
                "blank"
              ],
              "description": "Defaults to 'content'."
            },
            "slots": {
              "type": "object",
              "description": "Text for the layout's boxes, by slot name (title, subtitle, body and so on). Text is Markdown. An image box takes an object { src, alt } instead of text.",
              "additionalProperties": true
            },
            "html": {
              "type": "string",
              "maxLength": 200000,
              "description": "A custom slide: this HTML fills a Blank-layout slide. layoutId and slots are not used with it. Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture."
            },
            "notes": {
              "type": "string",
              "maxLength": 20000,
              "description": "Speaker notes."
            },
            "elements": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "shape",
                      "chart",
                      "icon",
                      "video",
                      "poll",
                      "html"
                    ],
                    "description": "add_element only. Tables and code go in a text element's markdown (a pipe table or a fenced block)."
                  },
                  "shape": {
                    "type": "string",
                    "enum": [
                      "rect",
                      "rounded",
                      "ellipse",
                      "line",
                      "arrow"
                    ],
                    "description": "Shapes: required when adding one."
                  },
                  "fill": {
                    "type": "string",
                    "enum": [
                      "accent",
                      "fg",
                      "muted",
                      "surface",
                      "rule"
                    ],
                    "description": "Shapes: a theme color."
                  },
                  "markdown": {
                    "type": "string",
                    "maxLength": 20000,
                    "description": "Text: the whole text, replacing what is there."
                  },
                  "textStyle": {
                    "type": "string",
                    "enum": [
                      "title",
                      "heading",
                      "body",
                      "kicker",
                      "default"
                    ],
                    "description": "Text: a theme text style. 'default' goes back to the layout's style."
                  },
                  "src": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Images: an http(s) URL or a path on this site. Required when adding one."
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "chart": {
                    "type": "object",
                    "description": "Charts: required when adding one; on update it replaces the chart. Every series needs one value per label.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "bar",
                          "line",
                          "pie"
                        ]
                      },
                      "labels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 60
                        },
                        "minItems": 1,
                        "maxItems": 24
                      },
                      "series": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "maxLength": 60
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "maxItems": 24
                            }
                          },
                          "required": [
                            "name",
                            "values"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "labels",
                      "series"
                    ],
                    "additionalProperties": false
                  },
                  "icon": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "Icons: a lucide icon name such as 'rocket' or 'bar-chart-3'. Required when adding one."
                  },
                  "videoUrl": {
                    "type": "string",
                    "maxLength": 2048,
                    "description": "Videos: a YouTube link. Required when adding one."
                  },
                  "poll": {
                    "type": "object",
                    "description": "Polls: required when adding one. Followers vote while you present.",
                    "properties": {
                      "question": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 80
                        },
                        "minItems": 2,
                        "maxItems": 6
                      },
                      "multi": {
                        "type": "boolean",
                        "description": "Allow several answers."
                      }
                    },
                    "required": [
                      "question",
                      "options"
                    ],
                    "additionalProperties": false
                  },
                  "html": {
                    "type": "string",
                    "maxLength": 200000,
                    "description": "Custom HTML: the source, replacing what is there. Required when adding one. Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture."
                  },
                  "htmlFill": {
                    "type": "boolean",
                    "description": "Custom HTML: cover the whole slide."
                  },
                  "x": {
                    "type": "number",
                    "description": "Left edge on the 1920 by 1080 stage."
                  },
                  "y": {
                    "type": "number",
                    "description": "Top edge on the stage."
                  },
                  "w": {
                    "type": "number",
                    "description": "Width on the stage."
                  },
                  "h": {
                    "type": "number",
                    "description": "Height on the stage."
                  },
                  "rot": {
                    "type": "number",
                    "description": "Rotation in degrees."
                  },
                  "build": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50,
                    "description": "The presenting step it appears at. 0 shows it from the start."
                  },
                  "buildBullets": {
                    "type": "boolean",
                    "description": "Text: show its top-level blocks one per step, the first together with the box."
                  },
                  "buildEffect": {
                    "type": "string",
                    "enum": [
                      "appear",
                      "fade",
                      "rise",
                      "scale"
                    ],
                    "description": "How it enters while presenting. Fade when left out."
                  },
                  "buildAfter": {
                    "type": "boolean",
                    "description": "Its step plays by itself after the previous step instead of waiting for a key press."
                  },
                  "buildDelay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5000,
                    "description": "Milliseconds to wait before an automatic step."
                  }
                },
                "additionalProperties": false
              },
              "description": "Free elements to add to the slide, each as in manage_slide_elements add_element."
            }
          },
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 60,
        "description": "add_slides: the slides to add, in order, at index (the end when left out)."
      },
      "themeId": {
        "type": "string",
        "enum": [
          "dali-dark",
          "dali-light"
        ],
        "description": "set_theme."
      },
      "layoutId": {
        "type": "string",
        "enum": [
          "title",
          "content",
          "split",
          "image",
          "section",
          "bignumber",
          "blank"
        ],
        "description": "set_layout, and add_slide for layouts beyond the four in slide.layout."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "action",
      "pageId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_slide_elements",
  "description": "Edit what's on one slide of a Drive slide deck: text boxes, images, shapes, charts (with data), icons, videos, polls, custom HTML and layout boxes. Actions: add_element · update_element (text, style, image, fill, place on the 1920 by 1080 stage, build step; fields left out are kept) · delete_elements · duplicate_elements · reorder_elements · group_elements · ungroup_elements · align_elements · distribute_elements · snap_back (return layout boxes to their layout). Layout boxes have their slot name as id (title, subtitle, body, image); update_element with a slot name sets that box's text. delete_elements removes a layout box only once it is empty (an image box loses its picture first); manage_slide_deck set_layout, snap_back or update_element on its slot name brings it back. Text is Markdown, including pipe tables and fenced code blocks. Custom HTML: kind 'html' with html. Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture. Polls only work while presenting. Get element ids from get_slide_deck with elements: true. Returns the slide it changed.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add_element",
          "update_element",
          "delete_elements",
          "duplicate_elements",
          "reorder_elements",
          "group_elements",
          "ungroup_elements",
          "align_elements",
          "distribute_elements",
          "snap_back"
        ]
      },
      "pageId": {
        "type": "string",
        "minLength": 1,
        "description": "The deck's page id."
      },
      "slideId": {
        "type": "string",
        "description": "The slide to act on."
      },
      "element": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "shape",
              "chart",
              "icon",
              "video",
              "poll",
              "html"
            ],
            "description": "add_element only. Tables and code go in a text element's markdown (a pipe table or a fenced block)."
          },
          "shape": {
            "type": "string",
            "enum": [
              "rect",
              "rounded",
              "ellipse",
              "line",
              "arrow"
            ],
            "description": "Shapes: required when adding one."
          },
          "fill": {
            "type": "string",
            "enum": [
              "accent",
              "fg",
              "muted",
              "surface",
              "rule"
            ],
            "description": "Shapes: a theme color."
          },
          "markdown": {
            "type": "string",
            "maxLength": 20000,
            "description": "Text: the whole text, replacing what is there."
          },
          "textStyle": {
            "type": "string",
            "enum": [
              "title",
              "heading",
              "body",
              "kicker",
              "default"
            ],
            "description": "Text: a theme text style. 'default' goes back to the layout's style."
          },
          "src": {
            "type": "string",
            "maxLength": 2000,
            "description": "Images: an http(s) URL or a path on this site. Required when adding one."
          },
          "alt": {
            "type": "string",
            "maxLength": 300
          },
          "chart": {
            "type": "object",
            "description": "Charts: required when adding one; on update it replaces the chart. Every series needs one value per label.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bar",
                  "line",
                  "pie"
                ]
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 60
                },
                "minItems": 1,
                "maxItems": 24
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 24
                    }
                  },
                  "required": [
                    "name",
                    "values"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "labels",
              "series"
            ],
            "additionalProperties": false
          },
          "icon": {
            "type": "string",
            "maxLength": 60,
            "description": "Icons: a lucide icon name such as 'rocket' or 'bar-chart-3'. Required when adding one."
          },
          "videoUrl": {
            "type": "string",
            "maxLength": 2048,
            "description": "Videos: a YouTube link. Required when adding one."
          },
          "poll": {
            "type": "object",
            "description": "Polls: required when adding one. Followers vote while you present.",
            "properties": {
              "question": {
                "type": "string",
                "maxLength": 200
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                },
                "minItems": 2,
                "maxItems": 6
              },
              "multi": {
                "type": "boolean",
                "description": "Allow several answers."
              }
            },
            "required": [
              "question",
              "options"
            ],
            "additionalProperties": false
          },
          "html": {
            "type": "string",
            "maxLength": 200000,
            "description": "Custom HTML: the source, replacing what is there. Required when adding one. Custom HTML (kind 'html'): html is the page's markup, CSS and script as one string, up to 200000 characters. It runs in a sandboxed frame laid out at the element's w by h in stage units, so 1px of your CSS is one stage unit; a full slide is 1920 by 1080. Set htmlFill: true to cover the whole slide (x, y, w, h are then ignored). Theme CSS variables are set on :root: --slide-accent, --slide-fg, --slide-muted, --slide-surface, --slide-ground, --slide-rule, --slide-font-display, --slide-font-body; html and body have no margin and are 100% tall. Network requests (fetch, XHR, WebSocket, forms) are blocked. Scripts run inline or from cdnjs.cloudflare.com, cdn.jsdelivr.net and unpkg.com only; images load over https or data:. It is not shared live between screens. PDF export prints what the frame shows after it loads; PowerPoint export turns it into a picture."
          },
          "htmlFill": {
            "type": "boolean",
            "description": "Custom HTML: cover the whole slide."
          },
          "x": {
            "type": "number",
            "description": "Left edge on the 1920 by 1080 stage."
          },
          "y": {
            "type": "number",
            "description": "Top edge on the stage."
          },
          "w": {
            "type": "number",
            "description": "Width on the stage."
          },
          "h": {
            "type": "number",
            "description": "Height on the stage."
          },
          "rot": {
            "type": "number",
            "description": "Rotation in degrees."
          },
          "build": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "description": "The presenting step it appears at. 0 shows it from the start."
          },
          "buildBullets": {
            "type": "boolean",
            "description": "Text: show its top-level blocks one per step, the first together with the box."
          },
          "buildEffect": {
            "type": "string",
            "enum": [
              "appear",
              "fade",
              "rise",
              "scale"
            ],
            "description": "How it enters while presenting. Fade when left out."
          },
          "buildAfter": {
            "type": "boolean",
            "description": "Its step plays by itself after the previous step instead of waiting for a key press."
          },
          "buildDelay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Milliseconds to wait before an automatic step."
          }
        },
        "additionalProperties": false,
        "description": "add_element and update_element: the element's fields."
      },
      "elementId": {
        "type": "string",
        "description": "update_element."
      },
      "elementIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "maxItems": 200,
        "description": "The elements the other actions act on. A group id stands for its items."
      },
      "direction": {
        "type": "string",
        "enum": [
          "forward",
          "backward",
          "front",
          "back"
        ],
        "description": "reorder_elements."
      },
      "align": {
        "type": "string",
        "enum": [
          "left",
          "center",
          "right",
          "top",
          "middle",
          "bottom"
        ],
        "description": "align_elements."
      },
      "relativeTo": {
        "type": "string",
        "enum": [
          "slide",
          "selection"
        ],
        "description": "align_elements: defaults to the selection for several elements, the slide for one."
      },
      "axis": {
        "type": "string",
        "enum": [
          "x",
          "y"
        ],
        "description": "distribute_elements: x spaces them across, y down. Needs three or more."
      }
    },
    "required": [
      "action",
      "pageId",
      "slideId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_notebook",
  "description": "Manage meeting notebooks (a notebook holds notes as tabs). Actions: create (an empty notebook), set_template (the template new notes seed from; omit templatePageId to clear), add_page (file a doc or note into a notebook), detach_note (a meeting note becomes a plain doc in the notebook's folder), attach_note (a plain doc becomes the note for one occurrence of a meeting), merge_into (move every tab into another notebook and retire this one), dissolve (tabs become plain docs in the notebook's folder, notebook archived), trash (archive the notebook and its tabs), set_series_notebook (a meeting series' default notebook; omit notebookId to unset). Anyone who can edit a notebook can add to it; series changes and attach_note need the meeting's organizer or Core.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "set_template",
          "add_page",
          "detach_note",
          "attach_note",
          "merge_into",
          "dissolve",
          "trash",
          "set_series_notebook"
        ]
      },
      "notebookId": {
        "type": "string",
        "minLength": 1,
        "description": "The notebook. Required for set_template, add_page, merge_into (the source), dissolve, trash. For set_series_notebook, the notebook to use (omit to unset)."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "For 'create'."
      },
      "workspaceType": {
        "type": "string",
        "enum": [
          "Lab",
          "Project"
        ],
        "description": "For 'create'."
      },
      "workspaceId": {
        "type": "string",
        "description": "For 'create' in a project: the project id."
      },
      "parentPageId": {
        "type": "string",
        "description": "For 'create': the folder to put it in (omit for top level)."
      },
      "templatePageId": {
        "type": "string",
        "description": "For 'create' and 'set_template': a template page (isTemplate). Omit to clear on set_template."
      },
      "pageId": {
        "type": "string",
        "minLength": 1,
        "description": "For add_page, detach_note, attach_note: the doc or note."
      },
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "For attach_note and set_series_notebook: the ScheduledMeeting id."
      },
      "occurrenceStart": {
        "type": "string",
        "description": "For attach_note: ISO start of the occurrence. Omit for the first occurrence."
      },
      "targetId": {
        "type": "string",
        "minLength": 1,
        "description": "For merge_into: the notebook to merge into."
      },
      "scope": {
        "type": "string",
        "enum": [
          "future",
          "all"
        ],
        "description": "For set_series_notebook: future only changes the default; all also moves existing notes in."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_page_templates",
  "description": "List page templates available in a workspace scope: Lab, Project, or Member (the caller's own private templates). Returns FreeForm pages marked as templates that the caller can access. Use the returned id with manage_page action=duplicate to create a page from a template.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspaceType": {
        "type": "string",
        "enum": [
          "Lab",
          "Project",
          "Member"
        ],
        "description": "Workspace scope to list templates for."
      },
      "workspaceId": {
        "type": "string",
        "description": "Required when workspaceType is 'Project'."
      }
    },
    "required": [
      "workspaceType"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "list_drive_trash",
  "description": "List archived (trashed) drive items the caller can access: docs, folders, files, and forms. Pages require at least view access; files require edit access; forms require Core/Admin/Instructor role. Returns items sorted newest-archived first. Only the newest 500 archived rows of each kind (pages, files, forms) are checked, and scanLimited is true when any kind hit that bound, so older items may not appear. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_drive_trash",
  "description": "Restore or permanently purge an archived drive item. Pages require edit access; files require edit-file access; forms require edit access on the form. Purging a form fails if the form is still bound to active hiring or education workflows.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "restore",
          "purge"
        ],
        "description": "'restore' clears archivedAt; 'purge' permanently deletes."
      },
      "type": {
        "type": "string",
        "enum": [
          "doc",
          "folder",
          "file",
          "form"
        ],
        "description": "Item type."
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "description": "Item id."
      }
    },
    "required": [
      "action",
      "type",
      "id"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "move_drive_item",
  "description": "Move a file, form, or email template to a different folder in the Drive (sets folderPageId). Pass destFolderPageId=null to unplace (remove from the folder tree). Agreements and rubrics are auto-filed and cannot be moved here. The caller must have appropriate access to both the item and the destination folder.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "itemType": {
        "type": "string",
        "enum": [
          "file",
          "form"
        ],
        "description": "Type of drive item to move."
      },
      "itemId": {
        "type": "string",
        "minLength": 1,
        "description": "ID of the item to move."
      },
      "destFolderPageId": {
        "type": "string",
        "description": "Target folder Page id. Omit to unplace (remove from the folder tree)."
      }
    },
    "required": [
      "itemType",
      "itemId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "upload_drive_file",
  "description": "Register an already-uploaded S3 file in the Lab or Member (My Drive) scope. The S3 object must exist at the given key (from the presign endpoint). Lab scope requires lab membership; Member scope creates a private file owned by the caller. Optional folderPageId places the file in a Drive folder (requires edit access to that folder). Project-scope files use upload_project_file instead.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "s3Key": {
        "type": "string",
        "minLength": 1,
        "description": "S3 object key (must start with 'uploads/')."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Human-facing file name."
      },
      "fileName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Original client filename shown on download."
      },
      "contentType": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "MIME type."
      },
      "sizeBytes": {
        "type": "number",
        "description": "File size in bytes (non-negative integer)."
      },
      "scope": {
        "type": "string",
        "enum": [
          "Lab",
          "Member"
        ],
        "description": "'Lab' for lab-wide files; 'Member' for personal My Drive files."
      },
      "folderPageId": {
        "type": "string",
        "description": "Optional Drive folder page id to place the file in."
      }
    },
    "required": [
      "s3Key",
      "title",
      "fileName",
      "contentType",
      "sizeBytes",
      "scope"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_blog_posts",
  "description": "List stories (blog posts) on the Resources front page: every published post, the caller's own drafts, and (for an Admin) posts waiting for approval. Returns metadata and an excerpt; use read_blog_post for the body. status is 'draft', 'review' (submitted, waiting on an Admin) or 'published'. visibility 'Public' posts also appear on the DALI website once published. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "review",
          "published"
        ],
        "description": "Only posts in this state. Omit for all of them."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "read_blog_post",
  "description": "Read one story (blog post): its metadata and its body as Markdown. A draft is readable only by its author and Core. Lossy for editor-only blocks, like read_page; member mentions read as [@handle](/members/<userId>), page mentions as [Title](/documents/<pageId>) and task mentions as [Title](/projects/<projectId>?tab=progress&task=<taskId>). Round-trips with manage_blog_post's markdown.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "postId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "postId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_blog_post",
  "description": "Write a story (blog post). Actions: create (a new draft by the caller), update (title/summary/audience/body), publish, unpublish. Only the author and Core can change a post. publish by an Admin publishes it (and approves a post in review); by anyone else it submits the draft to the Admins for review. unpublish returns a published post to a draft, or withdraws one from review. markdown OVERWRITES the whole body (same Markdown as set_page_content: mention a member as [@handle](/members/<userId>), not @Name, a page as [Title](/documents/<pageId>), a task as [Title](/projects/<projectId>?tab=progress&task=<taskId>); unknown ids are written as plain text and come back in warnings); to change part of an existing post, use edit_content with target { type: 'blogPost', id } (when available), otherwise read_blog_post first to preserve content. isPublic also lists the post on the DALI website once published, and only an Admin can change it after a post leaves draft.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "publish",
          "unpublish"
        ]
      },
      "postId": {
        "type": "string",
        "description": "Required for all actions except 'create'."
      },
      "title": {
        "type": "string",
        "maxLength": 300,
        "description": "For create (required) and update."
      },
      "summary": {
        "type": "string",
        "maxLength": 500,
        "description": "For create/update. Shown in listings in place of the excerpt derived from the body. Empty string clears it."
      },
      "isPublic": {
        "type": "boolean",
        "description": "For create/update. Defaults to false (lab only)."
      },
      "markdown": {
        "type": "string",
        "maxLength": 300000,
        "description": "For create/update. The post body as Markdown."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "outline_content",
  "description": "List a page's or blog post's blocks, one row each: id, type, depth, parentId, an 80-character text preview, childCount, table size, hash, and for blocks with children a treeHash covering the block and everything under it. Start here before edit_content: it gives you block ids and the hashes edit_content checks. Then fetch only the blocks you need with get_content_blocks.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "object",
        "description": "The document: { type: 'page', id: pageId } or { type: 'blogPost', id: postId }.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "page",
              "blogPost"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "description": "Page size (default 200, max 1000)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "target"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_content_blocks",
  "description": "Read chosen blocks of a page or blog post, each with its hash (and treeHash when it has children). format 'markdown' (default) returns each block as Markdown, including its children; mentions read as [@Name](/members/<id>), page links as [Title](/documents/<id>). markdownSafe: false means Markdown can't hold that block exactly (callouts, toggles, columns, embeds, signing fields); edit those with JSON (the 'json' field is included for them). format 'json' returns BlockNote JSON for every block. Omit blockIds for every top-level block.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "object",
        "description": "The document: { type: 'page', id: pageId } or { type: 'blogPost', id: postId }.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "page",
              "blogPost"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      },
      "blockIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 100
      },
      "format": {
        "type": "string",
        "enum": [
          "markdown",
          "json"
        ]
      }
    },
    "required": [
      "target"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "edit_content",
  "description": "Edit part of a page or blog post without resending the whole body. Ops apply in order, all or none, live to anyone who has it open (they see your caret and the blocks you touched). Before a delete, replace_all or children replacement the page's current state is saved to version history, so people can restore it. Read block ids and hashes with outline_content / get_content_blocks first; every op on an existing block needs that block's expectedHash, and a stale one fails with BLOCK_CHANGED plus the block's current content and hashes. A block you already changed earlier in the same call needs no new hash.\\nBlocks with children: delete, move, and update with children also need expectedTreeHash (the block's treeHash), so you don't remove or move children someone else just changed.\\nOps:\\nreplace_text {blockId, expectedHash, find, replace}: find must occur exactly once in the block's own text (not in children, not across a mention or line break). The cheapest edit; keeps formatting and comments around it.\\nupdate {blockId, expectedHash, markdown | block}: replace one block's content (markdown must be one block); its children stay unless you pass children.\\ninsert {position, markdown | blocks}: new blocks at position. Leave ids out to get new ones (returned in results); an id that already exists fails with ID_EXISTS, so retrying an insert that went through can't duplicate it.\\ndelete {blockId, expectedHash}: a block and its children.\\nmove {blockId, expectedHash, position}.\\nreplace_all {markdown | blocks}: the whole body; must be the only op.\\nTables: insert_row {blockId, expectedHash, index?, cells: [markdown per cell]} (index omitted appends), delete_row {blockId, expectedHash, index}, set_cell {blockId, expectedHash, row, col, markdown}. Rows and columns count from 0, header row included. Tables with merged cells fail with TABLE_HAS_MERGED_CELLS; update the whole table instead.\\nMarkdown: mentions are [@Name](/members/<userId>), page links [Title](/documents/<pageId>); an unknown id is written as plain text and reported in warnings. Use <br> for a line break in a table cell. JSON blocks use BlockNote's block shape.\\nReturns the new hash (and treeHash) of every block you touched, so a follow-up edit needs no re-read, and seenBy: how many people had it open when your edit landed (null when unknown).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "object",
        "description": "The document: { type: 'page', id: pageId } or { type: 'blogPost', id: postId }.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "page",
              "blogPost"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      },
      "ops": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "replace_text",
                "update",
                "insert",
                "delete",
                "move",
                "replace_all",
                "insert_row",
                "delete_row",
                "set_cell"
              ]
            },
            "blockId": {
              "type": "string"
            },
            "expectedHash": {
              "type": "string"
            },
            "expectedTreeHash": {
              "type": "string"
            },
            "position": {
              "type": "object",
              "description": "Exactly one of: after, before, firstChildOf, lastChildOf (a block id), start: true, end: true.",
              "properties": {
                "after": {
                  "type": "string"
                },
                "before": {
                  "type": "string"
                },
                "firstChildOf": {
                  "type": "string"
                },
                "lastChildOf": {
                  "type": "string"
                },
                "start": {
                  "type": "boolean"
                },
                "end": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "markdown": {
              "type": "string",
              "maxLength": 300000
            },
            "block": {
              "type": "object"
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "find": {
              "type": "string",
              "minLength": 1
            },
            "replace": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "col": {
              "type": "integer",
              "minimum": 0
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "target",
      "ops"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "point_at_content",
  "description": "Put your caret, or a selection, in a page or blog post people have open, to show them what you're looking at or about to change. Changes no content. Everyone with it open sees it under your name and colour for about a minute. blockId comes from outline_content. selectTo selects from the caret to a second point (its blockId defaults to the same block). edit_content already leaves your caret after what it wrote. Returns seenBy: how many people have it open (null when unknown); 0 means nobody saw it.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "object",
        "description": "The document: { type: 'page', id: pageId } or { type: 'blogPost', id: postId }.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "page",
              "blogPost"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      },
      "blockId": {
        "type": "string",
        "minLength": 1
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "Characters into the block's own text (clamped). Wins over at."
      },
      "at": {
        "type": "string",
        "enum": [
          "start",
          "end"
        ],
        "description": "Without offset: 'start' or 'end' (default) of the block's text."
      },
      "selectTo": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Characters into the block's own text (clamped). Wins over at."
          },
          "at": {
            "type": "string",
            "enum": [
              "start",
              "end"
            ],
            "description": "Without offset: 'start' or 'end' (default) of the block's text."
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "target",
      "blockId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_scheduled_meetings",
  "description": "List all meetings the authenticated member organizes or attends. Returns past and future meetings. Newest first. Supports filtering by status and role. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "Searching",
          "Confirmed",
          "Cancelled"
        ],
        "description": "Filter by meeting status. Omit to return all statuses."
      },
      "role": {
        "type": "string",
        "enum": [
          "organizer",
          "participant",
          "any"
        ],
        "description": "Filter by caller's role in the meeting (default: any)."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_meeting_attendance",
  "description": "Get the attendance roster for a scheduled meeting. A recurring meeting keeps a roster per occurrence; pass occurrenceStart to pick one (default: the first). Caller must be the organizer, Core, or a project member for project-scoped meetings.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "ScheduledMeeting.id to fetch attendance for."
      },
      "occurrenceStart": {
        "type": "string",
        "description": "For a recurring meeting, when the occurrence starts (ISO 8601)."
      }
    },
    "required": [
      "meetingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_group_availability",
  "description": "Compute group availability for a set of users over a window of up to 14 days. Returns day-bucketed match windows, busy blocks, and shared working hours, plus per-user free and working-hours intervals. A user who isn't free during a slot that falls outside their working intervals is outside their working hours, not busy.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "userIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "maxItems": 50,
        "description": "User IDs to include (1–50)."
      },
      "weekStartIso": {
        "type": "string",
        "minLength": 1,
        "description": "ISO 8601 start of the window (inclusive)."
      },
      "weekEndIso": {
        "type": "string",
        "minLength": 1,
        "description": "ISO 8601 end of the window (exclusive). Span must be at most 14 days."
      },
      "durationMinutes": {
        "type": "integer",
        "minimum": 5,
        "maximum": 480,
        "description": "Minimum match duration in minutes."
      },
      "timezone": {
        "type": "string",
        "minLength": 1,
        "description": "IANA timezone for day bucketing (e.g. America/New_York)."
      }
    },
    "required": [
      "userIds",
      "weekStartIso",
      "weekEndIso",
      "durationMinutes",
      "timezone"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "optimize_group_meetings",
  "description": "Plan multiple meetings — one per group — over a time window so total attendance is maximized across all of them. Unlike find_mutual_freebusy (single-group overlap), this jointly places every meeting so people who belong to more than one group aren't double-booked, and reports the recommended slot, attendees, double-bookings, and who has no linked calendar. Read-only: create the chosen meetings with schedule_meeting.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "meetings": {
        "type": "array",
        "minItems": 1,
        "maxItems": 15,
        "description": "One entry per meeting to schedule. Give each a groupId, an explicit memberUserIds list, or both.",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Stable identifier for this meeting, echoed in the result and used to name double-booking conflicts. Auto-assigned (m1, m2, …) if omitted."
            },
            "label": {
              "type": "string",
              "maxLength": 200,
              "description": "Human label. Defaults to the group name or the key."
            },
            "groupId": {
              "type": "string",
              "minLength": 1,
              "description": "Existing group; members are resolved automatically."
            },
            "memberUserIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Ad-hoc member userIds. Merged with groupId members if both are given."
            },
            "requiredUserIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Members who MUST be able to attend — slots where any of them is busy are discarded. Added to the member set if not already present."
            },
            "durationMinutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 480,
              "description": "Overrides the top-level durationMinutes for this meeting."
            }
          },
          "additionalProperties": false
        }
      },
      "windowStart": {
        "type": "string",
        "minLength": 1,
        "description": "ISO 8601 start of the scheduling window (inclusive)."
      },
      "windowEnd": {
        "type": "string",
        "minLength": 1,
        "description": "ISO 8601 end of the scheduling window (exclusive). Span must be ≤ 14 days."
      },
      "durationMinutes": {
        "type": "integer",
        "minimum": 5,
        "maximum": 480,
        "description": "Default meeting length in minutes (per-meeting durationMinutes overrides it)."
      },
      "slotMinutes": {
        "type": "integer",
        "enum": [
          15,
          30,
          60
        ],
        "description": "Granularity of candidate start times (default 30)."
      },
      "timezone": {
        "type": "string",
        "minLength": 1,
        "description": "IANA timezone the working-hours band and slot times are expressed in (e.g. America/New_York)."
      },
      "dayStartHour": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23,
        "description": "Earliest local hour a meeting may start (default 9)."
      },
      "dayEndHour": {
        "type": "integer",
        "minimum": 1,
        "maximum": 24,
        "description": "Latest local hour a meeting may end (default 18)."
      },
      "includeWeekends": {
        "type": "boolean",
        "description": "Allow Saturday/Sunday slots (default false)."
      },
      "alternativesPerMeeting": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5,
        "description": "How many runner-up slots to return per meeting (default 3)."
      }
    },
    "required": [
      "meetings",
      "windowStart",
      "windowEnd",
      "durationMinutes",
      "timezone"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_google_calendar_busy",
  "description": "Fetch your own Google Calendar busy blocks for a time range. Returns an empty array if no Google calendar is linked. Every page of events is read, up to 2,500 events per calendar; truncated is true when a calendar had more events than that, so the busy list may be missing some.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "start": {
        "type": "string",
        "minLength": 1,
        "description": "ISO 8601 start of the range (inclusive)."
      },
      "end": {
        "type": "string",
        "minLength": 1,
        "description": "ISO 8601 end of the range (exclusive)."
      }
    },
    "required": [
      "start",
      "end"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "check_in_to_meeting",
  "description": "Self check-in to a meeting with SelfCheckIn attendance mode. Only allowed within ±15 minutes of the meeting window.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "ScheduledMeeting.id to check in to."
      }
    },
    "required": [
      "meetingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "update_profile",
  "description": "Edit your own profile fields. All fields are optional; provide only those you want to change. firstName and lastName must both be non-empty if either is provided. birthday must be YYYY-MM-DD. classYear must be 1900–2100. personalEmail must contain @. Empty string clears a nullable field. bio is a collaborative document and cannot be changed here.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "firstName": {
        "type": "string",
        "minLength": 1,
        "description": "First name. Must be non-empty if provided."
      },
      "lastName": {
        "type": "string",
        "minLength": 1,
        "description": "Last name. Must be non-empty if provided."
      },
      "pronouns": {
        "type": "string",
        "description": "Pronouns (e.g. they/them). Empty string clears."
      },
      "handle": {
        "type": "string",
        "description": "Short profile handle ([a-z0-9_]). Normalized to lowercase. Empty string clears."
      },
      "timezone": {
        "type": "string",
        "description": "IANA timezone (e.g. America/New_York). Must be a valid IANA zone."
      },
      "photoUrl": {
        "type": "string",
        "description": "Profile photo URL. Empty string clears the current photo."
      },
      "classYear": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2100,
        "description": "4-digit graduation year."
      },
      "linkedinUrl": {
        "type": "string",
        "description": "LinkedIn profile URL. Empty string clears."
      },
      "githubUsername": {
        "type": "string",
        "description": "GitHub username. Empty string clears."
      },
      "personalSite": {
        "type": "string",
        "description": "Personal website URL. Empty string clears."
      },
      "major": {
        "type": "string",
        "description": "Field of study / major. Empty string clears."
      },
      "hometown": {
        "type": "string",
        "description": "Hometown. Empty string clears."
      },
      "birthday": {
        "type": "string",
        "description": "Birthday in YYYY-MM-DD format. Empty string clears."
      },
      "dietaryRestrictions": {
        "type": "string",
        "description": "Dietary restrictions / allergies. Empty string clears."
      },
      "phoneNumber": {
        "type": "string",
        "description": "Phone number. Empty string clears."
      },
      "personalEmail": {
        "type": "string",
        "description": "Personal (non-Dartmouth) email. Must contain @. Empty string clears."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "mark_meeting_attendance",
  "description": "Mark a participant present or absent for a meeting. Only meetings with an attendance roster (a type, a notebook, self check-in or invited people) can be marked. Allowed for: the meeting organizer, Core members, or project members of the meeting's project.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "ScheduledMeeting.id."
      },
      "userId": {
        "type": "string",
        "minLength": 1,
        "description": "User.id of the participant to mark."
      },
      "present": {
        "type": "boolean",
        "description": "true = present, false = absent."
      },
      "occurrenceStart": {
        "type": "string",
        "description": "For a recurring meeting, when the occurrence to mark starts (ISO 8601). Omit for a one-off meeting or its first occurrence."
      }
    },
    "required": [
      "meetingId",
      "userId",
      "present"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "get_meeting",
  "description": "Fetch full detail for a scheduled meeting: time, duration, URL, meeting type, Core flag, note page, the attendance roster, and the readable recordings across every occurrence (newest first) with their transcript status, 20 per page (pass page.nextCursor as cursor for older ones until page.hasMore is false; transcriptAvailable covers all of them). A recurring meeting keeps a separate note and roster per occurrence; pass occurrenceStart to pick one (default: the first). Accessible to the organizer, Core members, project members, and any invited attendee.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "ScheduledMeeting.id."
      },
      "occurrenceStart": {
        "type": "string",
        "description": "For a recurring meeting, when the occurrence starts (ISO 8601)."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Page size (default 20, max 100)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "meetingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_meeting_transcript",
  "description": "Fetch the transcript of a finished meeting recording: lines with timestamps and resolved speaker labels (roster name once an editor has renamed a speaker, else You/Others or Speaker N). Paged at 2,000 lines per call by default (set limit for fewer or more, max 5,000); pass page.nextCursor as cursor for the next page until page.hasMore is false. Pass from/to to filter by seconds into the recording. Identify the recording by recordingId, or by meetingId (picks the newest Done recording for that occurrence, or the meeting's newest overall if occurrenceStart is omitted). Same audience as the note: the recording's owner, or anyone who can view the note it belongs to.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "recordingId": {
        "type": "string",
        "minLength": 1,
        "description": "MeetingRecording.id. Alternative to meetingId."
      },
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "ScheduledMeeting.id. Alternative to recordingId."
      },
      "occurrenceStart": {
        "type": "string",
        "description": "With meetingId: which occurrence's recording to use (ISO 8601). Omitted picks the meeting's newest Done recording across all occurrences."
      },
      "from": {
        "type": "number",
        "minimum": 0,
        "description": "Only return lines at or after this many seconds into the recording."
      },
      "to": {
        "type": "number",
        "minimum": 0,
        "description": "Only return lines at or before this many seconds into the recording."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "description": "Page size (default 2000, max 5000)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "enhance_meeting_notes",
  "description": "Preview or apply Enhance for a finished meeting recording (specs/meeting-notes-model.md §2): merges the transcript into the note's typed blocks, citing the moments it drew from, and files Decisions the author missed, and lists action items as suggested tasks under a Tasks heading. Preview (apply omitted/false) regenerates the plan and returns it, verified against the real transcript — call this first. Apply (apply: true) merges the most recently previewed plan into the live note and marks it enhanced; it fails with a 409-equivalent error if someone else re-previewed after you did, meaning you should preview again before retrying. Requires edit access to the note, same as the Enhance button.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "recordingId": {
        "type": "string",
        "minLength": 1,
        "description": "MeetingRecording.id."
      },
      "apply": {
        "type": "boolean",
        "description": "true to merge the previewed plan into the note. Defaults to false (preview only)."
      }
    },
    "required": [
      "recordingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "search_calendar",
  "description": "Search calendar events by text query. Returns matching DALI meetings the caller is invited to, plus Google Calendar events if the caller has a linked calendar. Set scope='all' to search a wide two-year window (default: near the provided date range). Paging walks the DALI meeting matches (local); pass page.nextCursor for the next page. Google events are returned in full on the first page only and come back empty on later pages. googleTruncated is true when a Google calendar had more matches than one call reads.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "q": {
        "type": "string",
        "minLength": 2,
        "description": "Search query (minimum 2 characters)."
      },
      "scope": {
        "type": "string",
        "enum": [
          "near",
          "all"
        ],
        "description": "'near' pads the provided range by 2 weeks (default); 'all' searches a two-year window."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Page size (default 20, max 100)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      },
      "rangeStart": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 start of the view range (defaults to now)."
      },
      "rangeEnd": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 end of the view range (defaults to now)."
      }
    },
    "required": [
      "q"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "manage_class",
  "description": "Add, update, or delete a Dartmouth class for yourself. Classes appear in the DALI calendar. Use 'add' or 'update' with a periodCode (e.g. '2A') for scheduled classes, or omit it and provide customMeetings for irregular schedules. The destination controls where events live — use 'local' for DALI-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "intent": {
        "type": "string",
        "enum": [
          "add",
          "update",
          "delete"
        ],
        "description": "Operation to perform."
      },
      "classId": {
        "type": "string",
        "minLength": 1,
        "description": "MemberClass.id — required for 'update' and 'delete'."
      },
      "termId": {
        "type": "string",
        "minLength": 1,
        "description": "Term.id for the class — required for 'add' and 'update'."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Course title — required for 'add' and 'update'."
      },
      "location": {
        "type": "string",
        "maxLength": 200,
        "description": "Classroom or location string (optional)."
      },
      "periodCode": {
        "type": "string",
        "maxLength": 10,
        "description": "Dartmouth period code (e.g. '2A', '10'). Either periodCode OR customMeetings must be provided for add/update."
      },
      "includeXHour": {
        "type": "boolean",
        "description": "Include the x-hour meeting for this period (default false)."
      },
      "customMeetings": {
        "type": "array",
        "description": "Custom meeting schedule when periodCode is not used. Each item: days (weekday numbers this pattern meets, 0=Sun…6=Sat), startMin and endMin (minutes from local midnight, e.g. 9:30am = 570).",
        "items": {
          "type": "object",
          "properties": {
            "days": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "startMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            },
            "endMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            }
          },
          "required": [
            "days",
            "startMin",
            "endMin"
          ],
          "additionalProperties": false
        }
      },
      "destination": {
        "type": "string",
        "description": "Where to store the class events. 'local' = DALI-only layer; 'google-dedicated:<linkId>' = dedicated Classes calendar on a Google account; 'google-primary:<linkId>' = primary calendar; 'google-calendar:<linkId>:<calendarId>' = specific sub-calendar. Use list_my_calendar_links to find linkIds."
      },
      "offeringCrn": {
        "type": "string",
        "description": "CourseOffering CRN from the timetable (optional)."
      },
      "subject": {
        "type": "string",
        "description": "Subject code, e.g. 'COSC' (optional)."
      },
      "courseNumber": {
        "type": "string",
        "description": "Course number, e.g. '89' (optional)."
      },
      "section": {
        "type": "string",
        "description": "Section identifier, e.g. '01' (optional)."
      }
    },
    "required": [
      "intent"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "search_timetable_courses",
  "description": "Search the Dartmouth timetable course cache for a given term. Returns matching course sections with period, location, and enrollment info, 20 per page by default. Pass page.nextCursor as cursor to read the next page until page.hasMore is false. Use the returned CRN, subject, courseNumber, and section when calling manage_class.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "termId": {
        "type": "string",
        "minLength": 1,
        "description": "Term.id to search within."
      },
      "q": {
        "type": "string",
        "minLength": 2,
        "description": "Search text (minimum 2 characters) — matched against subject, number, and title."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Page size (default 20, max 100)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "termId",
      "q"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "scan_attendee",
  "description": "Scan a member's wallet-pass barcode token to mark them present at a meeting. The caller must be the meeting organizer, a Core member, or a project member. Wallet check-in must be configured.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "meetingId": {
        "type": "string",
        "minLength": 1,
        "description": "ScheduledMeeting.id."
      },
      "memberToken": {
        "type": "string",
        "minLength": 1,
        "description": "Signed wallet-pass member token from the scanned barcode."
      }
    },
    "required": [
      "meetingId",
      "memberToken"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "manage_calendar_link",
  "description": "Remove a connected calendar account link, or toggle a sub-calendar's visibility in the DALI calendar. Use list_my_calendar_links to discover link and calendar IDs.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "intent": {
        "type": "string",
        "enum": [
          "remove-calendar-link",
          "toggle-sub-calendar"
        ],
        "description": "'remove-calendar-link' disconnects the calendar account. 'toggle-sub-calendar' shows/hides a sub-calendar layer."
      },
      "linkId": {
        "type": "string",
        "minLength": 1,
        "description": "UserCalendarLink.id. Use list_my_calendar_links to find this."
      },
      "calendarId": {
        "type": "string",
        "minLength": 1,
        "description": "Sub-calendar ID — required for 'toggle-sub-calendar'."
      },
      "enabled": {
        "type": "boolean",
        "description": "true = show this sub-calendar in DALI; false = hide it. Required for 'toggle-sub-calendar'."
      }
    },
    "required": [
      "intent",
      "linkId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_rooms",
  "description": "List the DALI rooms that can be booked. Pass start and end to also get each room's conflict in that window (null when free); add recurrenceRule to check every occurrence of a repeating booking, where conflictOn names the first colliding date after the first occurrence.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "start": {
        "type": "string",
        "description": "Window start. ISO 8601 with a UTC offset, e.g. 2026-11-03T14:00:00-05:00."
      },
      "end": {
        "type": "string",
        "description": "Window end, at most 8 days after start. Same format as start."
      },
      "recurrenceRule": {
        "type": "string",
        "maxLength": 500,
        "description": "RFC 5545 RRULE. Requires start and end, which then describe the first occurrence."
      }
    },
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "get_room_schedule",
  "description": "Get a room's bookings and meetings in a window of up to 8 days. Items with kind 'booking' carry the id and occurrenceStart that cancel_room_booking takes.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "roomId": {
        "type": "string",
        "minLength": 1,
        "description": "Room id from list_rooms."
      },
      "start": {
        "type": "string",
        "description": "Window start. ISO 8601 with a UTC offset, e.g. 2026-11-03T14:00:00-05:00."
      },
      "end": {
        "type": "string",
        "description": "Window end, at most 8 days after start. Same format as start."
      }
    },
    "required": [
      "roomId",
      "start",
      "end"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
{
  "name": "book_room",
  "description": "Book a DALI room for yourself. A booking lasts at most 8 hours and can start up to 90 days ahead. Fails if the room is taken at any occurrence. To put a room on a meeting, pass roomIds to schedule_meeting instead.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "roomId": {
        "type": "string",
        "minLength": 1,
        "description": "Room id from list_rooms."
      },
      "start": {
        "type": "string",
        "description": "Booking start. ISO 8601 with a UTC offset, e.g. 2026-11-03T14:00:00-05:00."
      },
      "end": {
        "type": "string",
        "description": "Booking end. Same format as start."
      },
      "title": {
        "type": "string",
        "maxLength": 200,
        "description": "Shown on the room's schedule."
      },
      "recurrenceRule": {
        "type": "string",
        "maxLength": 500,
        "description": "RFC 5545 RRULE to repeat the booking. Needs COUNT or UNTIL and must end within the current term."
      }
    },
    "required": [
      "roomId",
      "start",
      "end"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "cancel_room_booking",
  "description": "Cancel a room booking. Only the booker or Core can. A booking already underway ends now, freeing the rest of the slot. On a repeating booking, scope defaults to 'all', which cancels the whole series; 'this' and 'following' need occurrenceStart. Bookings managed by hiring can't be cancelled here.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "bookingId": {
        "type": "string",
        "minLength": 1,
        "description": "Booking id from book_room or get_room_schedule."
      },
      "scope": {
        "type": "string",
        "enum": [
          "this",
          "following",
          "all"
        ],
        "description": "Which occurrences to cancel."
      },
      "occurrenceStart": {
        "type": "string",
        "description": "The occurrence's occurrenceStart from get_room_schedule."
      }
    },
    "required": [
      "bookingId"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:write"
}
{
  "name": "list_mentor_notes",
  "description": "List mentor notes the caller can see. Every lab mentor (and Core) sees all mentor notes lab-wide; mentees are never granted access. All filters are optional and AND-combined. Newest week first. Pass page.nextCursor as cursor to read the next page until page.hasMore is false.",
