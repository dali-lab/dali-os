        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "enum": [
          "pages",
          "files"
        ],
        "description": "Which list to return: the project's documents or its files."
      },
      "includeArchived": {
        "type": "boolean",
        "description": "Defaults to false."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page size (default 50, max 200)."
      },
      "cursor": {
        "type": "string",
        "description": "Pass page.nextCursor from the previous response to get the next page."
      }
    },
    "required": [
      "projectId",
      "kind"
    ],
    "additionalProperties": false
  },
  "requiredScope": "mcp:read"
}
