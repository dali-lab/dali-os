
# postgres connection url
DATABASE_URL="postgresql://user:password@localhost:5432/dali_dev"
# Postgres pool per process (see app/lib/db-pool.ts): max connections, warm
# connections kept open, and how long an idle connection above min stays open.
# DATABASE_POOL_MAX=25
# DATABASE_POOL_MIN=5
# DATABASE_POOL_IDLE_TIMEOUT_MS=300000

# BetterAuth secret — used for signing/encryption of sessions and tokens.
# Generate with: openssl rand -base64 32
# MUST be set (via Fly secrets) in staging and prod. BetterAuth uses a safe
# placeholder in dev when unset, but the placeholder is rejected in production.
BETTER_AUTH_SECRET=""

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Dartmouth DartAPI key — exchanged for short-lived JWTs against
# https://api.dartmouth.edu/api/jwt and used for the People API, the source of
# the graduation + enrollment signals that drive membership status (Active /
# Alumni). When unset, the sync silently no-ops and status falls back to
# graduatedAt + classYear math. Provisioned through Dartmouth IT
# (see developer.dartmouth.edu).
DARTMOUTH_API_KEY=""

# Gmail OAuth client for outbound app email. Falls back to GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET when unset. The refresh token lives in a GmailIntegration
# DB row created via the one-time /admin/authorize-gmail flow; without that row
# all email sending is skipped (no error).
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""

# Onboarding/welcome + acceptance emails: in non-prod (DALI_APP_ENV != prod)
# every candidate email is redirected to this single test inbox, with a banner
# naming who it WOULD have gone to in prod. Defaults to a lab test inbox if unset.
# ONBOARDING_EMAIL_OVERRIDE="test-inbox@example.edu"

# Google Workspace account provisioning (Admin SDK Directory API). When an
# applicant is accepted, creates their @dali.dartmouth.edu account. Needs a
# Google service account with DOMAIN-WIDE DELEGATION authorized for the
# admin.directory.user scope, impersonating a Workspace super-admin. All three
# must be set or the step is skipped. See docs/ONBOARDING_PROVISIONING.md.
# ⚠️ Creates REAL accounts even from local dev — only set when you mean it.
GOOGLE_WORKSPACE_SA_EMAIL=""
# Full PEM; literal \n is unescaped at runtime.
GOOGLE_WORKSPACE_SA_PRIVATE_KEY=""
GOOGLE_WORKSPACE_ADMIN_EMAIL=""
# Optional; defaults to dali.dartmouth.edu.
# GOOGLE_WORKSPACE_DOMAIN="dali.dartmouth.edu"

# frontend and api urls
FRONTEND_URL="http://localhost:5173"
API_BASE_URL="http://localhost:3001"

# Deployment environment. Auto-derived from FLY_APP_NAME in deployed envs
# (dali-api-prod → prod, dali-api-staging → staging, else dev). Set explicitly
# to override locally. Candidate-facing emails (acceptance + welcome) only go to
# the real applicant when this is "prod"; otherwise they're redirected to the
# test inbox below.
# DALI_APP_ENV="dev"

# AWS S3 — direct-to-S3 uploads (application files, profile photos). Required
# for the presign endpoints in app/lib/s3.server.ts; uploads fail without them.
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Redis URL for Hocuspocus cross-machine fan-out. Optional locally — without
# it the collab server runs single-process. Required in any environment where
# Fly runs more than one machine for the API app.
# REDIS_URL="redis://localhost:6379"

# Zoom Server-to-Server OAuth (optional — Zoom provisioning is skipped when missing)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# AES-256-GCM key (32 bytes base64) for encrypting UserCalendarLink.oauthTokens
# at rest. Generate with: openssl rand -base64 32
CALENDAR_TOKEN_KEY=""

# The shared "DALI General Calendar". My Availability prompts members who
# haven't subscribed to it to add it to one of their linked Google accounts.
# Paste the calendar's public iCal (.ics) address — its Google calendar id is
# derived from that URL. Optional: when empty the prompt never appears. Set
# DALI_GENERAL_CALENDAR_ID to give the id directly instead.
DALI_GENERAL_CALENDAR_ICS=""
DALI_GENERAL_CALENDAR_ID=""

# Slack bug-report bot (see app/slack/). Empty disables the bot end-to-end —
# /api/slack/events returns 503 when SLACK_SIGNING_SECRET is missing.
SLACK_SIGNING_SECRET=""
SLACK_BOT_TOKEN=""
# A newly-accepted member is invited into the workspace's #general channel on
# acceptance (the channel is resolved by name, no env var needed). The staffing
# "finalize" automation instead creates/uses each project's OWN channel (named
# after the project) for the team announcement + invites.
#
# Inviting a new member's email to the workspace uses admin.users.invite, which
# needs an ADMIN-scoped token (admin.users:write) on a Business+/Enterprise Grid
# workspace, distinct from SLACK_BOT_TOKEN. DALI's workspace is NOT Enterprise
# Grid, so leave these empty: the welcome email points new members at
# SLACK_WORKSPACE_URL and a teammate adds them.
SLACK_ADMIN_TOKEN=""
SLACK_TEAM_ID=""

# Workspace URL shown in the welcome email. Defaults to https://dali-lab.slack.com.
SLACK_WORKSPACE_URL="https://dali-lab.slack.com"

# GitHub App used to file issues from Slack bug reports, and (when the App has
# org "Members: write") to provision project teams from staffing finalize.
GITHUB_APP_ID=""
GITHUB_APP_INSTALLATION_ID=""
# Full PEM, newlines preserved. In Fly use a single-line literal with \n.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_ISSUES_REPO=""
# Org login (e.g. "dali-lab") under which the "Set up GitHub teams" staffing
# automation creates project teams. Unset = that automation skips.
GITHUB_ORG=""

# Shared secret for the GitHub webhook (POST /api/webhooks/github). Configure
# the matching value in the GitHub App's webhook settings. When empty the
# endpoint returns 503, so task→issue inbound sync is silently disabled.
GITHUB_WEBHOOK_SECRET=""

# Background jobs (app/jobs). The runner ticks in-process every 60s; this
# secret additionally allows POST /internal/jobs/tick from machine callers
# (an admin session works without it). Unset = header auth disabled.
JOBS_TICK_SECRET=""
# Slack DMs from notify() are prod-only (the staging DB is restored from a
# prod snapshot, so real members' Slack ids live there). Set to "1" to send
# DMs from a non-prod environment on purpose.
NOTIFY_SLACK_DM_OVERRIDE=""

# Feature flags that default ON outside production, so a design still behind
# its flag is what `npm run dev` shows without a trip to Admin → Feature Flags.
# Comma-separated keys. Left commented out (the default) the built-in dev list
# applies — see DEV_DEFAULT_ON in app/lib/feature-flags.server.ts. Uncomment it
# empty to turn the mechanism off entirely. Ignored when NODE_ENV=production.
# DEV_FEATURE_FLAGS=""

# ─── Wallet check-in (Apple/Google membership pass) ───────────────────────────
# Members add a DALI pass to their phone wallet; an organizer scans it at a
# meeting to mark attendance (app/lib/wallet-token.ts, wallet-apple.server.ts,
# wallet-google.server.ts). Empty = that half is off: the scan endpoint 503s
# without WALLET_PASS_SECRET, and each Add-to-Wallet button hides when its
# platform's vars are unset.
#
# Global HMAC key mixed into every barcode (openssl rand -base64 32). Rotating
# it invalidates ALL members' passes at once — the last-resort revoke.
WALLET_PASS_SECRET=""
# Apple Wallet: a Pass Type ID cert + key exported from the DALI Apple Developer
# account, plus the WWDR intermediate. Store the full PEMs (newlines may be
# escaped as \n). APPLE_PASS_KEY_PASSPHRASE is optional (empty if the key is
# unencrypted).
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT_PEM=""
APPLE_PASS_KEY_PEM=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT_PEM=""
# APNs host for pass-update pushes. Omit for production (defaults to
# https://api.push.apple.com). Set to https://api.sandbox.push.apple.com
# when testing against the sandbox environment.
APPLE_PASS_APNS_HOST=""
# Google Wallet: an issuer id + a DEDICATED service account (not the Workspace-
# provisioning SA) with the Google Wallet API enabled. Private key as full PEM
# (\n escapes tolerated).
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SA_EMAIL=""
GOOGLE_WALLET_SA_PRIVATE_KEY=""

# ─── AI (docs writing assistant, Ask DALI) ────────────────────────────────────
# Provider is picked from whichever key is set (app/lib/ai.server.ts).
# AI_PROVIDER forces one: "anthropic" or "dartmouth".
# AI_PROVIDER=""
ANTHROPIC_API_KEY=""
DARTMOUTH_CHAT_API_KEY=""
# Defaults to https://chat.dartmouth.edu/api.
# DARTMOUTH_CHAT_BASE_URL=""

# ─── Collab server ────────────────────────────────────────────────────────────
# Hocuspocus websocket port (default 3002) and the public ws(s) URL the browser
# connects to. COLLAB_URL is also added to the CSP connect-src.
# COLLAB_PORT="3002"
# COLLAB_URL=""

# Set to "1" in production to enforce the Content-Security-Policy instead of
# report-only.
# CSP_ENFORCE=""

# ─── Access ───────────────────────────────────────────────────────────────────
# Comma-separated user ids treated as admins on top of AdminMembership rows.
# ADMIN_USER_IDS=""

# ─── Public API (dali.website) ────────────────────────────────────────────────
# Shared secret for /api/public/*. The routes fail closed when it is unset.
SHOWCASE_API_SECRET=""

# ─── MCP OAuth ────────────────────────────────────────────────────────────────
# Extra comma-separated redirect hosts / exact redirect URIs allowed at client
# registration, on top of the built-in list (app/routes/oauth.register.ts).
# MCP_ALLOWED_REDIRECT_HOSTS=""
# MCP_ALLOWED_REDIRECT_URIS=""

# ─── Desktop app version check (/api/desktop/version) ────────────────────────
# DESKTOP_LATEST_VERSION="0.0.0"
# DESKTOP_MIN_VERSION="0.0.0"
# DESKTOP_DOWNLOAD_URL=""
# DESKTOP_NOTES_URL=""

# ─── Meeting transcription / diarization (asr/ on Modal) ─────────────────────
# Both must be set or diarized transcription is off. DIARIZE_SECRET signs
# requests with an HMAC.
# DIARIZE_URL=""
# DIARIZE_SECRET=""

# ─── Infrastructure dashboard (Admin → Infrastructure) ───────────────────────
# INFRA_SECRET_KEY encrypts stored Fly tokens (openssl rand -base64 32);
# INFRA_NEON_API_KEY enables Neon inventory and actions. The protected lists
# are comma-separated app names / project ids that the dashboard refuses to touch.
# INFRA_SECRET_KEY=""
# INFRA_NEON_API_KEY=""
# INFRA_PROTECTED_FLY_APPS=""
# INFRA_PROTECTED_NEON_PROJECTS=""

# ─── Release notes ────────────────────────────────────────────────────────────
# Repo the draft job reads merged PRs from (owner/name) and the Slack channel id
# for the weekly recap. Both optional.
# RELEASE_NOTES_REPO=""
# RELEASE_NOTES_SLACK_CHANNEL_ID=""

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Mailbox the interview Meet invites are created on. Defaults to
# applications@dali.dartmouth.edu.
# HIRING_CALENDAR_EMAIL=""
# Set to "1" to run staffing finalize's external steps (GitHub, Slack) from a
# non-prod environment.
# FINALIZE_EXTERNAL_OVERRIDE=""
# Chromium binary for headless PDF rendering. The Docker image sets it; locally
# a system Chrome is found automatically.
# CHROMIUM_EXECUTABLE_PATH=""
