
# postgres connection url
DATABASE_URL="postgresql://user:password@localhost:5432/dali_dev"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# dartmouth sso url
CAS_BASE_URL="https://login.dartmouth.edu/cas"

# frontend and api urls
FRONTEND_URL="http://localhost:5173"
API_BASE_URL="http://localhost:3001"

# Redis URL for Hocuspocus cross-machine fan-out. Optional locally — without
# it the collab server runs single-process. Required in any environment where
# Fly runs more than one machine for the API app.
# REDIS_URL="redis://localhost:6379"

# Zoom Server-to-Server OAuth (optional — Zoom provisioning is skipped when missing)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# AES-256-GCM key (32 bytes base64) for encrypting UserCalendarLink.oauthTokens
# at rest. Generate with: openssl rand -base64 32
CALENDAR_TOKEN_KEY=""

# Slack bug-report bot (see app/slack/). Empty disables the bot end-to-end —
# /api/slack/events returns 503 when SLACK_SIGNING_SECRET is missing.
SLACK_SIGNING_SECRET=""
SLACK_BOT_TOKEN=""
# Optional comma-separated Slack user IDs allowed to confirm-file (✅).
# Empty means any user in the channel can confirm.
SLACK_ALLOWED_REACTOR_IDS=""

# GitHub App used to file issues from Slack bug reports.
GITHUB_APP_ID=""
GITHUB_APP_INSTALLATION_ID=""
# Full PEM, newlines preserved. In Fly use a single-line literal with \n.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_ISSUES_REPO=""
