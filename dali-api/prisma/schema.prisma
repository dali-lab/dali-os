// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // unique identifier
  id String @id @default(cuid())

  // metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // all nullable, but at least one of these must be non-null
  netId          String? @unique // Dartmouth SSO
  daliEmail      String? @unique // DALI Google
  dartmouthEmail String? @unique // Dartmouth Google OAuth

  // profile
  firstName String
  lastName  String

  // Google API tokens (for calendar integration etc.) — populated when user
  // signs in via Google with appropriate scopes
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?

  daliMember                    DALIMember?
  applicationCycleStatusUpdates ApplicationCycleStatusUpdate[]
  challengeVersions             ChallengeVersion[]
  applications                  Application[]
  applicationStatusUpdates      ApplicationStatusUpdate[]
  oauthSessions                 OAuthSession[]
  refreshTokens                 RefreshToken[]
  rubricVersions                RubricVersion[]
}

// A DALI lab member. userId is optional because a member may be known (e.g. via daliEmail)
// before they have created a User account.
model DALIMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  firstName      String?
  lastName       String?
  daliEmail      String? @unique
  dartmouthEmail String? @unique
  did            String? @unique // Dartmouth D-number e.g. "F00709M"

  roles MemberRole[] @default([])

  domainLeadAssignments DomainLeadAssignment[]
  cycleReviewers        CycleReviewer[]
  cycleInterviewers     CycleInterviewer[]
  decisions             Decision[]
  applicationReviews    ApplicationReview[]    @relation("SubmittedBy")
  delibSessions         DelibsSession[]
  legacyEmailTemplates  LegacyEmailTemplate[]
  emailTemplateVersions EmailTemplateVersion[]
}

model ApplicationCycle {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Human-readable label (e.g. "Fall 2026"). No enforced format — cycles may
  // be non-standard (e.g. only one domain hiring). Dates are tracked via
  // ApplicationCycleStatusUpdate rather than stored directly here.
  name String

  // Application due date; triggers auto-transition to UnderReview when passed.
  closeDate DateTime?

  // Rubric for the general application form (reviewers score this alongside
  // the per-domain rubric set on DomainApplicationCycle).
  generalRubricVersionId String?
  generalRubricVersion   RubricVersion? @relation("CycleGeneralRubric", fields: [generalRubricVersionId], references: [id])

  statusUpdates     ApplicationCycleStatusUpdate[]
  applications      Application[]
  domains           DomainApplicationCycle[]
  challengeVersions ChallengeVersionApplicationCycle[]

  interviewConfig   InterviewConfig?
  cycleReviewers    CycleReviewer[]
  cycleInterviewers CycleInterviewer[]
  interviews        Interview[]
  delibsSessions    DelibsSession[]
  decisionEmails    CycleDecisionEmail[]
}

// Applicant-initiated status changes only. DALI-initiated outcomes (interview,
// offer, rejection) are tracked in a separate decisions table to record who
// made the decision and whether it has been communicated to the applicant.
enum ApplicationStatus {
  Draft
  Submitted
  Withdrawn
}

model ApplicationStatusUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  newStatus     ApplicationStatus
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // answers: map of question UUID key -> answer value (JSON). Saved incrementally
  // as the applicant fills out the form; finalized on submission.
  answers Json

  userId                    String
  user                      User             @relation(fields: [userId], references: [id])
  applicationCycleId        String
  applicationCycle          ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  // Pinned at application creation time so that form updates do not affect in-progress drafts.
  generalChallengeVersionId String
  generalChallengeVersion   ChallengeVersion @relation("ApplicationGeneralChallenge", fields: [generalChallengeVersionId], references: [id])

  statusUpdates      ApplicationStatusUpdate[]
  domainApplications DomainApplication[]
}

// Domain is not stored directly — it is derivable via challengeVersion.domain.
// Every DomainApplication is tied to a specific ChallengeVersion, which belongs to a Domain.
model DomainApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // answers: same shape as Application.answers, keyed by question UUID from the challenge version.
  answers Json

  // Whether this domain is currently selected by the applicant.
  // False means the applicant deselected the domain but the record is
  // preserved so answers survive re-selection.
  selected Boolean @default(true)

  applicationId      String
  application        Application      @relation(fields: [applicationId], references: [id])
  challengeVersionId String
  challengeVersion   ChallengeVersion @relation(fields: [challengeVersionId], references: [id])

  interviews Interview[]
  reviews    ApplicationReview[]
  decisions  Decision[]
}

model Challenge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  versions ChallengeVersion[]
}

model Domain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  challengeVersions     ChallengeVersion[]
  applicationCycles     DomainApplicationCycle[]
  domainLeadAssignments DomainLeadAssignment[]
  cycleReviewers        CycleReviewer[]
  cycleInterviewers     CycleInterviewer[]
  delibsSessions        DelibsSession[]
}

// Immutable snapshot of a challenge. Never update rows in this table —
// create a new version instead. domainId: null = general application form.
model ChallengeVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  questions   Json
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  domainId    String?
  domain      Domain?   @relation(fields: [domainId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])

  domainApplications    DomainApplication[]
  applicationCycles     ChallengeVersionApplicationCycle[]
  applicationsAsGeneral Application[]                      @relation("ApplicationGeneralChallenge")
}

// Lifecycle of an application cycle from the DALI side:
//   Draft       — cycle being set up by hiring lead and domain leads
//   Open        — applications open for submission
//   UnderReview — submissions closed; hiring team reviewing
//   Completed   — decisions communicated to applicants
enum ApplicationCycleStatus {
  Draft
  Open
  UnderReview
  Completed
}

model ApplicationCycleStatusUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  newStatus          ApplicationCycleStatus
  applicationCycleId String
  applicationCycle   ApplicationCycle       @relation(fields: [applicationCycleId], references: [id])
  userId             String? // null = system-generated (e.g. auto-close at closeDate)
  user               User?                  @relation(fields: [userId], references: [id])
}

// Indicates that a domain is hiring during a given application cycle
model DomainApplicationCycle {
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  // True once the domain lead has explicitly confirmed their challenge config is ready
  isReady Boolean @default(false)

  // Rubric assigned for this domain in this cycle (shared across all challenge versions for the domain)
  rubricVersionId         String?
  rubricVersion           RubricVersion? @relation(fields: [rubricVersionId], references: [id])
  // Target number of reviewers assigned to each application in this domain
  reviewersPerApplication Int            @default(2)

  @@id([domainId, applicationCycleId])
}

// Indicates that a specific version of a challenge is in use for an application cycle
model ChallengeVersionApplicationCycle {
  challengeVersionId String
  challengeVersion   ChallengeVersion @relation(fields: [challengeVersionId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  @@id([challengeVersionId, applicationCycleId])
}

// ─── Interview Scheduling ────────────────────────────────────────────────────

model InterviewConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationCycleId String           @unique
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  slotDurationMinutes Int @default(30)
  bufferMinutes       Int @default(15)
  dayStartHour        Int @default(9) // 9 AM
  dayEndHour          Int @default(18) // 6 PM

  interviewStartDate DateTime
  interviewEndDate   DateTime

  timezone String @default("America/New_York")
}

// A DALI member assigned as a written reviewer for a domain in a cycle.
// Purely for ApplicationReview — separate from CycleInterviewer.
model CycleReviewer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  daliMemberId       String
  daliMember         DALIMember       @relation(fields: [daliMemberId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])

  reviews ApplicationReview[]

  @@unique([daliMemberId, applicationCycleId, domainId])
}

// A DALI member assigned to conduct interviews for a domain in a cycle.
// Separate from CycleReviewer — interviewers and reviewers are managed independently.
model CycleInterviewer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  daliMemberId       String
  daliMember         DALIMember       @relation(fields: [daliMemberId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])

  availabilityBlocks   InterviewerAvailability[]
  interviewAssignments InterviewAssignment[]

  @@unique([daliMemberId, applicationCycleId, domainId])
}

model InterviewerAvailability {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  cycleInterviewerId String
  cycleInterviewer   CycleInterviewer @relation(fields: [cycleInterviewerId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime

  @@index([cycleInterviewerId, startTime, endTime])
}

enum InterviewStatus {
  Scheduled
  Completed
  CancelledByApplicant
  CancelledByAdmin
}

model Interview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No @unique: a DomainApplication can accumulate historical Interview rows
  // (Cancelled/Completed) alongside at most one active row. The partial
  // unique index "Interview_activeDomainApplication_key" (added in raw SQL
  // in the migration) enforces "at most one Scheduled per DA" at the DB
  // level. See SCHEDULING.md §Data model.
  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])
  applicationCycleId  String
  applicationCycle    ApplicationCycle  @relation(fields: [applicationCycleId], references: [id])

  startTime DateTime
  endTime   DateTime
  status    InterviewStatus @default(Scheduled)

  // Joint outcome — set by either interviewer when marking complete.
  // recommendation values: 'Strong Hire' | 'Hire' | 'Lean Hire' | 'Lean No Hire' | 'No Hire'
  recommendation      String?
  recommendationNotes String?

  assignments InterviewAssignment[]

  @@index([applicationCycleId, startTime])
  @@index([domainApplicationId, status])
}

enum AssignmentRole {
  InDomain
  CrossDomain
}

enum AssignmentStatus {
  Active
  Declined
  Replaced
}

enum MemberRole {
  Admin
  HiringLead
}

model InterviewAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  interviewId        String
  interview          Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  cycleInterviewerId String
  cycleInterviewer   CycleInterviewer @relation(fields: [cycleInterviewerId], references: [id])
  role               AssignmentRole
  status             AssignmentStatus @default(Active)

  noteVersions InterviewNoteVersion[]

  @@index([cycleInterviewerId, status])
}

// Append-only versioned notes for an interview assignment.
// Current notes = latest record by createdAt. Never updated — only appended.
model InterviewNoteVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  interviewAssignmentId String
  interviewAssignment   InterviewAssignment @relation(fields: [interviewAssignmentId], references: [id], onDelete: Cascade)

  content String

  @@index([interviewAssignmentId, createdAt])
}

// ─── Decisions ───────────────────────────────────────────────────────────────

enum DecisionType {
  Rejected
  InvitedToInterview
  Accepted
  Waitlisted
}

enum DecisionStage {
  Draft // visible only to domain lead / hiring lead
  Final // locked, ready to release (domain lead marks final)
  Released // visible to applicant; triggers notification hook (hiring lead releases)
}

// Append-only, immutable decision records. Never updated — only created.
// Current decision = latest record by createdAt.
// To change a Draft: create a new record (supersedes old by timestamp).
// To finalize: create new record with stage=Final.
// To release: create new record with stage=Released.
model Decision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])

  type  DecisionType
  stage DecisionStage

  madeById String
  madeBy   DALIMember @relation(fields: [madeById], references: [id])

  notes        String?
  waitlistRank Int? // set when type == Waitlisted; current rank = latest record's value

  @@index([domainApplicationId, createdAt])
}

// ─── Application Reviews ─────────────────────────────────────────────────────

// Replaces MentorReview. Scoped to DomainApplication, authored by a CycleReviewer.
model ApplicationReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])

  cycleReviewerId String
  cycleReviewer   CycleReviewer @relation(fields: [cycleReviewerId], references: [id])

  scores                Json    @default("{}") // { [criterionKey]: number }
  feedback              String  @default("")
  rejectionRationale    String  @default("")
  overallRecommendation String? // 'Strong Hire' | 'Hire' | 'Lean Hire' | 'Lean No Hire' | 'No Hire'
  annotations           Json    @default("[]") // [{id, fieldKey, start, end, comment, color}]

  submittedAt   DateTime? // null = in progress; non-null = read-only while set
  submittedById String? // records who authored the final review (set on submit, cleared on unsubmit)
  submittedBy   DALIMember? @relation("SubmittedBy", fields: [submittedById], references: [id])

  @@unique([cycleReviewerId, domainApplicationId])
}

// ─── Delibs ──────────────────────────────────────────────────────────────────

enum DelibsType {
  Initial // deliberating on applications with completed reviews, no decision yet
  Final // deliberating after interviews; produces Accept/Waitlist/Reject decisions
}

enum DelibsStatus {
  Active
  Closed
}

// Persisted deliberation session — one per type per domain+cycle (reopened, not recreated).
// columnOrder is the source of truth for kanban ordering during an active session.
// Draft Decisions are only created when the session is closed.
model DelibsSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  type   DelibsType
  status DelibsStatus @default(Active)

  // Ordered list of domainApplicationIds per column.
  // Column names vary by type:
  //   Initial: { "No Decision": [...], "Interview": [...], "Reject": [...] }
  //   Final:   { "Accept": [...], "Waitlist": [...], "Reject": [...] }
  columnOrder Json @default("{}")

  openedById String
  openedBy   DALIMember @relation(fields: [openedById], references: [id])

  @@unique([domainId, applicationCycleId, type])
}

// ─── Rubrics ─────────────────────────────────────────────────────────────────

model Rubric {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  versions RubricVersion[]
}

// Immutable snapshot of a rubric. Never update rows in this table —
// create a new version instead.
// criteria: array of { key, label, description?, maxScore }
model RubricVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  criteria      Json
  rubricId      String
  rubric        Rubric @relation(fields: [rubricId], references: [id])
  createdById   String
  createdBy     User   @relation(fields: [createdById], references: [id])

  // Back-ref: domain+cycle pairs that use this rubric version
  domainApplicationCycles DomainApplicationCycle[]
  // Back-ref: cycles using this as the general form rubric
  cyclesAsGeneralRubric   ApplicationCycle[]       @relation("CycleGeneralRubric")
}

// ─── Collaborative Editing ───────────────────────────────────────────────────

// Stores the Y.js binary state for each collaborative document.
// Document naming convention:
//   review:{reviewId}:feedback
//   review:{reviewId}:rejectionRationale
//   interview:{interviewId}:notes        (joint)
//   interview:{interviewId}:recommendation
model CollabDocument {
  id        String   @id @default(cuid())
  name      String   @unique
  state     Bytes
  updatedAt DateTime @updatedAt

  versions CollabDocumentVersion[]
}

// Periodic snapshots of a CollabDocument's Y.Doc state. One row written per
// onStoreDocument tick (every ~30s during active editing — see persistence.ts
// `maybeSnapshot`). Idle docs accrue no rows. Powers the version-history UI.
model CollabDocumentVersion {
  id        String   @id @default(cuid())
  name      String
  state     Bytes // Y.Doc binary at snapshot time
  plainText String // mirror, for fast preview without decoding `state`
  authorIds String[] // userIds that edited since previous snapshot, best-effort
  createdAt DateTime @default(now())

  collabDocument CollabDocument @relation(fields: [name], references: [name], onDelete: Cascade)

  @@index([name, createdAt(sort: Desc)])
}

// ─── OAuth & Sessions ────────────────────────────────────────────────────────

model OAuthSession {
  id String @id @default(cuid())

  // pkce fields
  codeChallenge       String
  codeChallengeMethod String @default("S256")

  // oAuth params preserved across IDP redirect
  redirectUri String
  state       String
  provider    String // "google" | "cas"
  accountType String? // "member" | "partner" (Google only)

  // set after IDP authenticates user
  userId            String?
  authorizationCode String? @unique
  exchanged         Boolean @default(false)

  // for chained Google → CAS account linking
  linkUserId String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha-256 token hash
  userId    String
  family    String // rotation detection
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Email Templates ────────────────────────────────────────────────────────

// Each value maps to one email template. Decision-related values mirror
// DecisionType so releasing a Decision can look up its template directly.
enum EmailTemplateType {
  ApplicationReceived // confirmation after submission
  Rejected // generic rejection (pre-interview)
  RejectedPostInterview // rejection after interview stage
  InvitedToInterview // applicant interview invite
  InterviewInviteMentor // internal: reviewer/mentor interview assignment
  Waitlisted
  Accepted
}

// Legacy single-table email templates (PR #112). Retained while
// ApplicationReceived and InterviewInviteMentor still use the global
// type-keyed lookup. Decision-related types have moved to the new
// EmailTemplate / EmailTemplateVersion / CycleDecisionEmail trio below.
// To be dropped in a follow-up PR after legacy callers are migrated.
model LegacyEmailTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type    EmailTemplateType
  subject String
  body    String
  version Int

  createdById String
  createdBy   DALIMember @relation(fields: [createdById], references: [id])

  @@index([type, createdAt])
}

// Named, versioned email template — independent of any cycle. Mirrors
// Rubric/RubricVersion. The "slot" a template fills (e.g. which DecisionType
// it sends for) is determined by the cycle binding row that points at it.
model EmailTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  versions EmailTemplateVersion[]
}

// Immutable snapshot of an EmailTemplate. Never update — append a new version.
// Subject and body use {{firstName}} interpolation.
model EmailTemplateVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  subject       String
  body          String

  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id])

  createdById String
  createdBy   DALIMember @relation(fields: [createdById], references: [id])

  cycleDecisionEmails CycleDecisionEmail[]

  @@index([templateId, versionNumber])
}

// Per-cycle binding: which EmailTemplateVersion fires when a Decision of the
// given DecisionType is released in this cycle. One row per (cycle, decisionType).
// No row = no email fires (surfaced explicitly in the picker UI).
model CycleDecisionEmail {
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  decisionType DecisionType

  emailTemplateVersionId String
  emailTemplateVersion   EmailTemplateVersion @relation(fields: [emailTemplateVersionId], references: [id])

  @@id([applicationCycleId, decisionType])
}

// Which domains a DALIMember leads (permanent assignment, not cycle-scoped)
model DomainLeadAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  memberId String
  member   DALIMember @relation(fields: [memberId], references: [id])
  domainId String
  domain   Domain     @relation(fields: [domainId], references: [id])
}
