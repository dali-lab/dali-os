// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // unique identifier
  id String @id @default(cuid())

  // metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // all nullable, but at least one of these must be non-null
  netId          String? @unique // Dartmouth SSO
  daliEmail      String? @unique // DALI Google
  dartmouthEmail String? @unique // Dartmouth Google OAuth

  // profile
  firstName String
  lastName  String

  // Google API tokens (for calendar integration etc.) — populated when user
  // signs in via Google with appropriate scopes
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?

  // ─── Profile additions (expansion v0) ──────────────────────────────────────
  classYear    Int?
  graduatedAt  DateTime?
  pronouns     String?
  photoUrl     String?
  bioDocId     String?
  major        String?
  hometown     String?
  linkedinUrl  String?
  githubUrl    String?
  personalSite String?
  timeZone     String?

  daliMember                    DALIMember?
  applicationCycleStatusUpdates ApplicationCycleStatusUpdate[]
  challengeVersions             ChallengeVersion[]
  applications                  Application[]
  applicationStatusUpdates      ApplicationStatusUpdate[]
  oauthSessions                 OAuthSession[]
  refreshTokens                 RefreshToken[]
  rubricVersions                RubricVersion[]
  confidentialitySignatures     ConfidentialityAgreementSignature[]

  // ─── Expansion role-model relations ────────────────────────────────────────
  domainEligibilities    DomainEligibility[]
  projectAssignments     ProjectAssignment[]
  menteePairs            MentorshipPair[]      @relation("MenteePairs")
  mentorPairs            MentorshipPair[]      @relation("MentorPairs")
  coreAssignments        CoreAssignment[]
  instructorAssignments  InstructorAssignment[]
  adminMembership        AdminMembership?
  educationApplications  EducationApplication[]
  taskAssignments        TaskAssignee[]
  staffingPreferences    StaffingPreference[]
  essentialityFormsAsPM  EssentialityForm[]
  essentialityRatings    EssentialityRating[]
  staffingAssignments    StaffingAssignment[]
  calendarLinks          UserCalendarLink[]
  scheduledMeetings      ScheduledMeeting[]
  availabilitySettings   UserAvailabilitySettings?
  workingHoursDays       WorkingHoursDay[]
  manualBlocks           ManualBlock[]
  notificationEvents     NotificationEvent[]
  notificationPreferences NotificationPreference[]
}

// A DALI lab member. userId is optional because a member may be known (e.g. via daliEmail)
// before they have created a User account.
model DALIMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  firstName      String?
  lastName       String?
  daliEmail      String? @unique
  dartmouthEmail String? @unique
  did            String? @unique // Dartmouth D-number e.g. "F00709M"

  roles MemberRole[] @default([])

  cycleReviewers        CycleReviewer[]
  cycleInterviewers     CycleInterviewer[]
  decisions             Decision[]
  applicationReviews    ApplicationReview[]    @relation("SubmittedBy")
  delibSessions         DelibsSession[]
  legacyEmailTemplates  LegacyEmailTemplate[]
  emailTemplateVersions EmailTemplateVersion[]
  confidentialityAgreementVersions ConfidentialityAgreementVersion[]
  domainLeadAssignments DomainLeadAssignment[]
}

model ApplicationCycle {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Human-readable label (e.g. "Fall 2026"). No enforced format — cycles may
  // be non-standard (e.g. only one domain hiring). Dates are tracked via
  // ApplicationCycleStatusUpdate rather than stored directly here.
  name String

  // Application due date; triggers auto-transition to UnderReview when passed.
  closeDate DateTime?

  // Pre-extension closeDate. Set on first extension; cleared when the lead
  // resets the close date via the picker. Nullable, no backfill needed.
  originalCloseDate DateTime?

  // Idempotency marker for the extension-notice blast. Set when the notice
  // is sent; cleared when the extension is removed so re-extending later
  // can re-trigger the notice.
  extensionNoticeSentAt DateTime?

  // Rubric for the general application form (reviewers score this alongside
  // the per-domain rubric set on DomainApplicationCycle).
  generalRubricVersionId String?
  generalRubricVersion   RubricVersion? @relation("CycleGeneralRubric", fields: [generalRubricVersionId], references: [id])

  statusUpdates     ApplicationCycleStatusUpdate[]
  applications      Application[]
  domains           DomainApplicationCycle[]
  challengeVersions ChallengeVersionApplicationCycle[]

  interviewConfig   InterviewConfig?
  cycleReviewers    CycleReviewer[]
  cycleInterviewers CycleInterviewer[]
  interviews        Interview[]
  delibsSessions    DelibsSession[]
  decisionEmails    CycleDecisionEmail[]
  notificationEmails CycleNotificationEmail[]
  notificationSends  CycleNotificationSend[]

  confidentialityBinding   CycleConfidentialityAgreement?
  confidentialitySignatures ConfidentialityAgreementSignature[]
}

// Applicant-initiated status changes only. DALI-initiated outcomes (interview,
// offer, rejection) are tracked in a separate decisions table to record who
// made the decision and whether it has been communicated to the applicant.
enum ApplicationStatus {
  Draft
  Submitted
  Withdrawn
}

model ApplicationStatusUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  newStatus     ApplicationStatus
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
}

// Distinguishes the app's purpose. Standard = regular DALI hire cycle.
// Intern = shorter form for ERAS / EEJUST / WISP intern programs.
// InternToFull = shorter form taken by current interns applying for
// regular hire after their intern term. Transfer = informal internal
// domain transfer (no dedicated form yet — placeholder for later).
enum ApplicationType {
  Standard
  Intern
  InternToFull
  Transfer
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // answers: map of question UUID key -> answer value (JSON). Saved incrementally
  // as the applicant fills out the form; finalized on submission.
  answers Json

  applicationType ApplicationType @default(Standard)

  userId                    String
  user                      User             @relation(fields: [userId], references: [id])
  applicationCycleId        String
  applicationCycle          ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  // Pinned at application creation time so that form updates do not affect in-progress drafts.
  generalChallengeVersionId String
  generalChallengeVersion   ChallengeVersion @relation("ApplicationGeneralChallenge", fields: [generalChallengeVersionId], references: [id])

  statusUpdates      ApplicationStatusUpdate[]
  domainApplications DomainApplication[]
  notificationSends  CycleNotificationSend[]

  @@unique([userId, applicationCycleId])
}

// Domain is not stored directly — it is derivable via challengeVersion.domain.
// Every DomainApplication is tied to a specific ChallengeVersion, which belongs to a Domain.
model DomainApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // answers: same shape as Application.answers, keyed by question UUID from the challenge version.
  answers Json

  // Whether this domain is currently selected by the applicant.
  // False means the applicant deselected the domain but the record is
  // preserved so answers survive re-selection.
  selected Boolean @default(true)

  applicationId      String
  application        Application      @relation(fields: [applicationId], references: [id])
  challengeVersionId String
  challengeVersion   ChallengeVersion @relation(fields: [challengeVersionId], references: [id])

  interviews Interview[]
  reviews    ApplicationReview[]
  decisions  Decision[]
}

model Challenge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  versions ChallengeVersion[]
}

model Domain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  // ─── Expansion fields ──────────────────────────────────────────────────────
  code            String?  @unique
  displayName     String?
  isInternProgram Boolean  @default(false)
  active          Boolean  @default(true)

  challengeVersions     ChallengeVersion[]
  applicationCycles     DomainApplicationCycle[]
  domainLeadAssignments DomainLeadAssignment[]
  cycleReviewers        CycleReviewer[]
  cycleInterviewers     CycleInterviewer[]
  delibsSessions        DelibsSession[]

  // ─── Expansion role-model back-refs ────────────────────────────────────────
  eligibilities       DomainEligibility[]
  projectAssignments  ProjectAssignment[]
  mentorshipPairs     MentorshipPair[]
  projectRoleRequests ProjectRoleRequest[]
}

// Immutable snapshot of a challenge. Never update rows in this table —
// create a new version instead. domainId: null = general application form.
model ChallengeVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Optional ProseMirror JSON document shown to applicants and reviewers above
  // the questions for this challenge version. Null = no description.
  description Json?
  questions   Json
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  domainId    String?
  domain      Domain?   @relation(fields: [domainId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])

  domainApplications    DomainApplication[]
  applicationCycles     ChallengeVersionApplicationCycle[]
  applicationsAsGeneral Application[]                      @relation("ApplicationGeneralChallenge")
}

// Lifecycle of an application cycle from the DALI side:
//   Draft       — cycle being set up by hiring lead and domain leads
//   Open        — applications open for submission
//   UnderReview — submissions closed; hiring team reviewing
//   Completed   — decisions communicated to applicants
enum ApplicationCycleStatus {
  Draft
  Open
  UnderReview
  Completed
}

model ApplicationCycleStatusUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  newStatus          ApplicationCycleStatus
  applicationCycleId String
  applicationCycle   ApplicationCycle       @relation(fields: [applicationCycleId], references: [id])
  userId             String? // null = system-generated (e.g. auto-close at closeDate)
  user               User?                  @relation(fields: [userId], references: [id])
}

// Indicates that a domain is hiring during a given application cycle
model DomainApplicationCycle {
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  // True once the domain lead has explicitly confirmed their challenge config is ready
  isReady Boolean @default(false)

  // Rubric assigned for this domain in this cycle (shared across all challenge versions for the domain)
  rubricVersionId         String?
  rubricVersion           RubricVersion? @relation(fields: [rubricVersionId], references: [id])
  // Target number of reviewers assigned to each application in this domain
  reviewersPerApplication Int            @default(2)

  @@id([domainId, applicationCycleId])
}

// Indicates that a specific version of a challenge is in use for an application cycle
model ChallengeVersionApplicationCycle {
  challengeVersionId String
  challengeVersion   ChallengeVersion @relation(fields: [challengeVersionId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  @@id([challengeVersionId, applicationCycleId])
}

// ─── Interview Scheduling ────────────────────────────────────────────────────

model InterviewConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationCycleId String           @unique
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  slotDurationMinutes Int @default(30)
  bufferMinutes       Int @default(15)
  dayStartHour        Int @default(9) // 9 AM
  dayEndHour          Int @default(18) // 6 PM

  interviewStartDate DateTime
  interviewEndDate   DateTime

  rescheduleNoticeHours Int @default(12) // minimum hours before interview to allow reschedule
  cancelNoticeHours     Int @default(0)  // minimum hours before interview to allow cancel (0 = up until start)

  timezone String @default("America/New_York")
}

// A DALI member assigned as a written reviewer for a domain in a cycle.
// Purely for ApplicationReview — separate from CycleInterviewer.
model CycleReviewer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  daliMemberId       String
  daliMember         DALIMember       @relation(fields: [daliMemberId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])

  reviews ApplicationReview[]

  @@unique([daliMemberId, applicationCycleId, domainId])
}

// A DALI member assigned to conduct interviews for a domain in a cycle.
// Separate from CycleReviewer — interviewers and reviewers are managed independently.
model CycleInterviewer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  daliMemberId       String
  daliMember         DALIMember       @relation(fields: [daliMemberId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])

  availabilityBlocks   InterviewerAvailability[]
  interviewAssignments InterviewAssignment[]

  @@unique([daliMemberId, applicationCycleId, domainId])
}

model InterviewerAvailability {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  cycleInterviewerId String
  cycleInterviewer   CycleInterviewer @relation(fields: [cycleInterviewerId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime

  @@index([cycleInterviewerId, startTime, endTime])
}

enum InterviewStatus {
  Scheduled
  Completed
  CancelledByApplicant
  CancelledByAdmin
}

enum InterviewLocation {
  PodAppa
  PodMomo
  Online
}

model Interview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No @unique: a DomainApplication can accumulate historical Interview rows
  // (Cancelled/Completed) alongside at most one active row. The partial
  // unique index "Interview_activeDomainApplication_key" (added in raw SQL
  // in the migration) enforces "at most one Scheduled per DA" at the DB
  // level. See SCHEDULING.md §Data model.
  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])
  applicationCycleId  String
  applicationCycle    ApplicationCycle  @relation(fields: [applicationCycleId], references: [id])

  startTime DateTime
  endTime   DateTime
  status    InterviewStatus @default(Scheduled)
  location  InterviewLocation @default(Online)

  zoomMeetingId String?
  zoomJoinUrl   String?

  // Joint outcome — set by either interviewer when marking complete.
  // recommendation values: 'Strong Hire' | 'Hire' | 'Lean Hire' | 'Lean No Hire' | 'No Hire'
  recommendation      String?
  recommendationNotes String?

  assignments InterviewAssignment[]

  @@index([applicationCycleId, startTime])
  @@index([domainApplicationId, status])
}

enum AssignmentRole {
  InDomain
  CrossDomain
}

// Existing assignment status for InterviewAssignment + new staffing flow.
enum AssignmentStatus {
  Active
  Declined
  Replaced
  // Staffing-flow values (StaffingAssignment.status). Not used by InterviewAssignment.
  Proposed
  Confirmed
}

enum MemberRole {
  Admin
  HiringLead
}

model InterviewAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  interviewId        String
  interview          Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  cycleInterviewerId String
  cycleInterviewer   CycleInterviewer @relation(fields: [cycleInterviewerId], references: [id])
  role               AssignmentRole
  status             AssignmentStatus @default(Active)

  noteVersions InterviewNoteVersion[]

  @@index([cycleInterviewerId, status])
}

// Append-only versioned notes for an interview assignment.
// Current notes = latest record by createdAt. Never updated — only appended.
model InterviewNoteVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  interviewAssignmentId String
  interviewAssignment   InterviewAssignment @relation(fields: [interviewAssignmentId], references: [id], onDelete: Cascade)

  content String

  @@index([interviewAssignmentId, createdAt])
}

// ─── Decisions ───────────────────────────────────────────────────────────────

enum DecisionType {
  Rejected
  InvitedToInterview
  Accepted
  Waitlisted
}

enum DecisionStage {
  Draft // visible only to domain lead / hiring lead
  Final // locked, ready to release (domain lead marks final)
  Released // visible to applicant; triggers notification hook (hiring lead releases)
}

// Append-only, immutable decision records. Never updated — only created.
// Current decision = latest record by createdAt.
// To change a Draft: create a new record (supersedes old by timestamp).
// To finalize: create new record with stage=Final.
// To release: create new record with stage=Released.
model Decision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])

  type  DecisionType
  stage DecisionStage

  madeById String
  madeBy   DALIMember @relation(fields: [madeById], references: [id])

  notes        String?
  waitlistRank Int? // set when type == Waitlisted; current rank = latest record's value

  // Lineage pointer for stage transitions (Draft → Final → Released).
  // Null when the row has no predecessor (e.g. delibs close, direct creation).
  parentDecisionId String?
  parent           Decision?  @relation("DecisionLineage", fields: [parentDecisionId], references: [id])
  children         Decision[] @relation("DecisionLineage")

  @@index([domainApplicationId, createdAt])
  @@index([parentDecisionId])
}

// ─── Application Reviews ─────────────────────────────────────────────────────

// Replaces MentorReview. Scoped to DomainApplication, authored by a CycleReviewer.
model ApplicationReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])

  cycleReviewerId String
  cycleReviewer   CycleReviewer @relation(fields: [cycleReviewerId], references: [id])

  scores                Json    @default("{}") // { [criterionKey]: number }
  feedback              String  @default("")
  rejectionRationale    String  @default("")
  overallRecommendation String? // 'Strong Hire' | 'Hire' | 'Lean Hire' | 'Lean No Hire' | 'No Hire'
  annotations           Json    @default("[]") // [{id, fieldKey, start, end, comment, color}]

  submittedAt   DateTime? // null = in progress; non-null = read-only while set
  submittedById String? // records who authored the final review (set on submit, cleared on unsubmit)
  submittedBy   DALIMember? @relation("SubmittedBy", fields: [submittedById], references: [id])

  @@unique([cycleReviewerId, domainApplicationId])
}

// ─── Delibs ──────────────────────────────────────────────────────────────────

enum DelibsType {
  Initial // deliberating on applications with completed reviews, no decision yet
  Final // deliberating after interviews; produces Accept/Waitlist/Reject decisions
}

enum DelibsStatus {
  Active
  Closed
}

// Persisted deliberation session — one per type per domain+cycle (reopened, not recreated).
// columnOrder is the source of truth for kanban ordering during an active session.
// Draft Decisions are only created when the session is closed.
model DelibsSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  type   DelibsType
  status DelibsStatus @default(Active)

  // Ordered list of domainApplicationIds per column.
  // Column names vary by type:
  //   Initial: { "No Decision": [...], "Interview": [...], "Reject": [...] }
  //   Final:   { "Accept": [...], "Waitlist": [...], "Reject": [...] }
  columnOrder Json @default("{}")

  openedById String
  openedBy   DALIMember @relation(fields: [openedById], references: [id])

  @@unique([domainId, applicationCycleId, type])
}

// ─── Rubrics ─────────────────────────────────────────────────────────────────

model Rubric {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  versions RubricVersion[]
}

// Immutable snapshot of a rubric. Never update rows in this table —
// create a new version instead.
// criteria: array of { key, label, description?, maxScore }
model RubricVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  criteria      Json
  rubricId      String
  rubric        Rubric @relation(fields: [rubricId], references: [id])
  createdById   String
  createdBy     User   @relation(fields: [createdById], references: [id])

  // Back-ref: domain+cycle pairs that use this rubric version
  domainApplicationCycles DomainApplicationCycle[]
  // Back-ref: cycles using this as the general form rubric
  cyclesAsGeneralRubric   ApplicationCycle[]       @relation("CycleGeneralRubric")
}

// ─── Collaborative Editing ───────────────────────────────────────────────────

// Stores the Y.js binary state for each collaborative document.
// Document naming convention:
//   review:{reviewId}:feedback
//   review:{reviewId}:rejectionRationale
//   interview:{interviewId}:notes        (joint)
//   interview:{interviewId}:recommendation
model CollabDocument {
  id        String   @id @default(cuid())
  name      String   @unique
  state     Bytes
  updatedAt DateTime @updatedAt

  versions CollabDocumentVersion[]
}

// Periodic snapshots of a CollabDocument's Y.Doc state. One row written per
// onStoreDocument tick (every ~30s during active editing — see persistence.ts
// `maybeSnapshot`). Idle docs accrue no rows. Powers the version-history UI.
model CollabDocumentVersion {
  id        String   @id @default(cuid())
  name      String
  state     Bytes // Y.Doc binary at snapshot time
  plainText String // mirror, for fast preview without decoding `state`
  authorIds String[] // userIds that edited since previous snapshot, best-effort
  createdAt DateTime @default(now())

  collabDocument CollabDocument @relation(fields: [name], references: [name], onDelete: Cascade)

  @@index([name, createdAt(sort: Desc)])
}

// ─── OAuth & Sessions ────────────────────────────────────────────────────────

model OAuthSession {
  id String @id @default(cuid())

  // pkce fields
  codeChallenge       String
  codeChallengeMethod String @default("S256")

  // oAuth params preserved across IDP redirect
  redirectUri String
  state       String
  provider    String // "google" | "cas"
  accountType String? // "member" | "partner" (Google only)

  // set after IDP authenticates user
  userId            String?
  authorizationCode String? @unique
  exchanged         Boolean @default(false)

  // for chained Google → CAS account linking
  linkUserId String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique // sha-256 token hash
  userId          String
  family          String // rotation detection
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  familyCreatedAt DateTime  @default(now()) // absolute session cap anchor

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Email Templates ────────────────────────────────────────────────────────

// Each value maps to one email template. Decision-related values mirror
// DecisionType so releasing a Decision can look up its template directly.
enum EmailTemplateType {
  ApplicationReceived // confirmation after submission
  Rejected // generic rejection (pre-interview)
  RejectedPostInterview // rejection after interview stage
  InvitedToInterview // applicant interview invite
  InterviewInviteMentor // internal: reviewer/mentor interview assignment
  Waitlisted
  Accepted
}

// Legacy single-table email templates (PR #112). Retained while
// ApplicationReceived and InterviewInviteMentor still use the global
// type-keyed lookup. Decision-related types have moved to the new
// EmailTemplate / EmailTemplateVersion / CycleDecisionEmail trio below.
// To be dropped in a follow-up PR after legacy callers are migrated.
model LegacyEmailTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type    EmailTemplateType
  subject String
  body    String
  version Int

  createdById String
  createdBy   DALIMember @relation(fields: [createdById], references: [id])

  @@index([type, createdAt])
}

// Named, versioned email template — independent of any cycle. Mirrors
// Rubric/RubricVersion. The "slot" a template fills (e.g. which DecisionType
// it sends for) is determined by the cycle binding row that points at it.
model EmailTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  versions EmailTemplateVersion[]
}

// Immutable snapshot of an EmailTemplate. Never update — append a new version.
// Subject and body use {{firstName}} interpolation.
model EmailTemplateVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  subject       String
  body          String

  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id])

  createdById String
  createdBy   DALIMember @relation(fields: [createdById], references: [id])

  cycleDecisionEmails     CycleDecisionEmail[]
  cycleNotificationEmails CycleNotificationEmail[]

  @@index([templateId, versionNumber])
}

// Per-cycle binding: which EmailTemplateVersion fires when a Decision of the
// given DecisionType is released in this cycle. One row per (cycle, decisionType).
// No row = no email fires (surfaced explicitly in the picker UI).
model CycleDecisionEmail {
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  decisionType DecisionType

  emailTemplateVersionId String
  emailTemplateVersion   EmailTemplateVersion @relation(fields: [emailTemplateVersionId], references: [id])

  @@id([applicationCycleId, decisionType])
}

// Non-decision email slots managed per-cycle. Mirrors CycleDecisionEmail but
// without the lock-on-release semantics — notification emails can be rebound
// at any time.
enum NotificationType {
  ApplicationReceived
  ApplicationExtensionNotice
  InterviewInviteMentor
  InterviewConfirmedApplicant
  InterviewCancelledApplicant
  InterviewCancelledInterviewer
  InterviewLocationChanged
}

model CycleNotificationEmail {
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  notificationType NotificationType

  emailTemplateVersionId String
  emailTemplateVersion   EmailTemplateVersion @relation(fields: [emailTemplateVersionId], references: [id])

  @@id([applicationCycleId, notificationType])
}

// One row per (cycle, notificationType, applicant). Enforces single-send
// per applicant per cycle per notification type even though an applicant
// can have multiple DomainApplications.
model CycleNotificationSend {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  notificationType NotificationType

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationCycleId, notificationType, applicationId])
  @@index([applicationCycleId, notificationType])
}

// ─── Audit Logging ───────────────────────────────────────────────────────────

// Append-only audit trail of security-relevant events (auth, role changes,
// decision state transitions, email sends). userId is intentionally a free-form
// string rather than an FK so audit rows survive User deletion.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  action    String // e.g. "login.success", "role.change", "decision.release"
  userId    String? // acting user id (null when unattributed)
  targetId  String? // affected resource id
  metadata  Json? // additional context — must not contain secrets, tokens, or PII beyond what's necessary
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Confidentiality Agreements ──────────────────────────────────────────────

// Named, versioned confidentiality agreement — independent of any cycle.
// Mirrors EmailTemplate / Rubric. The hiring lead binds a specific version
// to a cycle via CycleConfidentialityAgreement.
model ConfidentialityAgreement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  versions ConfidentialityAgreementVersion[]
}

// Immutable snapshot of a ConfidentialityAgreement. Never update — append
// a new version. body is ProseMirror JSON.
model ConfidentialityAgreementVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  body          Json

  agreementId String
  agreement   ConfidentialityAgreement @relation(fields: [agreementId], references: [id])

  createdById String
  createdBy   DALIMember @relation(fields: [createdById], references: [id])

  cycleBindings CycleConfidentialityAgreement[]
  signatures    ConfidentialityAgreementSignature[]

  @@index([agreementId, versionNumber])
}

// Per-cycle binding: at most one agreement version may be in force per cycle.
// No row = unbound; in that state nobody (including the hiring lead) can
// view sensitive cycle data.
model CycleConfidentialityAgreement {
  applicationCycleId String           @unique
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  confidentialityAgreementVersionId String
  confidentialityAgreementVersion   ConfidentialityAgreementVersion @relation(fields: [confidentialityAgreementVersionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-user-per-cycle signature. Pinned to the version that was active when
// the user signed — re-binding the cycle to a new version forces re-signing.
model ConfidentialityAgreementSignature {
  id        String   @id @default(cuid())
  signedAt  DateTime @default(now())

  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  confidentialityAgreementVersionId String
  confidentialityAgreementVersion   ConfidentialityAgreementVersion @relation(fields: [confidentialityAgreementVersionId], references: [id])

  @@unique([userId, applicationCycleId])
  @@index([applicationCycleId])
}

// ════════════════════════════════════════════════════════════════════════════
// EXPANSION v0 — Foundational Schema
// Per expansion_plan.md. Adds role model, projects, education, staffing,
// page tree, partners, calendar/scheduling, mentor notes, and notifications.
// ════════════════════════════════════════════════════════════════════════════

// ─── Term ────────────────────────────────────────────────────────────────────

model Term {
  id        String   @id @default(cuid())
  code      String   @unique // "26S", "26X", "27F", etc.
  year      Int
  season    Season
  // sortKey enables chronological sort. Alphabetical sort of `code` breaks
  // because within a year the seasons go W → S → X → F, not alphabetic.
  sortKey   Int      @unique // year * 10 + (W=1, S=2, X=3, F=4)
  startDate DateTime
  endDate   DateTime

  projectAssignments    ProjectAssignment[]
  mentorshipPairs       MentorshipPair[]
  domainLeadAssignments DomainLeadAssignment[]
  coreAssignments       CoreAssignment[]
  instructorAssignments InstructorAssignment[]
  staffingCycles        StaffingCycle[]
  projectTermStatuses   ProjectTermStatus[]
  projectRoleRequests   ProjectRoleRequest[]

  @@index([sortKey])
}

enum Season {
  W // winter
  S // spring
  X // summer
  F // fall
}

// ─── Domain Eligibility ──────────────────────────────────────────────────────

// Tracks qualifications, independent of active assignments.
model DomainEligibility {
  id         String   @id @default(cuid())
  userId     String
  domainId   String
  // Eligibility is monotonic in v1: only goes up.
  level      Level
  promotedAt DateTime @default(now())
  // Actor: a Domain Lead, Core member, or Admin who promoted them.
  promotedBy String?

  user   User   @relation(fields: [userId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([userId, domainId])
}

enum Level {
  P1 // Learner
  P2 // Doer
  P3 // Mentor
}

// ─── Project Assignments / Mentorship Pairs ──────────────────────────────────

model ProjectAssignment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  termId    String
  domainId  String
  // App-level constraint: assignment.level <= the matching
  // DomainEligibility.level for (userId, domainId).
  level     Level
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  domain  Domain  @relation(fields: [domainId], references: [id])

  @@unique([userId, projectId, termId, domainId])
  @@index([userId, termId])
  @@index([projectId, termId])
}

model MentorshipPair {
  id           String @id @default(cuid())
  menteeUserId String
  mentorUserId String
  projectId    String
  termId       String
  domainId     String

  mentee  User    @relation("MenteePairs", fields: [menteeUserId], references: [id])
  mentor  User    @relation("MentorPairs", fields: [mentorUserId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  domain  Domain  @relation(fields: [domainId], references: [id])

  @@unique([menteeUserId, projectId, termId, domainId])
}

// ─── DomainLeadAssignment ────────────────────────────────────────────────────
// Refactored from DALIMember-keyed timeless rows to User-keyed term-scoped rows.
// v0 migration: rename memberId → userId via DALIMember.userId; add termId
// (backfill to current term).

model DomainLeadAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  memberId String
  domainId String
  termId   String

  member DALIMember @relation(fields: [memberId], references: [id])
  domain Domain     @relation(fields: [domainId], references: [id])
  term   Term       @relation(fields: [termId], references: [id])

  @@unique([memberId, domainId, termId])
  @@index([domainId, termId])
}

// ─── Core / Instructor / Admin ───────────────────────────────────────────────

model CoreAssignment {
  id        String  @id @default(cuid())
  userId    String
  termId    String
  // Display label only; never appears in permission checks.
  leadTitle String?

  user User @relation(fields: [userId], references: [id])
  term Term @relation(fields: [termId], references: [id])

  @@index([userId, termId])
  @@index([termId, leadTitle])
}

model InstructorAssignment {
  id         String @id @default(cuid())
  userId     String
  offeringId String
  termId     String

  user     User              @relation(fields: [userId], references: [id])
  offering EducationOffering @relation(fields: [offeringId], references: [id])
  term     Term              @relation(fields: [termId], references: [id])

  @@unique([userId, offeringId])
}

model AdminMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id])
}

// ─── JobCodeLookup ───────────────────────────────────────────────────────────

model JobCodeLookup {
  id             String         @id @default(cuid())
  // Match against (assignmentType, level, domainId). Nullable fields act
  // as wildcards in the lookup.
  assignmentType AssignmentType
  level          Level?
  domainId       String?
  jobCode        String
  payRateUsdHour Decimal?
  notes          String?
}

enum AssignmentType {
  Project
  Core
  Instructor
  DomainLead
  Admin
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  name          String
  // Project-owned Google Workspace identity.
  calendarEmail String?
  // Term the project was first activated.
  firstTermId   String?
  status        ProjectStatus @default(Active)

  // Auto-created on Project creation.
  overviewPageId String? @unique
  overviewPage   Page?   @relation("ProjectOverview", fields: [overviewPageId], references: [id])

  partners        ProjectPartner[]
  termStatuses    ProjectTermStatus[]
  assignments     ProjectAssignment[]
  roleRequests    ProjectRoleRequest[]
  mentorshipPairs MentorshipPair[]
  sprints         Sprint[]
  epics           Epic[]
  tasks           Task[]
  essentialityForms EssentialityForm[]
  mentorNotes      MentorNote[]

  createdAt DateTime @default(now())
}

enum ProjectStatus {
  Active
  Paused
  Archived
}

model ProjectTermStatus {
  id           String   @id @default(cuid())
  projectId    String
  termId       String
  isContinuing Boolean
  setBy        String?
  setAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([projectId, termId])
}

model Epic {
  id               String     @id @default(cuid())
  projectId        String
  title            String
  descriptionDocId String?
  status           EpicStatus @default(Open)
  targetTermId     String?
  position         Int        @default(0)

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]

  createdAt DateTime @default(now())
}

enum EpicStatus {
  Open
  InProgress
  Done
  Cancelled
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  startsAt  DateTime
  endsAt    DateTime
  goalDocId String?
  status    SprintStatus @default(Planned)

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]

  @@index([projectId, status])
}

enum SprintStatus {
  Planned
  Active
  Closed
}

model Task {
  id               String     @id @default(cuid())
  projectId        String
  // Null sprintId = backlog.
  sprintId         String?
  epicId           String?

  title            String
  descriptionDocId String?
  status           TaskStatus @default(Todo)
  priority         Priority   @default(Normal)
  position         Int        @default(0)

  // Subtasks: simple checklist field.
  // JSON shape: [{ "text": "...", "done": false }]
  checklist        Json?

  project   Project        @relation(fields: [projectId], references: [id])
  sprint    Sprint?        @relation(fields: [sprintId], references: [id])
  epic      Epic?          @relation(fields: [epicId], references: [id])
  assignees TaskAssignee[]
  comments  TaskComment[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, sprintId])
}

enum TaskStatus {
  Todo
  InProgress
  InReview
  Done
  Cancelled
}

enum Priority {
  Low
  Normal
  High
  Urgent
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
}

// ─── Education ───────────────────────────────────────────────────────────────

model EducationOffering {
  id                   String         @id @default(cuid())
  type                 OfferingType
  title                String
  descriptionDocId     String?
  capacity             Int
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  startsAt             DateTime
  endsAt               DateTime
  status               OfferingStatus @default(Draft)
  requiresReview       Boolean
  calendarEmail        String?

  instructors          InstructorAssignment[]
  sessions             EducationSession[]
  applications         EducationApplication[]
  applicationQuestions EducationApplicationQuestion[]
  assignments          EducationAssignment[]
  announcements        EducationAnnouncement[]

  createdAt DateTime @default(now())
}

enum OfferingType {
  Miniseries
  Workshop
}

enum OfferingStatus {
  Draft
  Published
  Archived
}

model EducationSession {
  id             String   @id @default(cuid())
  offeringId     String
  sequence       Int
  datetime       DateTime
  location       String?
  materialsDocId String?
  recordingUrl   String?

  offering    EducationOffering     @relation(fields: [offeringId], references: [id])
  attendances EducationAttendance[]
  assignments EducationAssignment[]

  @@index([offeringId, sequence])
}

model EducationApplication {
  id          String               @id @default(cuid())
  studentId   String
  offeringId  String
  status      EduApplicationStatus
  submittedAt DateTime             @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  student     User                         @relation(fields: [studentId], references: [id])
  offering    EducationOffering            @relation(fields: [offeringId], references: [id])
  answers     EducationApplicationAnswer[]
  attendances EducationAttendance[]

  @@unique([studentId, offeringId])
}

enum EduApplicationStatus {
  Submitted
  Approved
  Rejected
  Waitlisted
  Withdrawn
}

model EducationApplicationQuestion {
  id         String  @id @default(cuid())
  offeringId String
  prompt     String
  position   Int
  required   Boolean @default(true)

  offering EducationOffering            @relation(fields: [offeringId], references: [id])
  answers  EducationApplicationAnswer[]

  @@index([offeringId, position])
}

model EducationApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  content       String

  application EducationApplication         @relation(fields: [applicationId], references: [id])
  question    EducationApplicationQuestion @relation(fields: [questionId], references: [id])

  @@unique([applicationId, questionId])
}

model EducationAttendance {
  id            String           @id @default(cuid())
  applicationId String
  sessionId     String
  status        AttendanceStatus

  application EducationApplication @relation(fields: [applicationId], references: [id])
  session     EducationSession     @relation(fields: [sessionId], references: [id])

  @@unique([applicationId, sessionId])
}

enum AttendanceStatus {
  Present
  Absent
  Excused
}

model EducationAssignment {
  id                String         @id @default(cuid())
  // Exactly one of offeringId/sessionId should be set (app-level).
  offeringId        String?
  sessionId         String?
  title             String
  instructionsDocId String?
  dueAt             DateTime?
  submissionType    SubmissionType

  offering    EducationOffering?    @relation(fields: [offeringId], references: [id])
  session     EducationSession?     @relation(fields: [sessionId], references: [id])
  submissions EducationSubmission[]
}

enum SubmissionType {
  Text
  File
  Mixed
}

model EducationSubmission {
  id            String    @id @default(cuid())
  assignmentId  String
  studentId     String
  contentDocId  String?
  files         Json?
  submittedAt   DateTime?
  gradedAt      DateTime?
  feedbackDocId String?

  assignment EducationAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, studentId])
}

model EducationAnnouncement {
  id         String   @id @default(cuid())
  offeringId String
  authorId   String
  body       String
  sentAt     DateTime @default(now())

  offering EducationOffering @relation(fields: [offeringId], references: [id])
}

// ─── Staffing ────────────────────────────────────────────────────────────────

model StaffingCycle {
  id                      String         @id @default(cuid())
  termId                  String
  name                    String
  opensAt                 DateTime
  closesAt                DateTime
  maxPreferencesPerMember Int            @default(3)
  status                  StaffingStatus @default(Draft)

  term              Term                 @relation(fields: [termId], references: [id])
  preferences       StaffingPreference[]
  essentialityForms EssentialityForm[]
  assignments       StaffingAssignment[]
}

enum StaffingStatus {
  Draft
  OpenToCoreFirst
  OpenToMembers
  Assigning
  Closed
}

model ProjectRoleRequest {
  id         String  @id @default(cuid())
  projectId  String
  termId     String
  domainId   String
  level      Level
  slots      Int
  notesDocId String?

  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  domain  Domain  @relation(fields: [domainId], references: [id])

  @@index([projectId, termId])
}

model StaffingPreference {
  id              String  @id @default(cuid())
  userId          String
  staffingCycleId String
  projectId       String
  domainId        String
  level           Level
  preferenceRank  Int
  notes           String?

  user          User          @relation(fields: [userId], references: [id])
  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])

  @@unique([userId, staffingCycleId, projectId, domainId, level])
  @@index([staffingCycleId, userId])
}

model EssentialityForm {
  id              String    @id @default(cuid())
  projectId       String
  staffingCycleId String
  pmUserId        String
  submittedAt     DateTime?

  project       Project              @relation(fields: [projectId], references: [id])
  staffingCycle StaffingCycle        @relation(fields: [staffingCycleId], references: [id])
  pmUser        User                 @relation(fields: [pmUserId], references: [id])
  ratings       EssentialityRating[]

  @@unique([projectId, staffingCycleId])
}

model EssentialityRating {
  id                 String            @id @default(cuid())
  essentialityFormId String
  userId             String
  rating             EssentialityLevel
  notes              String?

  form EssentialityForm @relation(fields: [essentialityFormId], references: [id])
  user User             @relation(fields: [userId], references: [id])

  @@unique([essentialityFormId, userId])
}

enum EssentialityLevel {
  Critical
  Important
  NiceToHave
  NotNeeded
}

model StaffingAssignment {
  id              String           @id @default(cuid())
  userId          String
  staffingCycleId String
  projectId       String
  termId          String
  domainId        String
  level           Level
  status          AssignmentStatus @default(Proposed)
  assignedAt      DateTime         @default(now())
  assignedById    String?

  user          User          @relation(fields: [userId], references: [id])
  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])

  @@index([userId, termId])
  @@index([projectId, termId])
}

// ─── Calendar / Scheduling ───────────────────────────────────────────────────

model UserCalendarLink {
  id             String      @id @default(cuid())
  userId         String
  provider       CalProvider
  externalEmail  String
  displayName    String?
  // Encrypted at rest; never logged. AES-256-GCM ciphertext via app/lib/calendar-crypto.ts.
  oauthTokens    String
  primary        Boolean     @default(true)
  enabled        Boolean     @default(true)
  // Sub-calendar IDs (from the provider) that should contribute to busy.
  // If empty, the link's primary calendar is used.
  subCalendarIds String[]
  linkedAt       DateTime    @default(now())
  lastSyncedAt   DateTime?
  syncError      String?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider, externalEmail])
  @@index([userId])
}

enum CalProvider {
  Google
  Outlook
}

model ScheduledMeeting {
  id                 String        @id @default(cuid())
  organizerId        String
  organizer          User          @relation(fields: [organizerId], references: [id])
  title              String
  descriptionDocId   String?
  durationMinutes    Int

  scopeType          ScopeType
  // Untyped at DB layer — dispatched in app code by scopeType.
  scopeId            String?

  participantUserIds String[]
  selectedAt         DateTime?
  externalEventId    String?
  status             MeetingStatus @default(Searching)

  // RFC 5545 RRULE for recurring meetings.
  recurrenceRule     String?

  // Resolved at create-time from scopeType/scopeId.
  ownerCalendarEmail String

  exceptions MeetingException[]

  createdAt DateTime @default(now())
}

enum ScopeType {
  Project
  Group
  UserList
  Series
  None
}

enum MeetingStatus {
  Searching
  Confirmed
  Cancelled
}

model GroupDefinition {
  id              String    @id @default(cuid())
  name            String
  type            GroupType
  // For dynamic groups: structured query identifier (e.g. "core:current-term").
  dynamicQuery    String?
  // For static groups: explicit member list.
  staticMemberIds String[]

  createdAt DateTime @default(now())
}

enum GroupType {
  Static
  Dynamic
}

model MeetingException {
  id                  String   @id @default(cuid())
  scheduledMeetingId  String
  // The original occurrence start time being overridden.
  originalStart       DateTime
  overrideStart       DateTime?
  overrideDurationMin Int?
  overrideTitle       String?
  cancelled           Boolean  @default(false)

  meeting ScheduledMeeting @relation(fields: [scheduledMeetingId], references: [id])

  @@unique([scheduledMeetingId, originalStart])
}

// Per-user calendar preferences. Lazily upserted on first write.
model UserAvailabilitySettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  // IANA zone, e.g. "America/New_York". Working hours are interpreted in this zone.
  timezone              String   @default("America/New_York")
  defaultEventBufferMin Int      @default(15)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// One row per user per weekday. startMinute/endMinute are minutes-from-local-midnight
// (0–1440), applied in the user's UserAvailabilitySettings.timezone.
model WorkingHoursDay {
  id          String       @id @default(cuid())
  userId      String
  dayOfWeek   Int          // 0=Sunday .. 6=Saturday
  enabled     Boolean      @default(true)
  startMinute Int          @default(540)  // 9:00
  endMinute   Int          @default(1020) // 17:00
  location    WorkLocation @default(InPerson)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

enum WorkLocation {
  InPerson
  Remote
}

// User-defined busy blocks, optionally recurring (RFC 5545 RRULE).
model ManualBlock {
  id              String   @id @default(cuid())
  userId          String
  title           String
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean  @default(false)
  // Nullable: a one-off block has no rule. When set, startTime/endTime define
  // the first occurrence; subsequent ones are expanded by rrule.
  recurrenceRule  String?
  // Optional cached UNTIL for query bounds; not authoritative.
  recurrenceUntil DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startTime])
}

// ─── Page Tree ───────────────────────────────────────────────────────────────

model Page {
  id            String        @id @default(cuid())
  workspaceType WorkspaceType
  // Null for Lab workspace. Otherwise FK to Project / EducationOffering.
  workspaceId   String?
  // Null for top-level pages. App-level constraint enforces 2-level cap.
  parentPageId  String?
  title         String
  kind          PageKind      @default(FreeForm)
  // Collab doc reference for FreeForm pages. Null for Structured pages.
  contentDocId  String?
  position      Int           @default(0)

  iconEmoji     String?
  coverImageUrl String?

  lastEditedById String?

  // Soft delete.
  archivedAt DateTime?

  parent   Page?  @relation("PageTree", fields: [parentPageId], references: [id])
  children Page[] @relation("PageTree")

  // Reverse of Project.overviewPage.
  projectAsOverview Project? @relation("ProjectOverview")

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceType, workspaceId, parentPageId])
  @@index([archivedAt])
}

enum WorkspaceType {
  Lab
  Project
  EducationOffering
}

enum PageKind {
  FreeForm
  Structured
}

model PageTemplate {
  id             String          @id @default(cuid())
  name           String
  description    String?
  // Empty array = available everywhere.
  workspaceTypes WorkspaceType[]
  // On Page create, new page's contentDoc is initialized from a clone.
  contentDocId   String
  iconEmoji      String?
  isDefault      Boolean         @default(false)
  createdBy      String?
  createdAt      DateTime        @default(now())
}

// ─── Mentorship ──────────────────────────────────────────────────────────────

model MentorNote {
  id           String   @id @default(cuid())
  mentorId     String
  menteeId     String
  projectId    String
  termId       String
  domainId     String
  // Start-of-week (Monday) the note covers. App enforces uniqueness per week.
  weekOf       DateTime
  // Note body as collab doc.
  contentDocId String

  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mentorId, menteeId, projectId, termId, domainId, weekOf])
}

model MentorNoteTemplate {
  id            String   @id @default(cuid())
  name          String
  contentDocId  String
  isDefault     Boolean  @default(false)
  lastUpdatedBy String?
  updatedAt     DateTime @updatedAt
}

// ─── Notifications ───────────────────────────────────────────────────────────

model NotificationEvent {
  id             String    @id @default(cuid())
  // Typed event identifier (e.g. "interview_scheduled", "sprint_due").
  type           String
  recipientId    String
  payload        Json
  readAt         DateTime?
  inAppDelivered Boolean   @default(false)
  emailDelivered Boolean   @default(false)
  createdAt      DateTime  @default(now())

  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model NotificationPreference {
  id              String     @id @default(cuid())
  userId          String
  // Matches NotificationEvent.type, or "*" for the user's global default.
  eventType       String
  inApp           Boolean    @default(true)
  email           Boolean    @default(true)
  digestFrequency DigestFreq @default(Instant)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, eventType])
}

enum DigestFreq {
  Instant
  Daily
  Weekly
  Off
}

// ─── Partner Portal ──────────────────────────────────────────────────────────

model PartnerOrg {
  id               String   @id @default(cuid())
  name             String
  logoUrl          String?
  website          String?
  // Optional designated primary contact (FK to PartnerUser within this org).
  primaryContactId String?
  // True for solo-individual partners modeled as a single-user org.
  isIndividual     Boolean  @default(false)

  users    PartnerUser[]
  projects ProjectPartner[]

  createdAt DateTime @default(now())
}

model PartnerUser {
  id           String              @id @default(cuid())
  partnerOrgId String
  name         String
  email        String              @unique
  displayRole  String?
  authProvider PartnerAuthProvider

  partnerOrg PartnerOrg @relation(fields: [partnerOrgId], references: [id])

  createdAt DateTime @default(now())
}

enum PartnerAuthProvider {
  MagicLink
  Google
}

model ProjectPartner {
  id           String    @id @default(cuid())
  projectId    String
  partnerOrgId String
  startedAt    DateTime?
  endedAt      DateTime?

  project    Project    @relation(fields: [projectId], references: [id])
  partnerOrg PartnerOrg @relation(fields: [partnerOrgId], references: [id])

  @@unique([projectId, partnerOrgId])
}
