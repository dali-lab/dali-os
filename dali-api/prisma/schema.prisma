// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Authoritative lab-membership status. Stored (not derived per-call) and
// recomputed only at transitions — see membershipStatus below and
// app/lib/membership-status.ts.
enum MembershipStatus {
  Active
  Alumni
}

model User {
  // unique identifier
  id String @id @default(cuid())

  // metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Identity (≥1 must be non-null for an auth path to land) ──────────────
  // netId is the canonical Dartmouth identifier (same value as the historical
  // "did" Dartmouth ID; case-normalized to lowercase here). CAS callbacks
  // write to this column. DALIMember.did is dropped in Phase 2 after a
  // backfill into User.netId.
  netId          String? @unique // Dartmouth NetID / DID
  daliEmail      String? @unique // @dali.dartmouth.edu Google
  dartmouthEmail String? @unique // @dartmouth.edu Google
  // Personal (non-Dartmouth) email. Used by alumni post-grad after
  // @dali.dartmouth.edu revocation and as the magic-link target for partners.
  personalEmail  String? @unique
  // Slack user id (e.g. "U0123ABCD"), populated by a daliEmail → Slack
  // lookup (see slack-client.lookupSlackUserByEmail in the reminders
  // follow-up). Nullable: a user with no resolved Slack id silently skips
  // any DM-based notification rather than blocking the feature.
  slackUserId    String? @unique

  // ─── Names — single source of truth ───────────────────────────────────────
  firstName String
  lastName  String

  // IANA zone, e.g. "America/New_York". Used by calendar/scheduling.
  timeZone String?

  // ─── Profile fields (Phase 1 additions; all nullable) ─────────────────────
  // Dartmouth class year (e.g., 2026). Solves the "took a term off"
  // ambiguity. Input to membership-status recompute + display.
  classYear   Int?
  // Optional explicit graduation override for off-cycle graduations. A manual
  // input to the status recompute (Alumni once past); never auto-stamped.
  graduatedAt DateTime?

  // ─── Membership status (authoritative, stored) ────────────────────────────
  // Recomputed at transitions (term rollover, login, mutation) — never derived
  // per request. See app/lib/membership-status.ts. Only meaningful when a
  // DALIMember row is present; non-members keep the inert Active default.
  membershipStatus           MembershipStatus  @default(Active)
  // Manual pin. When set it wins over recompute and is never clobbered —
  // handles BE dual-degree candidates (Active while enrolled), non-student
  // staff (never graduate), and any misclassification.
  membershipStatusOverride   MembershipStatus?
  // Observability: when the stored status was last (re)computed.
  membershipStatusComputedAt DateTime?

  // ─── Dartmouth directory signals (cached inputs) ──────────────────────────
  // From api.dartmouth.edu/api/people/{netid} (JWT-authenticated), refreshed
  // at transitions. Inputs to the status recompute; see dartmouth-people.ts.
  // dartmouthAffiliation: raw IDM code ("DART" | "ALUMNI" | "E-FAC" | ...).
  // Stays DART for months post-graduation — the slow long-tail signal.
  dartmouthAffiliation     String?
  // "Alum" in the affiliations array — degree conferred; appears within weeks
  // of Commencement. The prompt graduation signal.
  dartmouthIsAlum          Boolean?
  // "Student" in the affiliations array. Lingers after graduation, so
  // currently-enrolled is the compound: isStudent AND NOT isAlum.
  dartmouthIsStudent       Boolean?
  // Raw department_class from the People API: an undergrad class year ("'27")
  // or a grad/professional program code ("TH" Thayer, "GR" Guarini, "DM"
  // Geisel, "TU27" Tuck). A program code means currently enrolled in that
  // school, so a student who ALSO carries "Alum" (a prior Dartmouth degree) is
  // Active, not Alumni — see resolveMembershipStatus.
  dartmouthDepartmentClass String?
  dartmouthPeopleSyncedAt  DateTime?

  pronouns       String?
  photoUrl       String?
  // Bio stored as a collab doc reference for rich formatting + @mentions.
  bioDocId       String?
  major          String?
  hometown       String?
  linkedinUrl    String?
  // Bare GitHub login (e.g. "octocat"). Used to add the member to their
  // project's GitHub team during staffing finalize, and to derive a profile
  // link in the UI. Editable in member details; nullable — a member with no
  // username is silently skipped (and reported) by that automation.
  githubUsername String?
  personalSite   String?
  // Opt-in to the public dali.website team directory. The public API serves
  // only members with this set, and only ever a hard-coded narrow field set
  // (see app/public-api/lib/public-team.server.ts) — never the onboarding
  // fields below, the identity columns above, or anything else on this model.
  // Backfilled true for everyone with a project/Core assignment, preserving
  // the behavior of the Notion-backed team page it replaces.
  publicProfile  Boolean @default(false)
  // Short public handle for @-mentions (e.g. "spark" for Sophie Park). Seeded
  // from first-initial + last-name (lowercased), auto-suffixed on collision,
  // and editable in profile. Nullable + unique like the other identity handles;
  // a user with no handle simply can't be @-mentioned until they set one.
  handle         String? @unique

  // Per-member secret mixed into the signed barcode carried by the member's
  // Apple/Google Wallet membership pass (see app/lib/wallet-token.ts). Set
  // lazily the first time they download a pass; rotating it revokes every
  // barcode they've issued (lost phone / abuse) — the scan endpoint verifies
  // against this value. Null = no pass issued (or revoked to nothing); a null
  // secret never verifies. Server-only; never crosses the wire.
  walletPassSecret String?

  // ─── Onboarding profile fields (collected on the New Member Profile form) ──
  // Name as it appears on file with the College, when different from the
  // first/last above (e.g. a legal name). Optional — blank means "same".
  nameOnFile          String?
  phoneNumber         String?
  birthday            DateTime?
  // Free-text demographic; collected optionally (includes a "Prefer not to
  // say" choice on the form). Stored as the selected label.
  ethnicity           String?
  dietaryRestrictions String?

  // Manual onboarding step tracking: Figma can't be invited via API, so an admin
  // marks the member as invited to the DALI Figma from the onboarding board.
  // Null = not yet invited; the timestamp records when it was checked off.
  figmaInvitedAt DateTime?

  // ─── Presence ─────────────────────────────────────────────────────────────
  // Bumped at most once per 60s in requireAuth (fire-and-forget). Null = never
  // active since the column was added. hideActivity gates display only; the
  // write path always records.
  lastActiveAt DateTime?
  hideActivity Boolean   @default(false)

  // ─── Relations: existing ──────────────────────────────────────────────────
  daliMember                    DALIMember?
  applicationCycleStatusUpdates ApplicationCycleStatusUpdate[]
  applications                  Application[]
  applicationStatusUpdates      ApplicationStatusUpdate[]
  oauthSessions                 OAuthSession[]
  sessions                      Session[]
  rubricVersions                RubricVersion[]
  authoredSigningVersions       SigningDocumentVersion[]       @relation("SigningVersionAuthor")
  signingSignatures             SigningSignature[]             @relation("SigningSigner")

  // ─── Calendar / scheduling relations ───────────────────────────────────────
  calendarLinks        UserCalendarLink[]
  scheduledMeetings    ScheduledMeeting[]
  availabilitySettings UserAvailabilitySettings?
  workingHoursDays     WorkingHoursDay[]
  meetingAttendances   MeetingAttendance[]
  timeEntries          TimeEntry[]
  memberClasses        MemberClass[]

  // ─── Phase 1: foundational role-model back-relations ──────────────────────
  domainEligibilities      DomainEligibility[]
  projectAssignments       ProjectAssignment[]
  coreAssignments          CoreAssignment[]
  instructorAssignments    InstructorAssignment[]
  adminMembership          AdminMembership?
  mentorshipPairsAsMentee  MentorshipPair[]       @relation("MenteePairs")
  mentorshipPairsAsMentor  MentorshipPair[]       @relation("MentorPairs")
  staffingMentorRoles      StaffingMentorRole[]
  externalMentorPlacements ExternalMentor[]

  // ─── Phase 1: project workspace back-relations ────────────────────────────
  createdTasks               Task[]               @relation("TaskCreatedBy")
  taskAssignees              TaskAssignee[]
  taskComments               TaskComment[]
  taskViews                  TaskView[]
  projectDomainScopesUpdated ProjectDomainScope[] @relation("ProjectDomainScopeUpdatedBy")

  // ─── Phase 1: staffing back-relations ─────────────────────────────────────
  staffingPreferences   StaffingPreference[]
  essentialityFormsAsPm EssentialityForm[]         @relation("EssentialityFormPm")
  essentialityRatings   EssentialityRating[]
  staffingAssignments   StaffingAssignment[]
  staffingBoardMembers  StaffingBoardMember[]
  staffingCardOrders    StaffingCardOrder[]
  intentToWork          IntentToWork[]
  formsCreated          Form[]
  formVersions          FormVersion[]
  formSubmissions       FormSubmission[]
  formBindingsSet       StaffingCycleFormBinding[]

  // ─── Phase 1: education back-relations ────────────────────────────────────
  educationApplications  EducationApplication[]  @relation("EducationApplicant")
  educationSubmissions   EducationSubmission[]   @relation("EducationSubmissionStudent")
  educationAnnouncements EducationAnnouncement[] @relation("EducationAnnouncementAuthor")

  // ─── Education LMS expansion back-relations ───────────────────────────────
  educationDiscussionPosts    EducationDiscussionPost[] @relation("EducationDiscussionAuthor")
  educationNoteFeedbackAuthor EducationStudentNote[]    @relation("EduNoteFeedbackAuthor")
  educationNoteInternalAuthor EducationStudentNote[]    @relation("EduNoteInternalAuthor")
  ceCredits                   CECredit[]                @relation("CECreditUser")
  ceCreditsGranted            CECredit[]                @relation("CECreditGrantor")
  educationCertificatesIssued EducationCertificate[]    @relation("EducationCertificateIssuer")
  educationFormBindingsSet    EducationFormBinding[]    @relation("EducationFormBindingUpdater")
  educationOfferingsClosedOut EducationOffering[]       @relation("EducationOfferingClosedOutBy")

  // ─── Phase 1: mentorship back-relations ───────────────────────────────────
  mentorNotesAsMentor MentorNote[] @relation("MentorNoteMentor")
  mentorNotesAsMentee MentorNote[] @relation("MentorNoteMentee")

  // ─── Phase 1: page-tree back-relations ────────────────────────────────────
  createdPages    Page[]         @relation("PageCreatedBy")
  lastEditedPages Page[]         @relation("PageLastEditedBy")
  favorites       UserFavorite[]

  // ─── Phase 1: notification back-relations ─────────────────────────────────
  notificationPreferences NotificationPreference[]
  taskReminders           TaskReminder[]
  scheduledAnnouncements  ScheduledAnnouncement[]

  // ─── Phase 1: partner back-relation (single per User) ─────────────────────
  // partnerUser is deprecated (see PartnerUser); new code reads partnerContact.
  partnerUser    PartnerUser?
  partnerContact PartnerContact?

  // ─── Phase 1: OAuth / magic-link back-relations ───────────────────────────
  oauthGrants    OAuthGrant[]
  oneTimeTokens  OneTimeToken[]
  devicePairings DevicePairing[]

  // ─── Phase 1: Gmail integration (single per User) ─────────────────────────
  gmailIntegrations     GmailIntegration[]
  // ─── Notification relations ────────────────────────────────────────────────
  receivedNotifications Notification[]     @relation("NotificationRecipient")
  authoredNotifications Notification[]     @relation("NotificationAuthor")

  // ─── Phase 2: hiring FK back-relations (formerly via DALIMember) ──────────
  cycleReviewers               CycleReviewer[]
  cycleInterviewers            CycleInterviewer[]
  domainLeadAssignmentsAsUser  DomainLeadAssignment[]
  decisionsMade                Decision[]             @relation("DecisionMadeBy")
  applicationReviewsSubmitted  ApplicationReview[]    @relation("ApplicationReviewSubmittedBy")
  delibsSessionsOpened         DelibsSession[]
  emailTemplateVersionsCreated EmailTemplateVersion[]

  // ─── Documents & files ───────────────────────────────────────────────────
  projectFileVersionsUploaded ProjectFileVersion[] @relation("ProjectFileVersionUploader")
  docComments                 DocComment[]         @relation("DocCommentAuthor")
  docCommentReactions         DocCommentReaction[]

  // ─── Page documentation (per-page guides) ─────────────────────────────────
  pageDocsMaintained PageDoc[] @relation("PageDocMaintainer")
  pageDocsCreated    PageDoc[] @relation("PageDocCreatedBy")
  pageDocsLastEdited PageDoc[] @relation("PageDocLastEditedBy")

  // ─── Payroll: Reconcile back-relation ─────────────────────────────────────
  timesheetImports TimesheetImport[]
  customHires      CustomHire[]

  // ─── Public showcase ──────────────────────────────────────────────────────
  projectShowcasesUpdated ProjectShowcase[] @relation("ProjectShowcaseUpdatedBy")
}

// A DALI lab member. userId is optional because a member may be known (e.g. via daliEmail)
// before they have created a User account.
// Thin lab-membership marker. Presence = the User is a hired lab member.
// All display/identity fields live on User (firstName, lastName, daliEmail,
// dartmouthEmail, netId, did-equivalent). Hiring FKs now point at User
// directly; this model exists only to discriminate Member from
// non-Member Users.
model DALIMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null until the member finishes the first-login onboarding flow
  // (/onboarding). The layout loader redirects members with a null value into
  // onboarding. Pre-existing members are backfilled to createdAt by the
  // migration so they're never forced through it.
  onboardedAt DateTime?

  // Null until the member finishes (or dismisses) the launch tour. The tour is
  // shown once per USER (server-driven, not browser localStorage) on the first
  // home visit after onboarding. Pre-existing members are backfilled so they
  // don't suddenly get the tour.
  tourCompletedAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model ApplicationCycle {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Human-readable label (e.g. "Fall 2026"). No enforced format — cycles may
  // be non-standard (e.g. only one domain hiring). Dates are tracked via
  // ApplicationCycleStatusUpdate rather than stored directly here.
  name String

  // Application due date; triggers auto-transition to UnderReview when passed.
  closeDate DateTime?

  // Pre-extension closeDate. Set on first extension; cleared when the lead
  // resets the close date via the picker. Nullable, no backfill needed.
  originalCloseDate DateTime?

  // Idempotency marker for the extension-notice blast. Set when the notice
  // is sent; cleared when the extension is removed so re-extending later
  // can re-trigger the notice.
  extensionNoticeSentAt DateTime?

  // Idempotency marker for the internal-cycle eligibility notification fan-out
  // (Fellowship/Core, sent when the cycle first transitions to Open). Stays set
  // across Open→Draft→Open bounces so leads can iterate during setup without
  // re-spamming eligible members. Always null on Standard cycles.
  applicantsNotifiedAt DateTime?

  // Rubric for the general application form (reviewers score this alongside
  // the per-domain rubric set on DomainApplicationCycle).
  generalRubricVersionId String?
  generalRubricVersion   RubricVersion? @relation("CycleGeneralRubric", fields: [generalRubricVersionId], references: [id])

  // Blind review. When true (Standard cycles only), applicant identity — name,
  // photo, email, class year, pronouns — is hidden from reviewers behind a
  // stable pseudonym ("Applicant N") on the reviewer + Initial-delibs surfaces,
  // until a decision is Released for them (i.e. they move into interviews).
  // Core/lead cycle-management views are never blinded. Default on (opt-out per
  // cycle in setup); see app/hiring/lib/anonymization.server.ts.
  anonymizeReview Boolean @default(true)

  // Discriminator. Standard = the normal hire cycle (CAS-authed applicants,
  // general form + per-domain challenge + interviews). Fellowship = current
  // interns converting to full-time; Core = current members applying to join
  // Core. Both internal types use a shorter DB-backed shortform, no challenges,
  // no interviews. One active cycle per cycleType is enforced at the route
  // layer (see findOtherActiveCycleId).
  cycleType ApplicationCycleType @default(Standard)

  // The cycle's application form (a Drive Form). For internal cycles
  // (Fellowship/Core) this is the whole application form; it stays UNPUBLISHED —
  // the hiring portal reads its latest version directly and eligibility is the
  // fill gate. Auto-created + rebindable via app/hiring/lib/application-form.server.ts.
  applicationFormId String?
  applicationForm   Form?   @relation("CycleApplicationForm", fields: [applicationFormId], references: [id])

  statusUpdates        ApplicationCycleStatusUpdate[]
  applications         Application[]
  domains              DomainApplicationCycle[]
  domainChallengeForms CycleDomainForm[]

  interviewConfig    InterviewConfig?
  cycleReviewers     CycleReviewer[]
  cycleInterviewers  CycleInterviewer[]
  interviews         Interview[]
  delibsSessions     DelibsSession[]
  decisionEmails     CycleDecisionEmail[]
  notificationEmails CycleNotificationEmail[]

  signingBindings SigningBinding[]
}

// Applicant-initiated status changes only. DALI-initiated outcomes (interview,
// offer, rejection) are tracked in a separate decisions table to record who
// made the decision and whether it has been communicated to the applicant.
enum ApplicationStatus {
  Draft
  Submitted
  Withdrawn
}

model ApplicationStatusUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  newStatus     ApplicationStatus
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])

  // Status resolution fetches the latest update per application.
  @@index([applicationId, createdAt])
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // answers: map of question UUID key -> answer value (JSON). Saved incrementally
  // as the applicant fills out the form; finalized on submission.
  answers Json

  userId                   String
  user                     User             @relation(fields: [userId], references: [id])
  applicationCycleId       String
  applicationCycle         ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  // The FormVersion of the cycle's application form (a Drive Form) that this
  // applicant answered, pinned at creation so later edits to the form don't
  // change an in-progress draft.
  applicationFormVersionId String?
  applicationFormVersion   FormVersion?     @relation("ApplicationApplicationForm", fields: [applicationFormVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Phase 1: distinguishes the application's purpose. Standard = regular DALI
  // hire cycle (only value used today). Intern = shorter form for intern
  // programs (ERAS, EEJUST, WISP). Fellowship = current intern applying for
  // regular hire. Core = current member applying to join Core. Transfer =
  // informal internal domain transfer.
  applicationType ApplicationType @default(Standard)

  statusUpdates      ApplicationStatusUpdate[]
  domainApplications DomainApplication[]

  @@unique([userId, applicationCycleId])
  // By-cycle listings can't use the unique above (wrong leading column).
  @@index([applicationCycleId])
}

enum ApplicationType {
  Standard
  Intern
  Fellowship
  Core
  Transfer
}

// Cycle-level discriminator. Drives form rendering, eligibility gating,
// interview/challenge presence, and delibs column layout. Fellowship and Core
// are the "internal" cycle types (member-authed portal, shortform, no
// interviews) — see app/hiring/lib/internal-cycles.server.ts.
enum ApplicationCycleType {
  Standard
  Fellowship
  Core
}

// One DomainApplication per (application, target domain). `domainId` is the
// single source of truth for "what domain is this for". Standard cycles pin the
// per-domain challenge Form the applicant answered via challengeFormVersionId;
// internal (Fellowship/Core) cycles have no per-domain challenge (null).
model DomainApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // answers: same shape as Application.answers, keyed by question UUID from
  // the challenge version. Empty `{}` on internal cycles (no per-domain content).
  answers Json

  // Free-form note written by leads during Initial delibs ("specific things to
  // bring up in the interview"). Edited live as a collaborative doc
  // (domainApplication:{id}:prepNote); this column is the plaintext mirror that
  // the read-only interview page reads.
  interviewPrepNote String?

  // Whether this domain is currently selected by the applicant.
  // False means the applicant deselected the domain but the record is
  // preserved so answers survive re-selection.
  selected Boolean @default(true)

  // Administrative closure of an otherwise-undecided DA. Set when the applicant
  // is accepted into a *different* domain in the same cycle (single placement:
  // an Accept is final, so the sibling domains are moot). Distinct from a lab
  // deliberation outcome (Decision) and from applicant Withdrawal — the record
  // is preserved and status inference reads it as "Accepted elsewhere" instead
  // of a stale "Pending". Only ever set on DAs with no Released decision.
  closedAt      DateTime?
  closureReason DomainApplicationClosureReason?

  applicationId          String
  application            Application  @relation(fields: [applicationId], references: [id])
  // The FormVersion of the picked per-domain challenge Form the applicant
  // answered, pinned at pick time. Set on Standard cycles; null on internal.
  challengeFormVersionId String?
  challengeFormVersion   FormVersion? @relation("DomainApplicationChallengeForm", fields: [challengeFormVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // The target Domain this DA represents. Required for every DA regardless
  // of cycle type — single source of truth for "what domain is this for".
  domainId               String
  domain                 Domain       @relation(fields: [domainId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  interviews Interview[]
  reviews    ApplicationReview[]
  decisions  Decision[]

  @@index([applicationId])
  @@index([domainId])
  @@index([challengeFormVersionId])
}

// Drive-Form equivalent of ChallengeVersionApplicationCycle for per-domain
// challenges: links a Form (definition) to a (cycle, domain) as one of that
// domain's challenges. A domain may have several — the applicant picks one.
// Additive: cycles can mix legacy ChallengeVersion challenges and Form ones.
model CycleDomainForm {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  formId             String
  form               Form             @relation(fields: [formId], references: [id])

  @@unique([applicationCycleId, domainId, formId])
  @@index([applicationCycleId])
  @@index([domainId])
  @@index([formId])
}

model Domain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy display name. Retained as a soft fallback (some old fixtures
  // still read .name). Going forward, app code reads `displayName`.
  // Future cleanup can drop `name` once display.ts and tests stop reading it.
  name String

  // Phase 2: code/displayName now required.
  // Stable code referenced from app code (e.g. "Fullstack", "UIUX", "ERAS").
  code            String  @unique
  // Human-friendly display label (e.g. "Fullstack Dev").
  displayName     String
  // Intern programs (ERAS, EEJUST, WISP) are domains with this set true.
  // After the intern term, members apply normally and get a fresh
  // DomainEligibility in their actual hire domain.
  isInternProgram Boolean @default(false)
  // System domains are synthetic pseudo-domains used to hang the domain-keyed
  // review/delibs/decision pipeline off cycles that aren't really domain-scoped
  // (the single "CORE" domain backs Core cycles). Excluded from Standard/
  // Fellowship domain pickers and staffing.
  isSystem        Boolean @default(false)
  // Toggle visibility from Admin Console without code changes.
  active          Boolean @default(true)

  applicationCycles     DomainApplicationCycle[]
  domainLeadAssignments DomainLeadAssignment[]
  cycleReviewers        CycleReviewer[]
  cycleInterviewers     CycleInterviewer[]
  delibsSessions        DelibsSession[]
  // Internal-cycle DomainApplications link Domain directly (no ChallengeVersion).
  domainApplications    DomainApplication[]
  cycleChallengeForms   CycleDomainForm[]

  // ─── Phase 1 back-relations ───────────────────────────────────────────────
  eligibilities             DomainEligibility[]
  projectAssignments        ProjectAssignment[]
  mentorshipPairs           MentorshipPair[]
  externalMentors           ExternalMentor[]
  tasks                     Task[]
  projectRoleRequests       ProjectRoleRequest[]
  partnerApplicationDomains PartnerApplicationDomain[]
  projects                  ProjectDomain[]
  projectScopes             ProjectDomainScope[]
}

// Lifecycle of an application cycle from the DALI side:
//   Draft       — cycle being set up by hiring lead and domain leads
//   Open        — applications open for submission
//   UnderReview — submissions closed; hiring team reviewing
//   Completed   — decisions communicated to applicants
enum ApplicationCycleStatus {
  Draft
  Open
  UnderReview
  Completed
}

model ApplicationCycleStatusUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  newStatus          ApplicationCycleStatus
  applicationCycleId String
  applicationCycle   ApplicationCycle       @relation(fields: [applicationCycleId], references: [id])
  userId             String? // null = system-generated (e.g. auto-close at closeDate)
  user               User?                  @relation(fields: [userId], references: [id])

  // getActiveCycle runs on every shell navigation: latest update with an
  // active status, plus the latest update per cycle.
  @@index([newStatus, createdAt])
  @@index([applicationCycleId, createdAt])
}

// Indicates that a domain is hiring during a given application cycle
model DomainApplicationCycle {
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  // True once the domain lead has explicitly confirmed their challenge config is ready
  isReady Boolean @default(false)

  // Rubric assigned for this domain in this cycle (shared across all challenge versions for the domain)
  rubricVersionId         String?
  rubricVersion           RubricVersion? @relation(fields: [rubricVersionId], references: [id])
  // Target number of reviewers assigned to each application in this domain
  reviewersPerApplication Int            @default(2)

  @@id([domainId, applicationCycleId])
}

// ─── Interview Scheduling ────────────────────────────────────────────────────

model InterviewConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationCycleId String           @unique
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  slotDurationMinutes Int @default(30)
  bufferMinutes       Int @default(15)
  dayStartHour        Int @default(9) // 9 AM
  dayEndHour          Int @default(18) // 6 PM

  interviewStartDate DateTime
  interviewEndDate   DateTime

  rescheduleNoticeHours Int @default(12) // minimum hours before interview to allow reschedule
  cancelNoticeHours     Int @default(0) // minimum hours before interview to allow cancel (0 = up until start)
  bookingNoticeHours    Int @default(12) // minimum hours an applicant must book in the future

  timezone String @default("America/New_York")
}

// A DALI member assigned as a written reviewer for a domain in a cycle.
// Purely for ApplicationReview — separate from CycleInterviewer.
model CycleReviewer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId             String
  user               User             @relation(fields: [userId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])

  reviews ApplicationReview[]

  @@unique([userId, applicationCycleId, domainId])
}

// A DALI member assigned to conduct interviews for a domain in a cycle.
// Separate from CycleReviewer — interviewers and reviewers are managed independently.
model CycleInterviewer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId             String
  user               User             @relation(fields: [userId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])

  availabilityBlocks   InterviewerAvailability[]
  interviewAssignments InterviewAssignment[]

  @@unique([userId, applicationCycleId, domainId])
}

model InterviewerAvailability {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  cycleInterviewerId String
  cycleInterviewer   CycleInterviewer @relation(fields: [cycleInterviewerId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime

  @@index([cycleInterviewerId, startTime, endTime])
}

enum InterviewStatus {
  Scheduled
  Completed
  CancelledByApplicant
  CancelledByAdmin
}

enum InterviewLocation {
  PodAppa
  PodMomo
  Online
}

model Interview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No @unique: a DomainApplication can accumulate historical Interview rows
  // (Cancelled/Completed) alongside at most one active row. The partial
  // unique index "Interview_activeDomainApplication_key" (added in raw SQL
  // in the migration) enforces "at most one Scheduled per DA" at the DB
  // level. See SCHEDULING.md §Data model.
  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])
  applicationCycleId  String
  applicationCycle    ApplicationCycle  @relation(fields: [applicationCycleId], references: [id])

  startTime DateTime
  endTime   DateTime
  status    InterviewStatus   @default(Scheduled)
  location  InterviewLocation @default(Online)

  zoomMeetingId String?
  zoomJoinUrl   String?

  // Auto-provisioned video conference for online interviews (Google Meet).
  // videoUrl is the join link surfaced to applicant + interviewers and folded
  // into the interview emails/ICS; calendarEventId is the event on the shared
  // hiring calendar that hosts the Meet link — retained so reschedule / cancel /
  // location changes can update or delete it. The zoom* columns above are the
  // (currently blocked) S2S path and stay untouched. See
  // app/hiring/lib/interview-meet.ts.
  videoProvider   VideoProvider?
  videoUrl        String?
  calendarEventId String?

  // Joint outcome — set by either interviewer when marking complete.
  // recommendation values: 'Strong Hire' | 'Hire' | 'Lean Hire' | 'Lean No Hire' | 'No Hire'
  recommendation      String?
  recommendationNotes String?

  // RFC 5545 SEQUENCE for the ICS calendar event tied to this interview.
  // Bumped before each location-change / reassignment / cancel ICS send so
  // receiving calendars actually apply the update instead of treating the
  // new ICS as a duplicate of the previous publish.
  icsSequence Int @default(0)

  assignments  InterviewAssignment[]
  reminderLogs InterviewReminderLog[]

  @@index([applicationCycleId, startTime])
  @@index([domainApplicationId, status])
}

// Dedup ledger for the interview-reminders job: one row per (interview, lead
// tier), claimed before sending — same pattern as MeetingReminderLog.
model InterviewReminderLog {
  id          String                @id @default(cuid())
  interviewId String
  kind        InterviewReminderKind
  sentAt      DateTime              @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, kind])
}

enum InterviewReminderKind {
  DayBefore
  HourBefore
}

enum AssignmentRole {
  InDomain
  CrossDomain
}

// Used only by InterviewAssignment.
enum AssignmentStatus {
  Active
  Declined
  Replaced
}

// MemberRole enum dropped in Phase 2. Admin → AdminMembership row;
// HiringLead → CoreAssignment row with leadTitle="Hiring Lead". See
// V0_PHASE2_PLAN.md M3 backfill.

model InterviewAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  interviewId        String
  interview          Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  cycleInterviewerId String
  cycleInterviewer   CycleInterviewer @relation(fields: [cycleInterviewerId], references: [id])
  role               AssignmentRole
  status             AssignmentStatus @default(Active)

  noteVersions  InterviewNoteVersion[]
  notifications Notification[]

  @@index([cycleInterviewerId, status])
}

// Append-only versioned notes for an interview assignment.
// Current notes = latest record by createdAt. Never updated — only appended.
model InterviewNoteVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  interviewAssignmentId String
  interviewAssignment   InterviewAssignment @relation(fields: [interviewAssignmentId], references: [id], onDelete: Cascade)

  content String

  @@index([interviewAssignmentId, createdAt])
}

// ─── Decisions ───────────────────────────────────────────────────────────────

enum DecisionType {
  Rejected
  InvitedToInterview
  Accepted
  Waitlisted
}

enum DecisionStage {
  Draft // visible only to domain lead / hiring lead
  Final // locked, ready to release (domain lead marks final)
  Released // visible to applicant; triggers notification hook (hiring lead releases)
}

// Why an undecided DomainApplication was administratively closed (see
// DomainApplication.closureReason). Not a deliberation outcome.
enum DomainApplicationClosureReason {
  AcceptedElsewhere // applicant accepted into another domain this cycle
}

// Append-only, immutable decision records. Never updated — only created.
// Current decision = latest record by createdAt.
// To change a Draft: create a new record (supersedes old by timestamp).
// To finalize: create new record with stage=Final.
// To release: create new record with stage=Released.
model Decision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])

  type  DecisionType
  stage DecisionStage

  madeById String
  madeBy   User   @relation("DecisionMadeBy", fields: [madeById], references: [id])

  notes        String?
  waitlistRank Int? // set when type == Waitlisted; current rank = latest record's value

  // Lineage pointer for stage transitions (Draft → Final → Released).
  // Null when the row has no predecessor (e.g. delibs close, direct creation).
  parentDecisionId String?
  parent           Decision?  @relation("DecisionLineage", fields: [parentDecisionId], references: [id])
  children         Decision[] @relation("DecisionLineage")

  @@index([domainApplicationId, createdAt])
  @@index([parentDecisionId])
}

// ─── Application Reviews ─────────────────────────────────────────────────────

// Replaces MentorReview. Scoped to DomainApplication, authored by a CycleReviewer.
model ApplicationReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainApplicationId String
  domainApplication   DomainApplication @relation(fields: [domainApplicationId], references: [id])

  cycleReviewerId String
  cycleReviewer   CycleReviewer @relation(fields: [cycleReviewerId], references: [id])

  // The domain rubric version this review's score keys belong to, pinned at
  // submit time. Rubric edits create a NEW RubricVersion (with fresh
  // crit-<ts> keys for added criteria), so without this pin a later edit
  // orphans old score keys and labels render as raw keys. Nullable: reviews
  // created before this column existed have no pin (resolver falls back to
  // scanning version history).
  rubricVersionId String?
  rubricVersion   RubricVersion? @relation(fields: [rubricVersionId], references: [id])

  scores                Json    @default("{}") // { [criterionKey]: number }
  feedback              String  @default("")
  rejectionRationale    String  @default("")
  overallRecommendation String? // 'Strong Hire' | 'Hire' | 'Lean Hire' | 'Lean No Hire' | 'No Hire'
  annotations           Json    @default("[]") // [{id, fieldKey, start, end, comment, color}]

  submittedAt   DateTime? // null = in progress; non-null = read-only while set
  submittedById String? // records who authored the final review (set on submit, cleared on unsubmit)
  submittedBy   User?     @relation("ApplicationReviewSubmittedBy", fields: [submittedById], references: [id])

  @@unique([cycleReviewerId, domainApplicationId])
  // Per-DA review lookups can't use the unique above (wrong leading column).
  @@index([domainApplicationId])
}

// ─── Delibs ──────────────────────────────────────────────────────────────────

enum DelibsType {
  Initial // deliberating on applications with completed reviews, no decision yet
  Final // deliberating after interviews; produces Accept/Waitlist/Reject decisions
}

enum DelibsStatus {
  Active
  Closed
}

// Persisted deliberation session — one per type per domain+cycle (reopened, not recreated).
// columnOrder is the source of truth for kanban ordering during an active session.
// Draft Decisions are only created when the session is closed.
model DelibsSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  type   DelibsType
  status DelibsStatus @default(Active)

  // Ordered list of domainApplicationIds per column.
  // Column names vary by type:
  //   Initial: { "No Decision": [...], "Interview": [...], "Reject": [...] }
  //   Final:   { "Accept": [...], "Waitlist": [...], "Reject": [...] }
  columnOrder Json @default("{}")

  openedById String
  openedBy   User   @relation(fields: [openedById], references: [id])

  @@unique([domainId, applicationCycleId, type])
}

// ─── Rubrics ─────────────────────────────────────────────────────────────────

model Rubric {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  // Unified-Drive tree placement (Page of kind=Folder). Null = unplaced.
  // Organisation only — never affects who can view/edit the rubric. Lets a
  // rubric live in the Hiring drive alongside the forms it scores.
  folderPageId String?

  versions RubricVersion[]

  @@index([folderPageId])
}

// Immutable snapshot of a rubric. Never update rows in this table —
// create a new version instead.
// criteria: array of { key, label, description?, maxScore }
model RubricVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  criteria      Json
  rubricId      String
  rubric        Rubric @relation(fields: [rubricId], references: [id])
  createdById   String
  createdBy     User   @relation(fields: [createdById], references: [id])

  // Back-ref: domain+cycle pairs that use this rubric version
  domainApplicationCycles DomainApplicationCycle[]
  // Back-ref: cycles using this as the general form rubric
  cyclesAsGeneralRubric   ApplicationCycle[]       @relation("CycleGeneralRubric")
  // Back-ref: reviews pinned to this version's criteria at submit time
  applicationReviews      ApplicationReview[]
}

// ─── Collaborative Editing ───────────────────────────────────────────────────

// Stores the Y.js binary state for each collaborative document.
// Document naming convention:
//   review:{reviewId}:feedback
//   review:{reviewId}:rejectionRationale
//   interview:{interviewId}:notes        (joint)
//   interview:{interviewId}:recommendation
model CollabDocument {
  id        String   @id @default(cuid())
  name      String   @unique
  state     Bytes
  updatedAt DateTime @updatedAt

  // User ids already notified of an @-mention in this document's body. The
  // store hook (onStoreDocument) notifies only ids that appear as mention nodes
  // and aren't in here yet, then unions the current mention set in — so each
  // @-mention notifies its target at most once per document, despite throttled
  // saves re-running the hook.
  notifiedMentionUserIds String[] @default([])

  versions CollabDocumentVersion[]
}

// Periodic snapshots of a CollabDocument's Y.Doc state. One row written per
// onStoreDocument tick (every ~30s during active editing — see persistence.ts
// `maybeSnapshot`). Idle docs accrue no rows. Powers the version-history UI.
model CollabDocumentVersion {
  id        String   @id @default(cuid())
  name      String
  state     Bytes // Y.Doc binary at snapshot time
  plainText String // mirror, for fast preview without decoding `state`
  authorIds String[] // userIds that edited since previous snapshot, best-effort
  // User-given name for a pinned/named version ("Before the rewrite"). Null =
  // an ordinary auto-snapshot. A non-null label marks the version as pinned:
  // named versions are surfaced distinctly and exempt from auto-pruning.
  label     String?
  createdAt DateTime @default(now())

  collabDocument CollabDocument @relation(fields: [name], references: [name], onDelete: Cascade)

  @@index([name, createdAt(sort: Desc)])
}

// Lightweight full-text index of page bodies, so site-wide search matches what
// a document SAYS and not just what it is called. One row per indexed Page.
//
// Kept current from two directions: the collab store hook (app/collab/
// persistence.ts) re-indexes a page on every save, and the `doc-search-index`
// job sweeps for rows that are missing or older than their CollabDocument (a
// page edited while the app was down, or one that predates this table).
//
// `tsv` is the stemmed, stopword-stripped lexeme vector that powers the exact
// pass and its ts_rank ordering; `content` carries a trigram index so a
// misspelled query still finds the document. Deliberately NOT a generated
// column — the same raw upsert writes both, which keeps this schema and the
// database in agreement for `prisma migrate diff`. See lib/doc-search.server.ts.
model PageSearchIndex {
  pageId String @id
  // Flattened body text (one line per block), truncated to INDEX_MAX_CHARS.
  content String
  // to_tsvector('english', content) — written by indexPageBody, never by Prisma.
  tsv     Unsupported("tsvector")?

  // CollabDocument.updatedAt as of the last index write. The sweep job compares
  // it against the live value to find stale rows without decoding any state.
  sourceUpdatedAt DateTime
  indexedAt       DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // The exact pass (tsv @@ tsquery) and the typo-tolerant fallback
  // (query <% content) each need their own GIN index to stay off a seq scan.
  @@index([tsv], type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ─── Documents: tags, files, comments ────────────────────────────────────────

// Lab-wide, curated tag list applied to documents (Pages) and uploaded files.
// Examples: shipping, handoff, fullstack, UI/UX, hardware, graphics,
// animation, data. New tags are added by Core/Admin only (mirrors the curated
// Domain registry); everyone with edit access may apply existing tags.
// Archived (soft-deleted) tags stay attached to existing items but drop out of
// the picker.
model DocTag {
  id         String    @id @default(cuid())
  label      String
  // Stable, lowercased identifier (e.g. "ui-ux"). Used for de-dup and to keep
  // links/filters stable when the human label is edited.
  slug       String    @unique
  // Optional Tailwind-friendly accent (hex or token); UI falls back to a
  // neutral chip when null.
  color      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  pages PageTag[]
  files ProjectFileTag[]
}

// m2m: DocTag ↔ Page (documents).
model PageTag {
  pageId String
  tagId  String

  page Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tag  DocTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId])
  @@index([tagId])
}

// m2m: DocTag ↔ ProjectFile (uploads).
model ProjectFileTag {
  fileId String
  tagId  String

  file ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag  DocTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
  @@index([tagId])
}

// A standalone uploaded file attached to a project's Files section. The binary
// lives in S3 (see app/lib/s3.ts); each upload is a ProjectFileVersion row.
// Re-uploading creates a new version and advances currentVersionId, so older
// versions stay downloadable/restorable (mirrors CollabDocumentVersion).
model ProjectFile {
  id               String  @id @default(cuid())
  // Nullable — null for Lab-scoped files that are not tied to any project.
  projectId        String?
  // Human-facing name, independent of any single version's stored filename so
  // a rename survives re-upload.
  title            String
  // Points at the version surfaced by default. Nullable only transiently
  // during the create→first-version transaction.
  currentVersionId String? @unique

  // When true, partners on this project can see + download the file from the
  // partner portal (mirrors Page.partnerVisible for shared documents).
  partnerVisible Boolean @default(false)

  // Drive unified tree placement. Null = unplaced (rendered at a default
  // project-files location outside the folder tree). When set, must point at a
  // Page of kind=Folder. Loose FK — no DB-level constraint — matching the
  // existing Page.workspaceId / Page.scopeGroupId convention. Placement is
  // ORGANISATION only and never widens who can see the file: a viewer must
  // already have access to this file's project to see it in the tree.
  folderPageId String?

  // Drive scope for non-project files. Null for project-owned files (use
  // projectId instead). When workspaceType = Lab, workspaceId is null and
  // the file is visible to all lab members. Mirrors the Page.workspaceType /
  // Page.workspaceId polymorphic pattern.
  workspaceType WorkspaceType?
  workspaceId   String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versions       ProjectFileVersion[] @relation("FileVersions")
  currentVersion ProjectFileVersion?  @relation("FileCurrentVersion", fields: [currentVersionId], references: [id])

  tags      ProjectFileTag[]
  comments  DocComment[]
  taskLinks TaskFileLink[]

  @@index([projectId, archivedAt])
  @@index([folderPageId])
  @@index([workspaceType, workspaceId, archivedAt])
}

// m2m: Task ↔ ProjectFile. Links work artifacts (graphics, animation, design
// exports) to board tasks so the upload → feedback → re-upload loop is
// reachable from the card. A file may serve several tasks and vice versa.
model TaskFileLink {
  taskId    String
  fileId    String
  createdAt DateTime @default(now())

  task Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([taskId, fileId])
  @@index([fileId])
}

model ProjectFileVersion {
  id           String   @id @default(cuid())
  fileId       String
  // S3 object key under the uploads/ prefix.
  s3Key        String
  // Original client filename for this version, shown on download.
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  file       ProjectFile @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation("ProjectFileVersionUploader", fields: [uploadedById], references: [id])

  // Back-relation for ProjectFile.currentVersion (a file points at one of its
  // own versions). Optional + named to disambiguate from FileVersions.
  fileAsCurrent ProjectFile? @relation("FileCurrentVersion")

  // File comments pinned to this version (DocComment.versionId).
  comments DocComment[]

  @@index([fileId, createdAt(sort: Desc)])
}

// Threaded comments on documents and files. `targetType` discriminates the
// loose polymorphic `targetId` (a Page.id or ProjectFile.id) — no DB FK on the
// id column because it spans two tables; the app dispatches on targetType.
// `anchor` carries a Yjs relative-position range for inline (text-anchored)
// comments on documents; null = a comment on the whole doc/file. Replies set
// `parentId` to a root comment (one level of threading).
model DocComment {
  id         String           @id @default(cuid())
  targetType DocCommentTarget
  targetId   String
  parentId   String?
  authorId   String
  // Flattened plaintext body. Always populated (source of truth for search,
  // notification previews, and pre-rich comments). Rich content lives in
  // `bodyJson` when present.
  body       String
  // Rich comment body: an array of inline segments — text runs (with marks)
  // and `{ type: "mention", userId, label }` chips. Null for legacy/plaintext
  // comments, in which case `body` is rendered verbatim. Mention notifications
  // are derived from the mention segments here.
  bodyJson   Json?
  // { from: <encoded RelativePosition>, to: <encoded RelativePosition> } for
  // inline doc comments. Null for doc-level / file-level comments.
  anchor     Json?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  author    User                 @relation("DocCommentAuthor", fields: [authorId], references: [id])
  parent    DocComment?          @relation("DocCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DocComment[]         @relation("DocCommentThread")
  reactions DocCommentReaction[]

  // Back-relation when targetType=file. Kept loose: only the file side is a
  // real relation (Pages are referenced by id without a back-relation to avoid
  // a second FK on the polymorphic column).
  file   ProjectFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String?

  // File comments only: the version that was current when the comment was
  // written, so feedback reads against the right iteration ("on V2"). Null for
  // doc/pagedoc comments and file comments predating version pinning.
  version   ProjectFileVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  versionId String?

  @@index([targetType, targetId, createdAt])
  @@index([parentId])
}

// Per-user emoji reactions on a DocComment. Toggle semantics: upsert on add,
// delete on remove. Unique constraint enforces one row per (comment, user, emoji).
model DocCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String   @db.VarChar(64)
  createdAt DateTime @default(now())

  comment DocComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

enum DocCommentTarget {
  doc
  file
  // A per-page documentation guide (PageDoc.id). FAQ threads on a page's docs
  // modal are DocComments with this target — reuses the doc-comment pipeline
  // rather than a second comment table.
  pagedoc
}

// Per-page documentation / guide surfaced in a "Docs" modal on hard-to-navigate
// pages. Keyed by a stable `pageKey` a route declares via `handle.docKey`, so
// the doc is independent of any DB entity. Body is ProseMirror JSON (the shared
// RichTextEditor); the walkthrough video is an uploaded S3 object (videoKey).
// A maintainer (assignable by Core/Admin) plus Core/Admin can edit; any lab
// member can read it and post FAQ comments (see DocCommentTarget.pagedoc).
//
// `sections` is an ordered JSON array of { id, title, body, videoKey } for the
// modal sidebar. Null/[] → treat body+videoKey as a single Overview section.
// Legacy body/videoKey stay in sync with sections[0] when sections are saved.
model PageDoc {
  id       String  @id @default(cuid())
  pageKey  String  @unique
  title    String
  // ProseMirror JSON. Null until the maintainer writes the guide.
  body     Json?
  // S3 key of the uploaded walkthrough video (read via presigned URL). Null =
  // no video yet. Kept in sync with sections[0].videoKey for older clients.
  videoKey String?
  // Ordered sidebar sections: [{ id, title, body, videoKey }, ...]. Null =
  // legacy single-body docs (API synthesizes an Overview from body/videoKey).
  sections Json?

  maintainerId   String?
  createdById    String?
  lastEditedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintainer   User? @relation("PageDocMaintainer", fields: [maintainerId], references: [id], onDelete: SetNull)
  createdBy    User? @relation("PageDocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy User? @relation("PageDocLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@index([maintainerId])
}

// ─── OAuth & Sessions ────────────────────────────────────────────────────────

enum OAuthProvider {
  google
  cas
}

// Phase 2: collapsed to `member` only. MCP clients are members-only (per
// V0_PLAN.md Q18). The `dartmouth` and `partner` values were never used in
// production — first-party login (/auth/callback/*) doesn't go through this
// type, and the OAuth provider surface (/oauth/*) is MCP-only.
enum OAuthAccountType {
  member
}

model OAuthSession {
  id String @id @default(cuid())

  // pkce fields
  codeChallenge       String
  codeChallengeMethod String @default("S256")

  // oAuth params preserved across IDP redirect
  redirectUri String
  state       String
  provider    OAuthProvider
  // Optional. Set when the OAuthClient row pins a single accountType
  // (e.g. MCP clients require "member"). Null = any accountType is OK
  // for this session, decided by the callback's domain branch.
  accountType OAuthAccountType?

  // set after IDP authenticates user
  userId            String?
  authorizationCode String? @unique
  exchanged         Boolean @default(false)

  // for chained Google → CAS account linking
  linkUserId String?

  // MCP foundation track: the OAuthClient that initiated this authorization
  // request, and the requested scopes the consent screen authorized. Both
  // are nullable for backward-compat with pre-MCP rows; new sessions populate
  // them at /oauth/authorize.
  clientId String?
  scopes   String[] @default([])

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Single-credential session record backing both browser cookie logins and
// OAuth-issued (MCP) sessions. See SESSION_AUTH_PLAN.md for design.
//
// The PK `id` stores SHA-256(raw) so a DB read leak does not surface live
// credentials. The raw id is what travels in the __dali_sid cookie or in
// Authorization: Bearer headers; we never store it.
model Session {
  // sha256(raw session id), base64url
  id                String    @id
  userId            String
  // Null for cookie logins. Set for OAuth-issued (MCP) sessions, linking
  // the session to the OAuthGrant that authorized it. FK constraint enforced
  // by the MCP foundation track migration.
  grantId           String?
  createdAt         DateTime  @default(now())
  // Bumped on every successful auth lookup. Drives rolling expiry and powers
  // per-session telemetry.
  lastUsedAt        DateTime  @default(now())
  // Rolling expiry: extended on use up to absoluteExpiresAt.
  expiresAt         DateTime
  // Hard cap: never extended. Equivalent to the legacy familyCreatedAt + 30d.
  absoluteExpiresAt DateTime
  // Soft delete. Sessions are never hard-deleted so the audit log stays whole.
  revokedAt         DateTime?
  // Populated at issuance for audit / "active sessions" UI.
  userAgent         String?
  ip                String?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant OAuthGrant? @relation(fields: [grantId], references: [id])

  @@index([userId, revokedAt])
  @@index([grantId])
  @@index([expiresAt])
}

// ─── Email Templates ────────────────────────────────────────────────────────

// Named, versioned email template — independent of any cycle. Mirrors
// Rubric/RubricVersion. The "slot" a template fills (e.g. which DecisionType
// it sends for) is determined by the cycle binding row that points at it.
model EmailTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  // Unified-Drive tree placement (Page of kind=Folder). Null = unplaced.
  // Organisation only — never affects who can send or edit the template.
  // Email templates live under the Core drive's "Templates" area (auto-filed
  // into Hiring/Education subfolders by their bindings); templates are global
  // and shared across features, so they aren't hiring-owned.
  folderPageId String?

  versions EmailTemplateVersion[]

  @@index([folderPageId])
}

// Immutable snapshot of an EmailTemplate. Never update — append a new version.
// Subject and body use {{firstName}} interpolation.
model EmailTemplateVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  subject       String
  body          String

  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  cycleDecisionEmails     CycleDecisionEmail[]
  cycleNotificationEmails CycleNotificationEmail[]
  educationDecisionEmails EducationDecisionEmail[]

  @@index([templateId, versionNumber])
}

// Per-cycle binding: which EmailTemplateVersion fires when a Decision of the
// given DecisionType is released in this cycle. One row per (cycle, decisionType).
// No row = no email fires (surfaced explicitly in the picker UI).
model CycleDecisionEmail {
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  decisionType DecisionType

  emailTemplateVersionId String
  emailTemplateVersion   EmailTemplateVersion @relation(fields: [emailTemplateVersionId], references: [id])

  @@id([applicationCycleId, decisionType])
}

// Non-decision email slots managed per-cycle. Mirrors CycleDecisionEmail but
// without the lock-on-release semantics — notification emails can be rebound
// at any time.
enum NotificationType {
  ApplicationReceived
  ApplicationExtensionNotice
  InterviewInviteMentor
  InterviewInviteReminder
  InterviewConfirmedApplicant
  InterviewCancelledApplicant
  InterviewCancelledInterviewer
  InterviewLocationChanged
  // Scheduled 24h/1h reminders fired by the interview-reminders job.
  InterviewReminderApplicant
  InterviewReminderInterviewer
}

model CycleNotificationEmail {
  applicationCycleId String
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id])

  notificationType NotificationType

  emailTemplateVersionId String
  emailTemplateVersion   EmailTemplateVersion @relation(fields: [emailTemplateVersionId], references: [id])

  @@id([applicationCycleId, notificationType])
}

// One row per (cycle, notificationType, applicant). Enforces single-send
// per applicant per cycle per notification type even though an applicant
// can have multiple DomainApplications.
// ─── Audit Logging ───────────────────────────────────────────────────────────

// Append-only audit trail of security-relevant events (auth, role changes,
// decision state transitions, email sends). userId is intentionally a free-form
// string rather than an FK so audit rows survive User deletion.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  action    String // e.g. "login.success", "role.change", "decision.release"
  userId    String? // acting user id (null when unattributed)
  targetId  String? // affected resource id
  metadata  Json? // additional context — must not contain secrets, tokens, or PII beyond what's necessary
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Site Analytics ──────────────────────────────────────────────────────────

// Product-usage telemetry, distinct from AuditLog. PageView captures every
// document/navigation hit; ClientError captures uncaught browser errors. Both
// are time-bounded — see lib/analytics.ts for retention policy.
model PageView {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String? // null for unauthenticated visits (rare — most routes require auth)
  sessionId  String // signed cookie id, rotated on login/logout
  path       String // normalized route pattern (e.g. /projects/:id), not raw URL
  referrer   String?
  durationMs Int? // optional, reported by next-nav beacon

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
}

model ClientError {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  path      String
  message   String
  stack     String?
  userAgent String?
  release   String? // git sha from build, groups errors across deploys

  @@index([createdAt])
  @@index([message, createdAt])
}

// Per-user daily AI request counter — enforces the /api/ai/doc daily quota
// (accurate across machines, unlike the in-memory burst limiter) and doubles
// as usage data for a future admin view. One row per user per UTC day.
// Token counts are best-effort telemetry recorded after each model call.
model AiUsage {
  id           String @id @default(cuid())
  userId       String
  day          String // UTC date "YYYY-MM-DD"
  count        Int    @default(0)
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)

  @@unique([userId, day])
}

// ─── Document Signing ────────────────────────────────────────────────────────

// A named, versioned signable document — the generalization of
// ConfidentialityAgreement into a lab-wide e-sign service. A document declares
// how it's enforced (gateScope), who must sign it (audience), and optional
// letterhead branding for PDF export. Its immutable versions hold the body +
// signer roles; a SigningBinding puts one version in force for a context.
model SigningDocument {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  // Stable machine key for gates + lifecycle wiring (e.g. "member-agreement",
  // "mentorship-agreement", "hiring-confidentiality"). Rule-driven code
  // references a document by slug rather than a cuid.
  slug String @unique

  gateScope SigningGateScope @default(None) // how an unsigned copy is enforced
  audience  SigningAudience  @default(Manual) // who is required to sign
  cadence   SigningCadence   @default(Once) // how often a fresh signature is required

  // Target group when audience == Group (a GroupDefinition id; resolved through
  // resolveGroupMembers, so a plain column like Form.audienceGroupIds — no FK).
  // Null with audience=Group means "the binding's term group", so a per-term
  // agreement auto-rolls to each term's active-member roster (staffed this term).
  audienceGroupId String?

  // Unified-Drive tree placement (Page of kind=Folder). Null = unplaced
  // (agreements render at Lab top level today). Set for hiring Confidentiality
  // agreements so they live in the Hiring drive. Organisation only — signing
  // gates/audience are unchanged.
  folderPageId String?

  // Optional repeating page-header banner + footer for PDF export (the paper
  // letterhead look). Null = no running header/footer.
  letterheadImageUrl String?
  footerText         String?

  archivedAt DateTime?

  versions SigningDocumentVersion[]
  bindings SigningBinding[]
}

enum SigningGateScope {
  None // not enforced; surfaced only
  App // blocks the whole app until signed (membership / mentor agreements)
  HiringCycle // blocks sensitive cycle data until signed (confidentiality's scope)
}

enum SigningAudience {
  Manual
  NewMembers // this cycle's incoming hires (latest General/Fellowship accepts)
  Members // active members who are not new (the returning cohort)
  Mentors
  HiringParticipants
  Group // a user group (audienceGroupId); null id = the binding's term group
}

// How often a signature must be renewed — the binding scope an "activate" (or the
// signing-issuance job) targets. Replaces the old kind/audience-inferred scope.
enum SigningCadence {
  Once // one standing binding ("app"); re-sign only on a new version in force
  PerTerm // one binding per term ("term:<id>") — mentor/termly agreements
  PerCycle // one binding per hiring cycle ("cycle:<id>") — bound from hiring UI
}

// A version of a SigningDocument. Editable/deletable in place while it's still
// a draft (publishedAt null + no signatures) so repeated saves don't stack junk
// versions; once published or signed it's frozen — changes append a new version.
// body is ProseMirror JSON containing the placeable field + variable nodes;
// roles is the ordered list of signer-role slugs (e.g. ["member","supervisor"]).
model SigningDocumentVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  versionNumber Int
  body          Json
  roles         Json // ordered role slugs, e.g. ["member","supervisor"]
  publishedAt   DateTime? // only a published version may be bound

  documentId String
  document   SigningDocument @relation(fields: [documentId], references: [id])

  createdById String
  createdBy   User   @relation("SigningVersionAuthor", fields: [createdById], references: [id])

  bindings   SigningBinding[]
  signatures SigningSignature[]

  @@unique([documentId, versionNumber])
  @@index([documentId, versionNumber])
}

// Puts one version "in force" for a context. Generalizes
// CycleConfidentialityAgreement. scopeKey disambiguates the context because
// Postgres treats NULLs in composite uniques as distinct:
//   "app" (one active binding per doc) | "cycle:<id>" | "term:<id>"
// No binding for a context = nothing in force (the confidentiality
// "no_agreement" state).
model SigningBinding {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String
  document   SigningDocument        @relation(fields: [documentId], references: [id])
  versionId  String
  version    SigningDocumentVersion @relation(fields: [versionId], references: [id])

  scopeKey String
  cycleId  String? // set for HiringCycle scope
  cycle    ApplicationCycle? @relation(fields: [cycleId], references: [id])
  termId   String? // set for termly (mentorship) scope
  term     Term?             @relation(fields: [termId], references: [id])

  // Last time a Core member nudged this binding's outstanding signers from the
  // agreements console. Throttles reminders (≤ once/24h) and surfaces "reminded
  // N ago" in the UI. Null = never reminded.
  lastRemindedAt DateTime?

  signatures               SigningSignature[]

  @@unique([documentId, scopeKey])
  @@index([cycleId])
  @@index([termId])
}

// One party's signature on one binding. Generalizes
// ConfidentialityAgreementSignature: adds roleKey, typedName, ip/userAgent
// (low-security capture, like AuditLog), captured fieldValues, and a frozen
// archival snapshot of the body with baked-in values + resolved variables.
// The fixed staff counter-signature is a single row per binding with
// roleKey "supervisor", created once by staff and shown on every member copy.
model SigningSignature {
  id       String   @id @default(cuid())
  signedAt DateTime @default(now())

  bindingId String
  binding   SigningBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  versionId String // pinned version at sign time
  version   SigningDocumentVersion @relation(fields: [versionId], references: [id])

  signerUserId String
  signer       User   @relation("SigningSigner", fields: [signerUserId], references: [id], onDelete: Cascade)
  roleKey      String // "member" | "supervisor"

  typedName   String // typed full-name affirmation
  ip          String?
  userAgent   String?
  fieldValues Json // { [fieldId]: value }
  frozenBody  Json? // archival snapshot: body w/ baked values + resolved vars

  @@unique([bindingId, signerUserId, roleKey])
  @@index([signerUserId])
  @@index([versionId])
}

// ─── DomainLeadAssignment ────────────────────────────────────────────────────

model DomainLeadAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Phase 2: memberId column dropped; userId column added pointing at User.
  // termId NOT NULL after backfill to current term.
  userId   String
  domainId String
  termId   String

  user   User   @relation(fields: [userId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])
  term   Term   @relation(fields: [termId], references: [id])

  @@unique([userId, domainId, termId])
  @@index([domainId])
  @@index([termId])
}

// ─── Calendar / Scheduling ───────────────────────────────────────────────────

model UserCalendarLink {
  id             String      @id @default(cuid())
  userId         String
  provider       CalProvider
  externalEmail  String
  displayName    String?
  // Encrypted at rest; never logged. AES-256-GCM ciphertext via app/lib/calendar-crypto.ts.
  oauthTokens    String
  primary        Boolean     @default(true)
  enabled        Boolean     @default(true)
  // Sub-calendar IDs (from the provider) that should contribute to busy.
  // If empty, the link's primary calendar is used.
  subCalendarIds String[]
  linkedAt       DateTime    @default(now())
  lastSyncedAt   DateTime?
  syncError      String?

  user           User               @relation(fields: [userId], references: [id])
  hostedMeetings ScheduledMeeting[]

  @@unique([userId, provider, externalEmail])
  @@index([userId])
}

enum CalProvider {
  Google
  Outlook
}

model ScheduledMeeting {
  id               String  @id @default(cuid())
  organizerId      String
  organizer        User    @relation(fields: [organizerId], references: [id])
  title            String
  durationMinutes  Int

  scopeType ScopeType
  // Untyped at DB layer — dispatched in app code by scopeType.
  scopeId   String?

  participantUserIds String[]
  selectedAt         DateTime?
  externalEventId    String?

  // Optional video conference for the meeting. meetingUrl is the join link
  // (surfaced as a "Join" button and carried in notifications); it's minted on
  // the organizer's linked Google calendar when the organizer opts in at create
  // time (see createGoogleCalendarEvent `addMeet`). videoProvider records which
  // service produced it. Both null = no video link.
  meetingUrl         String?
  videoProvider      VideoProvider?

  status             MeetingStatus @default(Searching)

  // RFC 5545 RRULE for recurring meetings.
  recurrenceRule String?

  // Resolved at create-time from scopeType/scopeId.
  ownerCalendarEmail String

  // Which of the organizer's linked Google calendars hosts the event. When set,
  // the server pushes the meeting to that calendar and lets Google send Gmail
  // invites to attendees on its behalf.
  organizerCalendarLinkId String?
  organizerCalendarLink   UserCalendarLink? @relation(fields: [organizerCalendarLinkId], references: [id])

  // Set when the sender picks a meeting type at invite time. Drives auto-
  // creation of a meeting-note Page under `project`'s shared documents
  // (see notePage) plus a MeetingAttendance row per participant.
  // meetingTypeLabel is required (app-level) when meetingType == Other and
  // supplies the note's display label ("<label> meeting note (<date>)").
  meetingType      MeetingType?
  meetingTypeLabel String?
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id])
  notePage         Page?

  // Roster (default): organizer/Core check people off by hand via
  // AttendanceChecklist. SelfCheckIn: attendees mark themselves present via
  // the check-in route, scoped to a time window around selectedAt — meant for
  // events too large to check off manually (e.g. an all-lab Group event). The
  // check-in route always authenticates the caller's own session and routes by
  // meeting id — there is no bearer token, to prevent checking in on someone's
  // behalf.
  attendanceMode AttendanceMode @default(Roster)

  // Optional Core marker, set at invite time by a Core member. Independent of
  // scope: it pulls a meeting onto the Core hub's week calendar without
  // changing who is invited, so a project or ad-hoc meeting Core needs to see
  // shows up there next to the meetings scoped to the Core group itself.
  isCoreMeeting Boolean @default(false)

  exceptions    MeetingException[]
  notifications Notification[]
  reminderLogs  MeetingReminderLog[]
  attendance    MeetingAttendance[]
  timeEntries   TimeEntry[]

  createdAt DateTime @default(now())
}

enum ScopeType {
  Project
  Group
  UserList
  Series
  None
}

enum MeetingType {
  Team
  Partner
  Other
}

enum AttendanceMode {
  Roster
  SelfCheckIn
}

// One row per invited participant (including the organizer) on a
// ScheduledMeeting that has a meetingType/project. Checked off from the
// AttendanceChecklist on the meeting's notePage; drives TimeEntry creation
// (see the attendance-toggle route in app/calendar/routes).
model MeetingAttendance {
  id                 String    @id @default(cuid())
  scheduledMeetingId String
  userId             String
  present            Boolean   @default(false)
  markedByUserId     String?
  markedAt           DateTime?

  meeting ScheduledMeeting @relation(fields: [scheduledMeetingId], references: [id])
  user    User             @relation(fields: [userId], references: [id])

  @@unique([scheduledMeetingId, userId])
  @@index([userId])
}

// A user's personal timesheet row, shown on the Calendar "Timesheet" tab.
// Meeting-sourced rows are managed automatically by the attendance-toggle
// route (one row per present participant, kept in sync as attendance is
// checked/unchecked); Manual rows are user-authored entries — from the
// create-event modal's "count as work" toggle or the timesheet ledger.
model TimeEntry {
  id                 String          @id @default(cuid())
  userId             String
  source             TimeEntrySource
  scheduledMeetingId String?
  // Which concrete paid role (ProjectAssignment / CoreAssignment /
  // InstructorAssignment / DomainLeadAssignment / AdminMembership) this entry
  // is attributed to. Untyped at DB layer — dispatched in app code by
  // assignmentType, same pattern as ScheduledMeeting.scopeType/scopeId. Null
  // for legacy/unattributed rows (the export route's "unassigned" bucket).
  assignmentType     AssignmentType?
  roleRefId          String?
  // Denormalized from the resolved role when assignmentType == Project, so
  // existing project-grouped readers (export, project hour totals) keep
  // working without joining through ProjectAssignment.
  projectId          String?
  date               DateTime
  hours              Float
  note               String?
  // Optional precise time range, used to render this entry as a block on the
  // Timesheet tab's week grid (alongside external/manual calendar blocks).
  // Null for entries added via the plain date+hours form (no time-of-day
  // picked) — those still show in the ledger list, just not on the grid.
  // Set automatically for Meeting-sourced rows from the meeting's start time
  // + duration, and for grid drag-created Manual rows from the dragged range.
  startTime          DateTime?
  endTime            DateTime?
  // Google Timesheet mirror (Phase 3). Soft pointers — no FK — same pattern as
  // MemberClass.linkId/calendarId. Null until the user enables the sync and the
  // entry is first pushed to Google. Set to null when the mirror event is deleted.
  googleTimesheetEventId String?
  googleTimesheetLinkId  String?
  // The calendar event this entry was logged against — "count this as work" on
  // an event in the composer. Soft pointers, no FK, same pattern as the mirror
  // pair above. When set, the event and its hours are ONE thing: the grid draws
  // the event block with a role accent instead of an overlapping logged block,
  // and the entry is not mirrored to the DALI Timesheet calendar (it already
  // lives on a real one). Null for entries logged straight onto the timesheet.
  sourceEventId          String?
  sourceCalendarLinkId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  meeting     ScheduledMeeting? @relation(fields: [scheduledMeetingId], references: [id])
  project     Project?          @relation(fields: [projectId], references: [id])

  @@unique([scheduledMeetingId, userId])
  // One work log per event per user — lets the composer upsert on re-save
  // instead of stacking a second entry every time the event is edited.
  @@unique([sourceEventId, userId])
  @@index([userId, date])
  @@index([userId, assignmentType])
}

enum TimeEntrySource {
  Meeting
  Manual
}

enum MeetingStatus {
  Searching
  Confirmed
  Cancelled
}

// Which service produced a meeting's video-conference link. GoogleMeet is the
// only one minted today; Zoom is reserved for when the (currently blocked) S2S
// path lands; Manual covers a link entered by hand.
enum VideoProvider {
  GoogleMeet
  Zoom
  Manual
}

// In-app notification delivered to a single user. Fan-out at write time:
// sending to a group resolves to N rows (one per recipient).
model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  createdByUserId String?
  createdBy       User?            @relation("NotificationAuthor", fields: [createdByUserId], references: [id])
  kind            NotificationKind @default(General)
  title           String
  body            String?
  link            String?
  // Origin group for bulk sends. Not an FK so groups can be deleted independently.
  sourceGroupId   String?
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  // Typed event identifier ("meeting.invite", "task.due_reminder", …) used
  // for preference matching and digest grouping. The registry of valid values
  // and their per-channel defaults lives in app/lib/notification-events.ts;
  // `kind` stays the UI/render discriminator. Pre-registry rows carry the
  // hidden fallback value "general".
  eventType String    @default("general")
  // Delivery tracking, set by notify()/the digest job on actual delivery.
  // The digest scan is `emailedAt IS NULL` within its cadence window.
  emailedAt DateTime?
  slackDmAt DateTime?

  // Opt-in idempotency key for the in-app channel. Null → unconstrained (NULLs
  // are distinct in a Postgres unique index), so unkeyed notifications behave
  // exactly as before; a set key makes (recipientUserId, dedupKey) the claim a
  // re-fired notify() collides with instead of writing a duplicate row.
  dedupKey String?

  // Number of notifications merged into this row. Starts at 1; for events with
  // a coalesce window (notification-events.ts), a burst within the window
  // increments this in place instead of writing new rows, and notify() surfaces
  // the count in the body ("3 new comments · latest: …"). See notify.server.ts.
  coalesceCount Int @default(1)

  // Announcement extras (kind == SystemAnnouncement). `dueAt` makes the
  // announcement a "todo" with a deadline; `isTodo` marks it as action-needed
  // so it surfaces in the Tasks sidebar / Home banner like a meeting invite.
  // `formId` optionally attaches a published Form for the recipient to fill.
  isTodo Boolean   @default(false)
  dueAt  DateTime?
  formId String?
  form   Form?     @relation(fields: [formId], references: [id], onDelete: SetNull)

  // Set on MeetingInvite notifications so the bell can render Accept/Decline
  // buttons and the RSVP endpoint can locate the underlying meeting.
  scheduledMeetingId String?
  scheduledMeeting   ScheduledMeeting? @relation(fields: [scheduledMeetingId], references: [id], onDelete: SetNull)
  rsvp               MeetingRsvp?
  rsvpAt             DateTime?

  // Set on notifications fired for an InterviewAssignment. The tasks loader
  // hides the notification once the assignment is no longer Active or the
  // interview is no longer Scheduled, so reassignments / cancellations clear
  // the old interviewer's tile automatically. SetNull preserves the user's
  // notification history if the assignment is ever hard-deleted.
  interviewAssignmentId String?
  interviewAssignment   InterviewAssignment? @relation(fields: [interviewAssignmentId], references: [id], onDelete: SetNull)

  @@unique([recipientUserId, dedupKey])
  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
  @@index([interviewAssignmentId])
}

enum NotificationKind {
  General
  MeetingInvite
  MeetingReminder
  SystemAnnouncement
  Education
}

enum MeetingRsvp {
  Accepted
  Declined
  Tentative
}

model GroupDefinition {
  id              String    @id @default(cuid())
  name            String
  type            GroupType
  // For dynamic groups: structured query identifier dispatched in app code.
  // Recognized forms:
  //   - "term:<termId>"         – members with any assignment/mentorship in that term
  //   - "project:<projectId>"   – members assigned to that project (any term)
  //   - "domain:<domainId>"     – members holding eligibility in that domain
  //   - "core"                  – Core members for the current term
  //   - "offering:<offeringId>" – members with an Approved application to that EducationOffering
  dynamicQuery    String?
  // For static groups: explicit member list.
  staticMemberIds String[]
  // Marks a group as system-managed (auto-created and kept in sync with an
  // underlying entity). Matches the canonical dynamicQuery form for default
  // groups, or null for user-created groups. Used to prevent duplicate
  // backfill and block manual edits/deletes from the UI.
  systemKey       String?   @unique
  // Set when a static group is manually archived. A group is also treated as
  // archived once every term in boundTermIds has ended (derived at read time);
  // archivedAt only records an explicit, term-independent archive action.
  archivedAt      DateTime?
  // Term ids this static group is scoped to. Empty = not term-bound (never
  // auto-archives). When non-empty, the group auto-archives once the latest
  // bound term's endDate has passed. System (Dynamic) groups never use this.
  boundTermIds    String[]  @default([])

  createdAt DateTime @default(now())

  @@index([archivedAt])
}

enum GroupType {
  Static
  Dynamic
}

model MeetingException {
  id                  String    @id @default(cuid())
  scheduledMeetingId  String
  // The original occurrence start time being overridden.
  originalStart       DateTime
  overrideStart       DateTime?
  overrideDurationMin Int?
  overrideTitle       String?
  cancelled           Boolean   @default(false)

  meeting ScheduledMeeting @relation(fields: [scheduledMeetingId], references: [id])

  @@unique([scheduledMeetingId, originalStart])
}

// Send log for meeting reminders (meeting-reminders job) — the idempotency
// key. occurrenceStart is the occurrence's ORIGINAL start (pre-exception-
// override) so a moved occurrence doesn't double-remind; consequence: an
// exception created after the reminder already fired gets no second one.
// A dedicated log (rather than deduping on Notification) because per-user
// preferences can deliver a reminder by email/DM with no in-app row at all.
model MeetingReminderLog {
  id                 String   @id @default(cuid())
  scheduledMeetingId String
  occurrenceStart    DateTime
  userId             String
  sentAt             DateTime @default(now())

  meeting ScheduledMeeting @relation(fields: [scheduledMeetingId], references: [id], onDelete: Cascade)

  @@unique([scheduledMeetingId, occurrenceStart, userId])
}

// Per-user calendar preferences. Lazily upserted on first write.
model UserAvailabilitySettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  // IANA zone, e.g. "America/New_York". Working hours are interpreted in this zone.
  timezone              String   @default("America/New_York")
  defaultEventBufferMin Int      @default(15)
  // ── Phase 3: DALI Timesheet Google mirror ─────────────────────────────────
  // Opt-in flag. When true, work TimeEntry rows with startTime+endTime are
  // mirrored one-way to a "DALI Timesheet" calendar on the user's DALI Google
  // link. Off by default — see app/lib/timesheet-mirror.server.ts.
  timesheetGoogleSync    Boolean @default(false)
  // The UserCalendarLink (DALI @dali.dartmouth.edu Google account) hosting the
  // timesheet calendar. Soft pointer — no FK — matches the MemberClass pattern.
  timesheetCalendarLinkId String?
  // The Google calendar id of the "DALI Timesheet" calendar on that link.
  timesheetCalendarId     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// A paid job the member holds outside DALI — a library shift, a research
// assistantship, another department's hourly role.
//
// The lab has no assignment table for these (it doesn't staff them and can't
// verify them), but members still log the hours and still have to file them in
// JobX, which is per-job. Without somewhere to put them, non-DALI time either
// lands in the "unassigned" export bucket or doesn't get logged here at all.
//
// Owned by the member: they create, rename and archive their own. Nothing else
// in the app reads these — they exist to give TimeEntry.roleRefId a target when
// assignmentType is Custom, and to become a hire tag the timesheet extension
// can fill against.
model CustomHire {
  id     String @id @default(cuid())
  userId String
  label  String

  // Soft delete: entries already attributed to a hire keep resolving their
  // label after the member stops using it. Archived hires drop out of the
  // picker but stay in past exports.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One label per person — re-adding the same name should reuse the row rather
  // than split a member's hours across two identical-looking hires.
  @@unique([userId, label])
  @@index([userId, archivedAt])
}

// One row per user per weekday. startMinute/endMinute are minutes-from-local-midnight
// (0–1440), applied in the user's UserAvailabilitySettings.timezone.
// Working-hours segment. A user can have multiple segments per day-of-week, e.g.
// 07:00–09:00 Remote followed by 09:00–12:00 InPerson.
model WorkingHoursDay {
  id          String       @id @default(cuid())
  userId      String
  dayOfWeek   Int // 0=Sunday .. 6=Saturday
  enabled     Boolean      @default(true)
  startMinute Int          @default(540) // 9:00
  endMinute   Int          @default(1020) // 17:00
  location    WorkLocation @default(InPerson)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, dayOfWeek])
}

enum WorkLocation {
  InPerson
  Remote
}

// A member's Dartmouth class for a term, added to their calendar. Either synced
// to a linked Google calendar (storage="Google" → real recurring events we
// created, tracked in googleEventIds so edits/removals patch/delete them) or
// rendered as a DALI-only layer (storage="Local"). `meetings` holds the
// resolved weekly patterns (main + optional x-hour) as PeriodMeeting[] JSON, so
// period-picked and custom classes render and expand through one path.
model MemberClass {
  id             String   @id @default(cuid())
  userId         String
  termId         String
  title          String
  // Dartmouth period code ("10", "10A", …) when picked from the schedule; null
  // for a custom day/time entry.
  periodCode     String?
  // Resolved PeriodMeeting[] { kind, days, startMin, endMin } — source of truth
  // for rendering and RRULE generation.
  meetings       Json
  location       String?
  // "Google" (synced events on a linked calendar) or "Local" (in-app layer).
  storage        String   @default("Local")
  // Google destination + the events we created (main, and x-hour when included).
  // Soft pointer to CalendarLink (no FK) — an orphaned link surfaces in the
  // manager rather than cascading. Null for Local classes.
  linkId         String?
  calendarId     String?
  googleEventIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  term Term @relation(fields: [termId], references: [id])

  @@index([userId, termId])
}

// ═══ V0 Phase 1 ═════════════════════════════════════════════════════════════
//
// The models below land in `v0-phase1-additive`. They are purely additive
// (new tables; no column drops, no FK renames). Together they implement the
// foundational role model + new feature surfaces from `expansion_plan.md`
// and the auth-side foundation from `dali-os-mcp.md`. Phase 2 (destructive
// refactor) runs separately after the live 2026-S cycle closes.
//
// See V0_PLAN.md for the locked decisions, deploy sequencing, and the
// Phase 2 column-drop / FK-rename plan.

// ─── Term ────────────────────────────────────────────────────────────────────

model Term {
  id        String   @id @default(cuid())
  code      String   @unique // "26S", "27F", etc.
  year      Int
  season    Season
  // sortKey enables chronological sort. Alphabetical sort of `code` breaks
  // because within a year the seasons go W → S → X → F, not alphabetic.
  sortKey   Int      @unique // year * 10 + (W=1, S=2, X=3, F=4)
  startDate DateTime
  endDate   DateTime

  projectAssignments    ProjectAssignment[]
  mentorshipPairs       MentorshipPair[]
  domainLeadAssignments DomainLeadAssignment[]
  coreAssignments       CoreAssignment[]
  instructorAssignments InstructorAssignment[]
  educationOfferings    EducationOffering[]
  staffingCycles        StaffingCycle[]
  projectTermStatuses   ProjectTermStatus[]
  projectTerms          ProjectTerm[]
  projectRoleRequests   ProjectRoleRequest[]
  staffingAssignments   StaffingAssignment[]
  partnerApplications   PartnerApplicationTargetTerm[]
  intentToWork          IntentToWork[]
  projectDomainScopes   ProjectDomainScope[]
  ceCredits             CECredit[]
  payPeriods            PayPeriod[]
  budgetEntries         BudgetEntry[]
  budgetNotes           BudgetNote[]
  signingBindings       SigningBinding[]
  timelineWeeks         TimelineWeek[]
  timelineDomains       TimelineDomain[]
  memberClasses         MemberClass[]

  @@index([sortKey])
}

// ─── Lab term timeline (/milestones) ─────────────────────────────────────────

// The ten weeks of a term: what each week is for, the milestones every team
// (or the whole lab) hits, and what each domain owns alongside them. Seeded
// per term from the defaults in app/lib/term-timeline.ts the first time the
// page is opened, then edited in place by Core.
model TimelineWeek {
  id        String   @id @default(cuid())
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  // 0-based, matching the W0…W9 labels on the page.
  weekIndex Int
  title     String
  dates     String
  blurb     String
  // S3 object key (uploads/…) or a pasted URL — resolved through
  // resolvePhotoUrl like User.photoUrl, so both shapes render.
  imageKey  String?
  imageAlt  String?
  resources String[]
  // Typography overrides from the edit toolbar, keyed by field path
  // ("title", "milestone:<id>.name", …) → { size?, bold?, color? }. Absent
  // keys render at the design's defaults.
  format    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones TimelineMilestone[]
  lanes      TimelineLane[]

  @@unique([termId, weekIndex])
}

model TimelineMilestone {
  id       String       @id @default(cuid())
  weekId   String
  week     TimelineWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  name     String
  detail   String
  // Lab-wide events (Prod Tales, Bug Hunt, Technigala) render as the coral
  // banner; the rest are milestones each team hits on its own.
  labWide  Boolean      @default(false)
  position Int

  @@index([weekId])
}

// The domain vocabulary of one term's timeline — the lanes every week is
// split into. Seeded from DOMAINS in app/lib/term-timeline.ts, then edited
// (added to, renamed, recoloured, removed) from the page's edit mode.
model TimelineDomain {
  id       String @id @default(cuid())
  termId   String
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  // What TimelineLane.domainKey points at. "pm"/"design"/"dev"/"data" for the
  // seeded four, an opaque unique string for domains added later.
  key      String
  name     String
  // Brand hex owning this domain's stripe/dot.
  color    String
  position Int

  @@unique([termId, key])
}

model TimelineLane {
  id           String       @id @default(cuid())
  weekId       String
  week         TimelineWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  // TimelineDomain.key within this week's term — the domain vocabulary of this
  // page, not the Domain table (which is staffing's, and is finer-grained).
  domainKey    String
  role         String
  deliverables String[]
  challenge    String

  @@unique([weekId, domainKey])
}

enum Season {
  W // Winter
  S // Spring
  X // Summer
  F // Fall
}

// ─── Foundational role model ─────────────────────────────────────────────────

// Tracks qualifications, independent of active assignments. A member can hold
// P3 eligibility in Graphics and Animation but be currently working only as
// Animation P3 — the Graphics P3 eligibility persists.
model DomainEligibility {
  id         String   @id @default(cuid())
  userId     String
  domainId   String
  // Eligibility is monotonic in v1: only goes up (no demotions). To preserve
  // a simple one-row-per-(user,domain) shape, we update `level` in place and
  // store the most recent promotion metadata here.
  level      Level
  promotedAt DateTime @default(now())
  // Free-form: the userId of a Domain Lead / Core member / Admin who
  // promoted them. Not an FK so audit history survives user deletion.
  promotedBy String?

  user   User   @relation(fields: [userId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([userId, domainId])
}

enum Level {
  P1 // Learner
  P2 // Doer
  P3 // Mentor
}

// Active project work for a term. Drawn from the member's DomainEligibility
// rows. App-level constraint: assignment.level <= eligibility.level for
// (userId, domainId).
model ProjectAssignment {
  id        String @id @default(cuid())
  userId    String
  projectId String
  termId    String
  domainId  String
  level     Level

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  domain  Domain  @relation(fields: [domainId], references: [id])

  // Multiple rows per (user, term) is normal: a member can be on multiple
  // projects, and even multiple domains within the same project for
  // cross-training. The unique below prevents only literal duplicates.
  @@unique([userId, projectId, termId, domainId])
  @@index([userId, termId])
  @@index([projectId, termId])
}

// Domain-scoped mentorship within a project's context. The mentor is NOT
// required to have a ProjectAssignment for that project — Domain Leads and
// PM Mentors mentor across the lab without project membership.
//
// Per Cl-clarification Q22 (loosened): no unique on (mentee, project, term,
// domain); we allow multiple mentors per mentee in the same scope (rare but
// supported, e.g. a Domain Lead + project P3 co-mentorship).
model MentorshipPair {
  id           String @id @default(cuid())
  menteeUserId String
  mentorUserId String
  projectId    String
  termId       String
  domainId     String

  mentee  User    @relation("MenteePairs", fields: [menteeUserId], references: [id])
  mentor  User    @relation("MentorPairs", fields: [mentorUserId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  domain  Domain  @relation(fields: [domainId], references: [id])

  @@index([menteeUserId, projectId, termId])
  @@index([mentorUserId, termId])
}

// Per-cycle override of a member's mentor/mentee role on the staffing board.
// Default role is derived from level (P3 → mentor, P1/P2 → mentee); a row here
// exists only when a staffing manager clicked the card's role badge to flip it.
// `isMentor` is the explicit choice. Consumed at finalize: an effective mentor
// who isn't P3 in a mentee's domain is promoted (see api.staffing.finalize),
// and derivePairings pairs each domain's effective mentors to its mentees.
model StaffingMentorRole {
  id              String  @id @default(cuid())
  staffingCycleId String
  userId          String
  isMentor        Boolean

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  // One override per (cycle, user) — retoggling updates it in place.
  @@unique([staffingCycleId, userId])
  @@index([staffingCycleId])
}

// An external mentor placed on a project's staffing column — an existing DALI
// member (usually staffed on another project) who mentors this project's mentees
// in one domain. `user` points at that member, so they're a real MentorshipPair
// mentor and can write mentor notes. Rendered as a distinct card on the board.
// At finalize, derivePairings pairs them to the project's same-domain mentees;
// they're excluded from this project's roster automation (no ProjectAssignment,
// GitHub/Slack), since they aren't staffed here.
model ExternalMentor {
  id              String @id @default(cuid())
  staffingCycleId String
  projectId       String
  domainId        String
  userId          String

  createdAt   DateTime @default(now())
  createdById String?

  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])
  project       Project       @relation(fields: [projectId], references: [id])
  domain        Domain        @relation(fields: [domainId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  // One row per (cycle, project, mentor, domain) — re-adding is a no-op.
  @@unique([staffingCycleId, projectId, userId, domainId])
  @@index([staffingCycleId, projectId])
}

// Year-long elected lead position. `leadTitle` is display-only — Core has
// broad access to everything; the title affords UI surfacing but does not
// gate permissions.
model CoreAssignment {
  id        String  @id @default(cuid())
  userId    String
  termId    String
  leadTitle String?

  user User @relation(fields: [userId], references: [id])
  term Term @relation(fields: [termId], references: [id])

  // No (userId, termId) unique — a member can hold multiple Core titles in
  // the same term. App-level validates "no duplicate (user, term, leadTitle)".
  @@index([userId, termId])
  @@index([termId, leadTitle])
}

// Authority to teach a specific education offering in a specific term.
// Per Cl-clarification Q21: term scopes the uniqueness so a member can
// instruct the same offering across multiple terms.
model InstructorAssignment {
  id         String @id @default(cuid())
  userId     String
  offeringId String
  termId     String

  user     User              @relation(fields: [userId], references: [id])
  offering EducationOffering @relation(fields: [offeringId], references: [id])
  term     Term              @relation(fields: [termId], references: [id])

  @@unique([userId, offeringId, termId])
  @@index([offeringId, termId])
}

// Permanent (until revoked). The admin-access marker. Admin is a superset of
// Core. Both students (elected leads) and full-time staff can hold Admin.
// `isStaff` marks the strict subset who are full-time staff — professional
// employees for whom the student lifecycle (CE compliance, graduation,
// onboarding) does not apply. Living on this row enforces "staff ⊂ admin":
// there is no way to be staff without the row that grants admin.
model AdminMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  grantedAt DateTime @default(now())
  // Free-form: the userId of the actor who granted Admin. Not an FK so audit
  // history survives user deletion.
  grantedBy String?
  // Full-time staff: exempt from student checklist items and shown as Staff.
  isStaff   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}

// Each (assignmentType × level × domain) maps to a Dartmouth payroll job
// code. DALI OS does NOT track hours, but it surfaces job codes for payroll
// mapping/export. Derived at query time, not stored on assignment rows.
model JobCodeLookup {
  id             String         @id @default(cuid())
  // Nullable level/domain act as wildcards in the lookup.
  assignmentType AssignmentType
  level          Level?
  domainId       String?
  jobCode        String
  payRateUsdHour Decimal?
  notes          String?
}

enum AssignmentType {
  Project
  Core
  Instructor
  DomainLead
  Admin
  // A job the member holds outside DALI. Unlike every other variant this one
  // points at CustomHire rather than an assignment table the lab controls —
  // see that model for why it exists.
  Custom
}

// ─── Project workspace ───────────────────────────────────────────────────────

model Project {
  id            String  @id @default(cuid())
  name          String
  // Short plain-text blurb shown at the top of the project detail page.
  // Rich/long-form content lives in the collab overview page instead.
  description   String?
  // Project-owned Google Workspace identity (e.g.,
  // "projectalpha@dali.dartmouth.edu"). Calendar events for this project
  // are owned by this identity, not the organizer's personal calendar. Also
  // the user account provisioned by the staffing "Create Gmail accounts"
  // finalize automation (backfilled there if unset).
  calendarEmail String?

  // Project-team Google Workspace GROUP address (e.g.,
  // "projectalpha-team@dali.dartmouth.edu"). Get-or-created by the staffing
  // "Create Gmail accounts" finalize automation, which also adds the confirmed
  // roster as group members. Null until that automation first runs.
  teamGroupEmail String?
  // Expected span length: how many terms the project is *planned* to run, as
  // a target. Independent of the actual ProjectTerm set — a project may have
  // fewer terms added than expected (still being scheduled) or more. Drives
  // the "N of M terms added" projection. The start term is derived as the
  // earliest term in `projectTerms` (by Term.sortKey), not stored.
  termCount      Int           @default(1)
  status         ProjectStatus @default(Active)

  // Auto-created on Project creation: a top-level FreeForm Page in the
  // Project workspace. The workspace's Overview tab renders this page's
  // contentDoc with a structured project header above. Nullable to allow
  // Project creation in a transaction before the Page row exists; populated
  // immediately after.
  overviewPageId String? @unique

  // Product Requirement Doc — a collab Page, same pattern as overviewPageId
  // (loose reference; workspaceType dispatches at the app layer).
  prdPageId String? @unique

  // Project hero image, shown on the hub, partner, and public views.
  imageUrl String?

  // Notion-style project icon: a single emoji shown before the project name
  // across the hub, detail header, search, and profile surfaces. Null → a
  // neutral fallback glyph. Mirrors Page.iconEmoji.
  iconEmoji String?

  // Git repositories for this project (URLs). Empty by default.
  repoUrls String[] @default([])

  // Live deployment / hosted URL for the project (e.g. a Fly/Vercel app).
  // Single link, shown on the project detail page next to the repos. Null
  // until a lead sets it.
  deploymentUrl String?

  // GitHub team slug for this project's org team, persistent across terms.
  // Set on the project detail page. When present, the staffing "Set up GitHub
  // teams" finalize automation get-or-creates a team with this slug under
  // GITHUB_ORG and adds the confirmed roster. Null = automation skips.
  githubTeamSlug String?

  // The project's Slack channel id (e.g. "C0123ABC"), used to invite members +
  // post the team announcement on staffing finalize. Backfilled by finalize/modal
  // Save when the channel (named by slackChannelName) is get-or-created. Null
  // until the first sync runs the Slack channel step.
  slackChannelId   String?
  // Human channel name (e.g. "project-alpha") — the SHARED source of truth edited
  // on the project details page AND the staffing Finalize modal. Defaults to the
  // slugified project name until set. Finalize/modal-Save get-or-creates this
  // channel and backfills slackChannelId.
  slackChannelName String?

  // Dartmouth payroll chart string for this project. `chartStringType` is the
  // GL account category (e.g. "Grant", "Department"); `chartString` is the
  // full concatenated GL string. Both are admin-edited and surfaced in the
  // payroll export. Null until an admin sets them.
  chartStringType String?
  chartString     String?

  // Private projects are excluded from every `projects:*` form reference
  // source, so they can't be picked as an answer on a bid/preference form.
  // Deliberately NOT a hub/search filter — the hub still lists them.
  // Toggled by Core/Admin in the project settings modal.
  isPrivate Boolean @default(false)

  overviewPage Page? @relation("ProjectOverview", fields: [overviewPageId], references: [id])
  prdPage      Page? @relation("ProjectPRD", fields: [prdPageId], references: [id])

  partners          ProjectPartner[]
  // The project's planned term set — the source of truth for which terms the
  // project runs. The start term is the earliest of these (by Term.sortKey).
  projectTerms      ProjectTerm[]
  termStatuses      ProjectTermStatus[]
  assignments       ProjectAssignment[]
  roleRequests      ProjectRoleRequest[]
  mentorshipPairs   MentorshipPair[]
  externalMentors   ExternalMentor[]
  sprints           Sprint[]
  epics             Epic[]
  tasks             Task[]
  // Declared domains for the project — surfaced on the project detail page
  // and editable by Admin/Core/Hiring Lead. Display-only today; staffing
  // gating off this set is a follow-up.
  domains           ProjectDomain[]
  domainScopes      ProjectDomainScope[]
  // Standalone uploaded files in the project's Files section.
  files             ProjectFile[]
  budgetEntries     BudgetEntry[]
  budgetNotes       BudgetNote[]
  scheduledMeetings ScheduledMeeting[]
  timeEntries       TimeEntry[]
  // The curated public face of this project, if it has one. Absent until
  // someone opens the project's Public view.
  showcase          ProjectShowcase?

  createdAt DateTime @default(now())
}

// The public, curated view of a project — what dali.website shows to the
// world. Stands to the marketing site as the partner view stands to the
// partner portal: a deliberately narrow projection, not a filter over the
// internal record. Nothing here is derived from Project; every field is
// hand-written on the project's Public view tab, because the public framing
// of a project ("Assessing personal risk during COVID") is rarely the
// internal one ("CoRisk").
//
// Seeded from the frozen Notion "Projects Showcase" database
// (scripts/import-project-showcase.ts). Only rows with status = Published are
// ever served publicly.
model ProjectShowcase {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The publish gate — Published is the only value the public API serves, so
  // no separate boolean. The rest of the vocabulary is carried over from
  // Notion so the import is lossless and the pipeline stays visible to Core.
  status ProjectShowcaseStatus @default(NotStarted)

  // One-line public blurb ("Assessing personal risk during COVID"). This, not
  // the name, is what the showcase card leads with.
  tagline     String?
  // Public name, when it differs from the internal one (internally "AIPA",
  // publicly "AI Patient Actor"). Null = fall back to Project.name.
  displayName String?
  // Calendar year the project ran, e.g. 2020. Deliberately not a term code:
  // the public site groups by year, and the archive reaches back to 2015,
  // well before the Term table starts.
  year        Int?

  // Free-text facet lists, rendered as tag pills and used by the site's
  // filters. Not FKs to Domain/Term — the public taxonomy ("Mobile", "XR",
  // "Student Founder") is its own vocabulary, curated for the audience.
  partners  String[] @default([])
  products  String[] @default([])
  sectors   String[] @default([])
  techStack String[] @default([])

  appUrl     String?
  websiteUrl String?
  blogUrl    String?
  pressUrl   String?

  // Public hero image: an S3 key under `uploads/` or a full URL, resolved by
  // resolvePhotoUrl like every other image. Separate from Project.imageUrl so
  // curating the public face never disturbs the internal hub's banner.
  heroImageUrl String?

  // The Notion page this row was imported from. Makes re-running the importer
  // idempotent and lets a later --images pass find its row without re-doing
  // the (lossy) name matching. Null for rows created in-app.
  notionPageId String? @unique

  updatedById String?
  updatedBy   User?   @relation("ProjectShowcaseUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum ProjectShowcaseStatus {
  NotStarted
  InProgress
  NeedsReview
  Published
  Archive
}

// Many-to-many join: which domains a project has declared. Distinct from
// ProjectAssignment.domainId (the per-member, per-term concrete assignment),
// which is downstream of staffing.
model ProjectDomain {
  projectId String
  domainId  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain  Domain  @relation(fields: [domainId], references: [id])

  createdAt DateTime @default(now())

  @@id([projectId, domainId])
  @@index([domainId])
}

// Many-to-many join: which terms a project runs. Source of truth for the
// project's planned term set — editable on the project detail page (add /
// remove individual terms; the set need not be consecutive). The "start
// term" is derived as the earliest of these by Term.sortKey, and a project
// counts as active in a given term iff a row exists for that (project, term).
// Project.termCount is the *expected* length of this set, not derived from it.
model ProjectTerm {
  projectId String
  termId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())

  @@id([projectId, termId])
  @@index([termId])
}

// Per-term, per-domain free-text scope for a project. One cell per
// (project, domain, term): rendered as a grid on the project's Overview
// tab — declared domains down one axis, the project's planned terms
// across the other. Plain text, not markdown — keep it simple.
//
// Cells are rows in this table only when they have text; an empty cell
// means "no scope written yet" and the UI shows a placeholder.
model ProjectDomainScope {
  id        String @id @default(cuid())
  projectId String
  domainId  String
  termId    String
  // Free-form scope description for this (domain, term) slot. Multi-line
  // plain text; the UI auto-saves on blur. May be the empty string while
  // a user clears it before tabbing out — the action treats empty as
  // delete-row to keep the grid clean.
  scope     String

  // Editor accountability.
  updatedById String?
  updatedBy   User?    @relation("ProjectDomainScopeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain  Domain  @relation(fields: [domainId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([projectId, domainId, termId])
  @@index([projectId])
  @@index([domainId])
  @@index([termId])
}

enum ProjectStatus {
  Active
  Paused
  Archived
}

// Continuing-or-not flag per project per term. Both PM and Partner Relations
// Lead can write to this.
model ProjectTermStatus {
  id           String   @id @default(cuid())
  projectId    String
  termId       String
  isContinuing Boolean
  // Free-form actor userId.
  setBy        String?
  setAt        DateTime @default(now())

  // Per-term meeting links and Statement of Work. Calendar/Zoom rotate per
  // term; SOW is a collab Page (loose reference, app-layer dispatch like
  // Project.overviewPageId).
  gcalLink  String?
  zoomLink  String?
  sowPageId String?

  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([projectId, termId])
}

// Per-project per-term role requirements. Defines the slots staffing needs
// to fill — a project might need 2 P1 Fullstack, 1 P3 Fullstack Mentor,
// 1 P1 UIUX, etc.
model ProjectRoleRequest {
  id         String  @id @default(cuid())
  projectId  String
  termId     String
  domainId   String
  level      Level
  slots      Int
  // Optional collab doc explaining what this role entails on this project.
  notesDocId String?

  project Project @relation(fields: [projectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  domain  Domain  @relation(fields: [domainId], references: [id])

  @@index([projectId, termId])
}

model Epic {
  id               String     @id @default(cuid())
  projectId        String
  title            String
  // Plain-text epic description, edited in the epic detail panel.
  description      String?
  // Description as collab doc — Notion-style rich content.
  descriptionDocId String?
  status           EpicStatus @default(Open)
  // Explicit timeline span. Nullable: an epic may be created before its
  // dates are known. When null, the timeline falls back to the min/max of
  // the epic's sprint dates (see projects.$id loader).
  startsAt         DateTime?
  endsAt           DateTime?
  // Optional target term for cross-term epics that span multiple sprints.
  targetTermId     String?
  position         Int        @default(0)

  project Project     @relation(fields: [projectId], references: [id])
  tasks   Task[]
  sprints Sprint[]
  stories UserStory[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

enum EpicStatus {
  Backlog
  Open
  InProgress
  Done
  Cancelled
}

// User story under an epic. Kept lightweight: a title plus optional
// acceptance/notes text and a status. Position keeps a stable manual order.
model UserStory {
  id       String          @id @default(cuid())
  epicId   String
  title    String
  notes    String?
  status   UserStoryStatus @default(Todo)
  position Int             @default(0)

  // Timeline span. Nullable: stories predate the timeline and are created
  // before their dates are known. The timeline falls back to the min/max of
  // the story's tasks, then to the parent epic's span (see projects.$id loader).
  startsAt DateTime?
  endsAt   DateTime?

  // Product-requirement columns surfaced in the epic's prod-req table (internal
  // + partner views). All optional so existing stories migrate without
  // backfill; category is freeform text, priority is MoSCoW.
  successMetric      String?
  acceptanceCriteria String?
  category           String?
  priority           StoryPriority?

  epic  Epic   @relation(fields: [epicId], references: [id])
  tasks Task[]

  // Timeline dependency edges, same two-sided shape as SprintDependency.
  // `dependencies` are rows where this story is the dependent (stories it
  // waits on); `blocking` are rows where it is the predecessor.
  dependencies UserStoryDependency[] @relation("UserStoryDependent")
  blocking     UserStoryDependency[] @relation("UserStoryBlocker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([epicId])
}

// Directed edge: `story` waits on `dependsOnStory`. Both sides are same-epic's
// project — enforced in the API, not the schema. Drawn as arrows between story
// bars on the project timeline.
model UserStoryDependency {
  id               String @id @default(cuid())
  storyId          String
  dependsOnStoryId String

  story          UserStory @relation("UserStoryDependent", fields: [storyId], references: [id], onDelete: Cascade)
  dependsOnStory UserStory @relation("UserStoryBlocker", fields: [dependsOnStoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([storyId, dependsOnStoryId])
  @@index([dependsOnStoryId])
}

enum StoryPriority {
  Must
  Should
  Could
  Wont
}

enum UserStoryStatus {
  Todo
  InProgress
  Done
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  // Optional epic this sprint belongs to. Null = standalone/cross-epic
  // sprint. Tasks still carry their own epicId for cross-sprint grouping.
  epicId    String?
  name      String
  startsAt  DateTime
  endsAt    DateTime
  // Sprint goal as collab doc. Retros live as collab pages in the project's
  // page tree.
  goalDocId String?
  status    SprintStatus @default(Planned)

  project Project @relation(fields: [projectId], references: [id])
  epic    Epic?   @relation(fields: [epicId], references: [id])
  tasks   Task[]

  // Timeline dependency edges. `dependencies` are the rows where this sprint is
  // the dependent (the sprints it waits on); `blocking` are rows where it is
  // the predecessor (sprints that wait on it). Both sides are same-project —
  // enforced in the API, not the schema.
  dependencies SprintDependency[] @relation("SprintDependent")
  blocking     SprintDependency[] @relation("SprintBlocker")

  @@index([projectId, status])
}

// A directed "must finish before" edge between two sprints, drawn as an arrow
// on the epics timeline. `sprintId` depends on (waits for) `dependsOnSprintId`.
model SprintDependency {
  id                String @id @default(cuid())
  sprintId          String
  dependsOnSprintId String

  sprint          Sprint @relation("SprintDependent", fields: [sprintId], references: [id], onDelete: Cascade)
  dependsOnSprint Sprint @relation("SprintBlocker", fields: [dependsOnSprintId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sprintId, dependsOnSprintId])
  @@index([dependsOnSprintId])
}

enum SprintStatus {
  Planned
  Active
  Closed
}

model Task {
  id        String  @id @default(cuid())
  projectId String
  // Null sprintId = backlog.
  sprintId  String?
  // Optional epic linkage for cross-sprint grouping.
  epicId    String?
  // Optional parent user story. Null = the task hangs directly off the epic
  // (or nothing). Drives the timeline's task-inside-story nesting.
  storyId   String?

  title            String
  // Plain-text task description, edited in the task modal.
  description      String?
  descriptionDocId String?
  status           TaskStatus @default(Todo)
  priority         Priority   @default(Normal)
  position         Int        @default(0)
  // Optional timeline start. Pairs with dueAt to give the task a span on the
  // project timeline; null falls back to the parent story/sprint start.
  // Purely a planning field — it fires no reminders.
  startsAt         DateTime?
  // Optional deadline. UTC instant; UI formats in local time. When set,
  // the task-due-reminders job notifies assignees 24h before and at the
  // moment (channels per their preferences; TaskReminder is the idempotency
  // ledger). Null = no reminders fire.
  dueAt            DateTime?

  // Optional domain label (Design, Dev, etc.) — shown as a chip on the card
  // and editable in the task modal. Independent of who's assigned so the
  // label survives reassignment.
  domainId String?

  // Subtasks: simple checklist field rather than hierarchical Task→Task
  // children (Linear/Notion style).
  // JSON shape: [{ "text": "...", "done": false }]
  checklist Json?

  // Soft archive. Done/Cancelled tasks left untouched past the
  // task-auto-archive job's threshold get stamped here and drop off the
  // board (the loader filters archivedAt: null). The row is preserved, not
  // deleted, so it stays reportable/restorable.
  archivedAt DateTime?

  // Last *meaningful* change (status/field edit, assignee change, comment,
  // GitHub link) — deliberately separate from `updatedAt`, which also gets
  // bumped by drag-and-drop reordering of column-mates that didn't actually
  // change. Compared against TaskView.viewedAt to drive the "new updates"
  // dot on the board. Mutation routes set this explicitly; it is not
  // `@updatedAt`.
  activityAt DateTime @default(now())

  // Optional mirror to a GitHub issue. All three populated together when the
  // task was created with the "Create GitHub issue" toggle on; null when not
  // mirrored. The (githubRepo, githubIssueNumber) pair is the lookup key for
  // inbound webhook events.
  githubRepo        String?
  githubIssueNumber Int?
  githubIssueUrl    String?

  project   Project        @relation(fields: [projectId], references: [id])
  sprint    Sprint?        @relation(fields: [sprintId], references: [id])
  epic      Epic?          @relation(fields: [epicId], references: [id])
  story     UserStory?     @relation(fields: [storyId], references: [id])
  domain    Domain?        @relation(fields: [domainId], references: [id])
  assignees TaskAssignee[]
  comments  TaskComment[]
  reminders TaskReminder[]
  files     TaskFileLink[]
  views     TaskView[]

  createdById String
  createdBy   User     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([githubRepo, githubIssueNumber], name: "task_github_issue_unique")
  @@index([projectId, sprintId])
  @@index([storyId])
}

enum TaskStatus {
  Backlog
  Todo
  InProgress
  InReview
  Done
  Cancelled
}

enum Priority {
  Low
  Normal
  High
  Urgent
}

// Idempotency ledger for task deadline reminders (task-due-reminders job).
// The unique key includes dueAtSnapshot: re-enqueueing while the deadline is
// unchanged is a no-op (createMany skipDuplicates), and a moved deadline
// creates a fresh row while old unsent rows go inert — the send phase
// re-checks snapshot === Task.dueAt.
model TaskReminder {
  id            String       @id @default(cuid())
  taskId        String
  userId        String // the assignee being reminded
  kind          ReminderKind
  dueAtSnapshot DateTime
  sentAt        DateTime? // null until notify() succeeded
  createdAt     DateTime     @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId, kind, dueAtSnapshot])
  @@index([sentAt, dueAtSnapshot])
}

enum ReminderKind {
  DayBefore
  AtDeadline
}

// Multi-assignee per task (solo or multi both supported).
model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  // Plain text or markdown — small comments, not collab doc.
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

// Per-user "last opened this task" stamp. Compared against Task.activityAt
// to render the board's "new updates" indicator — a row only exists once a
// user has opened the task at least once, so a task nobody on the viewer's
// side has ever opened isn't flagged "new" (that would just be every task).
model TaskView {
  id       String   @id @default(cuid())
  taskId   String
  userId   String
  viewedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

// A reusable project blueprint: the shape of a project (epics + user stories,
// sprints with relative day-offsets, and tasks with checklists) captured so a
// new project can be spun up pre-populated. Standalone (no live FK to any one
// project) — capture serialises, instantiate rebuilds. The `blueprint` JSON
// shape is defined + versioned in app/lib/project-templates.server.ts.
model ProjectTemplate {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  iconEmoji            String?
  isDefault            Boolean  @default(false)
  blueprint            Json
  // Optional Lab/Project page duplicated as the new project's Overview doc.
  overviewSourcePageId String?
  // Free-form creator userId (loose, like other template models).
  createdBy            String?
  createdAt            DateTime @default(now())

  @@index([isDefault])
}

// ─── Education ───────────────────────────────────────────────────────────────

model EducationOffering {
  id                   String         @id @default(cuid())
  type                 OfferingType
  title                String
  descriptionDocId     String?
  capacity             Int
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  startsAt             DateTime?
  endsAt               DateTime?
  status               OfferingStatus @default(Draft)
  // True for typical miniseries (instructor-reviewed), false for typical
  // workshops (auto-approve up to capacity, waitlist after). Configurable
  // per-offering — workshops can opt into review without a schema change.
  requiresReview       Boolean
  // Fraction of sessions a student must attend (Present + Excused) to earn a
  // completion certificate. Miniseries only; workshops need one Present mark.
  completionThreshold  Float          @default(0.8)

  // Optional per-offering Google Workspace identity. Falls back to a shared
  // education identity if not set.
  calendarEmail        String?

  // The term this offering runs in — derived server-side from the first
  // session's date; null until sessions are added.
  termId               String?
  term                 Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)

  // The application/RSVP form for this offering, built with the shared Forms
  // system. Cloned from an education template at offering creation; fillers
  // always see the latest FormVersion. Null only transiently (offering
  // created before its form) — apply routes treat null as "not open".
  applicationFormId String?
  applicationForm   Form?   @relation("EducationOfferingApplicationForm", fields: [applicationFormId], references: [id], onDelete: SetNull)

  // Close-out: explicit instructor/Core action that issues certificates and
  // fires instructor exit surveys. Idempotent — re-running only issues
  // missing certificates. Independent of Archived status.
  closedOutAt   DateTime?
  closedOutById String?
  closedOutBy   User?     @relation("EducationOfferingClosedOutBy", fields: [closedOutById], references: [id])

  instructors          InstructorAssignment[]
  sessions             EducationSession[]
  applications         EducationApplication[]
  applicationQuestions EducationApplicationQuestion[]
  assignments          EducationAssignment[]
  announcements        EducationAnnouncement[]
  decisionEmails       EducationDecisionEmail[]
  discussionPosts      EducationDiscussionPost[]
  formBindings         EducationFormBinding[]
  formSubmissions      FormSubmission[]

  createdAt DateTime @default(now())

  @@index([termId])
}

enum OfferingType {
  Miniseries
  Workshop
}

enum OfferingStatus {
  Draft
  Published
  Archived
}

model EducationSession {
  id             String   @id @default(cuid())
  offeringId     String
  sequence       Int
  // Optional topic/title for the session (e.g. "Intro to Figma"). Null falls
  // back to "Session N" in the UI.
  title          String?
  datetime       DateTime
  // Optional end of the session. Null falls back to a default duration in the
  // UI (and the self-check-in window). Nullable for back-compat with sessions
  // created before end times existed.
  endsAt         DateTime?
  location       String?
  // Free text the instructor wants students to read alongside the session —
  // prep work, what to bring, a reading link. Shown on the course hub; distinct
  // from materials (which are pages) and from the recording.
  notes          String?
  // DORMANT in v1 — per-session materials live as pages in the offering's
  // page workspace instead. Kept for a possible per-session doc link later.
  materialsDocId String?
  recordingUrl   String?

  // Stamped when an instructor opens self-check-in for this session (students
  // scan a projected QR to mark themselves Present). Null = closed. Read
  // alongside the session's time window in app/education/lib/session-checkin.
  checkInOpenAt  DateTime?

  // Stamped when session-feedback todos/emails have been fanned out for this
  // session (first attendance save). Guards against duplicate fan-out.
  feedbackRequestedAt DateTime?

  // Stamped when a start-soon reminder has been fanned out for this session,
  // so the reminder job stays idempotent across ticks/retries.
  reminderSentAt DateTime?

  offering        EducationOffering     @relation(fields: [offeringId], references: [id])
  attendances     EducationAttendance[]
  assignments     EducationAssignment[]
  ceCredits       CECredit[]
  formSubmissions FormSubmission[]

  @@index([offeringId, sequence])
}

// Per Q14b: any User can apply (members can apply to offerings too). Field
// name preserves the "applicant" framing without restricting to students.
model EducationApplication {
  id              String               @id @default(cuid())
  applicantUserId String
  offeringId      String
  status          EduApplicationStatus
  submittedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  // Free-form: the userId of the reviewer who approved/rejected.
  reviewedBy      String?

  // The Forms-system submission holding this application's answers.
  // SetNull so deleting a form doesn't cascade away the application record.
  formSubmissionId String?         @unique
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)

  // FIFO position while status=Waitlisted (1 = next up). Mutable in place —
  // ranks shift down when someone is promoted or removed. Null otherwise.
  waitlistRank Int?

  applicant   User                         @relation("EducationApplicant", fields: [applicantUserId], references: [id])
  offering    EducationOffering            @relation(fields: [offeringId], references: [id])
  answers     EducationApplicationAnswer[]
  attendances EducationAttendance[]
  submissions EducationSubmission[]
  note        EducationStudentNote?
  certificate EducationCertificate?

  // One application per (applicant, offering). Withdrawal transitions
  // status, doesn't insert a second row.
  @@unique([applicantUserId, offeringId])
  // Roster views list by offering; the unique above leads with applicant.
  @@index([offeringId])
}

enum EduApplicationStatus {
  Submitted
  Approved
  Rejected
  Waitlisted
  Withdrawn
}

// DORMANT — never written or read. Applications use the shared Forms system
// (EducationOffering.applicationFormId → Form/FormVersion/FormSubmission)
// instead of these bespoke question tables. Kept because the migration that
// created them is applied; do not build on them.
model EducationApplicationQuestion {
  id         String  @id @default(cuid())
  offeringId String
  prompt     String
  position   Int
  required   Boolean @default(true)

  offering EducationOffering            @relation(fields: [offeringId], references: [id])
  answers  EducationApplicationAnswer[]

  @@index([offeringId, position])
}

// DORMANT — see EducationApplicationQuestion.
model EducationApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  content       String

  application EducationApplication         @relation(fields: [applicationId], references: [id])
  question    EducationApplicationQuestion @relation(fields: [questionId], references: [id])

  @@unique([applicationId, questionId])
}

model EducationAttendance {
  id            String           @id @default(cuid())
  applicationId String
  sessionId     String
  status        AttendanceStatus

  application EducationApplication @relation(fields: [applicationId], references: [id])
  session     EducationSession     @relation(fields: [sessionId], references: [id])

  @@unique([applicationId, sessionId])
}

enum AttendanceStatus {
  Present
  Absent
  Excused
}

model EducationAssignment {
  id                String         @id @default(cuid())
  // Exactly one of offeringId/sessionId should be set. App-level enforced.
  offeringId        String?
  sessionId         String?
  title             String
  instructionsDocId String?
  dueAt             DateTime?
  submissionType    SubmissionType
  // Optional max points. Null = complete/incomplete (free-form grade only).
  // Informational — points never gate course completion.
  points            Int?

  offering    EducationOffering?    @relation(fields: [offeringId], references: [id])
  session     EducationSession?     @relation(fields: [sessionId], references: [id])
  submissions EducationSubmission[]
}

enum SubmissionType {
  Text
  File
  Mixed
  // URL deliverable (Figma/GitHub/Drive link) — stored in EducationSubmission.link.
  Link
  // Student authors in a BlockNote collab doc (EducationSubmission.contentDocId).
  Doc
  // No artifact — the student marks the task done. Informational, like the rest.
  Complete
}

model EducationSubmission {
  id            String    @id @default(cuid())
  assignmentId  String
  studentId     String
  // Set for Doc submissions — the BlockNote collab room the student authors in
  // (room id "edusubmission:<submissionId>:content"). Null for other types.
  contentDocId  String?
  files         Json?
  submittedAt   DateTime?
  gradedAt      DateTime?
  // DORMANT in v1 — instructor feedback lives in feedbackText below.
  feedbackDocId String?

  // Plain-text submission body (Text/Mixed submission types).
  textContent  String?
  // URL deliverable body (Link submission type).
  link         String?
  // Free-form grade label (e.g. "Complete", "95"). No rubric in v1.
  grade        String?
  // Optional numeric score, set when the assignment defines points. Paired with
  // the free-form grade; informational only (never gates completion).
  score        Int?
  // Instructor feedback on this submission, shown to the student.
  feedbackText String?

  assignment             EducationAssignment   @relation(fields: [assignmentId], references: [id])
  student                User                  @relation("EducationSubmissionStudent", fields: [studentId], references: [id])
  educationApplication   EducationApplication? @relation(fields: [educationApplicationId], references: [id])
  educationApplicationId String?

  @@unique([assignmentId, studentId])
}

// Broadcast from instructor to all approved enrollees. On create, fans out
// via notify() (eventType "education.announcement") — in-app rows plus email
// per each recipient's preference.
// A post in an offering's discussion. The table keeps its original name — it
// started as instructor-only announcements — but the feature is now a
// discussion: instructors post either an Announcement (fans out to every
// enrollee, in-app + email) or an ordinary Message, students post Messages, and
// anyone in the offering can reply to any top-level post.
model EducationAnnouncement {
  id         String      @id @default(cuid())
  offeringId String
  authorId   String
  body       String
  // Announcement fans out a notification; Message doesn't. Only offering
  // managers may post an Announcement — a student post is always a Message.
  kind       EduPostKind @default(Announcement)
  // Set on a reply, pointing at the top-level post. One level only: a reply to
  // a reply still hangs off the same root, so a thread reads as a conversation
  // rather than a tree.
  parentId   String?
  sentAt     DateTime    @default(now())

  offering EducationOffering       @relation(fields: [offeringId], references: [id])
  author   User                    @relation("EducationAnnouncementAuthor", fields: [authorId], references: [id])
  parent   EducationAnnouncement?  @relation("EduPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  EducationAnnouncement[] @relation("EduPostReplies")

  @@index([offeringId, sentAt])
  @@index([parentId, sentAt])
}

enum EduPostKind {
  Announcement
  Message
}

// Per-offering binding: which EmailTemplateVersion fires when an application
// reaches the given status. One row per (offering, status). No row = in-app
// notification only, no email. Mirrors hiring's CycleDecisionEmail.
model EducationDecisionEmail {
  offeringId String
  offering   EducationOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  status EduApplicationStatus

  emailTemplateVersionId String
  emailTemplateVersion   EmailTemplateVersion @relation(fields: [emailTemplateVersionId], references: [id])

  @@id([offeringId, status])
}

// Course discussion board: top-level posts + one reply level (replies to
// replies are rejected at the lib layer). Plain text bodies in v1.
model EducationDiscussionPost {
  id         String   @id @default(cuid())
  offeringId String
  authorId   String
  // Null = top-level post; set = reply to that (top-level) post.
  parentId   String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offering EducationOffering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  author   User                      @relation("EducationDiscussionAuthor", fields: [authorId], references: [id])
  parent   EducationDiscussionPost?  @relation("EducationDiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  EducationDiscussionPost[] @relation("EducationDiscussionReplies")

  @@index([offeringId, createdAt])
  @@index([parentId])
}

// One consolidated instructor note per enrolled student per offering, with
// two lanes as two named columns. `feedback` is student-visible (shown with
// their certificate); `internalNote` is HIRING-ONLY and must never be
// selected by any student/portal-facing loader — the only sanctioned readers
// are the instructor roster view and the hiring application views (both
// behind reviewer access + confidentiality gates). Two columns (not an enum
// lane table) so the safe path is the default: leaking requires explicitly
// selecting the column, not merely forgetting a `where`.
model EducationStudentNote {
  id            String @id @default(cuid())
  applicationId String @unique

  feedback          String?
  feedbackUpdatedAt DateTime?
  feedbackAuthorId  String?

  internalNote          String?
  internalNoteUpdatedAt DateTime?
  internalNoteAuthorId  String?

  application        EducationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  feedbackAuthor     User?                @relation("EduNoteFeedbackAuthor", fields: [feedbackAuthorId], references: [id])
  internalNoteAuthor User?                @relation("EduNoteInternalAuthor", fields: [internalNoteAuthorId], references: [id])
}

// Continuing-education credit ledger. Every lab member must earn ≥1 credit
// per term; compliance views are display-only (nothing hard-blocks on this).
// Two row shapes:
//   - Attendance-derived: sessionId set, grantedById null. Written when an
//     instructor marks Present; deleted if the mark moves off Present.
//   - Manual grant: sessionId null, grantedById + reason set (covers the
//     async CEC check-in path and special cases; Core-only).
model CECredit {
  id     String @id @default(cuid())
  userId String
  termId String

  sessionId   String?
  grantedById String?
  reason      String?
  grantedAt   DateTime @default(now())

  user      User              @relation("CECreditUser", fields: [userId], references: [id])
  term      Term              @relation(fields: [termId], references: [id])
  session   EducationSession? @relation(fields: [sessionId], references: [id])
  grantedBy User?             @relation("CECreditGrantor", fields: [grantedById], references: [id])

  // Idempotent attendance-derived grants. Postgres treats NULL sessionId as
  // distinct, so manual grants are unconstrained by this.
  @@unique([userId, sessionId])
  @@index([termId])
  @@index([userId, termId])
}

// Completion certificate. Pure derived data (name, offering, term, dates) —
// the HTML page and PDF are generated on demand from this row; no stored
// artifact. Issued by the offering close-out action when the attendance
// threshold is met.
model EducationCertificate {
  id            String   @id @default(cuid())
  applicationId String   @unique
  issuedAt      DateTime @default(now())
  issuedById    String

  application EducationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  issuedBy    User                 @relation("EducationCertificateIssuer", fields: [issuedById], references: [id])
}

// Binds a Form to a named slot on one offering, mirroring
// StaffingCycleFormBinding. Slots: "session-feedback" | "instructor-exit"
// (free string — new slots need no migration).
model EducationFormBinding {
  id          String   @id @default(cuid())
  offeringId  String
  slot        String
  formId      String
  updatedAt   DateTime @updatedAt
  updatedById String

  offering  EducationOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  form      Form              @relation("EducationFormBindings", fields: [formId], references: [id], onDelete: Cascade)
  updatedBy User              @relation("EducationFormBindingUpdater", fields: [updatedById], references: [id])

  @@unique([offeringId, slot])
  @@index([formId])
}

// ─── Staffing ────────────────────────────────────────────────────────────────

// Staffing is always open. There is exactly one cycle per term (the term
// picker on /projects/staffing maps 1:1 to a cycle, auto-created on first
// use). No status / open-close lifecycle and no opens/closes dates.
model StaffingCycle {
  id                      String @id @default(cuid())
  termId                  String @unique
  name                    String
  // Member preference limit (UI-configurable per cycle, default 3).
  maxPreferencesPerMember Int    @default(3)

  term              Term                       @relation(fields: [termId], references: [id])
  preferences       StaffingPreference[]
  essentialityForms EssentialityForm[]
  assignments       StaffingAssignment[]
  intentToWork      IntentToWork[]
  formBindings      StaffingCycleFormBinding[]
  formSubmissions   FormSubmission[]
  boardMembers      StaffingBoardMember[]
  cardOrders        StaffingCardOrder[]
  mentorRoles       StaffingMentorRole[]
  externalMentors   ExternalMentor[]
}

// A member a staffing lead manually placed on the board for a cycle WITHOUT a
// bid. The board pool is otherwise derived from StaffingPreference / bid
// submissions, so a non-bidder would never appear; this row makes them show up
// as an ordinary Unassigned card the lead can then drag into a project. It is
// not a preference and not an assignment — purely "present on the board".
// Removed when the lead removes the card. A member who later bids still has
// their preferences take over the card; this row is harmless either way.
model StaffingBoardMember {
  id              String   @id @default(cuid())
  userId          String
  staffingCycleId String
  addedById       String? // actor; free-form userId, nullable for safety
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id])
  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])

  @@unique([userId, staffingCycleId])
}

model StaffingPreference {
  id              String  @id @default(cuid())
  userId          String
  staffingCycleId String
  projectId       String
  domainId        String
  level           Level
  // 1-based ranking among the member's preferences (1 = top choice).
  preferenceRank  Int
  notes           String?

  user          User          @relation(fields: [userId], references: [id])
  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])

  // Prevents duplicate preferences for the same (user, project, domain,
  // level) combination. Members revise prefs by updating the existing row.
  @@unique([userId, staffingCycleId, projectId, domainId, level])
  @@index([staffingCycleId, userId])
}

// "Intent to Work" form. Collected per cycle, before bids: for each term in
// the cycle's upcoming year a member states whether they'll be around. Drives
// who the staffing board expects to place. One row per (user, cycle, term);
// members revise by updating the existing row.
model IntentToWork {
  id              String       @id @default(cuid())
  userId          String
  staffingCycleId String
  termId          String
  status          IntentStatus
  notes           String?
  submittedAt     DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])
  term          Term          @relation(fields: [termId], references: [id])

  @@unique([userId, staffingCycleId, termId])
  @@index([staffingCycleId, termId])
}

enum IntentStatus {
  Returning // Working this term
  Off // Taking the term off (off-term / co-op / not enrolled)
  Graduating // Graduating before/at this term — won't return
  Leave // Leave of absence
  Unsure // Hasn't decided yet
}

// ─── Generic forms ──────────────────────────────────────────────────────────
//
// The Forms page is a generic form builder. Users create Forms, optionally
// organised into Page folders (Form.folderPageId nullable — null = top level;
// can be reassigned to move a form in/out of a folder in the Drive). A form's
// question set is edited by appending immutable FormVersion rows; members fill
// out the latest version and their answers are stored as a FormSubmission.

// Who may fill a published form via its link. Members = signed-in lab
// members (the historical behavior and default); SignedIn = any account
// (member, Dartmouth student, partner); Groups = signed-in users in at least
// one of the form's audienceGroupIds; Public = no account required.
enum FormAudience {
  Members
  SignedIn
  Groups
  Public
}

model Form {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Drive unified tree placement. Null = unplaced (rendered at the Lab top
  // level). When set, must point at a Page of
  // kind=Folder. Loose FK — no DB-level constraint — matching the existing
  // Page.workspaceId / ProjectFile.folderPageId convention. Placement is
  // ORGANISATION only and NEVER changes who can see or fill this form: the
  // existing canViewForms gate and form audience rules remain the sole access
  // controls. This field is consumed only for display ordering in the unified
  // drive tree; it does not affect fill/visibility semantics in any way.
  folderPageId String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  // Publishing: when `published`, the form is fillable from outside dali-api
  // (no auth) via its unguessable `publicToken`. Token is set on first
  // publish and reused so a published link stays stable across re-publishes.
  published   Boolean @default(false)
  publicToken String? @unique

  // Scheduled publish window. The form-windows job flips `published` when a
  // boundary passes (opensAt → publish, closesAt → unpublish), acting on each
  // boundary exactly once so a later manual publish/unpublish sticks.
  opensAt  DateTime?
  closesAt DateTime?

  // Soft-delete for Drive trash. Non-null = archived (hidden from Drive and
  // "Forms for you", not fillable), restorable from Trash. A permanent delete
  // from Trash removes the row (and cascades responses) for real.
  archivedAt DateTime?

  // Per-form response settings (Forms editor "Settings" card).
  // oneResponsePerMember: an authenticated member's ORDINARY fill (not
  // staffing-slot-bound, not education-scoped) is accepted at most once.
  // notifyOnSubmission: each submission creates an in-app Notification for
  // createdById (best-effort, after the submission transaction commits).
  oneResponsePerMember Boolean @default(false)
  notifyOnSubmission   Boolean @default(false)

  // Who may fill the form via its public link. `audienceGroupIds` is only
  // meaningful when audience == Groups (GroupDefinition ids; array rather
  // than a join table, matching GroupDefinition.staticMemberIds, so groups
  // stay independently deletable — a dangling id simply admits nobody).
  audience         FormAudience @default(Members)
  audienceGroupIds String[]     @default([])

  // Opt-in discovery: listed forms appear in "Forms for you" (Home) for
  // people the audience admits. Unlisted forms stay reachable by link only.
  listed Boolean @default(false)

  // Editable working copy. "Save" writes here; the draft is mutable and is
  // NEVER served to fillers. "Save as version" freezes the draft into an
  // immutable FormVersion and clears these back to null. Published fills
  // always read the latest FormVersion, so a draft is unusable until it's
  // saved as a version. `draftIntro` mirrors FormVersion.intro (serialized
  // ProseMirror description JSON).
  draftQuestions Json?
  draftIntro     String?

  versions      FormVersion[]
  submissions   FormSubmission[]
  notifications Notification[]
  cycleBindings StaffingCycleFormBinding[]

  partnerApplicationBindings          PartnerApplicationFormBinding[]
  educationOfferingsAsApplicationForm EducationOffering[]             @relation("EducationOfferingApplicationForm")
  educationBindings                   EducationFormBinding[]          @relation("EducationFormBindings")
  hiringCyclesAsApplicationForm       ApplicationCycle[]              @relation("CycleApplicationForm")
  hiringDomainChallenges              CycleDomainForm[]

  @@index([folderPageId])
  @@index([createdById])
}

// Snapshot of a form's question set. Append-only ONCE USED: a version whose
// questions have been served in a real response (a FormSubmission, or a hiring
// Application/DomainApplication that pinned it) is frozen — edits from then on
// must create a new version. Until first use it may be edited or deleted in
// place (Forms editor), which is how an accidental "Save as version" gets
// corrected without accreting dead versions. `questions` is a JSON array of
// question objects:
//   { id, type: "shortText"|"longText"|"select"|"multiSelect", label,
//     required, options?: string[], max?: number }
model FormVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // Bumps on every in-place edit. Doubles as the fingerprint a filler carries
  // from page-load to submit: a mismatch means the version was edited underneath
  // them, so the submit is rejected with a reload prompt instead of recording
  // answers keyed to questions that no longer exist.
  updatedAt DateTime @default(now()) @updatedAt

  versionNumber Int
  questions     Json
  // Free-form intro/instructions shown above the questions. Plain text.
  intro         String?

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  submissions FormSubmission[]

  // Internal hiring applications that pinned this version (see Application.applicationFormVersionId).
  hiringApplicationsAsPinnedForm      Application[]       @relation("ApplicationApplicationForm")
  hiringDomainApplicationsAsChallenge DomainApplication[] @relation("DomainApplicationChallengeForm")

  @@unique([formId, versionNumber])
  @@index([formId, versionNumber])
}

// Answers to a specific form version. `answers` is a JSON object keyed by
// question id. Internal users submit with `userId` set; public/external fills
// (a published form filled without auth) leave `userId` null and instead
// capture `submitterName`/`submitterEmail`. The old per-user uniqueness was
// dropped to allow anonymous rows — each public submission is its own row.
model FormSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  formVersionId String
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)

  // Null for public/external submissions (no authenticated user).
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Captured only for public submissions; null for internal ones.
  submitterName  String?
  submitterEmail String?
  // Client IP of an anonymous (userId-less) fill, for abuse tracing. Never
  // set on authenticated submissions.
  submitterIp    String?

  // Staffing context, set only when this submission was filled through a
  // staffing-cycle slot binding (e.g. the "project-bids" slot). Null for
  // every ordinary form submission (announcements, public forms). Nullable +
  // SetNull so deleting a cycle doesn't cascade-delete the answer record;
  // pre-existing rows intentionally stay null (no backfill).
  staffingCycleId String?
  staffingCycle   StaffingCycle? @relation(fields: [staffingCycleId], references: [id], onDelete: SetNull)
  // Which slot it was filled for (mirrors StaffingCycleFormBinding.slot, e.g.
  // "project-bids"). Null unless staffingCycleId is set. Education feedback
  // submissions reuse this column with EducationFormBinding slots (e.g.
  // "session-feedback") alongside educationOfferingId.
  slot            String?

  // Education context, set only when this submission was filled through an
  // education slot binding (session feedback / instructor exit survey) or as
  // an offering application. Nullable + SetNull mirrors staffingCycleId.
  educationOfferingId String?
  educationOffering   EducationOffering? @relation(fields: [educationOfferingId], references: [id], onDelete: SetNull)
  educationSessionId  String?
  educationSession    EducationSession?  @relation(fields: [educationSessionId], references: [id], onDelete: SetNull)

  answers Json

  partnerApplication   PartnerApplication?
  educationApplication EducationApplication?

  @@index([userId, formVersionId])
  @@index([formId])
  @@index([formVersionId])
  @@index([staffingCycleId, slot])
  @@index([educationOfferingId, slot])
}

// Binds a generic Form to a named "slot" within one staffing cycle, so an
// admin can choose which form members fill for that term's Intent to Work,
// Project Bids, etc. `slot` is a free string (e.g. "intent-to-work",
// "project-bids") rather than an enum so new slots need no migration. Absence
// of a row = no form selected for that slot (callers fall back to default
// behavior). The read-only staffing boards still read structured records;
// this only controls which form is surfaced to members.
model StaffingCycleFormBinding {
  id              String   @id @default(cuid())
  staffingCycleId String
  slot            String
  formId          String
  updatedAt       DateTime @updatedAt
  updatedById     String

  // Per-binding question→column mapping: which of the bound form's questions
  // fills each structured role for this slot, plus the manager's renamed
  // column label. Shape: { version, entries: [{ questionKey, role, label,
  // termId? }] }. Null = not mapped yet (the slot can't interpret submissions
  // until a manager defines this). App-layer validated (see slot-roles.ts).
  columnMapping Json?

  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id], onDelete: Cascade)
  form          Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  updatedBy     User          @relation(fields: [updatedById], references: [id])

  @@unique([staffingCycleId, slot])
  @@index([formId])
}

model EssentialityForm {
  id              String    @id @default(cuid())
  projectId       String
  staffingCycleId String
  // PM only — not project mentors. App-level check: pmUserId must have an
  // active ProjectAssignment with domain=PM on this project.
  pmUserId        String
  submittedAt     DateTime?

  staffingCycle StaffingCycle        @relation(fields: [staffingCycleId], references: [id])
  pmUser        User                 @relation("EssentialityFormPm", fields: [pmUserId], references: [id])
  ratings       EssentialityRating[]

  @@unique([projectId, staffingCycleId])
}

model EssentialityRating {
  id                 String            @id @default(cuid())
  essentialityFormId String
  userId             String
  rating             EssentialityLevel
  notes              String?

  form EssentialityForm @relation(fields: [essentialityFormId], references: [id])
  user User             @relation(fields: [userId], references: [id])

  @@unique([essentialityFormId, userId])
}

enum EssentialityLevel {
  Critical
  Important
  NiceToHave
  NotNeeded
}

// Output of the staffing assignment process. On Confirm, promoted to a
// canonical ProjectAssignment row; this row retains the proposal/audit
// trail and can be referenced for future analysis.
model StaffingAssignment {
  id              String                   @id @default(cuid())
  userId          String
  staffingCycleId String
  projectId       String
  termId          String
  domainId        String
  level           Level
  status          StaffingAssignmentStatus @default(Proposed)
  assignedAt      DateTime                 @default(now())
  // Free-form actor userId.
  assignedById    String?

  user          User          @relation(fields: [userId], references: [id])
  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id])
  term          Term          @relation(fields: [termId], references: [id])

  @@index([userId, termId])
  @@index([projectId, termId])
}

// Manual position of a member's card within its staffing-board column. The
// column itself is DERIVED (from the member's assignment, or its absence =
// Unassigned); this row records only where the card sits in that column's
// order. One row per (cycle, user); cards with no row fall back to last-name
// sort. Decoupled from StaffingAssignment so Unassigned bidders — who have no
// assignment — can still be ordered. `columnKey` is the project id, or
// "__unassigned__", recorded so a stale order from a previous column is ignored
// once a card moves.
model StaffingCardOrder {
  id              String @id @default(cuid())
  staffingCycleId String
  userId          String
  columnKey       String
  // Sparse fractional/spread integer key: cards sort ascending by this. Saved
  // as the card's index in the column on each reorder, so it stays dense.
  sortKey         Int

  staffingCycle StaffingCycle @relation(fields: [staffingCycleId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([staffingCycleId, userId])
  @@index([staffingCycleId, columnKey])
}

// Distinct from the existing AssignmentStatus enum (which scopes
// InterviewAssignment with Active/Declined/Replaced).
enum StaffingAssignmentStatus {
  Proposed
  Confirmed
  Declined
}

// ─── Page tree ───────────────────────────────────────────────────────────────

model Page {
  id            String        @id @default(cuid())
  workspaceType WorkspaceType
  // Null for Lab workspace. Otherwise references the Project, the
  // EducationOffering, or — for Member workspaces — the owning User's id. The
  // FK is loose (no Prisma relation enforced at the DB layer for the
  // polymorphic scope id); the explicit project / offering back-relations
  // below cover the cases we look up by.
  workspaceId   String?
  // Null for top-level pages. Arbitrary depth; app enforces a max of 6.
  parentPageId  String?
  title         String
  kind          PageKind      @default(FreeForm)
  // Collab doc reference for FreeForm pages. Null for Structured pages
  // (which render from their underlying schema entities).
  contentDocId  String?
  position      Int           @default(0)

  // ─── Drive scope (Wave 2) — meaningful only when kind = Folder ───────────
  //
  // Governs who can access this folder and all items it contains. Null on any
  // non-Folder page and on ordinary folders that inherit from their ancestor.
  // Only the *nearest* ancestor folder with a non-null scopeKind is governing;
  // further ancestors are shadowed (nesting only narrows, never widens).
  //
  // Private = owner only; Lab = any lab member; Group = resolveGroupMembers(scopeGroupId).
  // scopePermission is the base grant level members of that scope receive.
  // With no explicitly-scoped folders in the DB this has NO effect on getPageAccess —
  // the resolver falls back to the existing workspaceType-derived logic.
  scopeKind       ScopeKind?
  // Loose FK → GroupDefinition.id; only meaningful when scopeKind = Group.
  scopeGroupId    String?
  // Base permission members of this scope receive. Null = resolver picks a
  // sensible default (View for Lab, Edit for Group/Private roots).
  scopePermission SharePermission?

  // Notion-style page metadata.
  iconEmoji     String?
  coverImageUrl String?
  // Per-page display prefs (Notion's Style section): { font: "default" |
  // "serif" | "mono", smallText: boolean, fullWidth: boolean }. Null = all
  // defaults. Shared — every viewer sees the same rendering.
  typography    Json?

  // Distinct from createdById; updated on every edit. Used in breadcrumb
  // tooltips, page lists, and mention previews.
  lastEditedById String?

  // Soft delete. Archived pages are filtered out of the tree by default
  // and surface only in the workspace's Archive view.
  archivedAt DateTime?

  // Partner sharing: when true and workspaceType == Project, users of any
  // PartnerOrg with an active ProjectPartner link to workspaceId may open
  // (and collaboratively edit) this page from the partner portal. Meaningless
  // for Lab/EducationOffering workspaces (stays false).
  partnerVisible Boolean @default(false)

  // Optional link to an EducationSession, for offering materials scoped to one
  // session (groups the student Materials view by session). Loose FK — only
  // meaningful when workspaceType == EducationOffering; null = offering-wide.
  sessionId String?

  // Education collaborative doc: when true and workspaceType == EducationOffering,
  // students with an Approved application to workspaceId may collaboratively
  // edit this page (a shared "workspace" doc), not just read it server-side.
  // Meaningless for Lab/Project workspaces (stays false). Enrollment — not auth
  // type — grants access, so it covers member and Dartmouth-portal students
  // alike. Editing is gated to before the offering is closed out.
  studentEditable Boolean @default(false)

  // Public sharing: when true and workspaceType == Project, this page's body
  // is the project's write-up on dali.website. Orthogonal to partnerVisible —
  // a partner-shared working doc is not automatically public, and the public
  // write-up is not automatically shared with the partner. Read-only to the
  // outside world (the public API renders a snapshot; it never grants edit
  // access the way the partner portal does). At most one page per project is
  // expected to carry it; the public API takes the lowest `position` if
  // several do.
  publicVisible Boolean @default(false)

  // ─── Member-workspace visibility (meaningless elsewhere; stays false) ────
  //
  // Personal notes are private by default. `profileVisible` is the single
  // public/private switch the owner controls: true puts the note on their
  // profile for anyone who can see that profile. Sharing is ADDITIVE and
  // independent — a private note can still be readable by the groups and
  // members on its PageShare list, without appearing on the profile.
  //
  // Deliberately NOT `publicVisible`, which already means "published to
  // dali.website" for project pages. Two different publics.
  profileVisible Boolean @default(false)

  // Owner-proposed, Core-approved promotion of a personal note onto the
  // lab-wide Documents hub. The hub is the lab's curated shelf, so the owner
  // can only ask; Core decides. Reviewer fields are null until then.
  labListing             LabListingState @default(None)
  labListingNote         String?
  labListingReviewedById String?
  labListingReviewedAt   DateTime?

  // ─── General access (Google/Notion "General access" row) ─────────────────
  //
  // Orthogonal to the named PageShare list and to the workspace-specific
  // visibility flags above. Restricted (default) = only named accounts/groups
  // plus the workspace's base access. LabMembers = anyone in the lab gets
  // `linkPermission`. Public = anyone with the URL gets a read-only view.
  // Evaluated live in getPageAccess (max with base + named share), so flipping
  // back to Restricted revokes link access immediately — no rows to clean up.
  // `linkPermission` is only meaningful when linkAccess != Restricted and is
  // never FullAccess (re-share is a named-principal grant only). Public forces
  // it to View (no identity to attribute comment/edit writes to).
  linkAccess     LinkAccess      @default(Restricted)
  linkPermission SharePermission @default(View)

  shares    PageShare[]
  favorites UserFavorite[]

  // Pinned to the top of the project's Documents block. Timestamp so pins can
  // be ordered most-recent-first. Null = not pinned. (Distinct from the
  // system Overview/PRD docs, which are always shown pinned.)
  pinnedAt DateTime?

  // Set when this page was auto-created as a meeting's attendance-tracking
  // note (see ScheduledMeeting.notePage / meetingType). Lets the document
  // route know to render the AttendanceChecklist above the editor.
  meetingNoteId String?           @unique
  meetingNote   ScheduledMeeting? @relation(fields: [meetingNoteId], references: [id])

  // Marks a page as system-managed and undeletable (mirrors
  // GroupDefinition.systemKey) — e.g. the default "Team meeting notes" /
  // "Partner meeting notes" folders auto-created per project (see
  // ensureProjectFolder in app/lib/pages.ts). Null for ordinary user-created
  // pages. The unique constraint makes ensure-create idempotent.
  systemKey String? @unique

  // When true, this page acts as a template: it is excluded from the normal
  // document list and offered as a starting point when creating new pages.
  // The new page is created by byte-copying the CollabDocument state into a
  // fresh doc id — no structural schema change, just a new row.
  isTemplate Boolean @default(false)

  parent   Page?  @relation("PageTree", fields: [parentPageId], references: [id])
  children Page[] @relation("PageTree")

  // Lab-wide tags applied to this document. Comments (doc-level + inline) live
  // in DocComment with targetType=doc, targetId=Page.id — referenced loosely
  // (no back-relation) to keep the polymorphic target column FK-free.
  tags PageTag[]

  // Reverse of Project.overviewPageId. The polymorphic `workspaceId` column
  // above is intentionally NOT declared as a Prisma relation — workspaceType
  // dispatches to the right table at the app layer (see expansion_plan
  // §"Page Tree"). Two FK constraints on one column would conflict at the
  // DB level.
  projectAsOverview Project? @relation("ProjectOverview")
  projectAsPRD      Project? @relation("ProjectPRD")

  createdById  String
  createdBy    User     @relation("PageCreatedBy", fields: [createdById], references: [id])
  lastEditedBy User?    @relation("PageLastEditedBy", fields: [lastEditedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Backlink index: pages that link TO this page via a @page-mention inline node.
  incomingLinks PageLink[] @relation("PageLinkTarget")
  outgoingLinks PageLink[] @relation("PageLinkSource")

  // Full-text search index of this page's body. Absent until the page has been
  // saved once (or picked up by the doc-search-index sweep).
  searchIndex PageSearchIndex?

  @@index([workspaceType, workspaceId, parentPageId])
  @@index([archivedAt])
  // Trigram index behind the typo-tolerant title match in doc-search.server.ts
  // (`query <% "title"`). Ordinary exact/substring title search still uses the
  // plain ILIKE path.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Directed page→page reference maintained by the collab store hook whenever a
// doc body is saved. One row per (from, to) pair — re-mentioning the same page
// multiple times in one doc is still one edge. Cascade-deletes when either page
// is hard-deleted (soft-deleted / archived pages keep their links so the
// backlinks affordance can still show archived sources).
model PageLink {
  id         String   @id @default(cuid())
  fromPageId String
  toPageId   String
  createdAt  DateTime @default(now())

  fromPage Page @relation("PageLinkSource", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage   Page @relation("PageLinkTarget", fields: [toPageId], references: [id], onDelete: Cascade)

  @@unique([fromPageId, toPageId])
  @@index([toPageId])
}

// Who a personal note has been shared with, beyond its own profileVisible
// switch. Additive: a row here grants read access regardless of visibility.
//
// Principals are members and groups only. Partner orgs are deliberately absent
// — partner users live in a separate portal scoped to their linked projects,
// and a personal note has no project to hang off, so there'd be nowhere for it
// to appear. The principalType enum leaves room to add them later.
model PageShare {
  id            String             @id @default(cuid())
  pageId        String
  principalType SharePrincipalType
  // User.id or GroupDefinition.id, dispatched by principalType — same loose
  // polymorphic pattern as Page.workspaceId.
  principalId   String

  // What the principal may do. Additive on top of the page's base access —
  // getPageAccess takes the max, never a downgrade. Defaults to View so every
  // pre-existing share (all view-only) keeps its behavior. FullAccess adds the
  // right to re-share (see canManageSharing); it never applies to link/general
  // access, only to named principals.
  permission SharePermission @default(View)

  createdById String
  createdAt   DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, principalType, principalId])
  @@index([principalType, principalId])
}

// One person's relationship to one page: whether they favourited it, and when
// they last opened it. Both feed the home Favourites panel (pins first, then
// recents), and both are per-user — distinct from Page.pinnedAt, which is a
// single shared pin on the project's Documents block, not yours.
//
// Deliberately not PageView: that table is analytics and normalizes record ids
// out of the path (/documents/:id), so it cannot say *which* page you opened.
//
// One row per user per page, upserted — a cursor, not a history, so it stays
// bounded by (people × pages they've touched) and there is nothing to prune.
model UserFavorite {
  id     String @id @default(cuid())
  userId String

  // Exactly one target is set.
  //
  // `pageId` — a document. FK'd, so a deleted page takes its favourites with
  // it and the title always renders live rather than from a stale copy.
  //
  // `href` — anywhere else in the app that isn't a Page: a project hub, a
  // subtab. There is no row to point at, so the destination is the URL itself
  // and `label` is a snapshot taken when it was starred. That snapshot can go
  // stale (a renamed project keeps its old label) — the alternative is
  // resolving arbitrary routes to titles on every home load, which would mean
  // teaching this module every route in the app.
  pageId String?
  href   String?
  label  String?

  // Null = not favourited. Timestamped so pins order most-recent-first.
  favoritedAt DateTime?
  // Null = never opened. Set for both page visits (recordPageVisit) and the
  // entity detail routes — project / person / partner org (recordRouteVisit) —
  // that "Recently opened" surfaces. Hubs and sub-tabs are not recorded, so
  // they don't drown the list out.
  visitedAt   DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@unique([userId, href])
  @@index([userId, favoritedAt])
  @@index([userId, visitedAt])
}

enum SharePrincipalType {
  User
  Group
}

// Permission tiers for a share, ranked View < Comment < Edit < FullAccess.
// Mirrors Google/Notion. FullAccess = Edit plus the right to re-share; it is
// grantable only to named principals, never via general/link access.
enum SharePermission {
  View
  Comment
  Edit
  FullAccess
}

// Document-level "General access" audience (Google's General access row). Lives
// on Page.linkAccess. Restricted = only the named accounts/groups on the share
// list. LabMembers = anyone in the lab (isLabMember) gets Page.linkPermission —
// deliberately not "any signed-in account", which would include partner,
// applicant, and non-member Dartmouth users. Public = anyone with the URL gets
// a read-only view (no account needed).
enum LinkAccess {
  Restricted
  LabMembers
  Public
}

enum LabListingState {
  None
  Proposed
  Listed
  Declined
}

enum WorkspaceType {
  Lab
  Project
  EducationOffering
  // A member's own space — personal notes, scoped by workspaceId = User.id.
  // Unlike the other three, most of these are private to one person; see
  // Page.profileVisible and the PageShare list for how they're opened up.
  Member
}

enum PageKind {
  FreeForm
  Structured
  // A container page with no content of its own — only children. May nest
  // up to depth 6; a Folder may carry a scopeKind to govern access for
  // everything inside it.
  Folder
}

enum ScopeKind {
  Private
  Lab
  Group
}

// ─── Mentorship ──────────────────────────────────────────────────────────────

model MentorNote {
  id          String          @id @default(cuid())
  mentorId    String
  menteeId    String
  projectId   String
  termId      String
  domainId    String
  // Start-of-week date (Monday, UTC) the note covers. App enforces one row
  // per (mentor, mentee, project, term, domain, week).
  weekOf      DateTime
  // Tiptap/ProseMirror JSON document. Seeded from the current default
  // MentorNoteTemplate on create. Single-author — no Yjs/Hocuspocus.
  contentJson Json            @default("{}")
  // Mentor's at-a-glance read on how the mentee is doing this week. Null until
  // the mentor picks one — the browse grid renders it as a colored cell.
  vibe        MentorNoteVibe?

  mentor User @relation("MentorNoteMentor", fields: [mentorId], references: [id])
  mentee User @relation("MentorNoteMentee", fields: [menteeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mentorId, menteeId, projectId, termId, domainId, weekOf])
  @@index([menteeId, termId])
  @@index([mentorId, termId])
}

// Mentor's weekly vibe read on a mentee: Good (green), Ok (yellow), Bad (red).
enum MentorNoteVibe {
  Good
  Ok
  Bad
}

model MentorNoteTemplate {
  id            String   @id @default(cuid())
  name          String
  // Tiptap/ProseMirror JSON document; new MentorNotes seed contentJson
  // from the current isDefault template on create.
  contentJson   Json     @default("{}")
  isDefault     Boolean  @default(false)
  // Free-form last-updated userId.
  lastUpdatedBy String?
  updatedAt     DateTime @updatedAt
}

// ─── Notification preferences ────────────────────────────────────────────────
//
// The dormant NotificationEvent event-log model was dropped when notify()
// (app/lib/notify.server.ts) unified delivery on the Notification model —
// eventType/emailedAt/slackDmAt now live there.

model NotificationPreference {
  id              String     @id @default(cuid())
  userId          String
  // Matches Notification.eventType (registry: app/lib/notification-events.ts).
  // No wildcard rows — an absent row means the registry default applies, so
  // evolving a default never requires a backfill.
  eventType       String
  inApp           Boolean    @default(true)
  // Native banner raised by the desktop app for an in-app row. Sub-preference
  // of inApp: without the in-app row there is nothing to banner.
  desktop         Boolean    @default(true)
  // Slack DM requires a resolved User.slackUserId; without one the channel
  // silently skips regardless of this toggle.
  slackDm         Boolean    @default(false)
  // Email cadence: Instant = per-notification email at notify() time,
  // Daily/Weekly = batched digest, Off = in-app only.
  digestFrequency DigestFreq @default(Off)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
}

enum DigestFreq {
  Instant
  Daily
  Weekly
  Off
}

// ─── Background jobs ─────────────────────────────────────────────────────────
//
// Bookkeeping row per registered background job (registry: app/jobs/registry.ts).
// Rows self-heal from the registry on every tick — the dev DB is wiped and
// staging is restored from prod on each deploy, so nothing here can be assumed
// to survive. Cross-machine dedup is a lease: a tick claims a job with an
// atomic CAS UPDATE setting lockedUntil; expiry (not explicit release) is the
// crash recovery.

model ScheduledJob {
  name            String        @id // registry key, e.g. "task-due-reminders"
  enabled         Boolean       @default(true)
  // DB-authoritative once the row exists (editable from Admin → Jobs); the
  // registry value only seeds it at creation.
  intervalMinutes Int
  // Per-job numeric knobs declared by the registry entry (JobSettingDef[]),
  // e.g. { "leadMinutes": 30 }. Unknown/out-of-range values are ignored in
  // favor of the declared default at resolution time.
  settings        Json          @default("{}")
  nextRunAt       DateTime      @default(now())
  lockedUntil     DateTime?
  lastRunAt       DateTime?
  // Set only on successful runs; handlers receive it as their incremental
  // cursor (the digest jobs gate on it).
  lastSuccessAt   DateTime?
  lastStatus      JobRunStatus?
  lastError       String?
  lastDurationMs  Int?
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
}

enum JobRunStatus {
  Success
  Error
}

// A UI-configurable feature flag. The registry (app/lib/feature-flags.ts) is
// the source of truth for which flags exist and their seed defaults; this row
// is authoritative for the operator-edited targeting once it exists (edited in
// Admin → Feature Flags). Rows self-heal — a wiped/rebuilt DB just falls back
// to registry defaults (a missing row is evaluated as off). See ScheduledJob
// for the same registry-seeds/row-wins contract.
model FeatureFlag {
  key      String   @id // registry key, e.g. "desktop-app"
  // Master kill switch. When false the flag is off for everyone regardless of
  // the targeting below.
  enabled  Boolean  @default(false)
  // When enabled: on for all users.
  everyone Boolean  @default(false)
  // Role keys from getUserRoles() (app/lib/roles.ts), e.g. "isCore","isAdmin".
  // A user matches if they hold any listed role. Constrained to ROLE_TARGETS
  // at write time by the admin action.
  roles    String[] @default([])
  // Explicit User.id allowlist. Not an FK: a deleted user simply stops
  // matching; the flag config should not cascade-delete.
  userIds  String[] @default([])
  // Multi-value flags only (FeatureFlagDef.variants): which option targeted
  // users get. Null falls back to the registry's defaultVariant. Ignored by
  // plain on/off flags.
  variant  String?
  note     String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// A composed announcement waiting for its send time. Payload + audience
// mirror the /api/notifications/send schema; the scheduled-announcements job
// fires due rows through the same shared fan-out (app/lib/announcements.server).
// sentAt doubles as the CAS claim column — set BEFORE fan-out so a failure
// can never double-send a lab-wide blast (drops beat dupes here); errors land
// in lastError for the composer's scheduled list.
model ScheduledAnnouncement {
  id              String @id @default(cuid())
  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  title       String
  body        String?
  // Sanitized rich-text HTML for the email channel (rendered later, at fire
  // time). In-app/Slack use the plain-text `body` mirror. Null → plain body.
  bodyHtml    String?
  link        String?
  kind        NotificationKind @default(General)
  isTodo      Boolean          @default(false)
  dueAt       DateTime?
  // Deliberately not an FK: the payload is a deferred request, re-validated
  // at fire time — deleting a form must not cascade the pending announcement.
  formId      String?
  // Also email each recipient's Dartmouth address at fire time (composer
  // toggle). Email channel only.
  ccDartmouth Boolean          @default(false)

  allMembers Boolean  @default(false)
  groupIds   String[] @default([])
  userIds    String[] @default([])

  sendAt     DateTime
  sentAt     DateTime?
  sentCount  Int?
  lastError  String?
  canceledAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([sentAt, sendAt])
}

// ─── Partner portal ──────────────────────────────────────────────────────────

model PartnerOrg {
  id               String  @id @default(cuid())
  name             String
  logoUrl          String?
  website          String?
  // Optional designated primary contact within this org. Free-form: a
  // PartnerMembership.id (was PartnerUser.id pre-CRM-cutover). Not enforced as
  // a Prisma relation to avoid a circular FK; app-level keeps this valid.
  primaryContactId String?
  // True for solo-individual partners (e.g., a Dartmouth professor funding
  // a one-off project, no real organization). Single-user org to avoid a
  // second code path.
  isIndividual     Boolean @default(false)

  // `users` is the deprecated org membership (see PartnerUser). New code uses
  // `memberships` (PartnerMembership). Kept only until the PartnerUser drop.
  users        PartnerUser[]
  memberships  PartnerMembership[]
  projects     ProjectPartner[]
  applications PartnerApplication[]
  invites      PartnerInvite[]

  createdAt DateTime @default(now())
}

// Teammate invites into an existing PartnerOrg, sent by a partner (from
// portal settings) or by Core (from the internal org page). Deliberately not
// an OneTimeToken: invites are listed per-org with revoke/re-send, and the
// invitee's User row is only created on acceptance. The raw token is
// SHA-256 hashed at rest (same convention as OneTimeToken/Session).
model PartnerInvite {
  id              String    @id @default(cuid())
  partnerOrgId    String
  // Normalized lowercase.
  email           String
  displayRole     String?
  // sha256(raw token), base64url. Looked up by hash.
  tokenHash       String    @unique
  // User.id of the partner teammate or Core member who sent it. Loose ref,
  // no relation — display-only.
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  partnerOrg PartnerOrg @relation(fields: [partnerOrgId], references: [id])

  @@index([partnerOrgId])
  @@index([email])
}

// DEPRECATED — superseded by PartnerContact + PartnerMembership (the account-
// first CRM cutover). No longer read/written by app code; retained only so the
// data survives one deploy for a rollback window. Dropped in a follow-up
// migration. Do not add new references.
model PartnerUser {
  id           String              @id @default(cuid())
  userId       String              @unique
  partnerOrgId String
  displayRole  String?
  authProvider PartnerAuthProvider

  user       User       @relation(fields: [userId], references: [id])
  partnerOrg PartnerOrg @relation(fields: [partnerOrgId], references: [id])

  createdAt DateTime @default(now())
}

enum PartnerAuthProvider {
  MagicLink
  Google
}

// The account-first primitive: a person in the partner funnel. Exists BEFORE
// any authenticated User (Core logs inquiries from emails/referrals) and BEFORE
// any PartnerOrg (orgs are created only at promotion). One contact spans many
// applications and many orgs over time. `userId` is set when/if the person
// authenticates (Google or magic link).
model PartnerContact {
  id           String               @id @default(cuid())
  name         String
  // Normalized lowercase email — the natural key for de-duping inbound
  // inquiries and matching to a User at auth time.
  email        String               @unique
  // Set when the person authenticates and a User is resolved. Nullable +
  // unique: at most one contact per User, but a contact may never sign in.
  userId       String?              @unique
  // How the person authenticated (unset until first sign-in). Moved here from
  // PartnerUser — it's a person-level fact, not per-org.
  authProvider PartnerAuthProvider?

  user         User?                @relation(fields: [userId], references: [id])
  applications PartnerApplication[]
  memberships  PartnerMembership[]
  meetings     PartnerMeeting[]

  createdAt DateTime @default(now())

  @@index([email])
}

// A person's membership in one org (replaces PartnerUser). A PartnerContact
// can hold many memberships across many orgs over time; an org has many
// members. Access derives entirely from membership; `role` is display-only.
model PartnerMembership {
  id        String    @id @default(cuid())
  contactId String
  orgId     String
  // Free-text display role, e.g. "VP Engineering". Not a permission (was
  // PartnerUser.displayRole).
  role      String?
  // Soft end for "used to be at this org" without deleting history.
  // Null = current member.
  endedAt   DateTime?

  contact PartnerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  org     PartnerOrg     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([contactId, orgId])
  @@index([orgId])
  @@index([contactId])
}

// Many-to-many: projects can have multiple partners, and partners can fund
// multiple projects.
model ProjectPartner {
  id           String    @id @default(cuid())
  projectId    String
  partnerOrgId String
  startedAt    DateTime?
  endedAt      DateTime?

  project    Project    @relation(fields: [projectId], references: [id])
  partnerOrg PartnerOrg @relation(fields: [partnerOrgId], references: [id])

  @@unique([projectId, partnerOrgId])
}

// ─── OAuth provider (MCP) ────────────────────────────────────────────────────
//
// MCP clients register themselves via RFC 7591 Dynamic Client Registration
// at /oauth/register. No `dali-api` seed — per Q7 the OAuth provider surface
// is MCP-only.

model OAuthClient {
  id            String   @id @default(cuid())
  // The clientId MCP clients use. Stable, human-readable.
  clientId      String   @unique
  // Display name shown on the consent screen and in Settings.
  name          String
  redirectUris  String[]
  // For loopback native clients (Claude Desktop, Claude Code): match scheme
  // + host on redirectUris, ignore port. RFC 8252.
  isLoopback    Boolean  @default(false)
  // First-party clients skip the consent screen. No client gets this in v0
  // (per Q27); reserved for future use.
  isFirstParty  Boolean  @default(false)
  // Scopes this client is allowed to request.
  allowedScopes String[]

  // ─── Hard auth constraints ────────────────────────────────────────────────
  // Identity providers this client may use. MCP clients are ["google"].
  // /oauth/authorize rejects `provider` values not in this list.
  allowedProviders    String[]
  // Required accountType for this client. MCP clients: "member" — bars
  // Dartmouth-student and partner accounts. Null = any.
  requiredAccountType String?
  // If true, /oauth/callback/google verifies a DALIMember row exists for
  // the authenticated user, and mcp-auth re-checks it on every request (the
  // off-boarding kill switch). Defaults to true so a client provisioned
  // without an explicit value fails closed — a non-member can't reach the MCP
  // surface. Set false only for a deliberately public client.
  requireMembership   Boolean  @default(true)

  grants OAuthGrant[]

  createdAt DateTime @default(now())
}

// Represents a member's standing authorization for a specific client. One
// row per (user, client). Owns N Session rows over time (one per
// re-authorization after rolling expiry).
model OAuthGrant {
  id         String    @id @default(cuid())
  userId     String
  clientId   String // OAuthClient.clientId
  // Member-supplied or client-supplied label, shown in Settings.
  // Defaults to the client's name on first issuance.
  name       String
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user     User        @relation(fields: [userId], references: [id])
  client   OAuthClient @relation(fields: [clientId], references: [clientId])
  sessions Session[]

  @@unique([userId, clientId])
  @@index([userId, revokedAt])
}

// ─── Magic-link (partner + alumni personal-email auth) ───────────────────────

// Single-use tokens for magic-link sign-in. Used by Partner portal (primary
// auth) and alumni post-grad (personal-email fallback after dali.dartmouth
// .edu revocation). The raw token is SHA-256 hashed at rest; the email
// contains the raw value. Tokens are single-use: `usedAt` set on consumption.
model OneTimeToken {
  id        String       @id @default(cuid())
  userId    String
  // sha256(raw token), base64url. Looked up by hash.
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  // Optional context: e.g. the email that was sent the link, the redirect
  // target after verification.
  metadata  Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum TokenPurpose {
  PartnerMagicLink
  AlumniEmailLink
  EmailVerification
}

// ─── Desktop device pairing (GitHub-CLI style) ───────────────────────────────
//
// Backs the Tauri desktop app's sign-in. The app POSTs /auth/pair/start to
// create a Pending row, opens the system browser to /link?code=<userCode>, the
// signed-in user approves (binding userId), and the app polls /auth/pair/poll.
// On the consuming poll the server mints (a) a long-lived desktop Session for
// the background notification poller — returned for the OS keychain — and (b) a
// one-time handoff code that /auth/handoff redeems into a fresh webview cookie
// session. All codes are SHA-256 hashed at rest (same scheme as Session.id and
// OneTimeToken.tokenHash); raw values exist only in transit. See
// TAURI_DESKTOP_PLAN.md.
model DevicePairing {
  id String @id @default(cuid())

  // sha256(raw deviceCode), base64url. The raw deviceCode is the high-entropy
  // bearer secret the app polls with; we never store it.
  deviceCodeHash String @unique
  // Short, human-eyeballed code (8 chars from an unambiguous alphabet, no
  // 0/O/1/I/L). Stored canonical uppercase. NOT a bearer secret — approval
  // still requires an authenticated web session — so low entropy is fine.
  userCode       String @unique

  status DevicePairingStatus @default(Pending)

  // Human label the shell sends (hostname / OS), rendered on /link so the user
  // confirms which device they're approving.
  deviceLabel String

  // Bound at approval; null while pending.
  userId String?

  // Hashed id of the long-lived desktop Session minted on the consuming poll.
  // Doubles as the single-mint guard (claim requires this null) and an audit
  // link from the pairing to its revocable Session row.
  desktopSessionId String?

  // One-time handoff code minted on the consuming poll, ~60s TTL, single-use.
  // sha256(raw), base64url. Redeemed by /auth/handoff to plant the webview
  // cookie session.
  handoffCodeHash  String?
  handoffExpiresAt DateTime?
  handoffUsedAt    DateTime?

  // Pairing-request expiry (~10 min). Independent of handoff expiry.
  expiresAt  DateTime
  approvedAt DateTime?

  // Audit / abuse review of the start request.
  startIp        String?
  startUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([userId])
  @@index([expiresAt])
}

enum DevicePairingStatus {
  Pending
  Approved
  Consumed
  Cancelled
  Expired
}

// ─── Gmail integration (send-as) ─────────────────────────────────────────────
//
// New home for the Gmail send-as credential that today lives on the
// User.googleAccessToken/RefreshToken/TokenExpiresAt columns. Phase 1 adds
// this table; Phase 2 backfills from User.google* for the 1–2 admin
// accounts that use Gmail send-as, then drops the User columns.

model GmailIntegration {
  id             String           @id @default(cuid())
  userId         String
  // Which area's outbound mail this identity serves. Rows that predate
  // purposes are the applications@ integration and default to Hiring.
  // Resolution (lib/gmail-integration.ts) falls back to Hiring for purposes
  // with no connected row, so mail keeps flowing until ops links the
  // dedicated account.
  purpose        EmailSendPurpose @default(Hiring)
  // The Gmail account email being sent-as.
  sendAsEmail    String
  // Encrypted at rest (same AES-256-GCM helper used by UserCalendarLink).
  oauthTokens    String
  // Cached expiration of the access token portion of `oauthTokens`. Drives
  // proactive refresh ahead of expiry.
  tokenExpiresAt DateTime?
  // Soft-disable so the admin UI can revoke without deleting.
  enabled        Boolean          @default(true)
  // Last successful Gmail API call against this integration. Drives the
  // "Gmail connected" indicator on hiring email-templates UI.
  lastUsedAt     DateTime?
  syncError      String?
  linkedAt       DateTime         @default(now())
  // Per-day send cap for this identity (null = uncapped). The outbound-message
  // drain checks the SenderDailyUsage counter before each send and defers
  // over-cap messages to the next UTC day rather than dropping them.
  dailyCap       Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, purpose])
}

enum EmailSendPurpose {
  Hiring
  Education
  Partners
  General
}

// ─── Outbound Message Layer (transactional outbox) ───────────────────────────
// Every email / Slack send flows through this table. Producers (notify(), the
// digest, and the transactional per-feature pipelines) enqueue a row instead of
// calling Gmail/Slack directly; the enqueue is the idempotency claim (a re-fired
// producer collides on the unique (channel, dedupKey) instead of sending twice).
// A best-effort inline drain runs right after enqueue for low latency; the
// single-leased outbound-drain job sweeps the rest, retrying with backoff,
// respecting per-sender daily caps, and dead-lettering what it can't deliver.
// See specs/communication-idempotency.md.
model OutboundMessage {
  id      String @id @default(cuid())
  // "email" | "slack_dm" | "slack_channel"
  channel String

  // Opt-in idempotency claim. Null → NULLs are distinct in the unique index, so
  // unkeyed sends never collide (always send — the pre-outbox behavior).
  dedupKey String?

  // Routing. For email: `purpose` resolves the Gmail sender at drain time (so
  // token rotation / sender health apply at send), and `senderId` is stamped
  // with the resolved GmailIntegration id for the cap counter + audit. For
  // Slack: `target` is the user id (slack_dm) or channel id (slack_channel).
  purpose         String?
  senderId        String?
  target          String
  recipientUserId String?
  // The in-app Notification this outbound row delivers for (notify() only), so
  // the drain can stamp Notification.emailedAt / slackDmAt on success. Plain
  // string (not an FK) so retention can delete notifications independently.
  notificationId  String?

  // Rendered payload — the layer carries content; features own rendering.
  subject     String?
  bodyHtml    String? @db.Text
  bodyText    String? @db.Text
  slackText   String?
  ics         String? @db.Text
  // [{ filename, mimeType, contentBase64 }] — decoded to Buffers at send.
  attachments Json?

  // Lifecycle. status: Pending | Sending | Sent | Dead | Canceled.
  // nextAttemptAt doubles as the claim-lock stamp while Sending (a stale
  // Sending row past nextAttemptAt is reclaimable after a crash).
  status        String    @default("Pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?

  // Provenance / audit.
  eventType       String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([channel, dedupKey])
  @@index([status, nextAttemptAt])
  @@index([recipientUserId])
  @@index([senderId, sentAt])
}

// Per-sender, per-UTC-day send counter (mirrors AiUsage). The drain increments
// it on each successful email send and defers when it reaches GmailIntegration.dailyCap.
model SenderDailyUsage {
  id       String @id @default(cuid())
  senderId String
  day      String // UTC "YYYY-MM-DD"
  count    Int    @default(0)

  @@unique([senderId, day])
}

// Slack bug-report bot. A draft is created when a teammate @-mentions the bot
// in a Slack thread; it's filed (or cancelled) when they react to the bot's
// preview message with ✅ (or ❌). See app/slack/.
model SlackBugReportDraft {
  id                     String               @id @default(cuid())
  // Source thread on Slack — channel + the parent message ts identify the thread.
  slackChannelId         String
  slackThreadTs          String
  // Slack ts of the @-mention that triggered the filing. Combined with
  // channelId in the unique index this de-dupes Slack retries of the same
  // event. (Column kept its old name from the prior preview-then-confirm
  // flow to avoid a schema migration.)
  previewMessageTs       String
  // Snapshot of the thread at filing time so the issue body can be re-derived
  // or audited even if Slack messages get edited or deleted.
  threadJson             Json
  status                 SlackBugReportStatus @default(Pending)
  githubIssueNumber      Int?
  githubIssueUrl         String?
  // Captured so we can surface "who asked" in the issue body + audit.
  requestedBySlackUserId String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([slackChannelId, previewMessageTs])
  @@index([status])
}

enum SlackBugReportStatus {
  Pending
  Filed
  Cancelled
  Failed
}

// ─── Partner applications ────────────────────────────────────────────────────
//
// A partner's pitch for a project they want DALI to staff. Distinct from
// `Project` (which is work already underway): this is the inbound proposal
// and its review pipeline. On acceptance a Project is typically created and
// linked back via `resultingProjectId` (loose ref — no Prisma relation, to
// avoid a hard dependency cycle with Project).
//
// Account-owned inbound opportunity (the "partner card"): carries the whole
// CRM funnel from Inquiry → triage → application → meetings → decision →
// promotion. Owned by a PartnerContact (`applicantContactId`); the org is
// deferred and set only at promotion, so `partnerOrgId` is nullable.
model PartnerApplication {
  id                 String                   @id @default(cuid())
  // The account this opportunity belongs to. Always present — an opportunity
  // has an originating person even before any org exists.
  applicantContactId String
  // Set only at promotion (org is created then). Null through the whole
  // pre-promotion funnel.
  partnerOrgId       String?
  // Where this opportunity came from (Core-logged email/referral vs. a
  // /partner/apply form submission).
  source             PartnerApplicationSource @default(Form)
  // Free-text reason captured at a triage or decision transition
  // (e.g. "not enough dev scope", "revisit next term"). Reused across triage
  // + decision to avoid two near-identical columns.
  decisionReason     String?
  // Discovery eval: 8 numeric criteria + notes + criteriaVersion, kept as a
  // flexible blob so criteria can be reworded without a migration.
  evalRubric         Json?
  // 1–5 interview rating (own column so applications can be sorted by score).
  interviewRating    Int?
  // Captured on the acceptance checklist, before promotion.
  ambiguityRating    Int?
  fundingModel       String?
  // Core member assigned to meet the partner ("who will meet"). Loose ref to
  // User.id (same convention as PartnerInvite.invitedByUserId).
  assignedMeeterId   String?
  title              String
  // Short pitch summary. The long-form, versionable Statement of Work lives
  // in the collab doc named `partner-sow:{id}` (see sowDocId) — same Yjs +
  // CollabDocumentVersion machinery as project documents, so it gets
  // automatic version snapshots and the existing version-history UI.
  summary            String?
  // Free-form collab doc name for the SOW. Null until the SOW is first
  // opened/created. Not a Prisma relation: CollabDocument is keyed by its
  // unique `name`, addressed at the app layer.
  sowDocId           String?                  @unique
  status             PartnerApplicationStatus @default(Inquiry)
  // Set when status moves to Accepted and a Project is spun up. Loose ref to
  // Project.id; no relation to avoid a Project→PartnerApplication cycle.
  resultingProjectId String?
  // The partner's answers to the lab-configured application form (see
  // PartnerApplicationFormBinding), captured at submit time. Null when no
  // form was bound when they applied. SetNull because deleting the Form
  // cascades its submissions away — the application must survive that.
  formSubmissionId   String?                  @unique

  applicantContact PartnerContact                 @relation(fields: [applicantContactId], references: [id])
  partnerOrg       PartnerOrg?                    @relation(fields: [partnerOrgId], references: [id])
  formSubmission   FormSubmission?                @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  // The terms the partner wants the project to run / be staffed in. Drives
  // the "expected lab members per term" projection on the list page — an
  // application's expected headcount counts toward every target term.
  targetTerms      PartnerApplicationTargetTerm[]
  domains          PartnerApplicationDomain[]
  meetings         PartnerMeeting[]
  activities       PartnerActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerOrgId])
  @@index([applicantContactId])
  @@index([status])
}

// A Core↔partner meeting attached to an opportunity. Supports "meet in pairs":
// attendeeUserIds holds the Core members present; `debrief` and `outcome` are
// filled after the pair syncs. Notes/debrief are plain text (single-author
// internal scratch — unlike the co-authored SOW, no collab machinery).
model PartnerMeeting {
  id              String                 @id @default(cuid())
  applicationId   String
  scheduledAt     DateTime
  // Core attendees. Loose refs to User.id (same convention as
  // PartnerInvite.invitedByUserId) — display-only, no relation.
  attendeeUserIds String[]
  notes           String?
  debrief         String?
  outcome         PartnerMeetingOutcome?

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Denormalized contact link so a meeting is reachable from the account.
  contactId   String?
  contact     PartnerContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([scheduledAt])
}

enum PartnerMeetingOutcome {
  Advance
  Hold
  Reject
  MoreInfoNeeded
}

// Append-only activity log for a partner opportunity — the per-record timeline
// (status moves, notes, sent emails, meetings, eval, decision, promotion). This
// is the CRM history feed; distinct from the global security AuditLog. Rows are
// always written (even when the CRM flag is off) so history accrues before the
// feed is rolled out. `metadata` carries a typed payload per `type`
// (e.g. StatusChanged {from,to}, EmailSent {emailKind}, Triaged {kind}).
model PartnerActivity {
  id            String              @id @default(cuid())
  createdAt     DateTime            @default(now())
  applicationId String
  // Core member who performed the action. Null = system / partner-originated
  // (e.g. the applicant submitting the form). Loose ref to User.id.
  actorUserId   String?
  type          PartnerActivityType
  // Freeform for Note; a short human summary for other types (optional).
  body          String?
  metadata      Json?

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

enum PartnerActivityType {
  Created
  StatusChanged
  Note
  EmailSent
  MeetingScheduled
  MeetingDebriefed
  Evaluated
}

enum PartnerApplicationSource {
  Email // Core logged an inbound email
  Form // /partner/apply submission
  Referral // word-of-mouth / introduction
  Manual // Core created it directly (MCP / internal page)
}

// Binds the generic Form whose questions partners answer when pitching a
// project (/partner/apply). At most one row, app-enforced — absence means the
// apply page shows only its built-in structured fields. Mirrors
// StaffingCycleFormBinding but is lab-global rather than per-cycle.
model PartnerApplicationFormBinding {
  id          String   @id @default(cuid())
  formId      String
  // Loose ref to User.id (same convention as PartnerInvite.invitedByUserId).
  updatedById String?
  updatedAt   DateTime @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

// Join table: an application can target multiple terms (e.g. a 3-term
// engagement). `@@unique([applicationId, termId])` keeps a term from being
// added twice to the same application.
model PartnerApplicationTargetTerm {
  id            String @id @default(cuid())
  applicationId String
  termId        String

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  term        Term               @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())

  @@unique([applicationId, termId])
  @@index([termId])
}

// Per-domain expected scope for one application. `expectedChallenges` is the
// free-text description of the scope/challenges the partner expects in that
// domain; `expectedMembers` is the headcount used to project expected lab
// numbers per term.
model PartnerApplicationDomain {
  id                 String @id @default(cuid())
  applicationId      String
  domainId           String
  // Rich-text ProseMirror JSON doc (Tiptap StarterKit + Link). Pre-migration
  // rows were free text and have been wrapped into a single-paragraph doc.
  expectedChallenges Json?
  expectedMembers    Int    @default(0)

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  domain      Domain             @relation(fields: [domainId], references: [id])

  @@unique([applicationId, domainId])
  @@index([domainId])
}

// CRM funnel:
//   Inquiry → Triaged → Meeting / ApplicationSubmitted → UnderReview
//   → (Accepted → Promoted) | Rejected | LearnMore, with OnHold as a parking
//   state reachable from any active stage.
// (The pre-CRM values were Submitted/UnderReview/OnHold/Accepted/Rejected;
// Submitted → ApplicationSubmitted and Accepted → Promoted-when-projected in
// the backfill. Old enum labels linger in the Postgres type — harmless.)
enum PartnerApplicationStatus {
  Inquiry
  Triaged
  Meeting
  ApplicationSubmitted
  UnderReview
  LearnMore
  OnHold
  Accepted
  Rejected
  Promoted
  // Deprecated pre-CRM label, retained because Postgres can't drop enum values.
  Submitted
}

// ─── Payroll: Reconcile ──────────────────────────────────────────────────────
// Staff-only reconciliation of Dartmouth TimesheetX actuals against dali-os's
// authoritative assignments/wages, plus a per-project/chartstring/term Budget.
// All tables here are additive (no columns on existing tables).

// Which CSV kind a TimesheetImport audit row records.
enum TimesheetImportKind {
  Timesheet
  Notes
}

// A biweekly (2-week Sun–Sat) Dartmouth pay period. `name` is the canonical
// "MM/DD/YYYY - MM/DD/YYYY" label used as the natural key; dates are stored at
// UTC midnight to align with Term.startDate/endDate. `termId` is derived at
// ingest but admin-overridable, and null when no Term fits the period.
model PayPeriod {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  termId    String?

  createdAt DateTime @default(now())

  term    Term?             @relation(fields: [termId], references: [id])
  entries TimesheetEntry[]
  notes   TimesheetNote[]
  imports TimesheetImport[]

  @@index([termId])
}

// One approved shift from a TimesheetX export. Money/hours are Decimal (never
// float). `jobId` is the Dartmouth Job ID (category-level classifier, joined
// to JobCodeLookup.jobCode). Every dedupe-key column is NOT NULL — blank CSV
// fields are stored as "" so the unique actually dedupes (Postgres treats
// NULLs as distinct). Chart string is the charged line (authoritative for
// expense); shift times are raw strings for identity/display only.
model TimesheetEntry {
  id               String   @id @default(cuid())
  payPeriodId      String
  employeeNetId    String
  employeeName     String
  jobId            String
  jobTitle         String
  chartString      String
  shiftStartTime   String
  shiftEndTime     String
  totalShiftTime   Decimal
  hourlyPayRate    Decimal
  totalEarnings    Decimal
  overtimeHours    Decimal?
  overtimeEarnings Decimal?
  payCode          String
  department       String
  supervisorName   String
  timesheetStatus  String

  createdAt DateTime @default(now())

  payPeriod PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, employeeNetId, jobId, shiftStartTime, shiftEndTime, chartString, payCode])
  @@index([payPeriodId, employeeNetId])
  @@index([employeeNetId, jobId])
  @@index([chartString])
}

// A per-timesheet note row from the Notes CSV. `noteHash` is the sha-256 hex
// of the note text — used in the unique because a raw long note would blow
// Postgres's ~2.7KB btree index-row cap.
model TimesheetNote {
  id                   String  @id @default(cuid())
  payPeriodId          String
  netId                String
  jobId                String
  note                 String
  noteHash             String
  validatedChartstring String?
  linkToTimesheet      String?

  createdAt DateTime @default(now())

  payPeriod PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, netId, jobId, noteHash])
  @@index([payPeriodId, netId])
}

// Audit row per CSV import. Ingestion uses replace semantics (delete prior +
// re-create), so counts are recorded rather than updated in place.
model TimesheetImport {
  id                    String              @id @default(cuid())
  fileName              String
  kind                  TimesheetImportKind
  payPeriodId           String?
  rowsCreated           Int
  rowsSkippedDuplicates Int
  rowsDeletedPrior      Int
  uploadedById          String
  uploadedAt            DateTime            @default(now())

  payPeriod  PayPeriod? @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  @@index([payPeriodId])
  @@index([uploadedById])
}

// Admin-entered revenue for a project/chartstring/term line in the Budget
// view. `projectId` is null for Core/Instructor/External/unmatched lines;
// because Postgres treats NULLs as distinct, the null-project upsert path does
// a findFirst before create.
model BudgetEntry {
  id          String  @id @default(cuid())
  projectId   String?
  chartString String
  termId      String
  revenue     Decimal @default(0)
  projectType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])
  term    Term     @relation(fields: [termId], references: [id])

  @@unique([projectId, chartString, termId])
  @@index([termId])
}

// Free-text note attached to a Budget line, keyed the same as BudgetEntry.
model BudgetNote {
  id          String  @id @default(cuid())
  projectId   String?
  chartString String
  termId      String
  note        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])
  term    Term     @relation(fields: [termId], references: [id])

  @@unique([projectId, chartString, termId])
  @@index([termId])
}

// ─── Internal Processes ──────────────────────────────────────────────────────

// Admin-editable override for a term-roadmap week's content on the Lab
// Processes hub (app/internal-processes/routes/internal-processes.hub.tsx).
// The road geometry and week count are fixed in code (WEEK_META); this only
// overrides the human-editable text for a given week (0-10). A week with no
// row here falls back to WEEK_META's hardcoded default. updatedByUserId is a
// loose reference (not an FK) so it survives the editor's account being
// removed, matching the convention used elsewhere for audit-style fields.
model LabProcessWeekContent {
  id              String   @id @default(cuid())
  week            Int      @unique
  title           String
  summary         String
  highlights      String[]
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
