{
  "name": "dali-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "react-router typegen && tsc",
    "db:reset": "PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=yes prisma migrate reset --force && prisma db seed",
    "db:reset:local": "PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=yes DATABASE_URL=postgresql://dali:dali@localhost:5432/dali prisma migrate reset --force && DATABASE_URL=postgresql://dali:dali@localhost:5432/dali prisma db seed",
    "db:fetch:members": "tsx --env-file .env prisma/fetch-members.ts",
    "db:seed:members": "tsx prisma/seed-members.ts",
    "db:seed:v0-reference": "tsx --env-file .env prisma/seeds/v0-reference.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-presigned-post": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@blocknote/code-block": "0.52.1",
    "@blocknote/core": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@blocknote/server-util": "0.52.1",
    "@blocknote/shadcn": "0.52.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hocuspocus/extension-redis": "^3.4.4",
    "@hocuspocus/provider": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "@neondatabase/serverless": "^1.0.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.7.0",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@slack/web-api": "^7.15.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "canvas-confetti": "^1.9.4",
    "google-auth-library": "^10.6.2",
    "html-to-docx": "^1.8.0",
    "ioredis": "^5.10.1",
    "isbot": "^5.1.36",
    "isomorphic-dompurify": "^3.10.0",
    "lucide-react": "^0.544.0",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "react-router": "7.14.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.30",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.4",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.3"
  }
}
