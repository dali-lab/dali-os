<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime entitlements. The app stores the desktop Session token
	     in the login keychain (keyring crate → Security framework) using its
	     default per-app access group (<TeamID>.<bundleID>). No explicit
	     keychain-access-groups entitlement: its value needs an Xcode-expanded
	     $(AppIdentifierPrefix) that plain codesign leaves as a literal, which
	     AMFI then rejects at spawn (RBSRequestError 5 / errno 163 "Launchd job
	     spawn failed"). -->
	<!-- No JIT / unsigned-memory / debugging: this is a notarized release build. -->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<false/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<false/>
	<!-- Camera resource access for the WKWebView wallet-pass check-in scanner.
	     Under the hardened runtime this is what lets the webview reach the
	     camera once TCC grants it (the NSCameraUsageDescription in Info.plist
	     drives that one-time prompt). Plain boolean — no $(AppIdentifierPrefix)
	     expansion, so it's safe under plain codesign. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Microphone access for meeting-note recording, same shape as the camera
	     entitlement above (NSMicrophoneUsageDescription drives the prompt). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Associated Domains (webcredentials): lets WebAuthn passkeys engage the
	     platform authenticator (Touch ID) for os.dali.dartmouth.edu inside the
	     WKWebView. Pairs with the AASA served at
	     https://os.dali.dartmouth.edu/.well-known/apple-app-site-association.
	     Plain string, no $(AppIdentifierPrefix) expansion, so it is safe under
	     the plain-codesign flow (unlike keychain-access-groups). Requires the
	     Associated Domains capability on the App ID edu.dartmouth.dali.os in the
	     Apple Developer portal, and a signed/notarized build to verify. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:os.dali.dartmouth.edu</string>
	</array>
</dict>
</plist>
