<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime entitlements. The app stores the desktop Session token
	     in the login keychain (keyring crate → Security framework) using its
	     default per-app access group (<TeamID>.<bundleID>). No explicit
	     keychain-access-groups entitlement: its value needs an Xcode-expanded
	     $(AppIdentifierPrefix) that plain codesign leaves as a literal, which
	     AMFI then rejects at spawn (RBSRequestError 5 / errno 163 "Launchd job
	     spawn failed"). -->
	<!-- No JIT / unsigned-memory / debugging: this is a notarized release build. -->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<false/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<false/>
	<!-- Camera resource access for the WKWebView wallet-pass check-in scanner.
	     Under the hardened runtime this is what lets the webview reach the
	     camera once TCC grants it (the NSCameraUsageDescription in Info.plist
	     drives that one-time prompt). Plain boolean — no $(AppIdentifierPrefix)
	     expansion, so it's safe under plain codesign. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
