{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DALI OS",
  "version": "0.1.5",
  "identifier": "edu.dartmouth.dali.os",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://os.dali.dartmouth.edu"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 DALI Lab, Dartmouth College",
    "shortDescription": "DALI OS desktop",
    "longDescription": "Native desktop shell for DALI OS.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 },
        "windowSize": { "width": 660, "height": 420 }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dalios"]
      }
    },
    "updater": {
      "endpoints": [
        "https://dali-os-desktop-releases.s3.us-east-1.amazonaws.com/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RUYzMURBMTcyQzAxQzYKUldUR0FTd1gyakh2U0NJcTZ5enZDdnkvd21aU3ZsNGs0bmFrWlB6UlFla012R2RQS1k5ZW1ZVWkK"
    }
  }
}
