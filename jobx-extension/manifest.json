{
  "manifest_version": 3,
  "name": "DALI → JobX Timesheet Filler",
  "version": "1.0.0",
  "description": "Pre-fills the Dartmouth JobX timesheet from your DALI OS timesheet sections. Fills + saves each day; you review.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://dartmouth.studentemployment.ngwebsolutions.com/*",
    "http://localhost:3001/*",
    "http://localhost:3002/*",
    "http://localhost:5173/*",
    "https://*.dali.dartmouth.edu/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://dartmouth.studentemployment.ngwebsolutions.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DALI → JobX Timesheet Filler",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
